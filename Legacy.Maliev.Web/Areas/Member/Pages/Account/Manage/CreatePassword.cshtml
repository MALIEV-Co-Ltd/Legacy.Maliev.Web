@page
@model Legacy.Maliev.Web.Areas.Member.Pages.Account.Manage.CreatePassword
@inject IStringLocalizer<MemberCreatePasswordContent> MetadataLocalizer
@{
    ViewData["Title"] = MetadataLocalizer["Create password | MALIEV"];
    ViewData["Robots"] = "noindex,follow";
}
<section class="maliev-section" aria-labelledby="member-create-password-title">
    <form method="post" asp-page-handler="CreatePassword" class="maliev-panel maliev-form" data-password-confirmation data-password-mismatch="@MetadataLocalizer["Passwords do not match."]">
        <component type="typeof(MemberCreatePasswordContent)" render-mode="Static" param-Model="Model.DisplayModel" />
    </form>
</section>
