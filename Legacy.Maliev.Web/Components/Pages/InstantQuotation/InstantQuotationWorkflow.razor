@using Microsoft.AspNetCore.Components.Forms
@using Legacy.Maliev.Web.Application
@using Legacy.Maliev.Web.Application.Pricing
@inject IStringLocalizer<ThreeDimensionalPrintingEstimateContent> Localizer

<section class="instant-quote__workflow"
         @ref="workflowSection"
         aria-labelledby="instant-quote-workflow-heading"
         aria-busy="@IsBusy.ToString().ToLowerInvariant()"
         data-workflow-state="@State.ToString().ToLowerInvariant()">
    <h1 id="instant-quote-workflow-heading" class="instant-quote__sr-only">@Localizer["Instant Pricing"]</h1>

    <p id="instant-quote-status" class="instant-quote__sr-only" aria-live="polite" aria-atomic="true">@StatusMessage</p>
    <p data-workflow-preview-status class="instant-quote__sr-only" role="status">@PreviewStatusMessage</p>

    @if (!VisibleSections.Parts)
    {
        @foreach (var failure in failedPreviewSelections)
        {
            <article data-workflow-failed-preview data-preview-failure="@failure.Value.Category">
                <h4>@failure.Value.Name</h4>
                <p role="alert">@LocalPreviewFailureMessage(failure.Value)</p>
                <button type="button" disabled="@(InputDisabled || IsRepricing)"
                        aria-label="@Localizer["Remove {0}", failure.Value.Name]"
                        @onclick="() => RemoveFailedPreviewAsync(failure.Key)">@Localizer["Remove"]</button>
            </article>
        }
    }

    @if (VisibleSections.Upload)
    {
        <div class="instant-quote__gltf-unit">
            <label for="instant-quote-gltf-unit">@Localizer["Units for the next GLB/GLTF upload"]</label>
            <select id="instant-quote-gltf-unit" data-workflow-gltf-unit aria-describedby="instant-quote-gltf-unit-help" disabled="@InputDisabled">
                <option value="">@Localizer["Choose units before importing GLB/GLTF"]</option>
                <option value="metres">@Localizer["Metres (standard glTF)"]</option>
                <option value="millimetres">@Localizer["Millimetres (printing compatibility)"]</option>
            </select>
            <small id="instant-quote-gltf-unit-help">@Localizer["This choice applies only to new GLB/GLTF files. Existing parts and other formats keep their units."]</small>
        </div>
        <section data-workflow-upload
                 class="@(State is InstantQuotationWorkflowState.Empty ? null : "instant-quote__upload-control")"
                 aria-labelledby="instant-quote-upload-heading">
            <h3 id="instant-quote-upload-heading" class="instant-quote__sr-only">@Localizer["Start by uploading a file"]</h3>
            <InputFile id="instant-quote-files"
                       class="iq-file-input--empty"
                       @ref="fileInput"
                       name="files"
                       OnChange="UploadFilesAsync"
                       multiple
                       accept=".stl,.obj,.3mf,.glb,.gltf,.stp,.step,.igs,.iges,model/stl,application/sla,application/vnd.ms-pki.stl,model/x.stl-binary,model/x.stl-ascii,model/obj,model/3mf,model/gltf-binary,model/gltf+json,model/step,model/iges"
                       aria-describedby="instant-quote-upload-help instant-quote-status"
                       disabled="@InputDisabled" />
            <span id="instant-quote-upload-help" class="instant-quote__sr-only">
                @Localizer["Supported files: STL, OBJ, 3MF, GLB, GLTF, STP, STEP, IGS, and IGES. Maximum 100 files, 100 MB each."]
            </span>
            @if (uploadSelectionError is not null)
            {
                <p role="alert" tabindex="@(State is InstantQuotationWorkflowState.Empty ? "0" : null)">@uploadSelectionError</p>
            }
            @if (State is InstantQuotationWorkflowState.Empty)
            {
                <label for="instant-quote-files" class="iq-empty-dropzone" data-workflow-empty-dropzone tabindex="0">
                    <InstantQuotationEmptyScene />
                    <strong>@Localizer["Drop your 3D file here"]</strong>
                    <span>
                        @Localizer["or click to browse"] · STL, OBJ, 3MF, STEP, IGES, GLB, GLTF
                    </span>
                    <span data-workflow-upload-limit>@Localizer["Up to {0} MB per file · add multiple parts", InstantQuotationWorkflowCoordinator.MaximumFileSize / (1024 * 1024)]</span>
                </label>
            }
        </section>
    }

    @if (VisibleSections.Error)
    {
        <p role="alert">@Localizer["The file could not be uploaded. Try again."]</p>
    }

    @if (HasDevelopmentPreview)
    {
        <section data-workflow-local-demo
                 data-local-demo-step="@developmentStep.ToString().ToLowerInvariant()"
                 class="instant-quote__configuration"
                 aria-labelledby="development-preview-heading">
            <header class="instant-quote__panel-header">
                <h3 id="development-preview-heading" data-local-demo-badge>@Localizer["Demo"]</h3>
                <p role="status">@Localizer["Development preview only. Advisory prices cannot be submitted."]</p>
            </header>
            <canvas @key="developmentPreviewGeneration" @ref="developmentPreviewCanvas" data-local-demo-canvas
                    data-local-demo-generation="@developmentPreviewGeneration" tabindex="0"
                    style="display:block;width:100%;max-width:600px;height:300px"
                    aria-label="@Localizer["Interactive 3D part preview"]"></canvas>
            @foreach (var part in developmentPreviews.Values)
            {
                <article class="instant-quote__review-parts" data-local-demo-part>
                    <h4>@part.Name</h4>
                    <p data-local-demo-configuration>@part.MaterialKey @(part.Quantity)×</p>
                    <small>@Measurement(part.Claim.DimensionXmm) × @Measurement(part.Claim.DimensionYmm) × @Measurement(part.Claim.DimensionZmm) mm</small>
                    @if (developmentStep is not DevelopmentPreviewStep.Contact)
                    {
                        <div class="instant-quote__review-fields">
                            <div>
                                <label for="@DevelopmentInputId("material", part)">@Localizer["Material"]</label>
                                <select id="@DevelopmentInputId("material", part)" value="@part.MaterialKey"
                                        @onchange='args => ChangeDevelopmentSettingAsync(part.LocalId, "material", args)'>
                                    @foreach (var material in Materials)
                                    {
                                        <option value="@material.Key">@Localizer[material.DisplayName]</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label for="@DevelopmentInputId("preference", part)">@Localizer["Preference"]</label>
                                <select id="@DevelopmentInputId("preference", part)" value="@part.Preference.ToString()"
                                        disabled="@(PricingCatalog.ResolveMaterial(part.MaterialKey)?.Process is PrintProcess.Resin)"
                                        @onchange='args => ChangeDevelopmentSettingAsync(part.LocalId, "preference", args)'>
                                    <option value="Quality">@Localizer["Quality"]</option>
                                    <option value="Standard">@Localizer["Standard"]</option>
                                    <option value="Strength">@Localizer["Strength"]</option>
                                </select>
                            </div>
                            <div>
                                <label for="@DevelopmentInputId("color", part)">@Localizer["Color"]</label>
                                <select id="@DevelopmentInputId("color", part)" value="@part.Color" disabled="@(part.Claim.BodyCount > 1)"
                                        @onchange='args => ChangeDevelopmentSettingAsync(part.LocalId, "color", args)'>
                                    @foreach (var color in part.Claim.BodyCount > 1 ? new[] { "Any" } : GetColors(part.MaterialKey))
                                    {
                                        <option value="@color">@Localizer[color]</option>
                                    }
                                    @if (part.Claim.BodyCount == 1 && !GetColors(part.MaterialKey).Contains(part.Color, StringComparer.Ordinal))
                                    {
                                        <option value="@part.Color">@part.Color</option>
                                    }
                                </select>
                                @if (part.Claim.BodyCount == 1 && part.MaterialKey == "PLA")
                                {
                                    <input type="color" aria-label="@Localizer["Color"]"
                                           value="@(part.Color.StartsWith('#') ? part.Color : "#000000")"
                                           @onchange='args => ChangeDevelopmentSettingAsync(part.LocalId, "color", args)' />
                                }
                            </div>
                            <div>
                                <label for="@DevelopmentInputId("quantity", part)">@Localizer["Quantity"]</label>
                                <input id="@DevelopmentInputId("quantity", part)" type="number" min="1" max="@PricingCatalog.MaximumAdditiveQuantity"
                                       step="1" value="@part.Quantity"
                                       @onchange='args => ChangeDevelopmentSettingAsync(part.LocalId, "quantity", args)' />
                            </div>
                        </div>
                    }
                    <dl class="instant-quote__review-prices">
                        <div><dt>@Localizer["Unit price"]</dt><dd data-local-demo-unit-price>@Money(part.Price?.UnitPrice)</dd></div>
                        <div><dt>@Localizer["Subtotal"]</dt><dd data-local-demo-subtotal>@Money(part.Price?.Subtotal)</dd></div>
                        <div><dt>@Localizer["Print time"]</dt><dd>@(part.Price is null ? "—" : Measurement(part.Price.PrintTimeMinutesPerUnit)) @Localizer["minutes"]</dd></div>
                    </dl>
                    <details class="instant-quote__review-details">
                        <summary>@Localizer["Part details"]</summary>
                        <dl class="instant-quote__review-measurements">
                            <div><dt>@Localizer["Volume"]</dt><dd>@Measurement(part.Claim.VolumeMm3 / 1000) cm³</dd></div>
                            <div><dt>@Localizer["Surface area"]</dt><dd>@Measurement(part.Claim.SurfaceAreaMm2 / 100) cm²</dd></div>
                            <div><dt>@Localizer["Triangle count"]</dt><dd>@part.Claim.FacetCount</dd></div>
                        </dl>
                        <p>@Localizer["Price and lead time are estimates and may change after our engineers review your part for manufacturability."]</p>
                    </details>
                    <button type="button" data-local-demo-retry @onclick="() => RetryDevelopmentUploadAsync(part.LocalId)">@Localizer["Try again"]</button>
                </article>
            }
            <section class="instant-quote__pricing-summary" aria-labelledby="development-preview-price-heading">
                <h4 id="development-preview-price-heading">@Localizer["Advisory price and lead time"]</h4>
                @if (!DevelopmentPriceAvailable)
                {
                    <p role="status">@Localizer["Price unavailable — engineering review required."]</p>
                }
                <dl>
                    <div><dt>@Localizer["Subtotal"]</dt><dd>@Money(developmentTotal?.Printing)</dd></div>
                    <div><dt>@Localizer["Shipping"]</dt><dd>@Money(developmentTotal?.ShippingCost)</dd></div>
                    <div><dt>@Localizer["VAT"]</dt><dd>@Money(developmentTotal?.Vat)</dd></div>
                    <div><dt>@Localizer["Total"]</dt><dd>@Money(developmentTotal?.FinalOrderPrice)</dd></div>
                    <div><dt>@Localizer["Lead time"]</dt><dd data-local-demo-lead-time>@(developmentLeadTime is null ? "—" : developmentLeadTime.MinimumDays + "–" + developmentLeadTime.MaximumDays + " " + Localizer["days"].Value)</dd></div>
                </dl>
            </section>
            @if (developmentStep is DevelopmentPreviewStep.Configuration)
            {
                <button type="button" data-local-demo-review @onclick="ShowDevelopmentReview">@Localizer["Review"]</button>
            }
            else if (developmentStep is DevelopmentPreviewStep.Review)
            {
                <button type="button" @onclick="ShowDevelopmentConfiguration">@Localizer["Back"]</button>
                <button type="button" data-local-demo-continue @onclick="ShowDevelopmentContact">@Localizer["Customer details"]</button>
            }
            else
            {
                <section data-local-demo-contact aria-labelledby="development-preview-contact-heading">
                    <h4 id="development-preview-contact-heading">@Localizer["Customer details"]</h4>
                    <div class="instant-quote__customer-fields">
                        <label for="demo-contact-name">@Localizer["First name"]</label>
                        <input id="demo-contact-name" type="text" autocomplete="off" />
                        <label for="demo-contact-email">@Localizer["Email"]</label>
                        <input id="demo-contact-email" type="email" autocomplete="off" />
                        <label for="demo-contact-phone">@Localizer["Telephone"]</label>
                        <input id="demo-contact-phone" type="tel" autocomplete="off" maxlength="50" />
                        @foreach (var field in new[] { "Last name", "Mobile number", "Company", "Tax number", "Tax invoice issued to", "Branch code" })
                        {
                            var id = "demo-contact-" + field.Replace(" ", "-").ToLowerInvariant();
                            <label for="@id">@Localizer[field]</label>
                            <input id="@id" type="text" autocomplete="off" maxlength="50" />
                        }
                        <label for="demo-contact-country">@Localizer["Country"]</label>
                        <select id="demo-contact-country">
                            @foreach (var country in CustomerModel.Countries)
                            {
                                <option value="@country.Name">@country.DisplayName</option>
                            }
                        </select>
                        @foreach (var address in new[] { "Billing address", "Shipping address" })
                        {
                            <fieldset>
                                <legend>@Localizer[address]</legend>
                                @foreach (var field in new[] { "Building", "Street address", "Sub-district", "City / district", "Province", "Postal code" })
                                {
                                    var id = "demo-contact-" + address.Replace(" ", "-") + "-" + field.Replace(" ", "-");
                                    <label for="@id">@Localizer[field]</label>
                                    <input id="@id" type="text" autocomplete="off" maxlength="256" />
                                }
                            </fieldset>
                        }
                    </div>
                    <button type="button" @onclick="ReturnDevelopmentReview">@Localizer["Back"]</button>
                    <button type="button" data-local-demo-no-submit disabled>@Localizer["Submit"]</button>
                </section>
            }
            <button type="button" data-local-demo-remove @onclick="() => ClearDevelopmentPreviewAsync()">@Localizer["Remove"]</button>
        </section>
    }

    @if (incompletePreviewKey is not null && !VisibleSections.Viewer)
    {
        <section data-workflow-incomplete-preview aria-label="@Localizer["3D preview"]">
            <h3>@Localizer["3D preview"]</h3>
            <p role="status">@(incompletePreviewMeasured ? Localizer["Thickness analysis is incomplete"] : Localizer["Checking physical build…"])</p>
            <p>@Localizer["Preview only. No physical price is available. Repair the mesh and upload it again."]</p>
            <canvas @ref="incompletePreviewCanvas" tabindex="0"
                    style="display:block;width:100%;max-width:600px;height:300px"
                    aria-label="@Localizer["Interactive 3D part preview"]"></canvas>
            <button type="button" @onclick="RemoveIncompletePreviewAsync">@Localizer["Remove"]</button>
        </section>
    }

    @if (VisibleSections.Viewer)
    {
        <section data-workflow-viewer aria-labelledby="instant-quote-viewer-heading">
            <h3 id="instant-quote-viewer-heading">@Localizer["3D preview"]</h3>
            <p id="instant-quote-preview-help">@Localizer["The uploaded part preview will appear here."]</p>
            @if (incompletePreviewKey is not null)
            {
                <section data-workflow-incomplete-preview class="instant-quote__local-viewer" aria-hidden="@((SelectedLocalPreviewKey != incompletePreviewKey).ToString().ToLowerInvariant())"
                         style="visibility: @(SelectedLocalPreviewKey == incompletePreviewKey ? "visible" : "hidden")"
                         inert="@(SelectedLocalPreviewKey != incompletePreviewKey ? string.Empty : null)" aria-label="@Localizer["3D preview"]">
                    <h3 class="instant-quote__sr-only">@Localizer["3D preview"]</h3>
                    <p class="instant-quote__sr-only" role="status">@(incompletePreviewMeasured ? Localizer["Thickness analysis is incomplete"] : Localizer["Checking physical build…"])</p>
                    <p class="instant-quote__sr-only">@Localizer["Preview only. No physical price is available. Repair the mesh and upload it again."]</p>
                    <canvas @ref="incompletePreviewCanvas" tabindex="0"
                            aria-label="@Localizer["Interactive 3D part preview"]"></canvas>
                    <button type="button" @onclick="RemoveIncompletePreviewSelectionAsync">@Localizer["Remove"]</button>
                </section>
            }

            <canvas @ref="previewCanvas"
                    style="visibility: @(HasLocalPreviewSelection && selectedPendingPreviewKey is null ? "hidden" : "visible")"
                    aria-hidden="@((HasLocalPreviewSelection && selectedPendingPreviewKey is null).ToString().ToLowerInvariant())"
                    inert="@(HasLocalPreviewSelection && selectedPendingPreviewKey is null ? string.Empty : null)"
                    tabindex="0"
                    aria-label="@Localizer["Interactive 3D part preview"]"
                    aria-describedby="instant-quote-preview-help"></canvas>
            @if (HasLocalPreviewSelection && SelectedLocalPreviewKey != incompletePreviewKey
                && LocalThumbnail(SelectedLocalPreviewKey) is { } localThumbnail)
            {
                <img class="instant-quote__local-stage-thumbnail" src="@localThumbnail" alt="@Localizer["3D preview"]" />
            }
            <div data-workflow-file-error class="instant-quote__file-error" role="alert" aria-atomic="true" tabindex="0"
                 hidden="@(SelectedFileError is null)">
                @if (SelectedFileError is { } fileError)
                {
                    <strong>@fileError.Name</strong>
                    <span>@fileError.Message</span>
                    @if (fileError.Message != Localizer["The file could not be uploaded. Try again."].Value)
                    {
                        <span>@Localizer["The file could not be uploaded. Try again."]</span>
                    }
                }
            </div>
            <button type="button" @onclick="ResetPreviewAsync">@Localizer["Reset view"]</button>
            <button type="button" @onclick="FitPreviewAsync">@Localizer["Fit to view"]</button>
            <button type="button" @onclick="FullscreenPreviewAsync">@Localizer["Fullscreen"]</button>
            <button type="button"
                    class="instant-quote__thickness-toggle @(ThicknessNeedsAttention ? "needs-attention" : null)"
                    disabled="@(SelectedThickness?.Available != true)"
                    aria-label="@Localizer["Wall thickness"]"
                    aria-pressed="@(SelectedThickness?.Visible == true ? "true" : "false")"
                    @onclick="ToggleWallThicknessAsync">@Localizer["Wall thickness"]</button>
            @if (SelectedThickness?.Visible == true)
            {
                <p class="instant-quote__thickness-legend" role="status">
                    <span class="instant-quote__thickness-swatch" aria-hidden="true"></span>
                    @Localizer["Red: walls thinner than {0:N2} mm for {1}", SelectedThickness.LimitMm, SelectedThickness.Process.ToUpperInvariant()]
                    @if (SelectedThickness.Incomplete)
                    {
                        <span>@Localizer["Some regions could not be measured reliably."]</span>
                    }
                </p>
            }
        </section>
    }

    @if (VisibleSections.Parts)
    {
        var totalPartCount = Parts.Count + Uploads.Count(upload => Parts.All(part => part.PreviewCorrelationId != upload.LocalId));
        <section data-workflow-parts-panel aria-labelledby="instant-quote-parts-heading">
            <div class="instant-quote__parts-header">
                <h3 id="instant-quote-parts-heading">@Localizer["Parts"]</h3>
            <span data-workflow-part-count aria-live="polite">@(totalPartCount == 0 ? string.Empty : Localizer[totalPartCount == 1 ? "{0} part" : "{0} parts", totalPartCount])</span>
                <label class="instant-quote__bulk-checkbox">
                    <input type="checkbox" data-workflow-select-all @ref="bulkSelectAll"
                           checked="@AllBulkPartsSelected"
                           aria-checked="@(BulkSelectionMixed ? "mixed" : AllBulkPartsSelected ? "true" : "false")"
                           disabled="@(InputDisabled || IsRepricing || BulkParts.Count == 0)"
                           @onchange="SelectAllParts" />
                    @Localizer["Select all"]
                </label>
            </div>
            <div data-workflow-parts data-workflow-part-list aria-labelledby="instant-quote-parts-heading">
            <label for="instant-quote-files"
                   class="iq-compact-dropzone" data-workflow-add-file
                   aria-disabled="@InputDisabled.ToString().ToLowerInvariant()">
                <span aria-hidden="true">＋</span>
                <strong>@Localizer["Add parts"]</strong>
                <small>STL, OBJ, 3MF, STEP, IGES, GLB, GLTF</small>
                <small data-workflow-upload-limit>@Localizer["Up to {0} MB per file · add multiple parts", InstantQuotationWorkflowCoordinator.MaximumFileSize / (1024 * 1024)]</small>
            </label>
            @foreach (var pending in pendingPreviewSelections)
            {
                <article data-workflow-pending-parse data-browser-preview-key="@pending.Key" class="instant-quote__local-file">
                    <h4>@pending.Value.Name</h4>
                    <div data-workflow-local-configuration-summary>@MaterialSummary(LocalSummaryConfiguration(pending.Key))</div>
                    <span role="status">@Localizer["Checking physical build…"]</span>
                    <button type="button" disabled="@bulkApplying"
                            aria-label="@Localizer["View {0}", pending.Value.Name]"
                            aria-pressed="@(selectedPendingPreviewKey == pending.Key ? "true" : "false")"
                            @onclick="() => SelectPendingPreviewAsync(pending.Key)">@Localizer["View"]</button>
                    <button type="button" data-workflow-remove-pending
                            aria-label="@Localizer["Remove {0}", pending.Value.Name]"
                            @onclick="() => RemovePendingPreviewAsync(pending.Key)">@Localizer["Remove"]</button>
                </article>
            }
            @foreach (var failure in failedPreviewSelections)
            {
                <article data-workflow-upload-item data-workflow-failed-preview data-preview-failure="@failure.Value.Category" class="instant-quote__local-file is-error">
                    <h4>@failure.Value.Name</h4>
                    <div data-workflow-local-configuration-summary>@MaterialSummary(LocalSummaryConfiguration(failure.Key))</div>
                    <span class="instant-quote__local-thumbnail" aria-hidden="true">◇</span>
                    <span data-workflow-file-error-badge class="instant-quote__file-error-badge" role="img"
                          aria-label="@(failure.Value.Name + ": " + LocalPreviewFailureMessage(failure.Value))">!</span>
                    <button type="button" disabled="@bulkApplying"
                            aria-label="@Localizer["View {0}", failure.Value.Name]"
                            aria-pressed="@(selectedFailedPreviewKey == failure.Key ? "true" : "false")"
                            @onclick="() => SelectFailedPreviewAsync(failure.Key)">@Localizer["View"]</button>
                    <button type="button" data-workflow-remove-failed disabled="@(InputDisabled || IsRepricing)"
                            aria-label="@Localizer["Remove {0}", failure.Value.Name]"
                            @onclick="() => RemoveFailedPreviewAsync(failure.Key)">@Localizer["Remove"]</button>
                </article>
            }
            @foreach (var upload in Uploads.Where(upload => Parts.All(part => part.PreviewCorrelationId != upload.LocalId)))
            {
                var failed = upload.Status is InstantQuotationWorkflowUploadStatus.Error;
                var thumbnail = LocalThumbnail(previewKeys.GetValueOrDefault(upload.LocalId));
                var failureMessage = Localizer[upload.ProblemCategory is InstantQuotationProblemCategory.Validation
                    ? "Invalid file. Repair the model and reupload it." : "The file could not be uploaded. Try again."];
                <article data-workflow-upload-item data-upload-local-id="@upload.LocalId" data-browser-preview-key="@BrowserPreviewKey(upload.LocalId)" data-upload-error="@(failed ? "true" : null)"
                         class="instant-quote__local-file @(failed ? "is-error" : null)" aria-labelledby="upload-name-@upload.LocalId">
                    <h4 id="upload-name-@upload.LocalId">@upload.DisplayFileName</h4>
                    <div data-workflow-local-configuration-summary>@MaterialSummary(LocalSummaryConfiguration(BrowserPreviewKey(upload.LocalId)))</div>
                    @if (thumbnail is not null)
                    {
                        <img data-workflow-local-thumbnail class="instant-quote__local-thumbnail" src="@thumbnail" alt="@Localizer["3D preview"]" />
                    }
                    else
                    {
                        <span class="instant-quote__local-thumbnail" aria-hidden="true">◇</span>
                    }
                    @if ((upload.Status is InstantQuotationWorkflowUploadStatus.Pending or InstantQuotationWorkflowUploadStatus.Uploading)
                        && BrowserPreviewKey(upload.LocalId) is { } pendingKey)
                    {
                        <button type="button" disabled="@bulkApplying"
                                aria-label="@Localizer["View {0}", upload.DisplayFileName]"
                                aria-pressed="@(selectedPendingPreviewKey == pendingKey ? "true" : "false")"
                                @onclick="() => SelectPendingPreviewAsync(pendingKey)">@Localizer["View"]</button>
                    }
                    @if (upload.Status is InstantQuotationWorkflowUploadStatus.Uploading)
                    {
                        <span data-workflow-upload-overlay class="instant-quote__upload-overlay" role="status">
                            @UploadStatus(upload.Status)
                            <progress aria-label="@Localizer["Upload progress"]"></progress>
                        </span>
                        <button type="button"
                                aria-label="@Localizer["Cancel upload for {0}", upload.DisplayFileName]"
                                @onclick="() => CancelUpload(upload.LocalId)">@Localizer["Cancel"]</button>
                    }
                    else if (upload.Status is InstantQuotationWorkflowUploadStatus.Pending)
                    {
                        <button type="button"
                                aria-label="@Localizer["Remove {0}", upload.DisplayFileName]"
                                @onclick="() => DiscardUploadAsync(upload.LocalId)">@Localizer["Remove"]</button>
                    }
                    else if (upload.Status is InstantQuotationWorkflowUploadStatus.Error or InstantQuotationWorkflowUploadStatus.Cancelled)
                    {
                        @if (failed)
                        {
                            <span data-workflow-file-error-badge class="instant-quote__file-error-badge" role="img"
                                  aria-label="@(upload.DisplayFileName + ": " + failureMessage)">!</span>
                        }
                        <button type="button" data-workflow-view-upload disabled="@bulkApplying"
                                aria-label="@Localizer["View {0}", upload.DisplayFileName]"
                                aria-pressed="@(selectedPreviewUploadId == upload.LocalId ? "true" : "false")"
                                @onclick="() => SelectUploadPreviewAsync(upload.LocalId)">@Localizer["View"]</button>
                        <button type="button"
                                aria-label="@Localizer["Try upload again for {0}", upload.DisplayFileName]"
                                disabled="@(InputDisabled || IsRepricing)"
                                @onclick="() => RetryUploadAsync(upload.LocalId)">@Localizer["Try again"]</button>
                        <button type="button" data-workflow-remove-upload disabled="@(InputDisabled || IsRepricing)"
                                aria-label="@Localizer["Remove {0}", upload.DisplayFileName]"
                                @onclick="() => RemoveFailedUploadAsync(upload.LocalId)">@Localizer["Remove"]</button>
                    }
                    else
                    {
                        <p>@UploadStatus(upload.Status)</p>
                    }
                </article>
            }
            @foreach (var part in Parts)
            {
                var partNumber = PartNumber(part.PartId);
                <article data-workflow-part data-part-id="@part.PartId" data-browser-preview-key="@BrowserPreviewKey(part.PreviewCorrelationId)">
                    <span data-workflow-part-number aria-label="@Localizer["Part {0}", partNumber]">@partNumber.ToString("00")</span>
                    <h4>@part.DisplayFileName</h4>
                    <label class="instant-quote__bulk-checkbox">
                        <input type="checkbox" data-workflow-part-select
                               checked="@(IsBulkEligible(part) && selectedBulkParts.Contains(part.PartId))"
                               disabled="@(InputDisabled || IsRepricing || !IsBulkEligible(part))"
                               @onchange="args => SetPartSelected(part.PartId, args)" />
                        <span class="instant-quote__sr-only">@Localizer["Select for bulk material: {0}", part.DisplayFileName]</span>
                    </label>
                    <img class="instant-quote__review-thumbnail"
                         data-workflow-thumbnail
                         data-part-id="@ViewerPartKey(part.PartId)"
                         src="/src/images/3d-canvas-placeholder.svg"
                         alt="" />
                    <div data-workflow-part-summary>
                        <span data-workflow-summary-configuration>@MaterialSummary(part.Configuration)</span>
                        <span data-workflow-summary-unit-price
                              aria-label="@(Localizer["Unit price"].Value + " " + Money(DisplayQuote(part)?.UnitPrice))">@Money(DisplayQuote(part)?.UnitPrice)</span>
                    </div>
                    <button type="button"
                            aria-label="@Localizer["View {0}", part.DisplayFileName]"
                            aria-pressed="@IsPreviewSelected(part.PartId).ToString().ToLowerInvariant()"
                            disabled="@bulkApplying"
                            @onclick="() => SelectPreviewAsync(part.PartId)">@Localizer["View"]</button>
                    <button type="button"
                            aria-label="@Localizer["Remove {0}", part.DisplayFileName]"
                            disabled="@bulkApplying"
                            @onclick="() => RemovePartAsync(part.PartId)">@Localizer["Remove"]</button>
                </article>
            }
            </div>
        </section>
    }

    @if (VisibleSections.Configuration)
    {
        <section data-workflow-configuration
                 @ref="configurationSection"
                 tabindex="-1"
                 aria-labelledby="instant-quote-configuration-heading">
            <div data-workflow-configuration-content>
            <h3 id="instant-quote-configuration-heading">@Localizer["Part configuration"]</h3>

            <section data-workflow-dfm-status aria-labelledby="instant-quote-dfm-heading">
                <h4 id="instant-quote-dfm-heading">@Localizer["Design-for-manufacturing checks"]</h4>
                <p>@Localizer["You'll get a feedback from us if your design has potential problems."]</p>
                @foreach (var part in ConfigurationParts)
                {
                    var geometry = part.Geometry;
                    thicknessStatuses.TryGetValue(part.PartId, out var thicknessStatus);
                    var maximumDimension = Math.Max(geometry.DimensionXmm, Math.Max(geometry.DimensionYmm, geometry.DimensionZmm));
                    var oddlySmall = maximumDimension is > 0 and < 3;
                    var oddlyLarge = Math.Max(geometry.DimensionXmm, Math.Max(geometry.DimensionYmm, geometry.DimensionZmm)) > 350;
                    var hasWarning = HasManufacturingWarning(part);
                    <article data-workflow-dfm-part data-part-id="@part.PartId">
                        <h5>@part.DisplayFileName</h5>
                        <dl>
                            <div><dt>@Localizer["Dimensions"]</dt><dd>@Measurement(geometry.DimensionXmm) × @Measurement(geometry.DimensionYmm) × @Measurement(geometry.DimensionZmm) mm</dd></div>
                            <div><dt>@Localizer["Volume"]</dt><dd>@Measurement(geometry.VolumeMm3 / 1_000) cm³</dd></div>
                            <div><dt>@Localizer["Surface area"]</dt><dd>@Measurement(geometry.SurfaceAreaMm2 / 100) cm²</dd></div>
                            <div><dt>@Localizer["Min. thickness"]</dt><dd>@Measurement(geometry.MinThicknessMm) mm</dd></div>
                            <div><dt>@Localizer["Triangle count"]</dt><dd>@geometry.FacetCount.ToString("N0")</dd></div>
                        </dl>
                        @if (hasWarning)
                        {
                            <ul data-workflow-dfm-warnings>
                                @if (thicknessStatus?.Warning == true)
                                {
                                    <li data-dfm-code="thin-wall">@Localizer["Thin walls may print with defects"] — @Localizer["Some walls are below {0:N2} mm for {1} and may print with holes, weak walls, or missing details.", thicknessStatus.LimitMm, thicknessStatus.Process.ToUpperInvariant()]</li>
                                }
                                @if (thicknessStatus?.Incomplete == true)
                                {
                                    <li data-dfm-code="thickness-incomplete">@Localizer["Thickness analysis is incomplete"] — @Localizer["Some regions could not be measured reliably."]</li>
                                }
                                @if (!geometry.TopologyChecked)
                                {
                                    <li data-dfm-code="topology-not-checked">@Localizer["Detailed topology checks were skipped for this large mesh. Engineering review is required."]</li>
                                }
                                @if (geometry.NonWatertight)
                                {
                                    <li data-dfm-code="non-watertight">@Localizer["Non-watertight mesh"]</li>
                                }
                                @if (geometry.NonManifold)
                                {
                                    <li data-dfm-code="non-manifold">@Localizer["Non-manifold edges"]</li>
                                }
                                @if (geometry.BodyCount > 1)
                                {
                                    <li data-dfm-code="multiple-bodies">@Localizer["Multi-body mesh ({0} bodies)", geometry.BodyCount]</li>
                                }
                                @if (oddlySmall)
                                {
                                    <li data-dfm-code="dimension-too-small">@Localizer["A dimension is below 3 mm."]</li>
                                }
                                @if (oddlyLarge)
                                {
                                    <li data-dfm-code="dimension-too-large">@Localizer["A dimension exceeds 350 mm."]</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p data-workflow-dfm-clear>@Localizer["No automatic DFM warnings were found. Engineering review is still required."]</p>
                        }
                    </article>
                }
            </section>


            @if (SelectedPendingConfiguration is { } pending && selectedPendingPreviewKey is { } pendingKey)
            {
                <fieldset @key="pendingKey" data-workflow-material-picker data-workflow-local-settings data-browser-preview-key="@pendingKey"
                          disabled="@bulkApplying" inert="@(bulkApplying ? string.Empty : null)">
                    <legend>@pending.Name — @Localizer["Settings"]</legend>
                    <p role="status">@Localizer["Checking physical build…"]</p>
                    <InstantQuotationMaterialSelector @key="pendingKey" Materials="Materials"
                        SelectedMaterialKey="@pending.Configuration.MaterialKey"
                        PriceRows="Array.Empty<InstantQuotationMaterialPricingProgress>()"
                        PricingPending="true" FormatPrice="Money"
                        SelectionChanged="key => ChangePendingMaterialAsync(pendingKey, key)" />
                    <label for="pending-color-@pendingKey">@Localizer["Color"]</label>
                    <select id="pending-color-@pendingKey" name="color" value="@pending.Configuration.Color"
                            @onchange="args => ChangePendingColorAsync(pendingKey, args)">
                        @foreach (var color in GetColors(pending.Configuration.MaterialKey))
                        {
                            <option value="@color">@Localizer[color]</option>
                        }
                    </select>
                    <label for="pending-quantity-@pendingKey">@Localizer["Quantity"]</label>
                    <input id="pending-quantity-@pendingKey" name="quantity" type="number" min="1"
                           max="@PricingCatalog.MaximumAdditiveQuantity"
                           aria-describedby="pending-quantity-hint-@pendingKey"
                           @bind:get="pending.Quantity" @bind:set="raw => ChangePendingQuantityAsync(pendingKey, new ChangeEventArgs { Value = raw })"
                           @bind:event="oninput" />
                    <small id="pending-quantity-hint-@pendingKey">@Localizer["Maximum {0} pieces", PricingCatalog.MaximumAdditiveQuantity.ToString("N0")]</small>
                    <fieldset disabled="@(PricingCatalog.ResolveMaterial(pending.Configuration.MaterialKey)?.Process is PrintProcess.Resin)">
                        <legend>@Localizer["Build preference"]</legend>
                        @foreach (var preference in new[] { BuildPreference.Quality, BuildPreference.Standard, BuildPreference.Strength })
                        {
                            <label>
                                <input type="radio" name="pending-build-@pendingKey"
                                       checked="@(pending.Configuration.BuildPreference == preference)"
                                       @onchange="() => ChangePendingBuildPreferenceAsync(pendingKey, preference)" />
                                @Localizer[preference.ToString()]
                            </label>
                        }
                    </fieldset>
                </fieldset>
            }

            @foreach (var part in ConfigurationParts)
            {
                var partNumber = PartNumber(part.PartId);
                var selectorKey = (object?)BrowserPreviewKey(part.PreviewCorrelationId) ?? part.PartId;
                var displayQuote = DisplayQuote(part);
                <fieldset @key="selectorKey" data-workflow-material-color-quantity data-workflow-material-picker
                          disabled="@bulkApplying" inert="@(bulkApplying ? string.Empty : null)">
                    <legend><span data-workflow-part-number>@partNumber.ToString("00")</span> @part.DisplayFileName — @Localizer["Settings"]</legend>
                    <InstantQuotationMaterialSelector @key="selectorKey" Materials="Materials"
                        SelectedMaterialKey="@part.Configuration.MaterialKey" PriceRows="CardPriceRows(part)"
                        PricingPending="@(IsRepricing || HasUnacceptedConfiguration(part))"
                        FormatPrice="Money"
                        SelectionChanged="key => ChangeMaterialAsync(part.PartId, new ChangeEventArgs { Value = key })" />
                    @if (Parts.Count > 1)
                    {
                        <div class="instant-quote__bulk-material" data-workflow-bulk-material>
                            <span role="status" aria-live="polite">@Localizer["{0} parts selected", SelectedBulkCount]</span>
                            <button type="button" data-workflow-apply-material
                                    disabled="@(!CanApplyBulkMaterial)"
                                    @onclick="ApplyMaterialToSelectedAsync">
                                @(ConfigurationParts.SingleOrDefault() is { } active
                                    ? Localizer["Apply {0} to selected parts", active.Configuration.MaterialKey]
                                    : Localizer["Apply material to selected parts"])
                            </button>
                        </div>
                    }
                    <label for="color-@part.PartId">@Localizer["Color"]</label>
                    <select id="color-@part.PartId"
                            name="color"
                            value="@part.Configuration.Color"
                            disabled="@(part.Geometry.BodyCount > 1)"
                            @onchange="args => ChangeColorAsync(part.PartId, args)">
                        @foreach (var color in GetPartColors(part))
                        {
                            <option value="@color">@Localizer[color]</option>
                        }
                    </select>
                    @if (part.Geometry.BodyCount <= 1 && part.Configuration.MaterialKey == "PLA")
                    {
                        <input type="color" aria-label="@Localizer["Color"]"
                               value="@(part.Configuration.Color.StartsWith('#') ? part.Configuration.Color : "#000000")"
                               @onchange="args => ChangeColorAsync(part.PartId, args)" />
                    }
                    <div class="instant-quote__quantity-heading">
                        <label for="quantity-@part.PartId">@Localizer["Quantity"]</label>
                        @if (InstantQuotationBulkSavings.Calculate(part, HasUnacceptedConfiguration(part)) is { } savings)
                        {
                            <span data-workflow-bulk-savings>@Localizer["Saved"] @Money(savings)</span>
                        }
                    </div>
                    <input id="quantity-@part.PartId"
                           name="quantity"
                           type="number"
                           min="1"
                           max="@PricingCatalog.MaximumAdditiveQuantity"
                           aria-describedby="quantity-hint-@part.PartId"
                           @bind:get="QuantityInputValue(part)"
                           @bind:set="raw => OnQuantityInput(part.PartId, new ChangeEventArgs { Value = raw })"
                           @bind:event="oninput"
                           @onchange="args => ChangeQuantityAsync(part.PartId, args)"
                           @onblur="() => OnQuantityBlurAsync(part.PartId)" />
                    <small id="quantity-hint-@part.PartId">@Localizer["Maximum {0} pieces", PricingCatalog.MaximumAdditiveQuantity.ToString("N0")]</small>
                    <fieldset data-workflow-build-preference disabled="@(PricingCatalog.ResolveMaterial(part.Configuration.MaterialKey)?.Process is PrintProcess.Resin)">
                        <legend>@Localizer["Build preference"]</legend>
                        @if (PricingCatalog.ResolveMaterial(part.Configuration.MaterialKey)?.Process is PrintProcess.Resin)
                        {
                            <p data-resin-build-preference>@Localizer["Standard resin"]</p>
                        }
                        <label>
                            <input type="radio"
                                   name="build-preference-@part.PartId"
                                   value="quality"
                                   checked="@(part.Configuration.BuildPreference is BuildPreference.Quality)"
                                   @onchange="() => ChangeBuildPreferenceAsync(part.PartId, BuildPreference.Quality)" />
                            <strong>@Localizer["Quality"]</strong>
                            <span>@Localizer["Finer detail and a smoother appearance · takes longer and costs more"]</span>
                        </label>
                        <label>
                            <input type="radio"
                                   name="build-preference-@part.PartId"
                                   value="standard"
                                   checked="@(part.Configuration.BuildPreference is BuildPreference.Standard)"
                                   @onchange="() => ChangeBuildPreferenceAsync(part.PartId, BuildPreference.Standard)" />
                            <strong>@Localizer["Standard"]</strong>
                            <span>@Localizer["Balanced finish, durability, lead time, and price for everyday use"]</span>
                        </label>
                        <label>
                            <input type="radio"
                                   name="build-preference-@part.PartId"
                                   value="strength"
                                   checked="@(part.Configuration.BuildPreference is BuildPreference.Strength)"
                                   @onchange="() => ChangeBuildPreferenceAsync(part.PartId, BuildPreference.Strength)" />
                            <strong>@Localizer["Strength"]</strong>
                            <span>@Localizer["Greater structural strength · material and load direction still require engineering review"]</span>
                        </label>
                    </fieldset>
                </fieldset>

                @if (!IsRepricing
                    && OrderQuote?.Parts.SingleOrDefault(line => line.PartId == part.PartId)?.PhysicalReceipt?.GeometryReconstruction is { } reconstruction
                    && reconstruction.IsValid())
                {
                    <InstantQuotationPhysicalResult IsReady="true" Failure="None" Reconstruction="@reconstruction" />
                }

                @if (workflow?.CurrentPhysicalAnalysisBinding(part.PartId,
                    Services.GetRequiredService<FdmRuntimeProfileCatalog>().ProfileVersion) is not null)
                {
                    <div data-workflow-physical-analysis data-part-id="@part.PartId">
                        <button type="button"
                                disabled="@(physicalAnalysisPartId == part.PartId)"
                                @onclick="() => AnalyzePhysicalAsync(part.PartId)">@Localizer["Check physical build details"]</button>
                        @if (physicalAnalysisPartId == part.PartId)
                        {
                            <p role="status">@Localizer["Checking physical build…"]</p>
                        }
                        else if (physicalAnalyses.TryGetValue(part.PartId, out var physical))
                        {
                            <InstantQuotationPhysicalResult IsReady="@physical.IsReady" Failure="@physical.Failure.ToString()" />
                        }
                    </div>
                }

                @if (DisplayRows(part) is { Count: > 0 } displayRows)
                {
                    <details data-workflow-material-comparison>
                        <summary>@Localizer["Compare material prices"]</summary>
                        <ul>
                            @foreach (var row in displayRows)
                            {
                                <li data-workflow-material-price="@row.MaterialKey">
                                    <span>@Localizer[MaterialDisplayName(row.MaterialKey)]</span>
                                    @if (row.Status is InstantQuotationMaterialPricingStatus.Completed)
                                    {
                                        <strong>@Money(row.UnitPrice) @Localizer["per piece"]</strong>
                                    }
                                    else
                                    {
                                        <strong role="status">@(row.Status is InstantQuotationMaterialPricingStatus.Pending
                                            ? Localizer["Calculating price…"]
                                            : Localizer["Price unavailable — engineering review required."])</strong>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                else if (displayQuote is not null && !IsRepricing)
                {
                    <details data-workflow-material-comparison>
                        <summary>@Localizer["Compare material prices"]</summary>
                        <ul>
                            @foreach (var materialPrice in displayQuote.MaterialPrices)
                            {
                                <li data-workflow-material-price="@materialPrice.MaterialKey">
                                    <span>@Localizer[MaterialDisplayName(materialPrice.MaterialKey)]</span>
                                    <strong>@(materialPrice.UnitPrice is { } availablePrice
                                        ? $"{Money(availablePrice)} {Localizer["per piece"]}"
                                        : Localizer["Price unavailable — engineering review required."].Value)</strong>
                                </li>
                            }
                        </ul>
                    </details>
                }

                <dl data-workflow-part-price data-workflow-part-pricing>
                    @if (part.Quote is null && !HasUnacceptedConfiguration(part))
                    {
                        <div role="status" data-workflow-price-unavailable>
                            <dt>@Localizer["Price"]</dt>
                            <dd>@Localizer["Price unavailable — engineering review required."]</dd>
                        </div>
                    }
                    @if (InstantQuotationSelectedPrintTime.IsVisible(displayQuote?.PrintTimeMinutesPerUnit, IsRepricing))
                    {
                        <div data-workflow-selected-print-time data-part-id="@part.PartId">
                            <dt>@Localizer["Estimated print time per part"]</dt>
                            <dd>@FormatPrintDuration(displayQuote!.PrintTimeMinutesPerUnit)</dd>
                        </div>
                    }
                    <div>
                        <dt>@Localizer["Unit price"]</dt>
                        <dd>@Money(displayQuote?.UnitPrice)</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Subtotal"]</dt>
                        <dd>@Money(displayQuote?.Subtotal)</dd>
                    </div>
                    @if (displayQuote is { TechnicalFilamentMinimumApplied: true } technicalQuote)
                    {
                        <div data-technical-filament-minimum>
                            <dt>@Localizer["Technical filament preparation minimum included"]</dt>
                            <dd>+@Money(technicalQuote.TechnicalFilamentMinimumAdjustment)</dd>
                        </div>
                    }
                    @if (displayQuote is not null)
                    {
                        <div class="instant-quote__bulk-pricing" data-workflow-bulk-pricing tabindex="0" role="region" aria-label="@Localizer["Bulk pricing table"]">
                            @foreach (var tier in displayQuote.Tiers)
                            {
                                <div data-workflow-price-tier aria-current="@(tier.Active ? "true" : null)">
                                    <dt>@Localizer["Quantity"] @tier.MinQuantity.ToString("N0")</dt>
                                    <dd>@Money(tier.UnitPrice)</dd>
                                </div>
                            }
                        </div>
                    }
                </dl>
            }

            </div>
            <div class="instant-quote__configuration-footer">
                <details class="instant-quote__summary-dock" data-workflow-summary-dock>
                    <summary>
                        <span class="instant-quote__summary-dock-heading">
                            @if (HasConfigurationWarnings)
                            {
                                <span class="instant-quote__summary-warning" data-summary-warning role="img" aria-label="@Localizer["Manufacturing warning"]"><span aria-hidden="true">!</span></span>
                            }
                            <span class="instant-quote__summary-dock-title">@Localizer["Part and price summary"]</span>
                            @if (IsRepricing)
                            {
                                <span class="instant-quote__pricing-status" data-pricing-loading-status role="status">
                                    <span class="instant-quote__pricing-spinner" aria-hidden="true"></span>
                                    @Localizer["Updating price and lead time…"]
                                </span>
                            }
                        </span>
                        <span class="instant-quote__summary-dock-meta">
                            <span>@Localizer["Parts"] <strong>@Parts.Count</strong></span>
                            <span data-workflow-lead-time aria-live="polite" aria-atomic="true">@Localizer["Lead time"] <strong>@LeadTime</strong></span>
                        </span>
                        <strong aria-live="polite" aria-atomic="true">@Money(OrderQuote?.FinalOrderPrice)</strong>
                        <span class="instant-quote__summary-dock-disclosure">
                            <span data-summary-show>@Localizer["Show details"]</span>
                            <span data-summary-hide>@Localizer["Hide details"]</span>
                            <span class="instant-quote__summary-dock-caret" aria-hidden="true">⌄</span>
                        </span>
                    </summary>
                    <dl data-workflow-order-summary data-workflow-order-total aria-busy="@IsRepricing.ToString().ToLowerInvariant()" tabindex="0" aria-label="@Localizer["Part and price summary"]">
                        @foreach (var part in ConfigurationParts)
                        {
                            <div data-summary-part-details><dt>@Localizer["Part details"]</dt><dd>@part.DisplayFileName</dd></div>
                            <div><dt>@Localizer["Dimensions"]</dt><dd>@Measurement(part.Geometry.DimensionXmm) × @Measurement(part.Geometry.DimensionYmm) × @Measurement(part.Geometry.DimensionZmm) mm</dd></div>
                            <div><dt>@Localizer["Volume"]</dt><dd>@Measurement(part.Geometry.VolumeMm3 / 1_000) cm³</dd></div>
                            <div><dt>@Localizer["Surface area"]</dt><dd>@Measurement(part.Geometry.SurfaceAreaMm2 / 100) cm²</dd></div>
                            <div><dt>@Localizer["Min. thickness"]</dt><dd>@Measurement(part.Geometry.MinThicknessMm) mm</dd></div>
                        }
                        <div><dt>@Localizer["Subtotal"]</dt><dd>@Money(OrderQuote?.ItemsSubtotal)</dd></div>
                        @if (OrderQuote is { MinimumOrderSurcharge: > 0 } orderQuote)
                        {
                            <div data-workflow-minimum-order-surcharge>
                                <dt>@Localizer["Minimum order surcharge"] (@Localizer["minimum"] @Money(orderQuote.MinimumOrderPrice))</dt>
                                <dd>@Money(orderQuote.MinimumOrderSurcharge)</dd>
                            </div>
                        }
                        <div><dt>@Localizer["Shipping"]</dt><dd>@Money(OrderQuote?.ShippingCost)</dd></div>
                        <div><dt>@Localizer["VAT"]</dt><dd>@Money(OrderQuote?.Vat)</dd></div>
                        <div><dt>@Localizer["Total"]</dt><dd>@Money(OrderQuote?.FinalOrderPrice)</dd></div>
                    </dl>
                </details>
                <div class="instant-quote__summary-legal" data-summary-legal>
                    <a href="/legal/privacypolicy">@Localizer["Privacy Policy"]</a>
                    <span aria-hidden="true">·</span>
                    <a href="/legal/nondisclosureagreement">@Localizer["Non-Disclosure Agreement"]</a>
                </div>

                <div class="instant-quote__configuration-actions">
                    <button type="button" @onclick="EnterReview" disabled="@(!CanEnterReview)">@Localizer["Review all items"]</button>
                    <a class="instant-quote__consultation-link" data-summary-consultation href="/contact#contact-us" target="_blank" rel="noopener noreferrer">@Localizer["Talk to an engineer"]<span class="instant-quote__sr-only"> @Localizer["(opens in a new tab)"]</span></a>
                </div>
            </div>
        </section>
    }

    @if (VisibleSections.Review)
    {
        <div data-workflow-review
             @ref="reviewSection"
             tabindex="-1"
             aria-labelledby="instant-quote-review-heading">
            <InstantQuotationReview Parts="@Parts"
                                    Quote="@OrderQuote"
                                    IsRepricing="@IsRepricing"
                                    Materials="@Materials"
                                    ColorsForMaterial="GetColors"
                                    ThicknessWarnings="GetReviewThicknessWarnings"
                                    SelectedPartId="@selectedPreviewPartId"
                                    OnSelectPart="SelectReviewPartAsync"
                                    OnEditPart="EditReviewPartAsync"
                                    OnMaterialChanged="ChangeReviewMaterialAsync"
                                    OnColorChanged="ChangeReviewColorAsync"
                                    OnQuantityChanged="ChangeReviewQuantityAsync"
                                    OnBuildPreferenceChanged="ChangeReviewBuildPreferenceAsync"
                                    OnBack="ReturnToConfiguration"
                                    OnContinue="EnterCustomerDetails" />
        </div>
    }

    @if (VisibleSections.CustomerDetails)
    {
        <InstantQuotationCustomerOrderOverview Parts="@Parts" Quote="@OrderQuote" Materials="@Materials" />
        <div data-workflow-customer-details
             @ref="customerDetailsSection"
             tabindex="-1"
             aria-labelledby="instant-quote-customer-heading">
            <InstantQuotationCustomerForm Model="@CustomerModel" Quote="@OrderQuote" OnBack="ReturnToReview"
                                          HasFiles="@(workflow?.Uploads.Count > 0)"
                                          FileUploadCompleted="@(workflow is not null && workflow.Uploads.Count > 0
                                              && workflow.Uploads.All(upload => upload.Status is InstantQuotationWorkflowUploadStatus.Uploaded)
                                              && Parts.Count == workflow.Uploads.Count)" />
        </div>
    }

    @if (VisibleSections.Submitted)
    {
        <section data-workflow-submitted aria-labelledby="instant-quote-submitted-heading">
            <span class="instant-quote__submission-icon @(CustomerModel.SubmissionStatus is InstantQuotationCustomerDisplayModel.CompletedStatus ? null : "instant-quote__submission-icon--warning")" aria-hidden="true">
                @(CustomerModel.SubmissionStatus is InstantQuotationCustomerDisplayModel.CompletedStatus ? "✓" : "!")
            </span>
            <h3 id="instant-quote-submitted-heading">@SubmittedHeading</h3>
            @if (CustomerModel.SubmissionStatus is InstantQuotationCustomerDisplayModel.PartialStatus)
            {
                <p role="status">@Localizer["Your request was saved. File processing is pending. Do not resubmit."]</p>
                <p><a href="/contact#contact-us" data-contact-email="info@maliev.com">info@maliev.com</a></p>
            }
            else if (CustomerModel.SubmissionStatus is InstantQuotationCustomerDisplayModel.RejectedStatus)
            {
                @if (CustomerModel.ProblemCategory is "validation")
                {
                    <p role="alert">@Localizer["Your request could not be submitted. Please review the form and try again."]</p>
                    <p><a href="/InstantQuotation/3D-Printing">@Localizer["Return to your quotation"]</a></p>
                }
                else
                {
                    <p role="alert">@Localizer["We could not confirm whether your request was received. Do not submit it again; contact MALIEV support."]</p>
                    <p><a href="/contact#contact-us" data-contact-email="info@maliev.com">info@maliev.com</a></p>
                }
            }
            else
            {
                <p role="status">@Localizer["We will get back to you with a quotation"]</p>
            }
            @if (CustomerModel.RequestReference is not null)
            {
                <p>@Localizer["Request reference"]: <strong>@CustomerModel.RequestReference</strong></p>
            }
        </section>
    }
</section>
