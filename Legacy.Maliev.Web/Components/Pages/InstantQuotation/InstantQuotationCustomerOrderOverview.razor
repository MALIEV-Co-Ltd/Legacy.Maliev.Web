@using Legacy.Maliev.Web.Application
@inject IStringLocalizer<ThreeDimensionalPrintingEstimateContent> Localizer

<aside class="instant-quote__customer-order" data-workflow-customer-order aria-labelledby="instant-quote-customer-order-heading">
    <header>
        <h2 id="instant-quote-customer-order-heading">@Localizer["Parts"]</h2>
    </header>
    <div class="instant-quote__customer-order-scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">@Localizer["Part"]</th>
                    <th scope="col">@Localizer["Quantity"]</th>
                    <th scope="col">@Localizer["Subtotal"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in Parts)
                {
                    var quotedPart = Quote?.Parts.SingleOrDefault(item => item.PartId == part.PartId);
                    <tr data-workflow-customer-order-part>
                        <td>
                            <span class="instant-quote__customer-order-part">
                                <img data-review-thumbnail
                                     data-part-id="@InstantQuotationWorkflow.ViewerPartKey(part.PartId)"
                                     src="/src/images/3d-canvas-placeholder.svg"
                                     alt="" />
                                <span class="instant-quote__customer-order-identity">
                                    <strong>@part.DisplayFileName</strong>
                                    <small>@MaterialName(part.Configuration.MaterialKey)</small>
                                </span>
                            </span>
                        </td>
                        <td>@part.Configuration.Quantity</td>
                        <td>@Money(quotedPart?.Subtotal)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <section class="instant-quote__pricing-summary" aria-labelledby="instant-quote-customer-summary-heading">
        <h3 id="instant-quote-customer-summary-heading">@Localizer["Order summary"]</h3>
        <dl>
            <div><dt>@Localizer["Subtotal"]</dt><dd>@Money(Quote?.ItemsSubtotal)</dd></div>
            @if (Quote is { MinimumOrderSurcharge: > 0 } orderQuote)
            {
                <div data-workflow-minimum-order-surcharge>
                    <dt>@Localizer["Minimum order surcharge"] (@Localizer["minimum"] @Money(orderQuote.MinimumOrderPrice))</dt>
                    <dd>@Money(orderQuote.MinimumOrderSurcharge)</dd>
                </div>
            }
            <div><dt>@Localizer["Shipping"]</dt><dd>@Money(Quote?.ShippingCost)</dd></div>
            <div><dt>@Localizer["VAT"]</dt><dd>@Money(Quote?.Vat)</dd></div>
            <div><dt>@Localizer["Total"]</dt><dd>@Money(Quote?.FinalOrderPrice)</dd></div>
            <div><dt>@Localizer["Lead time"]</dt><dd>@LeadTime</dd></div>
        </dl>
    </section>
</aside>

@code {
    [Parameter]
    public IReadOnlyList<InstantQuotationWorkflowPartViewModel> Parts { get; set; } = [];

    [Parameter]
    public InstantQuotationOrderQuote? Quote { get; set; }

    [Parameter]
    public IReadOnlyList<InstantQuotationWorkflowMaterialOption> Materials { get; set; } = [];

    private string MaterialName(string key) => Materials
        .SingleOrDefault(item => string.Equals(item.Key, key, StringComparison.Ordinal))?.DisplayName ?? key;

    private string LeadTime => Quote is null
        ? "—"
        : Localizer["{0}–{1} business days", Quote.LeadTimeMinimumDays, Quote.LeadTimeMaximumDays];

    private static string Money(double? amount) => amount is null ? "—" : $"฿{amount.Value:N2}";
}
