@using Legacy.Maliev.Web.Application
@inject IStringLocalizer<ThreeDimensionalPrintingEstimateContent> Localizer

<p role="status" data-physical-analysis-result="@(IsReady ? "ready" : "unavailable")"
   data-physical-analysis-failure="@Failure">@Localizer[Message]</p>

@if (IsReady && Reconstruction is { } reconstruction && reconstruction.IsValid())
{
    <div class="alert alert-warning" data-geometry-reconstruction role="status">
        <strong>@Localizer["Voxel-based estimate ({0} mm) — engineering review required",
            reconstruction.VoxelSizeMm.ToString("0.0", System.Globalization.CultureInfo.CurrentCulture)]</strong>
        <p>@Localizer["Pricing uses reconstructed geometry. Small features may change; the original file must be reviewed before manufacture."]</p>
    </div>
}

@code {
    [Parameter] public Legacy.Maliev.Web.Application.Pricing.Simulation.VoxelReconstructionInfo? Reconstruction { get; set; }

    [Parameter] public bool IsReady { get; set; }
    [Parameter] public string Failure { get; set; } = string.Empty;

    private string Message => IsReady
        ? "Physical build evidence is ready. Verified analysis is used for the current price."
        : Failure switch
        {
            nameof(InstantQuotationBoundPhysicalAnalysisFailure.GeometryReview) =>
                "This mesh has open or non-manifold surfaces. Contact our engineers for a file review.",
            nameof(InstantQuotationBoundPhysicalAnalysisFailure.ComplexityExceeded) =>
                "This file exceeds the analysis limits. Simplify the mesh or contact our engineers for a quotation.",
            nameof(InstantQuotationBoundPhysicalAnalysisFailure.SimulationUnavailable) =>
                "Print simulation is unavailable for this file. Contact our engineers for a quotation.",
            _ => "Physical build analysis is unavailable. Engineering review is required.",
        };
}
