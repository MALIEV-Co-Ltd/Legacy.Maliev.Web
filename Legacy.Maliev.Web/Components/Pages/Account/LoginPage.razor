@page "/Account/Login"
@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject ITempDataDictionaryFactory TempDataDictionaryFactory
@inject IStringLocalizer<LoginContent> Localizer
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

@{
    var isThai = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    var title = isThai ? "เข้าสู่ระบบ | MALIEV" : "Login | MALIEV";
    var description = isThai
        ? "เข้าสู่ระบบ MALIEV เพื่อดูใบเสนอราคา คำสั่งซื้อ ไฟล์งาน และข้อมูลบัญชีในพื้นที่ทำงานออนไลน์"
        : "Sign in to MALIEV to review quotations, orders, project files, and account details in your secure workspace.";
    var keywords = isThai ? "member, เข้าสู่ระบบ" : "member area, login";
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <meta name="robots" content="noindex, follow" />
</HeadContent>
<main class="auth-page" data-migration-route-owner="blazor-static-ssr">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="login-intro-title">
            <p class="maliev-eyebrow">MALIEV WORKSPACE</p>
            <h1 id="login-intro-title">@Localizer["Manage your manufacturing projects"]</h1>
            <p>@Localizer["Sign in to review quotations, orders, files, and account details in one secure place."]</p>
        </section>
        <section class="auth-card" aria-labelledby="login-title">
            <header class="auth-card__header">
                <p class="maliev-eyebrow">@Localizer["Member account"]</p>
                <h2 id="login-title">@Localizer["Sign in"]</h2>
            </header>
            @if (!string.IsNullOrWhiteSpace(model.Notification))
            {
                <div class="maliev-alert mb-3" role="status">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <span>@model.Notification</span>
                </div>
            }
            @if (localReviewCredentials is not null)
            {
                <aside class="maliev-alert" data-local-aspire-login role="note">
                    <strong>Local Aspire review</strong>
                    <span>Email: <code>@localReviewCredentials.Email</code></span>
                    <span>Password: <code>@localReviewCredentials.Password</code></span>
                </aside>
            }
            <form method="post" class="maliev-form" id="customer-login">
                @if (tokens is not null)
                {
                    <input type="hidden" name="@tokens.FormFieldName" value="@tokens.RequestToken" />
                }
                <LoginContent Model="model" />
            </form>
            <footer class="auth-card__footer">
                <div class="maliev-actions">
                    <a href="/Account/Signup" class="maliev-button maliev-button--secondary">@Localizer["Create your account"]</a>
                    <a href="/Account/ForgotPassword">@Localizer["Forgot your password?"]</a>
                </div>
            </footer>
        </section>
    </div>
</main>

@code {
    private LoginFormDisplayModel model = new(string.Empty, false, null, null, new Dictionary<string, IReadOnlyList<string>>());
    private AntiforgeryTokenSet? tokens;
    private LocalReviewCredentials? localReviewCredentials;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnParametersSet()
    {
        var context = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
        if (context.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/Account");
            return;
        }

        var tempData = TempDataDictionaryFactory.GetTempData(context);
        var notification = tempData.TryGetValue("Notification", out var value) ? value?.ToString() : null;
        model = new LoginFormDisplayModel(
            Email?.Trim() ?? string.Empty,
            false,
            IsLocalUrl(ReturnUrl) ? ReturnUrl : null,
            notification,
            new Dictionary<string, IReadOnlyList<string>>());
        localReviewCredentials = GetLocalReviewCredentials();
        tokens = Antiforgery.GetAndStoreTokens(context);
    }

    private static bool IsLocalUrl(string? url) =>
        !string.IsNullOrEmpty(url)
        && ((url[0] == '/' && (url.Length == 1 || (url[1] != '/' && url[1] != '\\')))
            || (url.Length > 1 && url[0] == '~' && url[1] == '/'));

    private LocalReviewCredentials? GetLocalReviewCredentials()
    {
        var permittedEnvironment = Environment.IsDevelopment() || Environment.IsEnvironment("Testing");
        if (!permittedEnvironment || !Configuration.GetValue<bool>("LocalAspireLoginReview:Enabled"))
        {
            return null;
        }

        var email = Configuration["LocalAspireLoginReview:Email"];
        var password = Configuration["LocalAspireLoginReview:Password"];
        return string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password)
            ? null
            : new LocalReviewCredentials(email, password);
    }

    private sealed record LocalReviewCredentials(string Email, string Password);
}
