@page "/Account/SetInitialPassword"
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting("account")]
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject IStringLocalizer<SetInitialPasswordContent> Localizer
@inject NavigationManager Navigation

<PageTitle>@Localizer["Set your password | MALIEV"]</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<main class="auth-page" data-migration-route-owner="blazor-static-ssr">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="initial-password-intro-title">
            <p class="maliev-eyebrow">@Localizer["Account security"]</p>
            <h1 id="initial-password-intro-title">@Localizer["Make this account yours"]</h1>
            <p>@Localizer["Replace the temporary password before entering your workspace."]</p>
        </section>
        <section class="auth-card" aria-labelledby="initial-password-title">
            <header class="auth-card__header"><h2 id="initial-password-title">@Localizer["Set your new password"]</h2></header>
            <form method="post" class="maliev-form" id="set-initial-password" data-single-submit>
                @if (tokens is not null)
                {
                    <input type="hidden" name="@tokens.FormFieldName" value="@tokens.RequestToken" />
                }
                <SetInitialPasswordContent Model="model" />
            </form>
        </section>
    </div>
</main>

@code {
    private SetInitialPasswordFormDisplayModel model = new(string.Empty, string.Empty, null, false, new Dictionary<string, IReadOnlyList<string>>());
    private AntiforgeryTokenSet? tokens;

    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "rememberMe")] public string? RememberMe { get; set; }

    protected override void OnParametersSet()
    {
        var context = HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
        context.Response.Headers.CacheControl = "no-store";
        context.Response.Headers["Referrer-Policy"] = "no-referrer";
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        model = new(Email.Trim(), Token, Microsoft.AspNetCore.Http.HttpResults.RedirectHttpResult.IsLocalUrl(ReturnUrl) ? ReturnUrl : null, bool.TryParse(RememberMe, out var remember) && remember, new Dictionary<string, IReadOnlyList<string>>());
        tokens = Antiforgery.GetAndStoreTokens(context);
    }
}
