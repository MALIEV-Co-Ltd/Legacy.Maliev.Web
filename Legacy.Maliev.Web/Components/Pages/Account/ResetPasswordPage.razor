@page "/Account/ResetPassword"
@using Microsoft.AspNetCore.Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject IStringLocalizer<ResetPasswordContent> Localizer

@if (isValidChallenge)
{
    var isThai = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th";
    var description = isThai
        ? "ตั้งรหัสผ่านใหม่สำหรับบัญชี MALIEV ของคุณเพื่อกลับเข้าใช้งานพื้นที่ทำงานออนไลน์"
        : "Set a new password for your MALIEV account and return to your secure workspace.";
    <PageTitle>@(isThai ? "ตั้งรหัสผ่านใหม่ | MALIEV" : "Password Reset | MALIEV")</PageTitle>
    <HeadContent>
        <meta name="description" content="@description" />
        <meta name="robots" content="noindex, nofollow" />
    </HeadContent>
    <main class="auth-page" data-migration-route-owner="blazor-static-ssr">
        <div class="maliev-container auth-shell">
            <section class="auth-intro" aria-labelledby="reset-intro-title">
                <h1 id="reset-intro-title">@Localizer["Create a new password"]</h1>
                <p>@Localizer["Choose a strong password that you do not use for another account."]</p>
            </section>
            <section class="auth-card" aria-labelledby="reset-title">
                <header class="auth-card__header">
                    <h2 id="reset-title">@Localizer["Reset password"]</h2>
                </header>
                <form method="post" class="maliev-form">
                    @if (tokens is not null)
                    {
                        <input type="hidden" name="@tokens.FormFieldName" value="@tokens.RequestToken" />
                    }
                    <ResetPasswordContent Model="model" />
                </form>
                <footer class="auth-card__footer"><a class="auth-card__footer-link" href="/Account/Login">@Localizer["Back to sign in"]</a></footer>
            </section>
        </div>
    </main>
}

@code {
    private ResetPasswordFormDisplayModel model = new(
        string.Empty,
        string.Empty,
        new Dictionary<string, IReadOnlyList<string>>());
    private AntiforgeryTokenSet? tokens;
    private bool isValidChallenge;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnParametersSet()
    {
        var context = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
        context.Response.Headers.CacheControl = "no-store";
        context.Response.Headers["Referrer-Policy"] = "no-referrer";
        isValidChallenge = !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);
        if (!isValidChallenge)
        {
            context.Response.StatusCode = StatusCodes.Status400BadRequest;
            return;
        }

        model = new ResetPasswordFormDisplayModel(
            Email!,
            Token!,
            new Dictionary<string, IReadOnlyList<string>>());
        tokens = Antiforgery.GetAndStoreTokens(context);
    }
}
