@using Microsoft.AspNetCore.Components
@using System.Globalization
@inject IStringLocalizer<LoginContent> Localizer

<div class="validation-summary-errors @(Model.ErrorsFor(string.Empty).Count > 0 ? string.Empty : "validation-summary-valid")"
     data-migration-component="login-content"
     data-migration-renderer="blazor-static-ssr"
     role="alert">
    <ul>
        @if (Model.ErrorsFor(string.Empty).Count == 0)
        {
            <li style="display:none"></li>
        }
        else
        {
            @foreach (var error in Model.ErrorsFor(string.Empty))
            {
                <li>@error</li>
            }
        }
    </ul>
</div>

@if (!string.IsNullOrWhiteSpace(Model.EmailConfirmationRecoveryToken))
{
    <input type="hidden" name="EmailConfirmationRecoveryToken" value="@Model.EmailConfirmationRecoveryToken" />
    <div class="maliev-alert mb-3" role="alert">
        <i class="fas fa-envelope" aria-hidden="true"></i>
        <div>
            <strong>@Localizer["Email verification required"]</strong>
            <p>@Localizer["Please verify your email before signing in."]</p>
            <button type="submit" class="maliev-button maliev-button--secondary" formaction="@ResendAction">
                @Localizer["Resend verification email"]
            </button>
        </div>
    </div>
}

<input type="hidden" id="ReturnUrl" name="ReturnUrl" value="@Model.ReturnUrl" />
<div class="maliev-form-field">
    <label for="Email">@Localizer["Email"]</label>
    <input class="form-control" autocomplete="email" type="email" id="Email" maxlength="320" name="Email" value="@Model.Email" required aria-invalid="@AriaInvalid("Email")" aria-describedby="Email-error" />
    <span id="Email-error" class="maliev-form-error @(HasError("Email") ? "field-validation-error" : "field-validation-valid")">@Model.FirstErrorFor("Email")</span>
</div>
<div class="maliev-form-field">
    <label for="Password">@Localizer["Password"]</label>
    <input class="form-control" autocomplete="current-password" type="password" id="Password" maxlength="1024" name="Password" required aria-invalid="@AriaInvalid("Password")" aria-describedby="Password-error" />
    <span id="Password-error" class="maliev-form-error @(HasError("Password") ? "field-validation-error" : "field-validation-valid")">@Model.FirstErrorFor("Password")</span>
</div>
<div class="auth-check">
    <input type="checkbox" id="RememberMe" name="RememberMe" value="true" class="auth-check__input" checked="@Model.RememberMe" />
    <input type="hidden" name="RememberMe" value="false" />
    <label for="RememberMe" class="auth-check__label">@Localizer["Remember me"]</label>
</div>
<button type="submit" class="maliev-button" formaction="@FormAction"><span data-submit-label>@Localizer["Sign in"]</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></button>

@code {
    [Parameter, EditorRequired]
    public LoginFormDisplayModel Model { get; set; } = null!;

    private bool HasError(string fieldName) => Model.ErrorsFor(fieldName).Count > 0;

    private string? AriaInvalid(string fieldName) => HasError(fieldName) ? "true" : null;

    private static string FormAction =>
        $"/Account/Login?handler=Login&culture={Uri.EscapeDataString(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)}";

    private static string ResendAction =>
        $"/Account/Login?handler=ResendEmailConfirmation&culture={Uri.EscapeDataString(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)}";
}
