@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SetInitialPasswordContent> Localizer

<div class="validation-summary-errors @(Model.ErrorsFor(string.Empty).Count > 0 ? string.Empty : "validation-summary-valid")" role="alert">
    <ul>
        @foreach (var error in Model.ErrorsFor(string.Empty))
        {
            <li>@error</li>
        }
    </ul>
</div>
<input type="hidden" name="Email" value="@Model.Email" />
<input type="hidden" name="Token" value="@Model.Token" />
<input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
<input type="hidden" name="RememberMe" value="@Model.RememberMe.ToString().ToLowerInvariant()" />
<div class="maliev-form-field">
    <label for="Password">@Localizer["New password"]</label>
    <input class="form-control" autocomplete="new-password" type="password" id="Password" name="Password" minlength="8" maxlength="1024" required aria-invalid="@AriaInvalid("Password")" aria-describedby="Password-error" />
    <span id="Password-error" class="maliev-form-error @(HasError("Password") ? "field-validation-error" : "field-validation-valid")">@Model.FirstErrorFor("Password")</span>
</div>
<div class="maliev-form-field">
    <label for="ConfirmPassword">@Localizer["Confirm password"]</label>
    <input class="form-control" autocomplete="new-password" type="password" id="ConfirmPassword" name="ConfirmPassword" maxlength="1024" required aria-invalid="@AriaInvalid("ConfirmPassword")" aria-describedby="ConfirmPassword-error" />
    <span id="ConfirmPassword-error" class="maliev-form-error @(HasError("ConfirmPassword") ? "field-validation-error" : "field-validation-valid")">@Model.FirstErrorFor("ConfirmPassword")</span>
</div>
<button type="submit" class="maliev-button" formaction="/Account/SetInitialPassword?handler=Complete">
    @Localizer["Set password and continue"]
</button>

@code {
    [Parameter, EditorRequired]
    public SetInitialPasswordFormDisplayModel Model { get; set; } = null!;

    private bool HasError(string fieldName) => Model.ErrorsFor(fieldName).Count > 0;
    private string? AriaInvalid(string fieldName) => HasError(fieldName) ? "true" : null;
}
