@page "/Account/ForgotPassword"
@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject ITempDataDictionaryFactory TempDataDictionaryFactory
@inject IStringLocalizer<ForgotPasswordContent> Localizer

@{
    var isThai = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    var title = isThai ? "กู้คืนรหัสผ่าน | MALIEV" : "Forgot Password | MALIEV";
    var description = isThai
        ? "กู้คืนรหัสผ่านบัญชี MALIEV ด้วยลิงก์ที่ปลอดภัยเพื่อกลับไปจัดการใบเสนอราคาและโปรเจ็คผลิตของคุณ"
        : "Recover your MALIEV account with a secure reset link and return to manage quotations and manufacturing projects.";
    var keywords = isThai ? "กู้คืนรหัสผ่าน, บัญชี MALIEV" : "MALIEV password reset, account recovery";
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>
<main class="auth-page" data-migration-route-owner="blazor-static-ssr">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="forgot-intro-title">
            <h1 id="forgot-intro-title">@Localizer["Return to your workspace"]</h1>
            <p>@Localizer["Enter your confirmed email address and we will send you a secure password reset link."]</p>
        </section>
        <section class="auth-card" aria-labelledby="forgot-title">
            <header class="auth-card__header">
                <h2 id="forgot-title">@Localizer["Forgot password"]</h2>
            </header>
            <form method="post" class="maliev-form">
                @if (tokens is not null)
                {
                    <input type="hidden" name="@tokens.FormFieldName" value="@tokens.RequestToken" />
                }
                <ForgotPasswordContent Model="model" />
            </form>
            <footer class="auth-card__footer"><a class="auth-card__footer-link" href="/Account/Login">@Localizer["Back to sign in"]</a></footer>
        </section>
    </div>
</main>

@code {
    private ForgotPasswordFormDisplayModel model = new(
        string.Empty,
        null,
        new Dictionary<string, IReadOnlyList<string>>());
    private AntiforgeryTokenSet? tokens;

    protected override void OnInitialized()
    {
        var context = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
        var tempData = TempDataDictionaryFactory.GetTempData(context);
        var notification = tempData.TryGetValue("Notification", out var value) ? value?.ToString() : null;
        model = new ForgotPasswordFormDisplayModel(
            string.Empty,
            notification,
            new Dictionary<string, IReadOnlyList<string>>());
        tokens = Antiforgery.GetAndStoreTokens(context);
    }
}
