@page "/About"
@using System.Globalization
@using Legacy.Maliev.Web.Components.Layout
@inject IHttpContextAccessor HttpContextAccessor

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var isThai = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    var title = isThai
        ? "เกี่ยวกับ MALIEV | พัฒนาต้นแบบและวิศวกรรมย้อนกลับ"
        : "About MALIEV | Prototype Development & Reverse Engineering";
    var description = isThai
        ? "รู้จัก MALIEV ผู้พัฒนาชิ้นงานต้นแบบและวิศวกรรมย้อนกลับในนนทบุรี จากแนวคิดและชิ้นงานเดิม สู่แบบ CAD ชิ้นส่วนทดแทน และการต่อยอดผลิตภัณฑ์"
        : "Meet MALIEV: prototype development and reverse engineering in Nonthaburi, Thailand. From ideas and existing parts to CAD, replacement parts and product development.";
    var keywords = isThai
        ? "บริษัท มาลีฟ จำกัด, พัฒนาต้นแบบ, วิศวกรรมย้อนกลับ, ออกแบบ 3 มิติ, CNC, พิมพ์ 3 มิติ, สแกน 3 มิติ"
        : "MALIEV company profile, prototype development, reverse engineering, CNC machining, 3D design, 3D printing, 3D scanning";
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <link rel="preload" as="image" href="/src/images/landing/about-customer-partnership.webp" fetchpriority="high" />
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
</HeadContent>
<AboutContent RouteOwner="blazor-static-ssr" />
