@using System.Globalization
@inject IStringLocalizer<AboutContent> Localizer

<main class="landing-main profile-about" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner">
    <section class="landing-hero profile-about-hero profile-partnership-hero" aria-labelledby="profile-about-title">
        <div class="landing-container landing-hero-grid">
            <div class="landing-hero-copy">
                <h1 id="profile-about-title">@T("From concept to a working part.", "จากไอเดีย สู่ชิ้นงานจริง")</h1>
                <p class="landing-hero-lead">@T("MALIEV specializes in prototype development and reverse engineering. We create new parts from ideas and reconstruct designs from existing parts to make replacements, improve function and develop products further.", "MALIEV เชี่ยวชาญด้านการพัฒนาชิ้นงานต้นแบบและวิศวกรรมย้อนกลับ เราช่วยสร้างชิ้นงานใหม่จากแนวคิด และสร้างแบบจากชิ้นงานเดิม เพื่อผลิตชิ้นส่วนทดแทน ปรับปรุงการใช้งาน และต่อยอดผลิตภัณฑ์")</p>
                <div class="landing-actions"><a class="landing-button landing-button-primary" href="@Link("/Contact")">@T("Discuss your project", "ปรึกษาโปรเจกต์ของคุณ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
            </div>
            <figure class="profile-partnership-photo">
                <img src="/src/images/landing/about-customer-partnership.webp" width="1440" height="960" loading="eager" fetchpriority="high" decoding="async" alt="@T("Illustrative scenario of a Thai customer and MALIEV engineer reviewing a working camera-mount application together", "ภาพประกอบสถานการณ์ลูกค้าชาวไทยและวิศวกร MALIEV ร่วมกันทบทวนการใช้งานขายึดกล้องตรวจสอบชิ้นงาน")" />
            </figure>
        </div>
    </section>
    <section class="landing-value-wrap profile-company-facts" aria-label="@T("Company at a glance", "ข้อมูลบริษัท")"><div class="landing-container landing-value-strip">
        <article><i class="far fa-building" aria-hidden="true"></i><div><h2>@T("Maliev Co., Ltd.", "บริษัท มาลีฟ จำกัด")</h2><p>@T("A family-owned manufacturing business.", "ธุรกิจครอบครัวด้านการพัฒนาและผลิตชิ้นงาน")</p></div></article>
        <article><i class="far fa-calendar-alt" aria-hidden="true"></i><div><h2>@T("Established in 2018", "ก่อตั้งในปี 2018")</h2><p>@T("Design and manufacturing, connected.", "เชื่อมการออกแบบเข้ากับการผลิต")</p></div></article>
        <article><i class="fas fa-map-marker-alt" aria-hidden="true"></i><div><h2>@T("Nonthaburi, Thailand", "นนทบุรี ประเทศไทย")</h2><p>@T("Based in Pak Kret.", "ดำเนินงานในอำเภอปากเกร็ด")</p></div></article>
    </div></section>

    <section class="landing-section profile-outcomes" aria-labelledby="profile-outcomes-title"><div class="landing-container">
        <header class="landing-section-heading"><h2 id="profile-outcomes-title">@T("One bracket. From idea to production line.", "ขายึดหนึ่งชิ้น จากไอเดียสู่สายการผลิต")</h2><span>@T("An illustrative camera-mount project for inspecting bottles: define the requirements, develop the bracket, test variations and prepare the final design for use.", "ตัวอย่างการพัฒนาขายึดกล้องสำหรับตรวจวัดขวด ตั้งแต่กำหนดโจทย์ ออกแบบขายึด ทดลองหลายแนวทาง จนถึงเตรียมแบบสุดท้ายสำหรับใช้งาน")</span></header>
        <div class="landing-service-grid profile-rapid-workflow-grid">
            <article class="landing-service-card"><img src="/src/images/landing/camera-bracket-sketch-v6.webp" width="1200" height="800" loading="lazy" decoding="async" alt="@T("Illustrative customer sketches of camera-bracket variations, bottle and handwritten requirements on an office table", "ภาพประกอบภาพร่างขายึดกล้องหลายแบบ ขวด และข้อกำหนดที่เขียนด้วยมือบนโต๊ะสำนักงาน")" /><div><h3>@T("01 · Idea & sketch", "01 · ไอเดียและภาพร่าง")</h3><p>@T("Sketch bracket alternatives around the bottle, camera position and conveyor clearance. Record the basic requirements before developing CAD.", "ร่างขายึดหลายแนวทาง โดยพิจารณาขวด ตำแหน่งกล้อง และระยะหลบสายพาน พร้อมจดข้อกำหนดเบื้องต้นก่อนพัฒนาแบบ CAD")</p><a href="@Link("/Contact")">@T("Discuss your idea", "ปรึกษาไอเดียของคุณ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></article>
            <article class="landing-service-card"><img src="/src/images/landing/camera-bracket-cad-v5.webp" width="1200" height="800" loading="lazy" decoding="async" alt="@T("Illustrative Thai MALIEV engineer viewing the customer drawing on the left 30 percent of a monitor and bracket CAD on the right 70 percent", "ภาพประกอบวิศวกร MALIEV ชาวไทยดูภาพร่างลูกค้าฝั่งซ้าย 30 เปอร์เซ็นต์ และแบบ CAD ขายึดฝั่งขวา 70 เปอร์เซ็นต์ของจอ")" /><div><h3>@T("02 · CAD design", "02 · ออกแบบ CAD")</h3><p>@T("Work from the customer sketch alongside the CAD model. Refine the mounting holes, upright supports and camera fit before making prototypes.", "พัฒนาโมเดล CAD ควบคู่กับภาพร่างของลูกค้า ปรับรูยึด ขารองรับ และจุดประกอบกล้อง ก่อนสร้างต้นแบบ")</p><a href="@Link("/Services/3D-Design")">@T("Explore 3D design", "ดูงานออกแบบ 3 มิติ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></article>
            <article class="landing-service-card"><img src="/src/images/landing/camera-bracket-prototypes-v4.webp" width="1200" height="800" loading="lazy" decoding="async" alt="@T("Illustrative 3D-printed camera-bracket variations beside the same white inspection bottle in a printer room", "ภาพประกอบต้นแบบขายึดกล้องที่พิมพ์ 3 มิติหลายแบบ ข้างขวดสีขาวในห้องเครื่องพิมพ์")" /><div><h3>@T("03 · Prototype variations", "03 · ทดลองต้นแบบหลายแบบ")</h3><p>@T("3D-print several bracket variations to compare height, stiffness and camera fit. Use the results to refine the final design.", "พิมพ์ขายึด 3 มิติหลายแบบ เพื่อเปรียบเทียบความสูง ความแข็งแรง และการประกอบกล้อง แล้วนำผลมาปรับแบบสุดท้าย")</p><a href="@Link("/Services/3D-Printing")">@T("Explore prototyping", "ดูงานพิมพ์ต้นแบบ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></article>
            <article class="landing-service-card"><img src="/src/images/landing/camera-bracket-production-v5.webp" width="1200" height="800" loading="lazy" decoding="async" alt="@T("Illustrative batch machining of identical aluminium camera brackets in a guarded Haas VF-2", "ภาพประกอบการผลิตขายึดกล้องอะลูมิเนียมแบบเดียวกันเป็นชุดในเครื่อง Haas VF-2 ที่ปิดประตูนิรภัย")" /><div><h3>@T("04 · CNC batch production", "04 · ผลิตด้วย CNC เป็นชุด")</h3><p>@T("Machine the approved aluminium bracket in batches, using fixtures to hold the same design for repeat production and inspection.", "ผลิตขายึดอะลูมิเนียมตามแบบที่ยืนยันเป็นชุด โดยใช้ฟิกซ์เจอร์จับยึดสำหรับผลิตแบบเดียวกันซ้ำและตรวจสอบชิ้นงาน")</p><a href="@Link("/Services/Custom-Manufacturing")">@T("Plan production", "วางแผนการผลิต") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></article>
        </div>
        <p class="profile-workflow-note">@T("Illustrative project: the same camera bracket, bottle and inspection task throughout. Images illustrate the process and are not a named customer case study.", "โปรเจกต์ตัวอย่างที่ใช้ขายึดกล้อง ขวด และโจทย์ตรวจวัดเดียวกันตลอดกระบวนการ ภาพใช้ประกอบการอธิบาย ไม่ใช่กรณีศึกษาของลูกค้าที่ระบุชื่อ")</p>
    </div></section>

    <section class="landing-section profile-deployment" aria-labelledby="profile-deployment-title"><div class="landing-container profile-story-grid">
        <figure class="profile-story-media"><img src="/src/images/landing/camera-bracket-deployment.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Illustrative final aluminium bracket holding the same measurement camera beside white bottles on a customer production conveyor", "ภาพประกอบขายึดอะลูมิเนียมแบบสุดท้ายติดตั้งกล้องตรวจวัดข้างขวดสีขาวบนสายพานผลิตของลูกค้า")" /></figure>
        <div><header class="landing-section-heading"><h2 id="profile-deployment-title">@T("On the production line", "ติดตั้งบนสายการผลิต")</h2></header>
            <p class="profile-short-copy">@T("The final bracket holds the measurement camera beside the bottle conveyor. The mounting position, camera view and clearance come together in the application the customer sketched at the start.", "ขายึดแบบสุดท้ายรองรับกล้องตรวจวัดข้างสายพานขวด ตำแหน่งยึด มุมมองกล้อง และระยะหลบ เชื่อมกลับมาสู่โจทย์ที่ลูกค้าร่างไว้ตั้งแต่เริ่มต้น")</p>
        </div>
    </div></section>

    <section class="landing-section profile-development" aria-labelledby="profile-development-title"><div class="landing-container">
        <div class="profile-story-grid">
            <AboutWorkpieceGallery />
            <div><header class="landing-section-heading"><h2 id="profile-development-title">@T("Already have a part? Start there.", "เริ่มจากชิ้นงานเดิมที่มีอยู่ได้")</h2></header>
                <p class="profile-short-copy">@T("MALIEV also works from existing parts. Reverse engineering reconstructs a CAD design for replacement parts, functional improvements or further product development.", "MALIEV รับพัฒนางานจากชิ้นงานเดิมด้วยวิศวกรรมย้อนกลับ เพื่อสร้างแบบ CAD สำหรับผลิตชิ้นส่วนทดแทน ปรับปรุงการใช้งาน หรือต่อยอดผลิตภัณฑ์")</p>
                <p class="profile-short-copy">@T("Share your sample and explain how it is used. We review the material, geometry and quantity together before choosing a manufacturing process.", "นำชิ้นงานตัวอย่างมาพร้อมข้อมูลการใช้งาน เพื่อพิจารณาวัสดุ รูปทรง และจำนวนร่วมกัน ก่อนเลือกกระบวนการผลิต")</p>
                <a class="profile-text-link" href="@Link("/Services/3D-Scanning")"><span class="arrow-link-label">@T("Explore 3D scanning", "ดูงานสแกน 3 มิติ")</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
        </div>
    </div></section>

    <section class="landing-section profile-manufacturing" aria-labelledby="profile-manufacturing-title" aria-roledescription="@T("carousel", "ภาพเลื่อนบริการ")"><div class="landing-container" data-capability-carousel>
        <header class="landing-section-heading"><h2 id="profile-manufacturing-title">@T("Manufacturing capabilities", "ความสามารถด้านการผลิต")</h2><span>@T("Explore the processes available for your material, geometry and production quantity.", "เลือกดูกระบวนการให้เหมาะกับวัสดุ รูปทรง และจำนวนผลิตของคุณ")</span></header>
        @{
            var capabilities = new[] {
                (Id: "cnc", En: "CNC machining", Th: "งาน CNC", CopyEn: "Machine metal and plastic parts from your drawings, with material, finish and inspection requirements agreed before production.", CopyTh: "ผลิตชิ้นส่วนโลหะและพลาสติกตามแบบ โดยตกลงวัสดุ ผิวงาน และขอบเขตการตรวจสอบก่อนผลิต", Image: "services/cnc/part-bento-cnc-arched-linkage.webp", Page: "/Services/CNC-Machining"),
                (Id: "printing", En: "3D printing", Th: "พิมพ์ 3 มิติ", CopyEn: "Build prototypes and functional parts to compare fit, form and design variations before committing to a production process.", CopyTh: "สร้างต้นแบบและชิ้นส่วนใช้งาน เพื่อเปรียบเทียบการประกอบ รูปทรง และแบบต่าง ๆ ก่อนเลือกกระบวนการผลิต", Image: "services/printing/part-bento-abs-fan.webp", Page: "/Services/3D-Printing"),
                (Id: "scanning", En: "3D scanning", Th: "สแกน 3 มิติ", CopyEn: "Capture the geometry of an existing part as a starting point for reverse engineering and CAD reconstruction.", CopyTh: "เก็บข้อมูลรูปทรงชิ้นงานเดิม เพื่อใช้เป็นจุดเริ่มต้นของงานวิศวกรรมย้อนกลับและสร้างแบบ CAD", Image: "services/scanning/scanning-hero.webp", Page: "/Services/3D-Scanning"),
                (Id: "design", En: "3D design", Th: "ออกแบบ 3 มิติ", CopyEn: "Develop CAD from a sketch, idea or existing part. Review assembly, material and manufacturability before making the first prototype.", CopyTh: "พัฒนาแบบ CAD จากภาพร่าง ไอเดีย หรือชิ้นงานเดิม ทบทวนการประกอบ วัสดุ และความเหมาะสมในการผลิตก่อนสร้างต้นแบบ", Image: "landing/capability-design-mouse-cad.webp", Page: "/Services/3D-Design"),
                (Id: "silicone", En: "Silicone casting", Th: "หล่อซิลิโคน", CopyEn: "Produce small quantities of silicone parts using a suitable mold, with material and surface requirements reviewed for the application.", CopyTh: "ผลิตชิ้นงานซิลิโคนจำนวนน้อยด้วยแม่พิมพ์ที่เหมาะสม โดยพิจารณาวัสดุและผิวงานตามการใช้งาน", Image: "landing/silicone-owl-sculpture-casting.webp", Page: "/Services/Silicone-Casting"),
                (Id: "injection", En: "Low-volume injection molding", Th: "ฉีดพลาสติกจำนวนน้อย", CopyEn: "Review the part and tooling before production. Our pneumatic injection route supports the following limits.", CopyTh: "ประเมินชิ้นงานและแม่พิมพ์ก่อนผลิต โดยงานฉีดพลาสติกระบบลมรองรับขอบเขตดังนี้", Image: "services/injection-molding/part-bento-pp-source-derived.webp", Page: "/Services/Low-Volume-Injection-Molding")
            };
        }
        @{
            var capabilityDetails = new Dictionary<string, (string LabelEn, string LabelTh, string En, string Th)[]> {
                ["cnc"] = new[] {
                    ("Materials", "วัสดุ", "Metals and engineering plastics; confirm grade, stock and finish for each job.", "โลหะและพลาสติกวิศวกรรม โดยยืนยันเกรด วัตถุดิบ และผิวงานสำหรับแต่ละงาน"),
                    ("Files & requirements", "ไฟล์และข้อกำหนด", "STEP/STP or IGES/IGS geometry, plus a PDF drawing for critical dimensions, tolerances, threads and fits.", "ไฟล์ STEP/STP หรือ IGES/IGS พร้อมแบบ PDF ระบุขนาดสำคัญ ค่าความคลาดเคลื่อน เกลียว และจุดสวมประกอบ"),
                    ("Production scope", "ขอบเขตการผลิต", "One-off parts through repeat batches, with machining access, setup and inspection reviewed before quotation.", "ตั้งแต่ชิ้นเดียวถึงผลิตซ้ำเป็นชุด โดยทบทวนการเข้าถึงของเครื่องมือ การจับยึด และการตรวจสอบก่อนเสนอราคา")
                },
                ["printing"] = new[] {
                    ("Technologies", "เทคโนโลยี", "FDM and resin printing. MJF, SLS, SLM and DMLS require engineering review to confirm the project scope.", "พิมพ์ FDM และเรซิน ส่วน MJF, SLS, SLM และ DMLS ต้องประเมินทางวิศวกรรมเพื่อยืนยันขอบเขตของโปรเจกต์"),
                    ("Material selection", "การเลือกวัสดุ", "Match stiffness, impact, heat and chemical exposure to the application; review layer direction, supports and finish.", "เลือกตามความแข็ง การรับแรงกระแทก ความร้อน และสารเคมี พร้อมทบทวนทิศทางชั้นพิมพ์ ซัพพอร์ต และผิวงาน"),
                    ("Files & next step", "ไฟล์และขั้นตอนถัดไป", "STL, STEP, OBJ or 3MF. Compare printed variations for fit and function before approving the production design.", "รับไฟล์ STL, STEP, OBJ หรือ 3MF เปรียบเทียบต้นแบบหลายแบบเพื่อทดสอบการประกอบและการใช้งานก่อนยืนยันแบบผลิต")
                },
                ["scanning"] = new[] {
                    ("Capture", "การเก็บข้อมูล", "Structured-light scanning, in-house or onsite after reviewing access, surface preparation and working conditions.", "สแกนด้วยแสงแบบมีโครงสร้าง ทั้งที่บริษัทและนอกสถานที่ โดยประเมินการเข้าถึง การเตรียมผิว และสภาพแวดล้อมก่อน"),
                    ("Deliverables", "สิ่งส่งมอบ", "Scan-only work produces a triangular mesh such as STL. Editable CAD and 2D drawings are separately defined work.", "งานสแกนอย่างเดียวส่งมอบเมชสามเหลี่ยม เช่น STL ส่วน CAD ที่แก้ไขได้และแบบ 2 มิติเป็นขอบเขตงานที่ต้องกำหนดเพิ่มเติม"),
                    ("Engineering review", "การทบทวนทางวิศวกรรม", "Rebuild geometry or compare with nominal CAD. Agree critical features and reporting scope; wear may obscure the original design.", "สร้างรูปทรงใหม่หรือเปรียบเทียบกับ CAD อ้างอิง โดยตกลงจุดสำคัญและขอบเขตรายงาน ทั้งนี้รอยสึกอาจทำให้ระบุแบบเดิมได้ไม่ครบ")
                },
                ["design"] = new[] {
                    ("Starting information", "ข้อมูลเริ่มต้น", "Sketches, reference photos, drawings, sample parts or scanned meshes, with intended use and critical interfaces.", "ภาพร่าง ภาพอ้างอิง แบบงาน ชิ้นงานตัวอย่าง หรือเมชจากการสแกน พร้อมการใช้งานและจุดประกอบสำคัญ"),
                    ("Design for manufacture", "ออกแบบเพื่อการผลิต", "Review material, tolerances, assembly, machining access, print orientation and mold strategy for the chosen process.", "ทบทวนวัสดุ ค่าความคลาดเคลื่อน การประกอบ การเข้าถึงของเครื่องมือ ทิศทางพิมพ์ และแนวทางแม่พิมพ์ตามกระบวนการที่เลือก"),
                    ("Deliverables", "สิ่งส่งมอบ", "Agree CAD formats, STEP, STL and 2D drawings before modeling; validate the approved design with a prototype.", "ตกลงรูปแบบไฟล์ CAD, STEP, STL และแบบ 2 มิติก่อนเริ่มงาน แล้วทดสอบแบบที่ยืนยันด้วยต้นแบบ")
                },
                ["silicone"] = new[] {
                    ("Process", "กระบวนการ", "Cast liquid silicone in a 3D-printed mold for suitable prototypes and short runs.", "หล่อซิลิโคนเหลวในแม่พิมพ์พิมพ์ 3 มิติ สำหรับต้นแบบและการผลิตจำนวนน้อยที่เหมาะสม"),
                    ("Mold review", "การประเมินแม่พิมพ์", "Review parting lines, vents, release, printed mold surface and silicone compatibility before pouring and curing.", "ทบทวนแนวประกบ ช่องระบายอากาศ การถอดแบบ ผิวแม่พิมพ์ และความเข้ากันได้กับซิลิโคนก่อนเทและบ่ม"),
                    ("Specify the part", "ข้อมูลชิ้นงาน", "Send CAD, quantity, hardness or flexibility, color, finish, inserts and intended use. Cure cycles and mold count affect the schedule.", "ส่ง CAD จำนวน ความแข็งหรือความยืดหยุ่น สี ผิวงาน อินเสิร์ต และการใช้งาน โดยรอบบ่มและจำนวนแม่พิมพ์มีผลต่อระยะเวลา")
                },
                ["injection"] = new[] {
                    ("Technology & batch", "เทคโนโลยีและจำนวน", "Pneumatic PIMM injection molding for pilot runs and repeat batches of up to 1,000 parts.", "ฉีดพลาสติก PIMM ระบบลม สำหรับล็อตทดลองและการผลิตซ้ำไม่เกิน 1,000 ชิ้น"),
                    ("Machine limits", "ขอบเขตเครื่อง", "Up to 50 g per shot; plastic melting temperature up to 350 °C. Suitability depends on the part, resin and mold.", "น้ำหนักฉีดไม่เกิน 50 กรัมต่อช็อต อุณหภูมิหลอมพลาสติกไม่เกิน 350 °C โดยต้องประเมินชิ้นงาน เม็ดพลาสติก และแม่พิมพ์ร่วมกัน"),
                    ("Tooling & inspection", "แม่พิมพ์และการตรวจสอบ", "Review an existing mold or scope a new tool. Confirm resin, geometry, finish, quantity and inspection requirements before production.", "ประเมินแม่พิมพ์เดิมหรือกำหนดงานแม่พิมพ์ใหม่ พร้อมยืนยันวัสดุ รูปทรง ผิวงาน จำนวน และข้อกำหนดการตรวจสอบก่อนผลิต")
