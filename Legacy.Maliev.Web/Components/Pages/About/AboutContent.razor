                    ("landing/capability-cnc-vf2-machining.webp", "Illustrative Haas VF-2 machining an aluminium billet", "ภาพประกอบเครื่อง Haas VF-2 กัดชิ้นงานจากแท่งอะลูมิเนียม"),
                    ("landing/capability-cnc-finished-bracket.webp", "Illustrative finished aluminium brackets with machined faces", "ภาพประกอบขายึดอะลูมิเนียมที่กัดขึ้นรูปเสร็จแล้ว"),
                    ("landing/capability-cnc-finished-housing-v2.webp", "Illustrative instrument housing machined from aluminium billet", "ภาพประกอบตัวเรือนเครื่องมือที่กัดจากแท่งอะลูมิเนียม")
                },
                ["printing"] = new[] {
                    ("services/printing/part-bento-abs-fan.webp", "FDM printed ABS fan sample", "ตัวอย่างใบพัด ABS พิมพ์ FDM"),
                    ("services/printing/part-bento-rubber-resin-pulley.webp", "Flexible resin printed pulley sample", "ตัวอย่างพูลเลย์พิมพ์เรซินยืดหยุ่น"),
                    ("services/printing/part-bento-mjf-pa12-linkage.webp", "MJF PA12 nylon linkage sample", "ตัวอย่างชิ้นส่วนกลไกไนลอน PA12 พิมพ์ MJF")
                },
                ["scanning"] = new[] {
                    ("landing/reverse-engineering-worn-part.webp", "Start with the worn part", "เริ่มจากชิ้นงานที่สึกหรอ"),
                    ("landing/capability-scan-capture.webp", "Capture the visible surfaces", "สแกนผิวชิ้นงาน"),
                    ("landing/capability-scan-cad-grey-v2.webp", "Reconstruct the CAD geometry", "สร้างรูปทรง CAD ใหม่")
                },
                ["design"] = new[] {
                    ("landing/capability-design-mouse-sketch.webp", "Explore ergonomic mouse-shell concepts", "สำรวจแนวคิดรูปทรงตัวเรือนเมาส์ตามหลักสรีรศาสตร์"),
