        <div class="profile-capability-controls" data-capability-controls hidden>
            <div class="profile-capability-choices" role="group" aria-label="@T("Choose a capability", "เลือกบริการ")">
                @for (var i = 0; i < capabilities.Length; i++) {
                    <button type="button" data-capability-index="@i" aria-controls="capability-@capabilities[i].Id" aria-pressed="@(i == 0 ? "true" : "false")">@T(capabilities[i].En, capabilities[i].Th)</button>
                }
            </div>
            <div class="profile-capability-paging"><button type="button" data-capability-prev aria-label="@T("Previous service", "บริการก่อนหน้า")"><i class="fas fa-arrow-left" aria-hidden="true"></i></button><span data-capability-status role="status" aria-live="polite" aria-atomic="true">1 / 6</span><button type="button" data-capability-next aria-label="@T("Next service", "บริการถัดไป")"><i class="fas fa-arrow-right" aria-hidden="true"></i></button></div>
        </div>
        <div class="profile-capability-track" data-capability-track tabindex="0" aria-label="@T("Services, scroll horizontally", "เลื่อนแนวนอนเพื่อดูบริการ")">
            @for (var i = 0; i < capabilities.Length; i++) {
                var capability = capabilities[i];
                <article class="profile-capability-slide" id="capability-@capability.Id" role="group" aria-roledescription="@T("slide", "รายการบริการ")" aria-label="@(i + 1) / @capabilities.Length · @T(capability.En, capability.Th)">
                    <div><h3>@T(capability.En, capability.Th)</h3><p class="profile-short-copy">@T(capability.CopyEn, capability.CopyTh)</p>
                        <dl class="profile-capability-details">
                            @foreach (var detail in capabilityDetails[capability.Id]) {
                                <div><dt>@T(detail.LabelEn, detail.LabelTh)</dt><dd>@T(detail.En, detail.Th)</dd></div>
                            }
                        </dl>
                        <a class="profile-text-link" href="@Link(capability.Page)"><span class="arrow-link-label">@T("View service", "ดูรายละเอียดบริการ")</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                    <div class="profile-capability-bento" data-photo-count="@capabilityImages[capability.Id].Length" role="group" aria-label="@T("Process and workpiece examples", "ตัวอย่างกระบวนการและชิ้นงาน")">
                        @foreach (var photo in capabilityImages[capability.Id]) {
                            <figure><img src="/src/images/@photo.Image" width="1200" height="800" loading="lazy" decoding="async" alt="@T(photo.En, photo.Th)" /></figure>
                        }
                    </div>
                </article>
            }
        </div>
    </div></section>

    <section class="landing-section profile-collaboration" aria-labelledby="profile-collaboration-title"><div class="landing-container">
        <header class="landing-section-heading"><h2 id="profile-collaboration-title">@T("Before we quote", "ก่อนเสนอราคา")</h2><span>@T("Clarify the technical requirements, project scope and confidentiality before quotation and manufacturing.", "พูดคุยข้อกำหนดทางเทคนิค ขอบเขตงาน และการรักษาความลับ ก่อนเสนอราคาและเริ่มผลิต")</span></header>
        <div class="profile-collaboration-grid">
            <article><h3>@T("Engineering requirements", "โจทย์ทางวิศวกรรม")</h3><p>@T("Review intended use, critical dimensions and mating features using your CAD, drawing or physical sample. Identify missing information before choosing a production route.", "ทบทวนการใช้งาน ขนาดสำคัญ และจุดประกอบ จากไฟล์ CAD แบบงาน หรือชิ้นงานตัวอย่าง พร้อมระบุข้อมูลที่ต้องเพิ่มเติมก่อนเลือกแนวทางผลิต")</p></article>
            <article><h3>@T("Scope and deliverables", "ขอบเขตงานและสิ่งส่งมอบ")</h3><p>@T("Clarify the process, material, finish, quantity and inspection scope so the quotation reflects the work and deliverables agreed together.", "กำหนดกระบวนการ วัสดุ ผิวงาน จำนวน และขอบเขตการตรวจสอบ ให้ใบเสนอราคาสอดคล้องกับงานและสิ่งส่งมอบที่ตกลงร่วมกัน")</p></article>
            <article><h3>@T("Project confidentiality", "ความลับของโปรเจกต์")</h3><p>@T("If your project requires an NDA, complete and sign the agreement before sending sensitive drawings, CAD files or samples.", "หากโปรเจกต์ต้องใช้ NDA ให้จัดทำและลงนามข้อตกลงก่อนส่งแบบงาน ไฟล์ CAD หรือชิ้นงานตัวอย่างที่เป็นความลับ")</p><a href="@Link("/Legal/NonDisclosureAgreement")"><span class="arrow-link-label">@T("View our NDA", "ดูข้อตกลงรักษาความลับ")</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></article>
        </div>
    </div></section>
    <CorporateCustomers />

    <section class="landing-cta-section"><div class="landing-container landing-cta">
        <div><h2>@T("Have an idea, drawing or sample part?", "มีไอเดีย แบบงาน หรือชิ้นงานตัวอย่าง?")</h2><p>@T("Talk to us to review a development and manufacturing approach.", "คุยกับเราเพื่อประเมินแนวทางพัฒนาและผลิต")</p><div class="landing-actions"><a class="landing-button landing-button-primary" href="@Link("/Contact")">@T("Discuss your project", "ปรึกษาโปรเจกต์ของคุณ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div>
        <img src="/src/images/services/printing/part-bento-pa-cf-wheel.webp" width="1254" height="1254" loading="lazy" decoding="async" alt="@T("Source-based image of a PA-CF printed wheel-like sample", "ภาพจากชิ้นงานพิมพ์ PA-CF ลักษณะคล้ายล้อ")" />
    </div></section>
</main>

@code {
    [Parameter]
    public string RouteOwner { get; set; } = "razor-static-ssr";

    private string T(string english, string thai)
    {
        var value = Localizer[english];
        return value.ResourceNotFound
            ? CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th" ? thai : english
            : value.Value;
    }

    private static string Link(string path) =>
        $"{path}?culture={CultureInfo.CurrentUICulture.TwoLetterISOLanguageName}";
}
