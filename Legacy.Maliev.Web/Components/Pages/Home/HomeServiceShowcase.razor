@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var servicesUrl = culture == "en" ? "/services?culture=en" : "/services";
    string LocalizedLink(string path) => HomeHeroSelection.LocalizedLink(path, culture);
    string T(string english, string thai) => culture == "th" ? thai : english;
}
<section class="service-showcase" aria-label="@T("Our Services", "บริการของเรา")">
    <div class="landing-container">
        <header class="service-showcase-intro"><h2>@T("Choose how to make your part.", "เลือกวิธีผลิตชิ้นงานของคุณ")</h2><p>@T("Start with a process you know, or share your project and we will help you choose.", "เลือกกระบวนการที่คุณรู้จัก หรือบอกรายละเอียดงานเพื่อให้เราช่วยเลือก")</p><nav class="service-shortcuts" aria-label="@T("Our Services", "บริการของเรา")"><a href="#feature-print-title">@T("3D Printing", "งานพิมพ์ 3 มิติ")</a><a href="#feature-cnc-title">@T("CNC Machining", "งาน CNC ตามแบบ")</a><a href="#feature-scan-title">@T("3D Scanning", "งานสแกน 3 มิติ")</a><a href="#feature-design-title">@T("3D Design", "ออกแบบ 3 มิติ")</a><a href="@servicesUrl">@T("Need help choosing a process?", "ต้องการความช่วยเหลือในการเลือกกระบวนการหรือไม่?") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></nav></header>
        <article class="service-feature service-feature--printing" aria-labelledby="feature-print-title">
            <div class="service-feature-copy">
                <h2 class="service-feature-label" id="feature-print-title">@T("3D Printing", "งานพิมพ์ 3 มิติ")</h2><p class="service-feature-headline">@T("Bring your design to life.", "เปลี่ยนแบบของคุณให้เป็นชิ้นงานจริง")</p>
                <p>@T("Fast, flexible additive manufacturing for prototypes and functional parts in a variety of materials.", "ผลิตต้นแบบและชิ้นส่วนใช้งานจริงได้รวดเร็ว ยืดหยุ่น และเลือกวัสดุได้หลากหลาย")</p>
                <div class="service-feature-actions"><a class="service-feature-button" href="@LocalizedLink("/Services/3D-Printing")">@T("Explore 3D printing", "ดูบริการพิมพ์ 3 มิติ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-feature-secondary" href="@LocalizedLink("/InstantQuotation/3D-Printing")">@T("Instant 3D-print pricing", "ประเมินราคาพิมพ์ 3D ทันที") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><div class="service-feature-fit"><strong>@T("A good fit for", "เหมาะสำหรับ")</strong><span>@T("Prototypes, fixtures and functional parts", "ต้นแบบ ฟิกซ์เจอร์ และชิ้นส่วนใช้งานจริง")</span></div>
            </div>
            <div class="service-feature-rotation">
                <div class="rotation-frames" role="img" aria-label="@T("Examples of 3D printed parts: a fan, a patterned cube and a shell.", "ตัวอย่างชิ้นงานพิมพ์ 3 มิติ ได้แก่ ใบพัด ลูกบาศก์ลวดลาย และชิ้นงานทรงเปลือก")">
                    <img src="/src/images/landing/printing-studio.webp" alt="" loading="lazy" decoding="async" />
                    <img src="/src/images/landing/printing-cube-studio.webp" alt="" loading="lazy" decoding="async" />
                    <img src="/src/images/landing/printing-shell-studio.webp" alt="" loading="lazy" decoding="async" />
                </div>
            </div>
            <div class="service-feature-details service-feature-facts service-feature-facts--interactive service-feature-facts--expandable">
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-1" /><label for="fact-toggle-1" class="fact-summary"><i class="fas fa-layer-group" aria-hidden="true"></i><strong>@T("Materials", "วัสดุ")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Pick a material for your part", "เลือกวัสดุให้เหมาะกับชิ้นงาน")</h3><p>@T("Explore PLA, PETG, ABS, resin and more.", "เลือกดู PLA, PETG, ABS, เรซิ่น และวัสดุอื่น ๆ")</p><div class="fact-chips" aria-hidden="true"><span>PLA</span><span>PETG</span><span>ABS</span><span>@T("Resin", "เรซิ่น")</span></div><a href="@(LocalizedLink("/Services/3D-Printing") + "#printing-materials")">@T("Compare materials", "เปรียบเทียบวัสดุ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-2" /><label for="fact-toggle-2" class="fact-summary"><i class="far fa-clock" aria-hidden="true"></i><strong>@T("Lead time", "ระยะเวลาผลิต")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Lead time", "ระยะเวลาผลิต")</h3><p>@T("FDM usually starts at 1 day; resin usually starts at 7 days. Geometry, material and the production queue can extend timing.", "งาน FDM โดยทั่วไปเริ่มต้น 1 วัน และเรซิ่นเริ่มต้น 7 วัน ระยะเวลาขึ้นกับรูปทรง วัสดุ และคิวผลิต")</p><a href="@LocalizedLink("/Services/3D-Printing")">@T("Explore 3D printing", "ดูบริการพิมพ์ 3 มิติ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-3" /><label for="fact-toggle-3" class="fact-summary"><i class="fas fa-calculator" aria-hidden="true"></i><strong>@T("Price and quantity", "ราคาและจำนวน")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Estimate for one or many", "ประเมินราคาได้ตั้งแต่หนึ่งชิ้น")</h3><p>@T("No minimum quantity. Upload a model to estimate FDM or resin pricing and compare quantities.", "ไม่มีจำนวนขั้นต่ำ อัปโหลดโมเดลเพื่อประเมินราคา FDM หรือเรซิ่นและเปรียบเทียบจำนวน")</p><a href="@LocalizedLink("/InstantQuotation/3D-Printing")">@T("Get an instant estimate", "ประเมินราคาทันที") →</a></div></div></div>
            </div>
        </article>
        <article class="service-feature service-feature--cnc" aria-labelledby="feature-cnc-title">
            <div class="service-feature-copy"><h2 class="service-feature-label" id="feature-cnc-title">@T("CNC Machining", "งาน CNC ตามแบบ")</h2><p class="service-feature-headline">@T("Made to fit. Built to work.", "ผลิตให้พอดี พร้อมใช้งาน")</p><p>@T("High-precision machining for metals and plastics with tight tolerances and excellent surface finishes.", "ผลิตชิ้นส่วนโลหะและพลาสติกความแม่นยำสูง ควบคุมค่าความคลาดเคลื่อนและผิวงานอย่างละเอียด")</p><div class="service-feature-actions"><a class="service-feature-button" href="@LocalizedLink("/Services/CNC-Machining")">@T("Explore CNC machining", "ดูบริการ CNC") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><div class="service-feature-fit"><strong>@T("A good fit for", "เหมาะสำหรับ")</strong><span>@T("Precision components, housings and fixtures", "ชิ้นส่วนความแม่นยำ ตัวเรือน และฟิกซ์เจอร์")</span></div></div>
            <div class="service-feature-rotation service-feature-rotation--cnc"><div class="rotation-frames" role="img" aria-label="@T("Photograph-based illustrations of machined parts: an impeller, a flange and precision components.", "ภาพประกอบจากภาพถ่ายชิ้นงาน CNC ได้แก่ ใบพัด หน้าแปลน และชิ้นส่วนกลึง")"><img src="/src/images/landing/cnc-impeller-photo-studio.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/cnc-flange-photo-studio.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/cnc-components-photo-studio.webp" alt="" loading="lazy" decoding="async" /></div></div>
            <div class="service-feature-details service-feature-facts service-feature-facts--interactive service-feature-facts--expandable">
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-4" /><label for="fact-toggle-4" class="fact-summary"><i class="fas fa-layer-group" aria-hidden="true"></i><strong>@T("Materials", "วัสดุ")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Choose a material", "เลือกวัสดุ")</h3><p>@T("Choose metals or engineering plastics to suit how your part will be used.", "เลือกโลหะหรือพลาสติกวิศวกรรมให้เหมาะกับการใช้งานของชิ้นส่วน")</p><a href="@(LocalizedLink("/Services/CNC-Machining") + "#cnc-materials")">@T("Explore materials", "ดูวัสดุ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-5" /><label for="fact-toggle-5" class="fact-summary"><i class="fas fa-cubes" aria-hidden="true"></i><strong>@T("Capabilities", "ความสามารถ")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("CNC milling and turning", "งานกัดและกลึง CNC")</h3><p>@T("Share a drawing or CAD model so we can review the geometry and machining approach.", "ส่งแบบหรือโมเดล CAD เพื่อให้เราประเมินรูปทรงและแนวทางการผลิต")</p><a href="@(LocalizedLink("/Services/CNC-Machining") + "#cnc-capabilities")">@T("Explore capabilities", "ดูความสามารถ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-6" /><label for="fact-toggle-6" class="fact-summary"><i class="far fa-file-alt" aria-hidden="true"></i><strong>@T("Price and lead time", "ราคาและระยะเวลาผลิต")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Quote for your part", "ขอราคาสำหรับชิ้นงาน")</h3><p>@T("Price and timing depend on the drawing, material, tolerances and quantity.", "ราคาและระยะเวลาขึ้นกับแบบ วัสดุ ค่าความคลาดเคลื่อน และจำนวน")</p><a href="@LocalizedLink("/Quotation")">@T("Request a quote", "ขอใบเสนอราคา") →</a></div></div></div>
            </div>
        </article>
        <article class="service-feature service-feature--scanning" aria-labelledby="feature-scan-title">
            <div class="service-feature-copy"><h2 class="service-feature-label" id="feature-scan-title">@T("3D Scanning", "งานสแกน 3 มิติ")</h2><p class="service-feature-headline">@T("Turn a real part into a digital starting point.", "เปลี่ยนชิ้นงานจริงเป็นจุดเริ่มต้นในรูปแบบดิจิทัล")</p><p>@T("Capture the shape of existing parts for reverse engineering and CAD reconstruction.", "เก็บข้อมูลรูปทรงชิ้นงานเดิม สำหรับวิศวกรรมย้อนกลับและการสร้างแบบ CAD")</p><div class="service-feature-actions"><a class="service-feature-button" href="@LocalizedLink("/Services/3D-Scanning")">@T("Explore 3D scanning", "ดูบริการสแกน 3 มิติ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><div class="service-feature-fit"><strong>@T("A good fit for", "เหมาะสำหรับ")</strong><span>@T("Existing parts without drawings or CAD", "ชิ้นงานเดิมที่ไม่มีแบบหรือไฟล์ CAD")</span></div></div>
            <figure class="service-feature-rotation service-feature-rotation--scanning"><div class="rotation-frames" role="img" aria-label="@T("Illustrations of scanning, a cleaned mesh and reverse engineering.", "ภาพประกอบการสแกน การเก็บ mesh และวิศวกรรมย้อนกลับ")"><img src="/src/images/landing/scan-capture-studio.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/scan-mesh-studio.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/scan-cad-studio.webp" alt="" loading="lazy" decoding="async" /></div></figure>
            <div class="service-feature-details service-feature-facts service-feature-facts--interactive service-feature-facts--expandable">
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-7" /><label for="fact-toggle-7" class="fact-summary"><i class="fas fa-cube" aria-hidden="true"></i><strong>@T("Starting point", "สิ่งที่ใช้เริ่มงาน")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Start with your existing part", "เริ่มจากชิ้นงานจริง")</h3><p>@T("Bring a part when drawings or CAD are unavailable. Tell us how you plan to use the scan.", "นำชิ้นงานจริงมาเมื่อไม่มีแบบหรือไฟล์ CAD และบอกเราว่าต้องการนำข้อมูลไปใช้อย่างไร")</p><div class="fact-chips"><span>@T("Existing part", "ชิ้นงานจริง")</span><span>@T("Intended use", "การนำไปใช้งาน")</span></div><a href="@LocalizedLink("/Services/3D-Scanning")">@T("Explore 3D scanning", "ดูบริการสแกน 3 มิติ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-8" /><label for="fact-toggle-8" class="fact-summary"><i class="fas fa-drafting-compass" aria-hidden="true"></i><strong>@T("Deliverables", "สิ่งที่ส่งมอบ")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("From scan to digital data", "จากการสแกนสู่ข้อมูลดิจิทัล")</h3><p>@T("We capture scan data and a mesh. CAD reconstruction can be reviewed separately.", "สแกนและเก็บข้อมูล mesh พร้อมประเมินงานสร้าง CAD เพิ่มเติมได้")</p><div class="fact-chips"><span>@T("Scan data", "ข้อมูลสแกน")</span><span>@T("Mesh", "mesh")</span><span>@T("CAD on review", "CAD ประเมินเพิ่มเติม")</span></div><a href="@LocalizedLink("/Services/3D-Scanning")">@T("Explore deliverables", "ดูบริการสแกน") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-9" /><label for="fact-toggle-9" class="fact-summary"><i class="far fa-clock" aria-hidden="true"></i><strong>@T("Lead time and price", "ระยะเวลาผลิตและราคา")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Timing depends on the part", "ระยะเวลาขึ้นอยู่กับชิ้นงาน")</h3><p>@T("Simple scans can be completed the same day; scope and price are confirmed after review.", "งานสแกนไม่ซับซ้อนอาจเสร็จภายในวันเดียว ยืนยันขอบเขตและราคาหลังประเมิน")</p><div class="fact-chips"><span>@T("Scope reviewed", "ประเมินขอบเขตก่อน")</span></div><a href="@LocalizedLink("/Quotation")">@T("Discuss your part", "ปรึกษาชิ้นงาน") →</a></div></div></div>
            </div>
        </article>
        <article class="service-feature service-feature--design" aria-labelledby="feature-design-title">
            <div class="service-feature-copy"><h2 class="service-feature-label" id="feature-design-title">@T("3D Design", "ออกแบบ 3 มิติ")</h2><p class="service-feature-headline">@T("From idea to a design ready to make.", "จากไอเดียสู่แบบที่พร้อมผลิต")</p><p>@T("Turn an idea, sketch, or scanned part into a manufacturable 3D design with practical DFM guidance.", "เปลี่ยนไอเดีย ภาพร่าง หรือชิ้นงานสแกนเป็นแบบ 3 มิติพร้อมผลิต พร้อมคำแนะนำ DFM")</p><div class="service-feature-actions"><a class="service-feature-button" href="@LocalizedLink("/Services/3D-Design")">@T("Discuss your design", "ปรึกษางานออกแบบ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><div class="service-feature-fit"><strong>@T("A good fit for", "เหมาะสำหรับ")</strong><span>@T("Developing an idea or improving an existing part", "พัฒนาไอเดียหรือปรับปรุงชิ้นงานเดิม")</span></div></div>
            <figure class="service-feature-rotation service-feature-rotation--design"><div class="rotation-frames" role="img" aria-label="@T("Illustrations of a bracket progressing from hand sketch to 3D model, engineering drawing and finished-part visualization.", "ภาพประกอบชิ้นส่วนจากภาพร่างสู่แบบ 3 มิติ แบบวิศวกรรม และภาพชิ้นงานสำเร็จ")"><img src="/src/images/landing/design-journey-sketch-v2.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/design-cad-illustration.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/design-journey-drawing-v2.webp" alt="" loading="lazy" decoding="async" /><img src="/src/images/landing/design-journey-finished-v2.webp" alt="" loading="lazy" decoding="async" /></div></figure>
            <div class="service-feature-details service-feature-facts service-feature-facts--interactive service-feature-facts--expandable">
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-10" /><label for="fact-toggle-10" class="fact-summary"><i class="fas fa-pencil-ruler" aria-hidden="true"></i><strong>@T("Starting point", "ข้อมูลเริ่มต้น")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Bring what you have", "เริ่มจากสิ่งที่คุณมี")</h3><p>@T("Share an idea, sketch, drawing or scanned part, and tell us what the design needs to do.", "ส่งไอเดีย ภาพร่าง แบบงาน หรือชิ้นงานที่สแกน พร้อมบอกการใช้งานที่ต้องการ")</p><div class="fact-chips"><span>@T("Idea or sketch", "ไอเดียหรือภาพร่าง")</span><span>@T("Drawing or scan", "แบบงานหรือข้อมูลสแกน")</span></div><a href="@LocalizedLink("/Services/3D-Design")">@T("Explore 3D design", "ดูบริการออกแบบ 3 มิติ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-11" /><label for="fact-toggle-11" class="fact-summary"><i class="fas fa-cogs" aria-hidden="true"></i><strong>@T("Design for manufacturing", "ออกแบบเพื่อการผลิต")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("Design with production in mind", "ออกแบบโดยคำนึงถึงการผลิต")</h3><p>@T("Review geometry and the intended manufacturing process together.", "ตรวจแบบและกระบวนการผลิตที่เหมาะสมร่วมกัน")</p><div class="fact-chips"><span>@T("Geometry", "รูปทรง")</span><span>@T("Process", "กระบวนการผลิต")</span></div><a href="@LocalizedLink("/Services/3D-Design")">@T("Discuss your design", "ปรึกษางานออกแบบ") →</a></div></div></div>
                <div><div class="fact-disclosure"><input type="checkbox" class="fact-toggle" id="fact-toggle-12" /><label for="fact-toggle-12" class="fact-summary"><i class="far fa-file-alt" aria-hidden="true"></i><strong>@T("Scope and quote", "ขอบเขตและราคา")</strong><span aria-hidden="true">+</span></label><div class="fact-popover"><h3>@T("A scope tailored to your project", "กำหนดขอบเขตตามโปรเจกต์")</h3><p>@T("CAD work and timing are agreed for each project after reviewing your requirements.", "ตกลงขอบเขตงาน CAD และระยะเวลาเป็นรายโปรเจกต์หลังประเมินความต้องการ")</p><div class="fact-chips"><span>@T("CAD scope", "ขอบเขตงาน CAD")</span><span>@T("Project timing", "ระยะเวลาของโปรเจกต์")</span></div><a href="@LocalizedLink("/Quotation")">@T("Request a quote", "ขอใบเสนอราคา") →</a></div></div></div>
            </div>
        </article>
    </div>
</section>
