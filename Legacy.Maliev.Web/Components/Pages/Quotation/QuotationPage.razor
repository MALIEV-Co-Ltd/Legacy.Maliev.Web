@page "/Quotation"
@using System.Globalization
@using Legacy.Maliev.Web.Application
@using Legacy.Maliev.Web.Components.Layout
@using Legacy.Maliev.Web.Infrastructure
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.Extensions.Options
@inject IHttpContextAccessor HttpContextAccessor
@inject ICountryClient CountryClient
@inject IAccountSessionManager AccountSessionManager
@inject ICustomerAccountClient CustomerAccountClient
@inject IAntiforgery Antiforgery
@inject ITempDataDictionaryFactory TempDataDictionaryFactory
@inject IOptions<RecaptchaEnterpriseOptions> RecaptchaOptions
@inject IStringLocalizer<QuotationContent> Localizer

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var metadata = QuotationDocumentMetadata.Create(Item, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th");
    var title = metadata.Title;
    var description = metadata.Description;
    var keywords = metadata.Keywords;
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
    @if (!string.IsNullOrWhiteSpace(RecaptchaOptions.Value.SiteKey))
    {
        <script src="https://www.google.com/recaptcha/enterprise.js?render=@Uri.EscapeDataString(RecaptchaOptions.Value.SiteKey)" async defer></script>
    }
</HeadContent>
<div class="inquiry-page" data-migration-route-owner="blazor-static-ssr">
    <QuotationHeroContent />
    <main class="inquiry-content">
        <div class="inquiry-container">
            @if (!string.IsNullOrWhiteSpace(notification))
            {
                <div class="inquiry-notification" role="status" aria-live="polite">@notification</div>
            }
            <div class="inquiry-shell">
                <QuotationGuidanceContent />
                <section class="inquiry-form-card" aria-labelledby="quotation-form-title">
                    <form method="post"
                          enctype="multipart/form-data"
                          action="@FormAction"
                          id="quotation-form"
                          data-recaptcha-enterprise-form
                          data-recaptcha-site-key="@RecaptchaOptions.Value.SiteKey"
                          data-recaptcha-action="submit"
                          data-upload-analytics="true">
                        @if (tokens is not null)
                        {
                            <input type="hidden" name="@tokens.FormFieldName" value="@tokens.RequestToken" />
                        }
                        <QuotationFormFields Model="model" />
                    </form>
                </section>
            </div>
        </div>
    </main>
</div>

@code {
    private QuotationFormDisplayModel model = new(
        Guid.Empty,
        "custom_manufacturing",
        string.Empty,
        string.Empty,
        string.Empty,
        null,
        null,
        null,
        string.Empty,
        string.Empty,
        null,
        string.Empty,
        false,
        false,
        true,
        [],
        new Dictionary<string, IReadOnlyList<string>>());
    private AntiforgeryTokenSet? tokens;
    private string? notification;

    private string FormAction => $"/Quotation?handler=SubmitRequest&culture={CurrentCulture}";

    private static string CurrentCulture =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName is "en" ? "en" : "th";

    [SupplyParameterFromQuery(Name = "culture")]
    public string? Culture { get; set; }

    [SupplyParameterFromQuery(Name = "item")]
    public string? Item { get; set; }

    [SupplyParameterFromQuery(Name = "process")]
    public string? Process { get; set; }

    [SupplyParameterFromQuery(Name = "material")]
    public string? Material { get; set; }

    [SupplyParameterFromQuery(Name = "finder_files")]
    public string? FinderFiles { get; set; }

    [SupplyParameterFromQuery(Name = "finder_service")]
    public string? FinderService { get; set; }

    [SupplyParameterFromQuery(Name = "finder_material")]
    public string? FinderMaterial { get; set; }

    [SupplyParameterFromQuery(Name = "finder_quantity")]
    public string? FinderQuantity { get; set; }

    [SupplyParameterFromQuery(Name = "finder_end_use")]
    public string? FinderEndUse { get; set; }

    [SupplyParameterFromQuery(Name = "finder_performance")]
    public string? FinderPerformance { get; set; }

    [SupplyParameterFromQuery(Name = "finder_environment")]
    public string? FinderEnvironment { get; set; }

    [SupplyParameterFromQuery(Name = "finder_recommendations")]
    public string? FinderRecommendations { get; set; }

    [SupplyParameterFromQuery(Name = "finder_path")]
    public string? FinderPath { get; set; }

    [SupplyParameterFromQuery(Name = "finish_hex")]
    public string? FinishHex { get; set; }

    [SupplyParameterFromQuery(Name = "finish_hlc")]
    public string? FinishHlc { get; set; }

    [SupplyParameterFromQuery(Name = "finish_lab")]
    public string? FinishLab { get; set; }

    [SupplyParameterFromQuery(Name = "finish_pantone")]
    public string? FinishPantone { get; set; }

    [SupplyParameterFromQuery(Name = "finish_sheen")]
    public string? FinishSheen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var context = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
        var countries = await CountryClient.GetCountriesAsync(context.RequestAborted);
        var serviceAvailable = countries.ServiceAvailable;
        IReadOnlyDictionary<string, IReadOnlyList<string>> errors = serviceAvailable
            ? new Dictionary<string, IReadOnlyList<string>>()
            : new Dictionary<string, IReadOnlyList<string>>
            {
                [string.Empty] = ["Could not retrieve countries from the server."]
            };
        var prefill = QuotationPrefill.Create(
            Culture,
            Item,
            Process,
            Material,
            FinishHex,
            FinishHlc,
            FinishLab,
            FinishPantone,
            FinishSheen);
        var trustedCustomer = await QuotationTrustedCustomerLoader.LoadAsync(
            context,
            AccountSessionManager,
            CustomerAccountClient,
            countries.Value ?? [],
            context.RequestAborted);
        model = new QuotationFormDisplayModel(
            Guid.NewGuid(),
            prefill.ServiceContext,
            trustedCustomer.FirstName,
            trustedCustomer.LastName,
            trustedCustomer.Email,
            trustedCustomer.Phone,
            trustedCustomer.Company,
            trustedCustomer.TaxNumber,
            trustedCustomer.Country,
            prefill.Message,
            null,
            RecaptchaOptions.Value.SiteKey,
            serviceAvailable,
            trustedCustomer.IsAuthenticated,
            trustedCustomer.ProfileAvailable,
            (countries.Value ?? []).Select(country => new QuotationCountryOption(country.Name)).ToArray(),
            errors,
            FinderFiles,
            FinderService,
            FinderMaterial,
            FinderQuantity,
            FinderEndUse,
            FinderPerformance,
            FinderEnvironment,
            FinderRecommendations,
            FinderPath);
        var tempData = TempDataDictionaryFactory.GetTempData(context);
        notification = tempData.TryGetValue("Notification", out var value) ? value?.ToString() : null;
        tokens = Antiforgery.GetAndStoreTokens(context);
    }
}
