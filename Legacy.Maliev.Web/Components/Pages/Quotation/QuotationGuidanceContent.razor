@inject IStringLocalizer<QuotationContent> Localizer

<aside class="inquiry-aside inquiry-aside--sticky" aria-label="@Localizer["Quotation guidance"]" data-migration-component="quotation-guidance-content" data-migration-renderer="blazor-static-ssr">
    <section class="inquiry-panel inquiry-panel--accent">
        <div class="inquiry-panel__icon"><i class="fas fa-clipboard-list" aria-hidden="true"></i></div>
        <h2>@Localizer["What helps us quote accurately"]</h2>
        <ul class="inquiry-checklist">
            <li><i class="fas fa-check-circle" aria-hidden="true"></i><span>@Localizer["3D CAD, drawing, scan, or reference images"]</span></li>
            <li><i class="fas fa-check-circle" aria-hidden="true"></i><span>@Localizer["Required quantity and preferred material"]</span></li>
            <li><i class="fas fa-check-circle" aria-hidden="true"></i><span>@Localizer["Critical dimensions, tolerances, and surface finish"]</span></li>
            <li><i class="fas fa-check-circle" aria-hidden="true"></i><span>@Localizer["Delivery location and required date"]</span></li>
        </ul>
    </section>

    <section class="inquiry-panel">
        <div class="inquiry-panel__icon"><i class="fas fa-file-archive" aria-hidden="true"></i></div>
        <h2>@Localizer["Preparing your files"]</h2>
        <p>@Localizer["If you want to send us files from"] <a href="https://www.sketchup.com/" target="_blank" rel="noopener"><strong>SketchUp</strong></a>@Localizer[", please ZIP the files before sending it to us."]</p>
        <p>@Localizer["For files larger than 100 MB, upload them to a trusted file-sharing service and paste the link in your project details."]</p>
        <p class="inquiry-help">@Localizer["You can use"] WeTransfer, Uploadfiles.io, Google Drive, Dropbox, or OneDrive. @Localizer["For Google Drive, set sharing permission so our team can access the files."]</p>
    </section>

    <section class="inquiry-panel">
        <div class="inquiry-panel__icon"><i class="fas fa-comments" aria-hidden="true"></i></div>
        <h2>@Localizer["Prefer to speak with us?"]</h2>
        <p>@Localizer["Email your request to"] <a href="mailto:manufacturing@maliev.com">manufacturing@maliev.com</a> @Localizer["or contact our team through these channels."]</p>
        <p><a href="https://line.me/ti/p/@@maliev" target="_blank" rel="noopener">LINE OA @@maliev</a> · <a href="/Contact">@Localizer["Contact MALIEV"]</a></p>
    </section>
</aside>
