<article class="knowledge-document" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner">
<h1>@Localizer["Plan heat treatment before final machining"]</h1>
<p class="docs-lead">@Localizer["Heat treatment changes the properties of a suitable metal through controlled processing. Choose it together with the alloy, starting condition, geometry, and acceptance requirements. A note saying only heat treated leaves important decisions unresolved and can make the finished dimension difficult to achieve."]</p>
<figure class="docs-figure knowledge-photo">
    <img src="/src/images/knowledge/photos/heat-treatment.webp" srcset="/src/images/knowledge/photos/heat-treatment-small.webp 768w, /src/images/knowledge/photos/heat-treatment.webp 1536w" sizes="(min-width: 72rem) calc(100vw - 25rem), calc(100vw - 4rem)" alt="@Localizer["Steel shafts, rings and a tool insert on a rack near a closed industrial furnace."]" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" />
    <figcaption>@Localizer["Plan treatment, remaining machining stock and final inspection in the same process sequence. Illustrative image."]</figcaption>
</figure>
