@inject IStringLocalizer<KnowledgeIndexContent> Localizer

<article class="knowledge-document" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner">
    <p class="maliev-eyebrow">@Localizer["Manufacturing resources"]</p>
<h1>@Localizer["Knowledge center"]</h1>
<p class="docs-lead">@Localizer["Understand what makes a part easier to manufacture, what to put on the drawing, and which decisions to resolve before requesting a quotation."]</p>
<section class="docs-section" aria-labelledby="cnc-guides"><h2 id="cnc-guides">@Localizer["Design a better CNC part"]</h2><p>@Localizer["A CAD model can be geometrically correct yet difficult to hold, reach, cut, or inspect. Learn the trade-offs behind manufacturability, cost, dimensional control, and finishing."]</p><div class="maliev-card-grid docs-topic-grid"><a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining#thin-walls"><strong>@Localizer["Thin walls, warpage, and chatter"]</strong><span>@Localizer["Understand stiffness, residual stress, tool reach, and why a part can move during machining."]</span></a>
<a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining#radii-pockets"><strong>@Localizer["Corner radii and deep pockets"]</strong><span>@Localizer["Give the cutter room to work. Review depth, internal corners, access, and relief features."]</span></a>
<a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining#holes-threads"><strong>@Localizer["Holes, threads, and fits"]</strong><span>@Localizer["Specify usable depth, thread details, locating features, and mating components."]</span></a>
<a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining#tolerances"><strong>@Localizer["Tolerances and inspection"]</strong><span>@Localizer["Separate size from position and form. Define datums and the acceptance condition."]</span></a>
<a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining#axes"><strong>@Localizer["3-axis, 5-axis, EDM, and grinding"]</strong><span>@Localizer["Compare routes by tool access, geometry, material, and the surfaces that matter."]</span></a>
<a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining#finishing"><strong>@Localizer["Surface finish and anodizing"]</strong><span>@Localizer["Plan coating growth, masking, cosmetic faces, and the effect on a close fit."]</span></a></div><div class="maliev-actions"><a class="maliev-button" href="/knowledges/specifications/cnc-machining">@Localizer["Read the CNC design guide"]</a></div></section><section class="docs-section" aria-labelledby="project-guides"><h2 id="project-guides">@Localizer["Prepare your project"]</h2><div class="maliev-card-grid docs-topic-grid"><a class="maliev-panel docs-link-card" href="/knowledges/specifications/3d-printing"><strong>@Localizer["Design for 3D printing"]</strong><span>@Localizer["FDM and resin, orientation, supports, hollow parts, fit, and finishing requirements."]</span></a><a class="maliev-panel docs-link-card" href="/knowledges/specifications/3d-scanning"><strong>@Localizer["Plan a 3D scan"]</strong><span>@Localizer["Choose mesh or CAD deliverables and agree access, accuracy, datums, and reconstructed areas."]</span></a><a class="maliev-panel docs-link-card" href="/knowledges/guidelines"><strong>@Localizer["Build a complete quotation package"]</strong><span>@Localizer["Files, units, revisions, quantities, functional requirements, and confidentiality."]</span></a></div></section><section class="docs-section" aria-labelledby="before-sending"><h2 id="before-sending">@Localizer["Before you send a part"]</h2><ul class="docs-checklist"><li>@Localizer["Match the model and drawing revision; identify the units and quantity for every part."]</li><li>@Localizer["Explain how the part works, where it locates in the assembly, and which dimensions or surfaces are critical."]</li><li>@Localizer["Specify the material grade or required properties, finish, masking, and reports needed for acceptance."]</li><li>@Localizer["Flag flexible design choices, supplied components, the requested date, and delivery destination."]</li></ul><p><a href="/knowledges/workflow">@Localizer["Understand review, approval, production, and delivery"]</a></p></section><aside class="docs-note"><p>@Localizer["Design examples explain engineering principles; they are not guaranteed MALIEV machine limits or acceptance tolerances. Material, geometry, tooling, finishing, and inspection need review together."]</p></aside><section class="docs-next" aria-labelledby="knowledge-next"><h2 id="knowledge-next">@Localizer["Have a design question?"]</h2><p>@Localizer["Send the files you have and describe what the part needs to do. If you are still choosing a process, start with the preparation guides."]</p><div class="maliev-actions"><a class="maliev-button" href="/quotation">@Localizer["Request a project review"]</a><a class="maliev-button maliev-button--secondary" href="/knowledges/specifications">@Localizer["Compare preparation guides"]</a></div></section>
</article>

@code {
    [Parameter]
    public string? RouteOwner { get; set; }
