@page "/Knowledges"
@using Legacy.Maliev.Web.Components.Layout
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<KnowledgeIndexContent> ContentLocalizer
@inject IStringLocalizer<KnowledgeIndexPage> Localizer

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var title = ContentLocalizer["Manufacturing knowledge library | MALIEV"].Value;
    var description = ContentLocalizer["Practical manufacturing articles, calculations, material comparisons and design guidance for better engineering decisions."].Value;
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
</HeadContent>
<KnowledgeShell CurrentPage="/Index" RouteOwner="blazor-static-ssr">
    <KnowledgeIndexContent RouteOwner="blazor-static-ssr" />
</KnowledgeShell>
