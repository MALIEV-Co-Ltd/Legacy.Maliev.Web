        <h2>@Localizer["Bring the model and the functional requirements"]</h2>
        <p>@Localizer["Use the checklist to identify missing information before requesting a quotation. Highlight the features that drive fit, function or inspection so the proposed manufacturing route can be reviewed against the actual job."]</p>
        <div class="maliev-actions"><a class="maliev-button" href="/quotation?item=CNC-Machining">@Localizer["Request a CNC project review"]</a><a class="maliev-button maliev-button--secondary" href="/services/cnc-machining">@Localizer["View CNC machining service"]</a><a href="#files">@Localizer["Review the quotation checklist"]</a></div>
    </aside>
</article>

