@page "/Knowledges/Specifications"
@using System.Globalization
@using System.Text.Json
@using Legacy.Maliev.Web.Components.Layout
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SpecificationsIndexContent> ContentLocalizer
@inject IStringLocalizer<SpecificationsIndexPage> Localizer

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var title = ContentLocalizer["Service specifications | MALIEV"].Value;
    var description = ContentLocalizer["Compare the information needed for CNC machining, 3D printing, and 3D scanning before requesting a quotation."].Value;
    var documentLinks = PublicDocumentLinksDisplayModel.Create(context);
    var structuredData = CreateStructuredData(documentLinks.CanonicalUrl, title, description);
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="documentLinks" />
    @foreach (var document in structuredData)
    {
        <script type="application/ld+json">@((MarkupString)document)</script>
    }
</HeadContent>
<div class="docs-page" data-migration-route-owner="blazor-static-ssr">
    <div class="workspace-shell docs-shell">
        <aside id="knowledge-navigation" class="workspace-sidebar workspace-sidebar--knowledge" aria-label="@Localizer["Knowledge center"]">
            <div class="workspace-sidebar__header">
                <strong>@Localizer["Knowledge center"]</strong>
                <button type="button" class="workspace-drawer-close" data-workspace-close aria-label="@Localizer["Close contents"]">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <nav aria-label="@Localizer["Knowledge sections"]">
                <section class="workspace-nav-group" aria-labelledby="knowledge-overview">
                    <p id="knowledge-overview" class="workspace-nav-group__label">@Localizer["Overview"]</p>
                    <ul class="workspace-nav-list">
                        <li><a class="workspace-nav-link" href="/knowledges"><i class="fas fa-book-open" aria-hidden="true"></i><span>@Localizer["Knowledge center"]</span></a></li>
                    </ul>
                </section>
                <section class="workspace-nav-group" aria-labelledby="knowledge-services">
                    <p id="knowledge-services" class="workspace-nav-group__label">@Localizer["Service specifications"]</p>
                    <ul class="workspace-nav-list">
                        <li><a class="workspace-nav-link" href="/knowledges/specifications" aria-current="page"><i class="fas fa-list" aria-hidden="true"></i><span>@Localizer["All service specifications"]</span></a></li>
                        <li><a class="workspace-nav-link" href="/knowledges/specifications/cnc-machining"><i class="fas fa-cog" aria-hidden="true"></i><span>@Localizer["CNC manufacturing"]</span></a></li>
                        <li><a class="workspace-nav-link" href="/knowledges/specifications/3d-printing"><i class="fas fa-cubes" aria-hidden="true"></i><span>@Localizer["3D printing"]</span></a></li>
                        <li><a class="workspace-nav-link" href="/knowledges/specifications/3d-scanning"><i class="fas fa-cube" aria-hidden="true"></i><span>@Localizer["3D scanning"]</span></a></li>
                    </ul>
                </section>
                <section class="workspace-nav-group" aria-labelledby="knowledge-process">
                    <p id="knowledge-process" class="workspace-nav-group__label">@Localizer["Working with MALIEV"]</p>
                    <ul class="workspace-nav-list">
                        <li><a class="workspace-nav-link" href="/knowledges/guidelines"><i class="fas fa-clipboard-check" aria-hidden="true"></i><span>@Localizer["Guidelines"]</span></a></li>
                        <li><a class="workspace-nav-link" href="/knowledges/workflow"><i class="fas fa-project-diagram" aria-hidden="true"></i><span>@Localizer["Workflow"]</span></a></li>
                    </ul>
                </section>
            </nav>
        </aside>
        <main id="knowledge-content" class="docs-content" tabindex="-1">
            <div class="workspace-toolbar">
                <button type="button" class="workspace-drawer-toggle" aria-controls="knowledge-navigation" aria-expanded="false" data-workspace-open>
                    <i class="fas fa-bars" aria-hidden="true"></i>
                    <span>@Localizer["Contents"]</span>
                </button>
            </div>
            <SpecificationsIndexContent RouteOwner="blazor-static-ssr" />
        </main>
    </div>
    <button type="button" class="workspace-backdrop" data-workspace-backdrop hidden aria-label="@Localizer["Close contents"]"></button>
</div>
@code {
    private static string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private string[] CreateStructuredData(string canonicalUrl, string title, string description)
    {
        var webPage = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebPage",
            ["name"] = title,
            ["description"] = description,
            ["url"] = canonicalUrl,
            ["inLanguage"] = CurrentLanguage
        };
        var breadcrumb = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new object[]
            {
                CreateBreadcrumbItem(1, Localizer["Home"].Value, CanonicalUrlPolicy.GetLocalizedUrl("/", CurrentLanguage)),
                CreateBreadcrumbItem(2, Localizer["Knowledge center"].Value, CanonicalUrlPolicy.GetLocalizedUrl("/knowledges", CurrentLanguage)),
                CreateBreadcrumbItem(3, Localizer["Service specifications"].Value, canonicalUrl)
            }
        };

        return [JsonSerializer.Serialize(webPage), JsonSerializer.Serialize(breadcrumb)];
    }

    private static Dictionary<string, object> CreateBreadcrumbItem(int position, string name, string item) => new()
    {
        ["@type"] = "ListItem",
        ["position"] = position,
        ["name"] = name,
        ["item"] = item
    };
}
