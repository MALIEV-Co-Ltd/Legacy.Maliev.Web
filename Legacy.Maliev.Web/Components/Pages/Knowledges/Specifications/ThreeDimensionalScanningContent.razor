    <p class="maliev-eyebrow">@Localizer["3D scanning preparation"]</p>
<h1>@Localizer["Prepare a part for 3D scanning"]</h1>
<p class="docs-lead">@Localizer["Start with the decision the scan must support: visual reference, a replacement part, editable CAD, or comparison against a reference. These goals require different preparation and deliverables. Define the output and critical features before sending the physical part."]</p>
<nav class="docs-toc" aria-label="@Localizer["On this page"]">
<strong>@Localizer["On this page"]</strong>
<ul>
