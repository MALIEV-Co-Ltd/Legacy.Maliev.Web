@inject IStringLocalizer<SpecificationsIndexContent> Localizer

<article class="knowledge-document" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner">
<h1>@Localizer["Manufacturing preparation guides"]</h1>
<p class="docs-lead">@Localizer["Start with the result you need, then prepare the files and requirements that let an engineer choose a suitable process."]</p>
<figure class="docs-figure knowledge-photo">
    <img src="/src/images/knowledge/photos/service-guides.webp" srcset="/src/images/knowledge/photos/service-guides-small.webp 768w, /src/images/knowledge/photos/service-guides.webp 1536w" sizes="(min-width: 72rem) calc(100vw - 25rem), calc(100vw - 4rem)" alt="@Localizer["Turned, milled, printed and cast samples beside engineering drawings."]" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" />
    <figcaption>@Localizer["The starting information depends on the part and the intended process. Illustrative image."]</figcaption>
</figure>
<figure class="docs-figure knowledge-diagram">
    <div class="knowledge-diagram-viewport" role="region" tabindex="0" aria-label="@Localizer["Three panels distinguish digital geometry, a dimensioned drawing and a physical sample."]">
        <img src="/src/images/knowledge/visual-service-inputs.svg" alt="@Localizer["Three panels distinguish digital geometry, a dimensioned drawing and a physical sample."]" width="960" height="480" loading="lazy" decoding="async" />
    </div>
    <figcaption>@Localizer["1: a model communicates nominal geometry and units. 2: a drawing specifies tolerances and requirements that shape alone cannot express. 3: an existing sample reveals actual condition, including wear or damage; it does not automatically establish the original nominal dimensions. Submit the inputs relevant to the required service and identify unresolved differences."] <a class="knowledge-diagram-link" href="/src/images/knowledge/visual-service-inputs.svg" target="_blank" rel="noopener">@Localizer["Open full-size diagram"]</a></figcaption>
</figure>

<div class="maliev-card-grid docs-topic-grid"><a class="maliev-panel docs-link-card" href="/knowledges/specifications/cnc-machining"><strong>@Localizer["CNC machining"]</strong><span>@Localizer["Walls, radii, pockets, workholding, tolerances, machining axes, EDM, grinding, and coatings."]</span></a><a class="maliev-panel docs-link-card" href="/knowledges/specifications/3d-printing"><strong>@Localizer["3D printing"]</strong><span>@Localizer["Material choice, clean geometry, orientation, supports, fit, and post-processing."]</span></a><a class="maliev-panel docs-link-card" href="/knowledges/specifications/3d-scanning"><strong>@Localizer["3D scanning"]</strong><span>@Localizer["Surface access, preparation, measurement requirements, mesh, and reverse-engineered CAD."]</span></a></div><section class="docs-section" aria-labelledby="compare-inputs"><h2 id="compare-inputs">@Localizer["What should you send?"]</h2><div class="docs-table-wrap" role="region" tabindex="0" aria-label="@Localizer["Submission information by manufacturing process"]"><table><caption>@Localizer["A starting checklist; additional information depends on the actual part."]</caption><thead><tr><th scope="col">@Localizer["Process"]</th><th scope="col">@Localizer["Starting information"]</th><th scope="col">@Localizer["Decisions to resolve"]</th></tr></thead><tbody><tr><th scope="row">@Localizer["CNC machining"]</th><td>@Localizer["Solid CAD, matching drawing, material grade and condition, quantity, and finish."]</td><td>@Localizer["Critical datums and fits, tool access, clamping, coating allowances, and inspection scope."]</td></tr><tr><th scope="row">@Localizer["3D printing"]</th><td>@Localizer["A clean model at the intended scale, quantity, application, and material requirements."]</td><td>@Localizer["Load direction, support-contact areas, hollow regions, mating clearances, and supplied finish."]</td></tr><tr><th scope="row">@Localizer["3D scanning"]</th><td>@Localizer["Photos, dimensions, approximate weight, surface condition, and intended use of the data."]</td><td>@Localizer["Preparation permissions, mesh versus CAD, accuracy needs, and treatment of missing areas."]</td></tr></tbody></table></div></section><section class="docs-section" aria-labelledby="other-processes"><h2 id="other-processes">@Localizer["Design, casting, or molding instead?"]</h2><p>@Localizer["These service pages explain the starting information for additional processes. Confirm material, tooling, quantity, and deliverables during review."]</p><ul class="docs-checklist"><li><a href="/services/3d-design">@Localizer["3D design: sketches, references, or an existing part"]</a></li><li><a href="/services/silicone-casting">@Localizer["Silicone casting: master, flexible material, and required copies"]</a></li><li><a href="/services/low-volume-injection-molding">@Localizer["Low-volume injection molding: part, resin, mold, and batch quantity"]</a></li></ul></section><aside class="docs-note"><p>@Localizer["There is no single wall thickness, part size, or tolerance for every material and process. The quotation defines the agreed manufacturing and inspection scope."]</p></aside><div class="maliev-actions"><a class="maliev-button" href="/knowledges/guidelines">@Localizer["Prepare a complete request"]</a><a class="maliev-button maliev-button--secondary" href="/contact">@Localizer["Discuss an uncertain requirement"]</a></div>
</article>

@code {
    [Parameter]
    public string? RouteOwner { get; set; }
}
