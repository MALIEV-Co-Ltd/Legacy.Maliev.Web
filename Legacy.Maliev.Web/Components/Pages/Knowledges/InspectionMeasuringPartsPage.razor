@page "/knowledges/inspection/measuring-parts"
@using Legacy.Maliev.Web.Components.Layout
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<InspectionMeasuringPartsContent> ContentLocalizer
@inject IStringLocalizer<KnowledgeIndexPage> Localizer

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var title = ContentLocalizer["Measuring manufactured parts | MALIEV"].Value;
    var description = ContentLocalizer["Choose dimensional inspection methods, control temperature and fixturing, understand measurement uncertainty, and agree useful inspection reports."].Value;
    var documentLinks = PublicDocumentLinksDisplayModel.Create(context);
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="documentLinks" />
</HeadContent>
<KnowledgeShell CurrentPage="/Inspection/Measuring-Parts" RouteOwner="blazor-static-ssr">
    <InspectionMeasuringPartsContent RouteOwner="blazor-static-ssr" />
</KnowledgeShell>
