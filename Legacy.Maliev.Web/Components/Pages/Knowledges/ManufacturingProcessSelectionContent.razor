<article class="knowledge-document" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner">
<h1>@Localizer["Choose the process around the part"]</h1>
<p class="docs-lead">@Localizer["A process is a route to a functional part, not a quality ranking. Start with the job the component must do, then compare feasible routes against the same drawing, material requirement, delivery scope, and inspection plan."]</p>
<figure class="docs-figure knowledge-photo">
    <img src="/src/images/knowledge/photos/process-selection.webp" srcset="/src/images/knowledge/photos/process-selection-small.webp 768w, /src/images/knowledge/photos/process-selection.webp 1536w" sizes="(min-width: 72rem) calc(100vw - 25rem), calc(100vw - 4rem)" alt="@Localizer["Printed, machined and folded-sheet instrument housings illustrate different process routes."]" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" />
    <figcaption>@Localizer["A similar function can lead to different construction, tooling and material decisions. Illustrative image."]</figcaption>
</figure>
