@page "/Error"
@using Legacy.Maliev.Web.Middleware
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<ErrorContent> Localizer

<PageTitle>@(displayModel.IsNotFound ? $"404 — {Localizer["Page not found"]} | MALIEV" : Localizer["Error | MALIEV"])</PageTitle>
<HeadContent>
    <meta name="robots" content="@(displayModel.IsNotFound ? "noindex, follow" : "noindex,nofollow")" />
    @if (displayModel.IsNotFound)
    {
        <meta name="theme-color" content="#020408" />
    }
</HeadContent>
<ErrorContent Model="displayModel" RouteOwner="blazor-static-ssr" />

@code {
    private ErrorDisplayModel displayModel = new(false, null, default, null);

    [SupplyParameterFromQuery(Name = "code")]
    public int? Code { get; set; }

    protected override void OnParametersSet()
    {
        var context = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");

        var requestedStatusCode = Code;
        if (requestedStatusCode is null
            && int.TryParse(context.Request.Query["code"], out var parsedStatusCode))
        {
            requestedStatusCode = parsedStatusCode;
        }

        var resolved = ErrorDisplayModelResolver.Resolve(context, requestedStatusCode);
        if (resolved is null)
        {
            return;
        }

        displayModel = resolved;
    }
}
