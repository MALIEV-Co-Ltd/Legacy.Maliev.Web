@page "/Contact"
@using Legacy.Maliev.Web.Application
@using Legacy.Maliev.Web.Components.Layout
@using Legacy.Maliev.Web.Infrastructure
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.Extensions.Options
@inject IHttpContextAccessor HttpContextAccessor
@inject ICountryClient CountryClient
@inject IContactTrustedCustomerLoader TrustedCustomerLoader
@inject IAntiforgery Antiforgery
@inject ITempDataDictionaryFactory TempDataDictionaryFactory
@inject IOptions<RecaptchaEnterpriseOptions> RecaptchaOptions
@inject IOptions<GoogleMapsOptions> GoogleMapsOptions
@inject IStringLocalizer<ContactContent> Localizer

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var title = Localizer["Contact MALIEV | Manufacturing Services"];
    var description = Localizer["Contact MALIEV about CNC machining, 3D printing, 3D scanning, or a general manufacturing question."];
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@Localizer["contact MALIEV, manufacturing enquiry, CNC quotation, 3D printing support"]" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
    @if (!string.IsNullOrWhiteSpace(RecaptchaOptions.Value.SiteKey))
    {
        <script src="https://www.google.com/recaptcha/enterprise.js?render=@Uri.EscapeDataString(RecaptchaOptions.Value.SiteKey)" async defer></script>
    }
</HeadContent>
<main class="inquiry-page" data-migration-route-owner="blazor-static-ssr">
    <ContactHeroContent />
    <section class="inquiry-content">
      <div class="inquiry-container">
        @if (!string.IsNullOrWhiteSpace(notification))
        {
            <div class="inquiry-notification" role="status" aria-live="polite"><p>@notification</p></div>
        }
        <div class="contact-method-grid" aria-label="@Localizer["Contact options"]">
            <article class="contact-method-card"><div class="contact-method-card__icon"><i class="far fa-envelope" aria-hidden="true"></i></div><div><h2>@Localizer["Email us"]</h2><p>@Localizer["Best for project details and files."]</p><a href="/contact#contact-us" data-contact-email="info@maliev.com">info@maliev.com</a></div></article>
            <article class="contact-method-card"><div class="contact-method-card__icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></div><div><h2>@Localizer["Call us"]</h2><p>@Localizer["Best for a quick question during business hours."]</p><a href="tel:+66898950690">+66(0)89-895-0690</a><a href="tel:+66818030404">+66(0)81-803-0404</a></div></article>
            <article class="contact-method-card"><div class="contact-method-card__icon"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></div><div><h2>@Localizer["Visit our workshop"]</h2><address>@Localizer["36/1 Moo 3"]<br />@Localizer["Khlong Khoi"], <span class="maliev-nowrap">@Localizer["Pak Kret"]</span><br />@Localizer["Nonthaburi 11120"], @Localizer["Thailand"]</address><p><strong>@Localizer["Business hours"]</strong><br />@Localizer["Monday-Friday: 09:00-18:00"]<br />@Localizer["Saturday-Sunday: Closed"]</p></div></article>
        </div>
        <div class="inquiry-shell">
            <aside class="inquiry-aside inquiry-aside--sticky" aria-label="@Localizer["Company contact details"]">
                <section class="inquiry-panel inquiry-panel--accent contact-line-card">
                    <a href="@SocialNetworks.Line" target="_blank" rel="noopener" data-contact-placement="contact_line_qr"><img src="/src/images/line-qr-clean.svg" width="160" height="160" title="LINE Official Account" alt="@Localizer["MALIEV LINE Official Account QR code"]" /></a>
                    <div><h2>@Localizer["Chat with us"]</h2><p>@Localizer["Scan the QR code or open our LINE Official Account for a quick conversation."]</p><div class="contact-channel-actions" aria-label="@Localizer["Chat channels"]"><a href="@SocialNetworks.Line" target="_blank" rel="noopener" data-contact-placement="contact_line"><i class="fab fa-line" aria-hidden="true"></i><span>@Localizer["Open LINE Official Account"]</span></a><a href="@SocialNetworks.WhatsApp" target="_blank" rel="noopener" data-contact-placement="contact_whatsapp" data-maliev-contact-destination="whatsapp_business"><i class="fab fa-whatsapp" aria-hidden="true"></i><span>@Localizer["Message us on WhatsApp"]</span></a><a href="@SocialNetworks.MessengerChat" target="_blank" rel="noopener" data-contact-placement="contact_messenger"><i class="fab fa-facebook-messenger" aria-hidden="true"></i><span>@Localizer["Open Messenger"]</span></a></div></div>
                </section>
                <section class="inquiry-panel"><div class="inquiry-panel__icon"><i class="fas fa-building" aria-hidden="true"></i></div><h2>Maliev Co., Ltd.</h2><p>@Localizer["36/1 Moo 3"]<br />@Localizer["Khlong Khoi"], <span class="maliev-nowrap">@Localizer["Pak Kret"]</span><br />@Localizer["Nonthaburi 11120"], @Localizer["Thailand"]</p>@if (culture == "th") { <p class="contact-tax">เลขประจำตัวผู้เสียภาษี 0125561001573 (สำนักงานใหญ่)</p> }</section>
                <section class="inquiry-panel"><div class="inquiry-panel__icon"><i class="fas fa-share-alt" aria-hidden="true"></i></div><h2>@Localizer["Follow and message MALIEV"]</h2><p>@Localizer["Find our latest work and contact us through our official social channels."]</p><div class="inquiry-social"><SocialLinks /></div></section>
            </aside>
            <form method="post"
                      action="@($"/Contact?handler=SubmitRequest&culture={culture}")"
                      id="contact-us"
                      class="inquiry-form-card"
                      data-recaptcha-enterprise-form
                      data-recaptcha-site-key="@RecaptchaOptions.Value.SiteKey"
                      data-recaptcha-action="submit">
                    @if (tokens is not null)
                    {
                        <input type="hidden" name="@tokens.FormFieldName" value="@tokens.RequestToken" />
                    }
                    <ContactFormFields Model="model" />
            </form>
        </div>
        <ContactDetailsContent Model="map" />
      </div>
    </section>
</main>

@code {
    private ContactFormDisplayModel model = new(
        string.Empty,
        string.Empty,
        string.Empty,
        null,
        null,
        string.Empty,
        string.Empty,
        null,
        string.Empty,
        false,
        false,
        [],
        new Dictionary<string, IReadOnlyList<string>>());
    private AntiforgeryTokenSet? tokens;
    private string? notification;
    private ContactMapDisplayModel map = new(null, SocialNetworks.GoogleMaps);
    private string culture = "en";

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
        var countries = await CountryClient.GetCountriesAsync(context.RequestAborted);
        var countryValues = countries.Value ?? [];
        var trustedCustomer = await TrustedCustomerLoader.LoadAsync(context, countryValues, context.RequestAborted);
        var serviceAvailable = countries.ServiceAvailable;
        var errors = serviceAvailable
            ? new Dictionary<string, IReadOnlyList<string>>()
            : new Dictionary<string, IReadOnlyList<string>>
            {
                [string.Empty] = ["Could not retrieve countries from the server."]
            };
        if (trustedCustomer.IsAuthenticated && trustedCustomer.Customer is null)
        {
            var profileError = "Could not retrieve your customer profile. Please update your profile or contact us directly.";
            errors[string.Empty] = errors.TryGetValue(string.Empty, out var existingErrors)
                ? [.. existingErrors, profileError]
                : [profileError];
        }
        var customer = trustedCustomer.Customer;
        model = new ContactFormDisplayModel(
            customer?.FirstName ?? string.Empty,
            customer?.LastName ?? string.Empty,
            customer?.Email ?? string.Empty,
            customer?.Phone,
            customer?.Company,
            customer?.Country ?? string.Empty,
            string.Empty,
            null,
            RecaptchaOptions.Value.SiteKey,
            trustedCustomer.IsAuthenticated,
            serviceAvailable,
            countryValues.Select(country => new ContactCountryOption(country.Name)).ToArray(),
            errors);
        culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName is "th" ? "th" : "en";
        map = ContactMapDisplayModel.Create(GoogleMapsOptions);
        var tempData = TempDataDictionaryFactory.GetTempData(context);
        notification = tempData.TryGetValue("Notification", out var value) ? value?.ToString() : null;
        tokens = Antiforgery.GetAndStoreTokens(context);
    }
}
