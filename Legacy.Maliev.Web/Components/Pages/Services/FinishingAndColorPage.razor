@page "/services/finishing-and-color"
@using System.Globalization
@using System.Text.Json
@using Legacy.Maliev.Web.Components.Layout
@using Legacy.Maliev.Web.Components.Shared
@using Legacy.Maliev.Web.Components.Pages.Services
@using Legacy.Maliev.Web.Components.Metadata
@inject IHttpContextAccessor HttpContextAccessor

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var title = T("Finishing & Colour Standards for 3D Printed Parts | MALIEV", "การเก็บผิวและมาตรฐานสีสำหรับงานพิมพ์ 3 มิติ | MALIEV");
    var description = T("Define paint colour, sheen, surface preparation, seams, and acceptance criteria before production so the quotation and the finished part match.", "กำหนดสี ระดับความเงา การเตรียมผิว รอยต่อ และเกณฑ์ตรวจรับก่อนผลิต เพื่อให้ใบเสนอราคาและชิ้นงานจริงตรงกัน");
    var keywords = T("3D print painting, Pantone RAL matching, clear coat matte gloss, 3D print assembly finishing, surface preparation", "พ่นสีงานพิมพ์ 3 มิติ, เทียบสี Pantone RAL, เคลือบใสด้านเงา, ประกอบและเก็บผิวงานพิมพ์, เตรียมผิวก่อนพ่นสี");
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <link rel="preload" as="image" href="/src/images/services/printing/printing-finish-color-approval.webp" imagesrcset="/src/images/services/printing/printing-finish-color-approval-640.webp 640w, /src/images/services/printing/printing-finish-color-approval-768.webp 768w, /src/images/services/printing/printing-finish-color-approval-960.webp 960w, /src/images/services/printing/printing-finish-color-approval.webp 1536w" imagesizes="100vw" fetchpriority="high" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
    <PublicServiceStructuredData Model="@(PublicServiceStructuredDataDisplayModel.Create("Finishing and Color"))" />
    <script type="application/ld+json">@((MarkupString)FaqJson)</script>
</HeadContent>
<ServiceBreadcrumb ServiceKey="Finishing and Color" />

<main class="service-page" data-migration-route-owner="blazor-static-ssr" data-migration-component="finishing-and-color-content">
    <section class="service-hero" aria-labelledby="finishing-title">
        <img class="service-hero-media" src="/src/images/services/printing/printing-finish-color-approval.webp" srcset="/src/images/services/printing/printing-finish-color-approval-640.webp 640w, /src/images/services/printing/printing-finish-color-approval-768.webp 768w, /src/images/services/printing/printing-finish-color-approval-960.webp 960w, /src/images/services/printing/printing-finish-color-approval.webp 1536w" sizes="100vw" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" alt="@T("Technician comparing a 3D-printed part with color swatches and a reference image", "ช่างกำลังเทียบสีชิ้นงานพิมพ์ 3 มิติกับแผ่นเทียบสีและภาพอ้างอิง")" />
        <div class="service-container service-hero-copy">
            <h1 id="finishing-title">@T("Finishing and colour standards", "การเก็บผิวและมาตรฐานสี")</h1>
            <p class="service-hero-lead">@T("A reference photo communicates the idea, but it does not define a measured colour or sheen. Agree the finish scope before production so the quotation, the result, and the acceptance criteria all match.", "ภาพอ้างอิงช่วยสื่อแนวคิด แต่ไม่ได้กำหนดค่าสีหรือระดับความเงาที่วัดได้ ควรยืนยันขอบเขตงานเก็บผิวก่อนผลิต เพื่อให้ใบเสนอราคา ผลงาน และเกณฑ์ยอมรับตรงกัน")</p>
            <ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Pantone and RAL colour matching", "เทียบสีด้วยรหัส Pantone และ RAL")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Matte, satin, and gloss clear coat", "เคลือบใสแบบด้าน ซาติน และเงา")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Split, join, and refinish large parts", "แบ่ง ต่อ และเก็บผิวชิ้นงานขนาดใหญ่")</li></ul>
            <div class="service-actions"><a class="service-button service-button-primary" href="/quotation?item=3D-Printing">@T("Request a finishing quote", "ขอใบเสนอราคางานเก็บผิว")</a><a class="service-button service-button-secondary" href="/InstantQuotation/3D-Printing">@T("Get instant 3D pricing", "ประเมินราคาพิมพ์ 3D ทันที")</a></div>
        </div>
    </section>

    <ServicePageToc />

    <section id="finishing-standards" class="service-section">
        <div class="service-container">
            <header class="service-heading center">
                <h2>@T("Define the finish before we paint", "กำหนดรายละเอียดผิวก่อนเริ่มพ่นสี")</h2>
                <p>@T("Choose any screen colour or sample one from an image. We mark the closest open HLC reference, then arrange lighter and darker tonal alternatives for your finishing quote.", "เลือกสีจากหน้าจอหรือจิ้มสีจากภาพ ระบบจะทำเครื่องหมายรหัสอ้างอิง HLC แบบเปิดที่ใกล้ที่สุด แล้วจัดตัวเลือกโทนที่สว่างและเข้มกว่าเพื่อส่งพร้อมคำขอใบเสนอราคางานเก็บผิว")</p>
            </header>

            <section class="finish-color-matcher"
                     aria-labelledby="finish-color-matcher-title"
                     data-finish-color-matcher
                     data-culture="@(isThai ? "th" : "en")"
                     data-results-status="@T("{count} guided HLC references for {hex}, ordered from lightest to darkest.", "รหัสอ้างอิง HLC แนะนำ {count} รายการสำหรับ {hex} เรียงจากสว่างไปเข้ม")"
                     data-selection-status="@T("Selected {code}, {sheen}, ΔE00 {delta}. Your finish brief is updated.", "เลือก {code} ผิว{sheen} ค่า ΔE00 {delta} แล้ว อัปเดตสรุปรายละเอียดผิวเรียบร้อย")"
                     data-closest-position="@T("Closest match: {position} of {count}. Swipe to explore lighter and darker alternatives.", "สีที่ใกล้ที่สุด: ลำดับ {position} จาก {count} ปัดเพื่อดูตัวเลือกที่สว่างและเข้มกว่า")"
                     data-select-template="@T("Select {code}. Color difference {delta}. {position}.", "เลือก {code} ค่าความต่างสี {delta} {position}")"
                     data-lightness-position="@T("Lightness {lightness} out of 100", "ความสว่าง {lightness} จาก 100")"
                     data-closest-label="@T("Closest match", "ใกล้ที่สุด")"
                     data-sheen-matte="@T("Matte", "ด้าน")"
                     data-sheen-satin="@T("Satin", "ซาติน")"
                     data-sheen-gloss="@T("Gloss", "เงา")"
                     data-preview-template="@T("{sheen} finish preview", "ภาพจำลองผิว{sheen}")"
                     data-no-pantone="@T("Not supplied", "ไม่ได้ระบุ")"
                     data-primer-template="@T("Start the spray-out with {primer}.", "เริ่มพ่นแผ่นทดสอบด้วย{primer}")"
                     data-primer-light="@T("a white or light-neutral primer", "สีรองพื้นขาวหรือสีกลางโทนอ่อน")"
                     data-primer-medium="@T("a medium-grey primer", "สีรองพื้นเทากลาง")"
                     data-primer-dark="@T("a dark-grey primer", "สีรองพื้นเทาเข้ม")"
                     data-clear-matte="@T("Use a compatible matte clear system, keep overlap and film build even, and do not polish the finished surface.", "ใช้ระบบเคลือบใสด้านที่เข้ากัน ควบคุมระยะซ้อนและความหนาฟิล์มให้สม่ำเสมอ และห้ามขัดเงาผิวสำเร็จ")"
                     data-clear-satin="@T("Use a compatible satin clear system and keep overlap, film build, flash-off, and drying consistent across the part.", "ใช้ระบบเคลือบใสซาตินที่เข้ากัน และควบคุมระยะซ้อน ความหนาฟิล์ม ระยะพัก และการแห้งให้สม่ำเสมอทั้งชิ้น")"
                     data-clear-gloss="@T("Use a compatible gloss clear system over a uniform base coat; polish only after the specified cure when the chosen system allows it.", "ใช้ระบบเคลือบใสเงาที่เข้ากันบนสีพื้นซึ่งสม่ำเสมอ และขัดเงาหลังบ่มตามเวลาที่ระบบสีกำหนดเท่านั้น")"
                     data-invalid-hex="@T("Enter a complete six-digit HEX color, such as #A2474F.", "กรุณากรอกรหัส HEX 6 หลัก เช่น #A2474F")"
                     data-invalid-image="@T("Choose a JPEG, PNG, WebP, GIF, or other valid image file and try again.", "กรุณาเลือกไฟล์ภาพ JPEG, PNG, WebP, GIF หรือไฟล์ภาพที่ถูกต้องแล้วลองอีกครั้ง")"
                     data-image-ready="@T("Image loaded. Move the sampling marker with the arrow keys, then press Enter, or click the area you want to sample.", "โหลดภาพแล้ว ใช้ปุ่มลูกศรเลื่อนจุดเก็บตัวอย่างแล้วกด Enter หรือคลิกบริเวณที่ต้องการจิ้มสี")">
                <div class="finish-matcher-intro">
                    <div>
                        <h3 id="finish-color-matcher-title">@T("Choose a finish colour with confidence", "เลือกสีและผิวสำเร็จได้อย่างมั่นใจ")</h3>
                    </div>
                    <p class="finish-matcher-caveat"><i class="fas fa-circle-info" aria-hidden="true"></i>@T("Screen colours and the sheen preview guide the quotation; production colour is confirmed with a physical spray-out or reference.", "สีบนหน้าจอและภาพจำลองความเงาใช้ประกอบใบเสนอราคา ส่วนสีสำหรับผลิตจริงจะยืนยันด้วยแผ่นพ่นทดสอบหรือชิ้นอ้างอิง")</p>
                </div>

                <div class="finish-matcher-layout">
                    <div class="finish-matcher-controls">
                        <div class="finish-sheen-preview" data-sheen-preview data-sheen="satin" style="--finish-color: #A2474F;">
                            <div class="finish-sheen-stage" data-sheen-stage aria-hidden="true">
                                <canvas class="finish-sheen-canvas" data-sheen-canvas></canvas>
                                <span class="finish-sheen-fallback" data-color-preview></span>
                            </div>
                            <p class="finish-sheen-caption">
                                <strong data-preview-sheen>@T("Satin finish preview", "ภาพจำลองผิวซาติน")</strong>
                                <span>@T("Real-time physical clear-coat rendering shows relative reflections. Confirm production colour and gloss with a physical spray-out.", "การเรนเดอร์เคลือบใสแบบกายภาพแสดงการสะท้อนโดยเปรียบเทียบ กรุณายืนยันสีและความเงาสำหรับผลิตจริงด้วยแผ่นพ่นทดสอบ")</span>
                            </p>
                        </div>

                        <div class="finish-color-inputs">
                            <div class="finish-color-field">
                                <label for="finish-color-picker">@T("Choose a screen colour", "เลือกสีบนหน้าจอ")</label>
                                <input id="finish-color-picker" type="color" value="#A2474F" data-color-input />
                            </div>
                            <div class="finish-color-field finish-hex-field">
                                <label for="finish-color-hex">HEX</label>
                                <input id="finish-color-hex" type="text" value="#A2474F" inputmode="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" spellcheck="false" aria-describedby="finish-hex-help" data-hex-input />
                                <span id="finish-hex-help" class="finish-field-help">@T("Six digits, for example #A2474F", "ใช้ 6 หลัก เช่น #A2474F")</span>
                            </div>
                        </div>

                        <label class="finish-image-button" for="finish-image-input">
                            <i class="fas fa-image" aria-hidden="true"></i>
                            @T("Pick a colour from an image", "เลือกสีจากภาพ")
                        </label>
                        <input id="finish-image-input" class="visually-hidden" type="file" accept="image/*" data-image-input />
                        <p class="finish-inline-message" role="status" aria-live="polite" data-image-status hidden></p>

                        <div class="finish-image-panel" data-image-panel hidden>
                            <div class="finish-image-heading">
                                <strong data-image-name></strong>
                                <span id="finish-image-help">@T("Click an area, or use the arrow keys to move the marker and press Enter.", "คลิกบริเวณที่ต้องการ หรือใช้ปุ่มลูกศรเลื่อนจุดแล้วกด Enter")</span>
                            </div>
                            <div class="finish-image-sampling-area">
                                <canvas class="finish-image-canvas" tabindex="0" role="img" aria-describedby="finish-image-help" aria-label="@T("Uploaded image with a movable colour-sampling marker", "ภาพที่อัปโหลดพร้อมจุดเก็บตัวอย่างสีที่เลื่อนได้")" data-image-canvas></canvas>
                                <span class="finish-image-sample-cursor" data-image-cursor aria-hidden="true"></span>
                            </div>
                        </div>

                        <fieldset class="finish-sheen-options">
                            <legend>@T("Finish sheen", "ระดับความเงา")</legend>
                            <label><input type="radio" name="finish-sheen" value="matte" /> <span>@T("Matte", "ด้าน")</span></label>
                            <label><input type="radio" name="finish-sheen" value="satin" checked /> <span>@T("Satin", "ซาติน")</span></label>
                            <label><input type="radio" name="finish-sheen" value="gloss" /> <span>@T("Gloss", "เงา")</span></label>
                        </fieldset>
                    </div>

                    <div class="finish-matcher-results">
                        <div class="finish-results-heading">
                            <div>
                                <h4>@T("10 guided HLC references", "รหัส HLC แนะนำ 10 รายการ")</h4>
                            </div>
                            <span class="finish-tone-order"><span>@T("Lightest", "สว่างสุด")</span><i aria-hidden="true"></i><span>@T("Darkest", "เข้มสุด")</span></span>
                        </div>
                        <p id="finish-results-help" class="finish-results-help"><strong>@T("Lower ΔE00 means a closer screen-to-reference match.", "ค่า ΔE00 ยิ่งต่ำ สีบนหน้าจอยิ่งใกล้รหัสอ้างอิง")</strong> @T("Start with the recommended card, then compare its lighter and darker alternatives.", "เริ่มจากรายการแนะนำ แล้วเปรียบเทียบตัวเลือกที่สว่างและเข้มกว่าตามลำดับ")</p>
                        <p class="finish-results-navigation" data-closest-position></p>
                        <p class="visually-hidden" aria-live="polite" data-result-status></p>
                        <ol class="finish-match-list" aria-label="@T("Ten HLC references ordered from lightest to darkest", "รหัสอ้างอิง HLC 10 รายการ เรียงจากสว่างที่สุดไปเข้มที่สุด")" aria-describedby="finish-results-help" data-color-results></ol>
                    </div>
                </div>

                <div class="finish-selection">
                    <span class="finish-selection-swatch" data-selected-swatch aria-hidden="true"></span>
                    <div class="finish-selection-summary">
                        <span class="finish-selection-label">@T("Your finish brief", "สรุปรายละเอียดผิวของคุณ")</span>
                        <strong data-selected-code></strong>
                        <dl>
                            <div><dt>@T("Screen HEX", "HEX บนหน้าจอ")</dt><dd data-selected-hex></dd></div>
                            <div><dt>@T("Sheen", "ระดับความเงา")</dt><dd data-selected-sheen></dd></div>
                            <div><dt>@T("Match", "ความใกล้เคียง")</dt><dd data-selected-delta></dd></div>
                            <div><dt>Pantone</dt><dd data-selected-pantone></dd></div>
                        </dl>
                    </div>
                    <div class="finish-selection-action">
                        <p>@T("MALIEV confirms the production colour and gloss against the agreed physical reference and coating system.", "MALIEV จะยืนยันสีและความเงาสำหรับผลิตจริงกับชิ้นอ้างอิงและระบบสีที่ตกลงกัน")</p>
                        <a class="service-button service-button-primary" href="/quotation?item=3d-printing" data-base-url="/quotation" data-quote-link>@T("Use this finish in my quote", "ใช้รายละเอียดผิวนี้ในคำขอใบเสนอราคา") <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
                <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-selection-status></p>

                <div class="finish-support-details">
                    <details data-guidance-topic="color_science">
                        <summary>@T("What HLC, Lab, and ΔE00 mean", "HLC, Lab และ ΔE00 หมายถึงอะไร")</summary>
                        <div class="finish-definition-grid">
                            <div><strong>HLC</strong><p>@T("A readable colour address: hue family, measured lightness, and chroma or colour intensity.", "รหัสสีที่อ่านเป็นลำดับ ได้แก่ กลุ่มเฉดสี ค่าความสว่าง และความอิ่มหรือความเข้มของสี")</p></div>
                            <div><strong>Lab</strong><p>@T("Three measured coordinates: L* is light to dark, a* runs green to red, and b* runs blue to yellow. This tool calculates D50 Lab values.", "พิกัดสี 3 ค่า ได้แก่ L* จากสว่างไปเข้ม a* จากเขียวไปแดง และ b* จากน้ำเงินไปเหลือง เครื่องมือนี้คำนวณค่า Lab ภายใต้แสง D50")</p></div>
                            <div><strong>ΔE00</strong><p>@T("A perceptual colour-difference score. Lower is closer; zero means the same measured Lab colour. Screens, paint, texture, and lighting can still change what you see.", "คะแนนความต่างสีตามการรับรู้ ค่ายิ่งต่ำยิ่งใกล้กัน และศูนย์หมายถึงค่า Lab ที่วัดได้เท่ากัน แต่หน้าจอ สีจริง พื้นผิว และแสงยังทำให้มองเห็นต่างกันได้")</p></div>
                        </div>
                    </details>

                    <details data-guidance-topic="painting_plan">
                        <summary>@T("Painting plan for this selection", "แนวทางพ่นสีสำหรับตัวเลือกนี้")</summary>
                        <div class="finish-paint-plan">
                            <div><span>@T("Primer starting point", "แนวทางเริ่มต้นสำหรับสีรองพื้น")</span><strong class="finish-primer-guidance" data-primer-guidance></strong><p>@T("The substrate, filler, paint opacity, and selected coating system may require a different primer shade. Confirm it with a physical spray-out.", "วัสดุชิ้นงาน ฟิลเลอร์ ความทึบของสี และระบบสีที่เลือกอาจต้องใช้สีรองพื้นต่างออกไป กรุณายืนยันด้วยแผ่นพ่นทดสอบจริง")</p></div>
                            <div><span>@T("Mixing formula", "สูตรผสมสี")</span><strong>@T("Do not calculate a paint formula from a screen HEX value.", "ไม่ควรคำนวณสูตรผสมสีจากค่า HEX บนหน้าจอ")</strong><p>@T("Choose the supplier's paint system first, retrieve or develop its formula, then verify colour and coverage on a labelled spray-out card.", "ควรเลือกระบบสีของผู้ผลิตก่อน จากนั้นเรียกใช้หรือพัฒนาสูตรในระบบนั้น แล้วตรวจสอบสีและการกลบบนแผ่นพ่นทดสอบที่ระบุข้อมูลครบ")</p></div>
                            <div><span>@T("Clear-coat technique", "แนวทางพ่นเคลือบใส")</span><strong data-clear-guidance></strong><p>@T("Follow the chosen system's technical data sheet for compatible products, mixing, flash-off, film build, curing, and safety controls.", "ปฏิบัติตามเอกสารข้อมูลทางเทคนิคของระบบสีที่เลือกสำหรับผลิตภัณฑ์ที่เข้ากัน การผสม ระยะพัก ความหนาฟิล์ม การบ่ม และข้อควบคุมด้านความปลอดภัย")</p></div>
                        </div>
                    </details>

                    <details class="finish-pantone-handoff" data-guidance-topic="pantone_handoff">
                        <summary>@T("Already have a Pantone code?", "มีรหัส Pantone อยู่แล้วหรือไม่?")</summary>
                        <div class="finish-pantone-content">
                            <div>
