                        <tr data-material-row data-material-key="PVA" data-material-group="specialty"><th scope="row" data-label="@T("Material", "วัสดุ")"><strong>PVA</strong><small>Water-soluble Support</small></th><td data-label="@T("Process", "กระบวนการ")">@T("Support FDM", "ซัพพอร์ต FDM")</td><td data-label="@T("Best for", "เหมาะกับ")">@T("Internal channels, complex overhangs", "ช่องภายในและส่วนยื่นซับซ้อน")</td><td data-label="@T("Advantages", "ข้อดี")">@T("Dissolves in water", "ละลายน้ำได้")</td><td data-label="@T("Watch-outs", "ข้อควรทราบ")">@T("Support only; moisture sensitive", "ใช้เป็นซัพพอร์ต ไวต่อความชื้น")</td></tr>
                        <tr data-material-row data-material-key="M68" data-material-group="resin"><th scope="row" data-label="@T("Material", "วัสดุ")"><strong>@T("Standard Resin", "เรซินมาตรฐาน")</strong><small>M68</small></th><td data-label="@T("Process", "กระบวนการ")">SLA / DLP</td><td data-label="@T("Best for", "เหมาะกับ")">@T("Detailed visual models", "โมเดลรายละเอียดสูง")</td><td data-label="@T("Advantages", "ข้อดี")">@T("Smooth and precise detail", "ผิวเรียบ รายละเอียดแม่นยำ")</td><td data-label="@T("Watch-outs", "ข้อควรทราบ")">@T("Brittle; UV aging", "เปราะ เสื่อมจาก UV")</td></tr>
                        <tr data-material-row data-material-key="K" data-material-group="resin"><th scope="row" data-label="@T("Material", "วัสดุ")"><strong>@T("Tough Resin", "เรซินเหนียว")</strong><small>K</small></th><td data-label="@T("Process", "กระบวนการ")">SLA / DLP</td><td data-label="@T("Best for", "เหมาะกับ")">@T("Snap-fits, functional models", "สแนปฟิตและโมเดลใช้งาน")</td><td data-label="@T("Advantages", "ข้อดี")">@T("Improved impact and flex", "ทนกระแทกและงอมากขึ้น")</td><td data-label="@T("Watch-outs", "ข้อควรทราบ")">@T("Not equal to molded plastic", "ไม่เท่างานพลาสติกฉีด")</td></tr>
                        <tr data-material-row data-material-key="G217" data-material-group="resin"><th scope="row" data-label="@T("Material", "วัสดุ")"><strong>@T("Transparent Resin", "เรซินใส")</strong><small>G217</small></th><td data-label="@T("Process", "กระบวนการ")">SLA / DLP</td><td data-label="@T("Best for", "เหมาะกับ")">@T("Clear prototypes, light guides", "ต้นแบบใส ตัวนำแสง")</td><td data-label="@T("Advantages", "ข้อดี")">@T("Clear with fine detail", "โปร่งใส รายละเอียดดี")</td><td data-label="@T("Watch-outs", "ข้อควรทราบ")">@T("Finishing affects clarity", "ความใสขึ้นกับการเก็บผิว")</td></tr>
                        <tr data-material-row data-material-key="F80" data-material-group="resin"><th scope="row" data-label="@T("Material", "วัสดุ")"><strong>@T("Flexible Resin", "เรซินยืดหยุ่น")</strong><small>F80</small></th><td data-label="@T("Process", "กระบวนการ")">SLA / DLP</td><td data-label="@T("Best for", "เหมาะกับ")">@T("Soft seals and details", "ซีลและชิ้นส่วนนุ่ม")</td><td data-label="@T("Advantages", "ข้อดี")">@T("Soft, rubber-like response", "นุ่มและคล้ายยาง")</td><td data-label="@T("Watch-outs", "ข้อควรทราบ")">@T("Limited tear and aging life", "อายุฉีกขาดและเสื่อมจำกัด")</td></tr>
                        <tr data-material-row data-material-key="CASTWAX" data-material-group="resin"><th scope="row" data-label="@T("Material", "วัสดุ")"><strong>@T("Castable Wax Resin", "เรซินหล่อขี้ผึ้งหาย")</strong><small>CASTWAX</small></th><td data-label="@T("Process", "กระบวนการ")">SLA / DLP</td><td data-label="@T("Best for", "เหมาะกับ")">@T("Jewelry and casting patterns", "เครื่องประดับและต้นแบบหล่อ")</td><td data-label="@T("Advantages", "ข้อดี")">@T("Clean investment-casting burnout", "เผาออกสะอาดสำหรับงานหล่อ")</td><td data-label="@T("Watch-outs", "ข้อควรทราบ")">@T("Pattern only, not final part", "ใช้ทำต้นแบบ ไม่ใช่ชิ้นงานสุดท้าย")</td></tr>
                        <tr data-material-empty hidden><td colspan="5">@T("No materials match your search. Try another term or reset the filters.", "ไม่พบวัสดุที่ตรงกับการค้นหา ลองใช้คำอื่นหรือล้างตัวกรอง")</td></tr>
                    </tbody>
