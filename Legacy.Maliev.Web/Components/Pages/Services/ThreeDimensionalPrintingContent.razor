@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="service-page" data-migration-component="three-dimensional-printing-content" data-migration-route-owner="@RouteOwner">
    <ServiceBreadcrumb ServiceKey="3D Printing" />
    <section class="service-hero" aria-labelledby="printing-title">
        <img class="service-hero-media" src="/src/images/services/printing/printing-hero.webp" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" alt="@T("Professional FDM printer producing a blue engineering fixture", "เครื่องพิมพ์ FDM กำลังผลิตฟิกซ์เจอร์วิศวกรรมสีน้ำเงิน")" />
        <div class="service-container service-hero-copy">
            <p class="service-eyebrow">@T("FDM & Resin 3D Printing", "บริการพิมพ์ FDM และเรซิน")</p>
            <h1 id="printing-title">@T("Professional 3D Printing for Prototypes and Functional Parts", "รับพิมพ์ 3D และรับปริ้น 3D สำหรับต้นแบบและชิ้นงานใช้งานจริง")</h1>
            <p class="service-hero-lead">@T("Upload your 3D model, select a material, and receive an instant estimate. We produce visual models, fit-check prototypes, jigs, fixtures, enclosures, and functional parts with FDM and resin processes.", "MALIEV รับพิมพ์ 3D ด้วยระบบ FDM และเรซิน อัปโหลดโมเดล เลือกวัสดุ และรับราคาประเมินออนไลน์สำหรับโมเดล ต้นแบบทดสอบประกอบ จิ๊ก ฟิกซ์เจอร์ กล่องครอบ และชิ้นงานใช้งานจริง")</p>
            <ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Instant online estimate", "ประเมินราคาออนไลน์ทันที")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("No minimum quantity", "ไม่มีจำนวนขั้นต่ำ")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Engineering and specialty materials", "วัสดุวิศวกรรมและวัสดุเฉพาะทาง")</li></ul>
            <div class="service-actions"><a class="service-button service-button-primary" href="/InstantQuotation/3D-Printing">@T("Get Instant 3D Pricing", "ประเมินราคาพิมพ์ 3D ทันที") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="/Quotation?item=3D-Printing">@T("Request Engineering Review", "ขอให้วิศวกรประเมิน")</a></div>
        </div>
    </section>

    <section class="service-quick"><div class="service-container service-quick-grid">
        <article><i class="fas fa-upload" aria-hidden="true"></i><div><h2>@T("Upload", "อัปโหลด")</h2><p>@T("STL, STEP, OBJ, 3MF, and supported CAD files.", "รองรับ STL, STEP, OBJ, 3MF และไฟล์ CAD")</p></div></article>
        <article><i class="fas fa-layer-group" aria-hidden="true"></i><div><h2>@T("Processes", "กระบวนการ")</h2><p>@T("FDM for durable parts; resin for fine detail and smooth surfaces.", "FDM สำหรับชิ้นงานทนทาน เรซินสำหรับรายละเอียดและผิวเรียบ")</p></div></article>
        <article><i class="fas fa-palette" aria-hidden="true"></i><div><h2>@T("Materials", "วัสดุ")</h2><p>@T("General, engineering, carbon-fiber, ESD, FR, flexible, and resin options.", "วัสดุทั่วไป วิศวกรรม คาร์บอนไฟเบอร์ ESD หน่วงไฟ ยืดหยุ่น และเรซิน")</p></div></article>
        <article><i class="fas fa-calculator" aria-hidden="true"></i><div><h2>@T("Price factors", "ปัจจัยราคา")</h2><p>@T("Geometry, material, size, support, orientation, finish, and quantity.", "รูปทรง วัสดุ ขนาด ซัพพอร์ต ทิศทาง ผิว และจำนวน")</p></div></article>
    </div></section>

    <nav class="service-page-toc" aria-label="@T("On this page", "ในหน้านี้")" data-service-page-toc>
        <strong>@T("On this page", "ในหน้านี้")</strong>
        <a href="#printing-processes">@T("Process", "กระบวนการ")</a>
        <a href="#printing-finishing">@T("Finishing", "การเก็บผิว")</a>
        <a href="#printing-workflow">@T("Workflow", "ขั้นตอน")</a>
        <a href="#printing-split-assembly">@T("Large-part assembly", "การประกอบชิ้นงานใหญ่")</a>
        <a href="#printing-materials">@T("Materials", "วัสดุ")</a>
        <a href="#printing-file-guide">@T("File preparation", "เตรียมไฟล์")</a>
        <a href="#printing-guides">@T("Guides", "คู่มือ")</a>
        <a href="#printing-finish-brief">@T("Brief", "ข้อมูลที่ควรส่ง")</a>
        <a href="#printing-faq">@T("FAQ", "คำถามที่พบบ่อย")</a>
    </nav>

    <section id="printing-processes" class="service-section"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Choose the Process", "เลือกกระบวนการ")</p><h2>@T("When should you use FDM or resin printing?", "ควรเลือกพิมพ์ FDM หรือเรซินเมื่อใด?")</h2><p>@T("The best process depends on part purpose, detail, strength, surface finish, size, material behavior, and budget.", "กระบวนการที่เหมาะสมขึ้นกับการใช้งาน รายละเอียด ความแข็งแรง ผิว ขนาด พฤติกรรมวัสดุ และงบประมาณ")</p></header><div class="service-card-grid">
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-fdm-application.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("FDM-printed fixture being fitted in a workshop", "ฟิกซ์เจอร์ที่พิมพ์ด้วย FDM กำลังทดสอบประกอบในเวิร์กช็อป")" /><figcaption class="service-card-body"><h3>@T("FDM: functional and larger parts", "FDM: ชิ้นงานใช้งานจริงและขนาดใหญ่")</h3><p>@T("FDM builds thermoplastic parts layer by layer. It is a practical choice for fit checks, brackets, enclosures, jigs, fixtures, ducts, and low-volume functional components.", "FDM สร้างชิ้นงานเทอร์โมพลาสติกทีละชั้น เหมาะกับงานทดสอบประกอบ ขายึด กล่อง จิ๊ก ฟิกซ์เจอร์ ท่อลม และชิ้นงานใช้งานจริงจำนวนน้อย")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-resin-application.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Smooth resin prototype enclosure being fit around electronics", "ต้นแบบกล่องเรซินผิวเรียบกำลังทดสอบประกอบกับอุปกรณ์อิเล็กทรอนิกส์")" /><figcaption class="service-card-body"><h3>@T("Resin: detail and smooth surfaces", "เรซิน: รายละเอียดสูงและผิวเรียบ")</h3><p>@T("Resin processes cure liquid photopolymer for fine features and smooth presentation surfaces. They suit detailed models, small prototypes, clear parts, flexible details, and casting patterns.", "การพิมพ์เรซินทำให้โฟโตโพลิเมอร์แข็งตัวเพื่อรายละเอียดสูงและผิวเรียบ เหมาะกับโมเดล ต้นแบบขนาดเล็ก ชิ้นงานใส ชิ้นงานยืดหยุ่น และต้นแบบงานหล่อ")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-industrial-application.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Industrial additive bracket and duct installed on automation equipment", "ขายึดและท่อที่ผลิตด้วยกระบวนการเติมเนื้อวัสดุติดตั้งอยู่บนเครื่องจักรอัตโนมัติ")" /><figcaption class="service-card-body"><h3>@T("Industrial additive: complex parts in use", "งานพิมพ์อุตสาหกรรม: ชิ้นงานซับซ้อนที่ใช้งานจริง")</h3><p>@T("Industrial additive processes can make lightweight ducts, brackets, fixtures, and complex low-volume components. The real load, heat, chemicals, and safety requirements still need engineering review.", "กระบวนการเติมเนื้อวัสดุสำหรับงานอุตสาหกรรมช่วยผลิตท่อ น้ำหนักเบา ขายึด ฟิกซ์เจอร์ และชิ้นงานซับซ้อนจำนวนน้อย โดยต้องประเมินแรง ความร้อน สารเคมี และความปลอดภัยตามการใช้งานจริง")</p></figcaption></figure>
    </div></div></section>

    <section id="printing-finishing" class="service-section service-section-soft"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Surface Finishing & Color Approval", "การเก็บผิวและการยืนยันสี")</p><h2>@T("Define the finish before we paint", "กำหนดรายละเอียดผิวก่อนเริ่มพ่นสี")</h2><p>@T("A reference photo communicates the idea, but it does not define a measured color or sheen. Confirm the finish scope before production so the quotation, result, and acceptance criteria match.", "ภาพอ้างอิงช่วยสื่อแนวคิด แต่ไม่ได้กำหนดค่าสีหรือระดับความเงาที่วัดได้ ควรยืนยันขอบเขตงานเก็บผิวก่อนผลิต เพื่อให้ใบเสนอราคา ผลงาน และเกณฑ์ยอมรับตรงกัน")</p></header><div class="service-card-grid">
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-finish-color-approval.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Technician comparing a painted 3D-printed part with color swatches and a reference image", "ช่างกำลังเทียบสีชิ้นงานพิมพ์ 3 มิติกับแผ่นเทียบสีและภาพอ้างอิง")" /><figcaption class="service-card-body"><h3>@T("Color references need a standard", "กำหนดสีให้ชัดเจนด้วยรหัส Pantone หรือ RAL")</h3><p>@T("A photo or screen can shift with lighting, camera, and display settings. Provide a Pantone or RAL code, or a physical swatch, when an exact match matters. Otherwise we use the closest available color and record that limitation.", "ภาพถ่ายหรือหน้าจออาจแสดงสีต่างกันตามแสง กล้อง และการตั้งค่าหน้าจอ หากต้องการสีที่ตรง ควรแจ้งรหัส Pantone หรือ RAL หรือส่งชิ้นตัวอย่างจริง หากไม่มีข้อมูลดังกล่าว เราจะเลือกสีที่ใกล้เคียงที่สุดและแจ้งให้ทราบก่อนผลิต")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-finish-surface-prep.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Technician spray-priming a 3D-printed part before painting", "ช่างกำลังพ่นรองพื้นด้วยปืนสเปรย์บนชิ้นงานพิมพ์ 3 มิติก่อนพ่นสี")" /><figcaption class="service-card-body"><h3>@T("Surface preparation affects the result", "การเตรียมผิวมีผลต่อผลงาน")</h3><p>@T("Layer lines, support marks, seams, and print texture may need sanding, filler, heat welding, primer, or other preparation before paint. The selected level of preparation changes cost, lead time, and visible detail.", "รอยชั้น รอยซัพพอร์ต รอยต่อ และผิวจากการพิมพ์อาจต้องขัด ฟิลเลอร์ เชื่อมด้วยความร้อน ลงรองพื้น หรือเตรียมผิวแบบอื่นก่อนพ่นสี ระดับงานที่เลือกมีผลต่อราคา เวลา และรายละเอียดที่มองเห็น")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-finish-clear-coat.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Raw 3D print, matte clear coat, and standard gloss clear coat shown side by side", "เปรียบเทียบชิ้นงานพิมพ์ 3 มิติแบบดิบ เคลือบใสด้าน และเคลือบใสมาตรฐานแบบเงา")" /><figcaption class="service-card-body"><h3>@T("Raw print, matte, or standard gloss", "พ่นเคลือบใส: ระบุผิวด้านหรือผิวเงา")</h3><p>@T("The raw print shows the original layer texture; a matte clear coat diffuses reflections; standard clear coat is shiny and produces stronger reflections. Specify the required finish before painting begins. Changing the sheen later can require re-preparation and repainting, which is an additional change order.", "ก่อนเริ่มงานควรระบุว่าต้องการชิ้นงานดิบ พ่นสีอย่างเดียว หรือพ่นเคลือบใสเพิ่มเติม หากต้องการเคลือบใส ให้ระบุผิวด้านหรือผิวเงาให้ชัดเจน เพราะแต่ละแบบให้การสะท้อนแสงและสัมผัสต่างกัน หากมีการเปลี่ยนรายละเอียดหลังเริ่มงาน อาจต้องเตรียมผิวและพ่นใหม่ ซึ่งมีผลต่อราคาและระยะเวลา")</p></figcaption></figure>
    </div><div class="service-note"><strong>@T("Approval checkpoint", "ยืนยันก่อนผลิต")</strong> @T("Before we paint, confirm the color standard, sheen, visible surfaces, and acceptance reference. If a requirement changes after approval, we will re-quote the additional work before proceeding.", "ก่อนพ่นสีควรยืนยันมาตรฐานสี ระดับความเงา ผิวที่มองเห็น และข้อมูลอ้างอิงสำหรับตรวจรับ หากมีการเปลี่ยนหลังยืนยัน เราจะประเมินราคาแก้ไขเพิ่มเติมก่อนดำเนินการ")</div></div></section>

    <section id="printing-workflow" class="service-section service-section-soft"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("How It Works", "ขั้นตอนการสั่งผลิต")</p><h2>@T("From 3D model to delivered part", "จากโมเดล 3D สู่ชิ้นงาน")</h2></header><ol class="service-process">
        <li><h3>@T("Upload the model", "อัปโหลดโมเดล")</h3><p>@T("Use the Instant Quotation page to inspect the model, dimensions, bodies, and geometry warnings.", "ใช้หน้าประเมินราคาทันทีเพื่อตรวจโมเดล ขนาด จำนวนบอดี และคำเตือนรูปทรง")</p></li>
        <li><h3>@T("Select material and quantity", "เลือกวัสดุและจำนวน")</h3><p>@T("Choose by use case, environment, required behavior, color, and budget—not only appearance.", "เลือกจากการใช้งาน สภาพแวดล้อม คุณสมบัติ สี และงบประมาณ ไม่ใช่เพียงรูปลักษณ์")</p></li>
        <li><h3>@T("Review orientation and support", "ตรวจทิศทางและซัพพอร์ต")</h3><p>@T("Orientation changes strength, visible layers, support marks, accuracy, print time, and cost.", "ทิศทางมีผลต่อความแข็งแรง รอยชั้น รอยซัพพอร์ต ความแม่นยำ เวลา และราคา")</p></li>
        <li><h3>@T("Print, join, finish, and deliver", "พิมพ์ ประกอบ เก็บผิว และจัดส่ง")</h3><p>@T("Parts are printed, supports removed, split sections joined when required, and the approved finish checked before delivery.", "พิมพ์ชิ้นงาน ถอดซัพพอร์ต ต่อชิ้นส่วนเมื่อจำเป็น และตรวจผิวตามที่ยืนยันก่อนเตรียมจัดส่ง")</p></li>
    </ol></div></section>

    <section id="printing-split-assembly" class="service-section"><div class="service-container service-split"><div class="service-copy"><p class="service-eyebrow">@T("Large-part assembly", "การประกอบชิ้นงานขนาดใหญ่")</p><h2>@T("When a part is too large for one print", "เมื่อชิ้นงานใหญ่เกินพื้นที่พิมพ์")</h2><p>@T("We can divide a large model into smaller sections, then join and refinish it as one assembly. Before printing, we review split lines, alignment keys, fasteners, visible surfaces, final dimensions, and the loads around the joint.", "เราสามารถแบ่งโมเดลขนาดใหญ่ออกเป็นส่วนย่อย แล้วต่อและเก็บผิวให้เป็นชิ้นงานเดียว ก่อนพิมพ์เราจะทบทวนแนวแบ่ง จุดจัดแนว ตัวยึด ผิวที่มองเห็น ขนาดสุดท้าย และแรงบริเวณรอยต่อ")</p><p>@T("Depending on the material and use, joining may use adhesive, heat welding, epoxy, automotive putty, or wood filler. We can sand, prime, paint, and clear-coat the assembled part when that scope is included in the quote.", "ขึ้นกับวัสดุและการใช้งาน การต่ออาจใช้กาว เชื่อมด้วยความร้อน อีพ็อกซี ฟิลเลอร์รถยนต์ หรือฟิลเลอร์ไม้ และเราสามารถขัด ลงรองพื้น พ่นสี และเคลือบใสหลังประกอบได้เมื่อรวมขอบเขตนี้ไว้ในใบเสนอราคา")</p><div class="service-note">@T("Seams may remain visible, and the joining method affects strength, tolerance, price, and lead time. Tell us which surfaces must look seamless and how the finished part will be used.", "รอยต่ออาจยังมองเห็นได้ และวิธีต่อมีผลต่อความแข็งแรง ค่าคลาดเคลื่อน ราคา และระยะเวลา แจ้งผิวที่ต้องการให้เรียบต่อเนื่องและลักษณะการใช้งานของชิ้นงาน")</div></div><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-split-assembly.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Technician joining two large 3D-printed sections and spreading automotive body filler with a putty spreader", "ช่างกำลังต่อชิ้นงานพิมพ์ 3 มิติขนาดใหญ่สองส่วนและใช้เกรียงปาดฟิลเลอร์รถยนต์อุดรอยต่อ")" /><figcaption class="service-card-body"><h3>@T("Split, join, smooth, and finish", "แบ่ง ต่อ ขัด และเก็บผิว")</h3><p>@T("Assembly and surface finishing are quoted as a defined production step, not an assumption after printing.", "การประกอบและการเก็บผิวเป็นขั้นตอนผลิตที่ต้องระบุในใบเสนอราคา ไม่ใช่งานที่ถือว่ารวมโดยอัตโนมัติหลังพิมพ์")</p></figcaption></figure></div></section>

    <section id="printing-materials" class="service-section"><div class="service-container service-split reverse"><img class="service-split-image" src="/src/images/services/printing/printing-materials.webp" loading="lazy" width="1536" height="1024" alt="@T("Examples of FDM and resin 3D printed parts", "ตัวอย่างชิ้นงานพิมพ์ 3D แบบ FDM และเรซิน")" /><div class="service-copy"><p class="service-eyebrow">@T("Material Catalogue", "รายการวัสดุ")</p><h2>@T("Available 3D printing materials", "วัสดุพิมพ์ 3 มิติที่มีให้เลือก")</h2><p>@T("This guide follows the materials currently selectable in MALIEV Instant Quotation. Availability, color, manufacturer grade, and special performance requirements are confirmed with the order.", "รายการนี้อ้างอิงวัสดุที่เลือกได้ในหน้าประเมินราคา MALIEV ปัจจุบัน โดยยืนยันสต็อก สี เกรดผู้ผลิต และคุณสมบัติพิเศษพร้อมคำสั่งซื้อ")</p><div class="service-actions"><a class="service-button service-button-primary" href="#material-comparison">@T("Compare and Price Materials", "เปรียบเทียบวัสดุและราคา") <i class="fas fa-arrow-down" aria-hidden="true"></i></a></div></div></div></section>

