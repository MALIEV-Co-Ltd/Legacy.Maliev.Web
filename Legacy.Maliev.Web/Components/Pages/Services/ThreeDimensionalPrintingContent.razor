@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="service-page" data-migration-component="three-dimensional-printing-content" data-migration-route-owner="@RouteOwner">
    <ServiceBreadcrumb ServiceKey="3D Printing" />
    <ServicePageToc />
    <section class="service-hero" aria-labelledby="printing-title">
        <img class="service-hero-media" src="/src/images/services/printing/printing-hero.webp" srcset="/src/images/services/printing/printing-hero-640.webp 640w, /src/images/services/printing/printing-hero-768.webp 768w, /src/images/services/printing/printing-hero-960.webp 960w, /src/images/services/printing/printing-hero.webp 1672w" sizes="100vw" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" alt="@T("Professional FDM printer producing a blue engineering fixture", "เครื่องพิมพ์ FDM กำลังผลิตฟิกซ์เจอร์วิศวกรรมสีน้ำเงิน")" />
        <div class="service-container service-hero-copy">
            <p class="service-eyebrow">@T("FDM, Resin & Industrial Additive", "FDM เรซิ่น และงานพิมพ์อุตสาหกรรม")</p>
            <h1 id="printing-title">@T("3D Printing Service in Thailand for Prototypes and Production Parts", "รับปริ้น 3D และรับพิมพ์ 3 มิติ อัปโหลดไฟล์ประเมินราคา")</h1>
            <p class="service-hero-lead">@T("MALIEV provides 3D printing services across Thailand. Upload FDM or resin parts for an instant estimate, or request an engineering review for MJF, SLS, SLM, DMLS, and safety-critical parts so process, material, finishing, and inspection can be confirmed per project.", "MALIEV รับพิมพ์ 3D ด้วยระบบ FDM และเรซิ่น พร้อมประเมินราคาออนไลน์ สำหรับงาน MJF, SLS, SLM, DMLS หรือชิ้นงานที่มีข้อกำหนดสำคัญ ให้ส่งไฟล์เพื่อให้วิศวกรยืนยันกระบวนการ วัสดุ การเก็บผิว และการตรวจสอบเป็นรายโปรเจ็ค")</p>
            <ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Instant online estimate", "ประเมินราคาออนไลน์ทันที")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("No minimum quantity", "ไม่มีจำนวนขั้นต่ำ")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Engineering and specialty materials", "วัสดุวิศวกรรมและวัสดุเฉพาะทาง")</li></ul>
            <p class="service-hero-proof"><a class="service-hero-proof-link" href="#printing-part-proof"><i class="fas fa-images" aria-hidden="true"></i>@T("See actual MALIEV-produced parts", "ดูตัวอย่างชิ้นงานผลิตจริงจาก MALIEV")</a></p>
            <div class="service-actions"><a class="service-button service-button-primary" href="/InstantQuotation/3D-Printing">@T("Get Instant 3D Pricing", "ประเมินราคาพิมพ์ 3D ทันที") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="/Quotation?item=3D-Printing">@T("Request Engineering Review", "ขอให้วิศวกรประเมิน")</a></div>
            <p class="service-hero-followup"><a href="/Services/Custom-Manufacturing">@T("Not sure 3D printing is the right process? Start with a custom manufacturing review.", "ยังไม่แน่ใจว่าควรใช้ 3D Printing หรือไม่? เริ่มที่บริการรับผลิตชิ้นงานตามแบบเพื่อช่วยเลือกกระบวนการ")</a></p>
        </div>
    </section>

    <section class="service-quick"><div class="service-container service-quick-grid">
        <article><i class="fas fa-upload" aria-hidden="true"></i><div><h2>@T("Upload", "อัปโหลด")</h2><p>@T("STL, STEP, OBJ, 3MF, and supported CAD files.", "รองรับ STL, STEP, OBJ, 3MF และไฟล์ CAD")</p></div></article>
        <article><i class="fas fa-layer-group" aria-hidden="true"></i><div><h2>@T("Processes", "กระบวนการ")</h2><p>@T("FDM for durable parts; resin for fine detail and smooth surfaces.", "FDM สำหรับชิ้นงานทนทาน เรซินสำหรับรายละเอียดและผิวเรียบ")</p></div></article>
        <article><i class="fas fa-palette" aria-hidden="true"></i><div><h2>@T("Materials", "วัสดุ")</h2><p>@T("General, engineering, carbon-fiber, ESD, FR, flexible, and resin options.", "วัสดุทั่วไป วิศวกรรม คาร์บอนไฟเบอร์ ESD หน่วงไฟ ยืดหยุ่น และเรซิน")</p></div></article>
        <article><i class="fas fa-calculator" aria-hidden="true"></i><div><h2>@T("Price factors", "ปัจจัยราคา")</h2><p>@T("Geometry, material, size, support, orientation, finish, and quantity.", "รูปทรง วัสดุ ขนาด ซัพพอร์ต ทิศทาง ผิว และจำนวน")</p></div></article>
    </div></section>

    <nav class="service-page-toc" aria-label="@T("On this page", "ในหน้านี้")" data-service-page-toc>
        <strong>@T("On this page", "ในหน้านี้")</strong>
        <a href="#printing-processes">@T("Process", "กระบวนการ")</a>
        <a href="#printing-tolerances">@T("Tolerances", "ค่าความคลาดเคลื่อน")</a>
        <a href="#printing-workflow">@T("Workflow", "ขั้นตอน")</a>
        <a href="#printing-related">@T("Related processes", "กระบวนการที่เกี่ยวข้อง")</a>
        <a href="#printing-materials">@T("Materials", "วัสดุ")</a>
        <a href="#printing-file-guide">@T("File preparation", "เตรียมไฟล์")</a>
        <a href="#printing-guides">@T("Guides", "คู่มือ")</a>
        <a href="#printing-faq">@T("FAQ", "คำถามที่พบบ่อย")</a>
    </nav>

    <section id="printing-processes" class="service-section"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Choose the Process", "เลือกกระบวนการ")</p><h2>@T("When should you use FDM or resin printing?", "ควรเลือกพิมพ์ FDM หรือเรซินเมื่อใด?")</h2><p>@T("The best process depends on part purpose, detail, strength, surface finish, size, material behavior, and budget.", "กระบวนการที่เหมาะสมขึ้นกับการใช้งาน รายละเอียด ความแข็งแรง ผิว ขนาด พฤติกรรมวัสดุ และงบประมาณ")</p></header><div class="service-card-grid">
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-fdm-application.webp" srcset="/src/images/services/printing/printing-fdm-application-640.webp 640w, /src/images/services/printing/printing-fdm-application-960.webp 960w, /src/images/services/printing/printing-fdm-application.webp 1536w" sizes="(max-width: 767px) 100vw, 33vw" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("FDM-printed fixture being fitted in a workshop", "ฟิกซ์เจอร์ที่พิมพ์ด้วย FDM กำลังทดสอบประกอบในเวิร์กช็อป")" /><figcaption class="service-card-body"><h3>@T("FDM: functional and larger parts", "FDM: ชิ้นงานใช้งานจริงและขนาดใหญ่")</h3><p>@T("FDM builds thermoplastic parts layer by layer. It is a practical choice for fit checks, brackets, enclosures, jigs, fixtures, ducts, and low-volume functional components.", "FDM สร้างชิ้นงานเทอร์โมพลาสติกทีละชั้น เหมาะกับงานทดสอบประกอบ ขายึด กล่อง จิ๊ก ฟิกซ์เจอร์ ท่อลม และชิ้นงานใช้งานจริงจำนวนน้อย")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-resin-application.webp" srcset="/src/images/services/printing/printing-resin-application-640.webp 640w, /src/images/services/printing/printing-resin-application-960.webp 960w, /src/images/services/printing/printing-resin-application.webp 1536w" sizes="(max-width: 767px) 100vw, 33vw" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Smooth resin prototype enclosure being fit around electronics", "ต้นแบบกล่องเรซินผิวเรียบกำลังทดสอบประกอบกับอุปกรณ์อิเล็กทรอนิกส์")" /><figcaption class="service-card-body"><h3>@T("Resin: detail and smooth surfaces", "เรซิน: รายละเอียดสูงและผิวเรียบ")</h3><p>@T("Resin processes cure liquid photopolymer for fine features and smooth presentation surfaces. They suit detailed models, small prototypes, clear parts, flexible details, and casting patterns.", "การพิมพ์เรซินทำให้โฟโตโพลิเมอร์แข็งตัวเพื่อรายละเอียดสูงและผิวเรียบ เหมาะกับโมเดล ต้นแบบขนาดเล็ก ชิ้นงานใส ชิ้นงานยืดหยุ่น และต้นแบบงานหล่อ")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/printing/printing-industrial-application.webp" srcset="/src/images/services/printing/printing-industrial-application-640.webp 640w, /src/images/services/printing/printing-industrial-application-960.webp 960w, /src/images/services/printing/printing-industrial-application.webp 1536w" sizes="(max-width: 767px) 100vw, 33vw" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Industrial additive bracket and duct installed on automation equipment", "ขายึดและท่อที่ผลิตด้วยกระบวนการเติมเนื้อวัสดุติดตั้งอยู่บนเครื่องจักรอัตโนมัติ")" /><figcaption class="service-card-body"><h3>@T("Industrial additive: complex parts in use", "งานพิมพ์อุตสาหกรรม: ชิ้นงานซับซ้อนที่ใช้งานจริง")</h3><p>@T("Industrial additive processes can make lightweight ducts, brackets, fixtures, and complex low-volume components. The real load, heat, chemicals, and safety requirements still need engineering review.", "กระบวนการเติมเนื้อวัสดุสำหรับงานอุตสาหกรรมช่วยผลิตท่อ น้ำหนักเบา ขายึด ฟิกซ์เจอร์ และชิ้นงานซับซ้อนจำนวนน้อย โดยต้องประเมินแรง ความร้อน สารเคมี และความปลอดภัยตามการใช้งานจริง")</p></figcaption></figure>
    </div></div></section>

    <section id="printing-engineering-review" class="service-section service-section-soft"><div class="service-container"><div class="service-copy">
        <p class="service-eyebrow">@T("Industrial additive", "งานพิมพ์อุตสาหกรรม")</p>
        <h2>@T("Industrial & metal engineering review", "ประเมินงานพิมพ์อุตสาหกรรมและโลหะ")</h2>
        <p>@T("MJF and SLS polymer parts, plus SLM and DMLS metal parts, are reviewed manually rather than priced by the FDM/resin calculator. Send the CAD file, material or alloy, quantity, operating load, temperature, critical dimensions, finishing, and inspection needs so feasibility and lead time can be confirmed.", "งานพอลิเมอร์ MJF และ SLS รวมถึงงานโลหะ SLM และ DMLS ต้องให้วิศวกรประเมินแทนเครื่องคำนวณ FDM/เรซิ่น กรุณาส่งไฟล์ CAD วัสดุหรือเกรดโลหะ จำนวน แรงและอุณหภูมิใช้งาน มิติสำคัญ การเก็บผิว และการตรวจสอบที่ต้องการ เพื่อยืนยันความเป็นไปได้และระยะเวลา")</p>
        <div class="service-actions"><a class="service-button service-button-primary" href="/Quotation?item=3D-Printing">@T("Request Industrial & Metal Review", "ขอประเมินงานอุตสาหกรรมและโลหะ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="/InstantQuotation/3D-Printing">@T("Price FDM or Resin Instantly", "ประเมินราคา FDM หรือเรซิ่นทันที")</a></div>
    </div></div></section>

    <section id="printing-part-proof" class="service-section service-part-proof"><div class="service-container">
        <header class="service-heading"><p class="service-eyebrow">@T("Actual produced parts", "ตัวอย่างชิ้นงานที่ผลิตจริง")</p><h2>@T("Actual MALIEV-produced part examples", "ตัวอย่างชิ้นงานจริงจากการผลิตของ MALIEV")</h2><p>@T("Hover, focus, or tap each image to see its material and defining geometry. Every presentation is anchored to an owner-confirmed original production photo.", "เลื่อนเมาส์ โฟกัส หรือแตะภาพแต่ละภาพเพื่อดูวัสดุและลักษณะรูปทรงสำคัญ ภาพนำเสนอทุกภาพยึดโยงกับภาพถ่ายต้นฉบับจากการผลิตจริงที่เจ้าของยืนยันแล้ว")</p></header>
        <div class="service-part-bento">
            <figure class="service-part-bento-tile service-part-bento-tile--hero" tabindex="0" data-part-proof="source-derived" data-source-photo="DSC_3824.JPG"><img class="service-part-bento-media" src="/src/images/services/printing/part-bento-sls-pa11-impeller-wide.webp" srcset="/src/images/services/printing/part-bento-sls-pa11-impeller-wide-640.webp 640w, /src/images/services/printing/part-bento-sls-pa11-impeller-wide-1024.webp 1024w, /src/images/services/printing/part-bento-sls-pa11-impeller-wide.webp 1535w" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 50vw" width="1535" height="1025" loading="lazy" decoding="async" alt="@T("Actual white SLS PA11 impeller-like sample with complex internal geometry", "ตัวอย่างชิ้นงาน SLS PA11 สีขาวที่ผลิตจริง มีรูปทรงภายในซับซ้อน")" /><figcaption class="service-part-bento-overlay"><h3>SLS PA11</h3><p>@T("Complex internal geometry and powder-bed surface", "รูปทรงภายในซับซ้อนและพื้นผิวจากกระบวนการ powder bed")</p></figcaption></figure>
            <figure class="service-part-bento-tile service-part-bento-tile--petg" tabindex="0" data-part-proof="source-derived" data-source-photo="DSC_3391.JPG"><img class="service-part-bento-media" src="/src/images/services/printing/part-bento-petg-cat.webp" srcset="/src/images/services/printing/part-bento-petg-cat-640.webp 640w, /src/images/services/printing/part-bento-petg-cat-1024.webp 1024w, /src/images/services/printing/part-bento-petg-cat.webp 1122w" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 25vw" width="1122" height="1402" loading="lazy" decoding="async" alt="@T("Actual translucent PETG printed cat sample with faceted surfaces", "ตัวอย่างแมว PETG โปร่งแสงที่ผลิตจริง มีพื้นผิวเหลี่ยม")" /><figcaption class="service-part-bento-overlay"><h3>FDM · PETG</h3><p>@T("Faceted form and translucent surface", "รูปทรงเหลี่ยมและพื้นผิวโปร่งแสง")</p></figcaption></figure>
            <figure class="service-part-bento-tile service-part-bento-tile--mjf" tabindex="0" data-part-proof="source-derived" data-source-photo="DSC_3637.JPG"><img class="service-part-bento-media" src="/src/images/services/printing/part-bento-mjf-pa12-linkage.webp" srcset="/src/images/services/printing/part-bento-mjf-pa12-linkage-640.webp 640w, /src/images/services/printing/part-bento-mjf-pa12-linkage-1024.webp 1024w, /src/images/services/printing/part-bento-mjf-pa12-linkage.webp 1535w" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 34vw" width="1535" height="1024" loading="lazy" decoding="async" alt="@T("Actual dark MJF PA12 linkage-like sample with multiple mounting features", "ตัวอย่างชิ้นงานคล้ายลิงก์ MJF PA12 สีเข้มที่ผลิตจริง มีจุดยึดหลายตำแหน่ง")" /><figcaption class="service-part-bento-overlay"><h3>MJF · PA12</h3><p>@T("Long geometry with multiple mounting features", "รูปทรงยาวและจุดยึดหลายตำแหน่ง")</p></figcaption></figure>
            <figure class="service-part-bento-tile service-part-bento-tile--pacf" tabindex="0" data-part-proof="source-derived" data-source-photo="DSC_3775.JPG"><img class="service-part-bento-media" src="/src/images/services/printing/part-bento-pa-cf-wheel.webp" srcset="/src/images/services/printing/part-bento-pa-cf-wheel-640.webp 640w, /src/images/services/printing/part-bento-pa-cf-wheel-1024.webp 1024w, /src/images/services/printing/part-bento-pa-cf-wheel.webp 1254w" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 25vw" width="1254" height="1254" loading="lazy" decoding="async" alt="@T("Actual dark PA-CF wheel-like sample with spokes and central hub", "ตัวอย่างชิ้นงานคล้ายล้อ PA-CF สีเข้มที่ผลิตจริง มีซี่และดุมกลาง")" /><figcaption class="service-part-bento-overlay"><h3>FDM · PA-CF</h3><p>@T("Spokes, teeth, and central hub", "ซี่ ฟัน และดุมกลาง")</p></figcaption></figure>
