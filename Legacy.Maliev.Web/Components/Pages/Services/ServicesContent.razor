@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="maliev-page maliev-page-main services-index-page" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner" data-service-finder data-progress-question="@T("Question", "คำถาม")" data-progress-of="@T("of", "จาก")" data-finder-suggestion-label="@T("Suggested", "แนะนำ")" data-finder-optional-label="@T("Optional", "คำถามเพิ่มเติม")" data-finder-partial-results="@T("Starting points based on the answers so far.", "แนวทางเบื้องต้นจากคำตอบที่ให้ไว้ตอนนี้")" data-guidance-standard-plastic="@T("PLA, PETG, ABS, or ASA depending on the part and environment.", "PLA, PETG, ABS หรือ ASA ตามลักษณะชิ้นงานและสภาพแวดล้อม")" data-guidance-resin="@T("SLA or DLP resin for fine detail and presentation quality.", "เรซิ่น SLA หรือ DLP สำหรับรายละเอียดและงานที่เน้นรูปลักษณ์")" data-guidance-engineering-plastic="@T("Nylon, PC, PP, or another engineering plastic selected for the application.", "Nylon, PC, PP หรือพลาสติกวิศวกรรมที่เลือกตามการใช้งาน")" data-guidance-metal="@T("Aluminium, steel, or stainless steel when strength or heat resistance is critical.", "อะลูมิเนียม เหล็ก หรือสแตนเลสเมื่อเน้นความแข็งแรงหรือทนความร้อน")" data-guidance-silicone="@T("Silicone or an elastomer when flexibility and soft touch matter.", "ซิลิโคนหรืออีลาสโตเมอร์เมื่อเน้นความยืดหยุ่นและสัมผัสนุ่ม")" data-guidance-reason-strength="@T("Prioritizes strength and reliable functional use.", "เน้นความแข็งแรงและการใช้งานจริงที่เชื่อถือได้")" data-guidance-reason-appearance="@T("Prioritizes fine detail, surface quality, and presentation.", "เน้นรายละเอียด พื้นผิว และรูปลักษณ์สำหรับการนำเสนอ")" data-guidance-reason-flexibility="@T("Prioritizes flexibility, soft touch, or impact absorption.", "เน้นความยืดหยุ่น สัมผัสนุ่ม หรือการซับแรงกระแทก")" data-guidance-reason-temperature="@T("Prioritizes heat, chemical, or demanding operating conditions.", "เน้นการทนความร้อน สารเคมี หรือสภาพการใช้งานที่หนัก")" data-guidance-reason-environment="@T("A starting point for the stated environment; the final grade needs an application review.", "เป็นแนวทางเบื้องต้นสำหรับสภาพแวดล้อมที่ระบุ ควรยืนยันเกรดวัสดุหลังประเมินการใช้งาน")" data-guidance-reason-general="@T("A practical starting point while the final material is still open.", "เป็นแนวทางเริ่มต้นที่ใช้งานได้เมื่อยังไม่ได้กำหนดวัสดุสุดท้าย")" data-guidance-reason-weight="@T("Balances low mass with the required stiffness and function.", "พิจารณาน้ำหนักเบาควบคู่กับความแข็งและการใช้งานที่ต้องการ")" data-guidance-reason-wear="@T("Flags repeated contact and wear for the material and finish review.", "ชี้ให้ทบทวนการสัมผัสซ้ำและการสึกหรอในการเลือกวัสดุและผิวงาน")" data-guidance-reason-precision="@T("Keeps critical dimensions, fit, and inspection requirements visible.", "ให้ความสำคัญกับขนาดสำคัญ การประกอบ และข้อกำหนดการตรวจสอบ")" data-guidance-reason-corrosion="@T("Prioritizes corrosion exposure when comparing alloy and surface options.", "พิจารณาการกัดกร่อนเมื่อเปรียบเทียบเกรดโลหะและทางเลือกการเก็บผิว")" data-guidance-reason-finish="@T("Leaves room for the finishing route to be confirmed with the drawing.", "เผื่อการยืนยันวิธีเก็บผิวเพิ่มเติมจากแบบงาน")" data-guidance-reason-scan="@T("The final scan output determines the required processing after capture.", "ผลลัพธ์งานสแกนเป็นตัวกำหนดงานประมวลผลหลังการเก็บข้อมูล")" data-guidance-reason-print="@T("The print technology and post-processing should follow the intended use.", "เลือกเทคโนโลยีและการเก็บงานพิมพ์ตามการใช้งานจริง")" data-guidance-reason-molding="@T("The material family and mold route depend on the part requirements.", "กลุ่มวัสดุและแนวทางทำแม่พิมพ์ขึ้นอยู่กับความต้องการของชิ้นงาน")">

    <ServiceBreadcrumb ServiceKey="Services" />

    <header class="maliev-page-header">
        <div class="maliev-container">
            <p class="maliev-eyebrow">@T("Our services", "บริการของเรา")</p>
            <h1>@T("Manufacturing services", "บริการผลิตชิ้นส่วน")</h1>
            <p>@T("Choose a service to review capabilities, materials, workflows, pricing guidance, lead times, and frequently asked questions.", "เลือกบริการเพื่อดูความสามารถ วัสดุ ขั้นตอน ราคา ระยะเวลา และคำถามที่พบบ่อย")</p>
        </div>
    </header>

    <section class="service-finder" aria-labelledby="service-finder-title">
        <div class="maliev-container service-finder-shell">
            <div class="service-finder-intro">
                <div>
                    <p class="service-finder-kicker">@T("A faster way to choose", "ตัวช่วยเลือกบริการที่ง่ายขึ้น")</p>
                    <h2 id="service-finder-title">@T("Find the right manufacturing service for your project", "ค้นหาบริการผลิตที่เหมาะกับโปรเจ็คของคุณ")</h2>
                    <p>@T("Answer five quick questions, then add optional requirements if you want a more tailored service and material shortlist.", "ตอบคำถามสั้น ๆ 5 ข้อ แล้วเลือกตอบคำถามเพิ่มเติมได้หากต้องการคำแนะนำบริการและวัสดุที่ตรงยิ่งขึ้น")</p>
                    <ul class="service-finder-trust-list">
                        <li><i class="fas fa-clock" aria-hidden="true"></i>@T("Takes about 1–2 minutes", "ใช้เวลาประมาณ 1–2 นาที")</li>
                        <li><i class="fas fa-sliders-h" aria-hidden="true"></i>@T("You can change any answer", "แก้คำตอบได้ทุกข้อ")</li>
                        <li><i class="fas fa-user-shield" aria-hidden="true"></i>@T("No account required", "ไม่ต้องสมัครสมาชิก")</li>
                        <li><i class="fas fa-forward" aria-hidden="true"></i>@T("Skip ahead to results anytime", "ข้ามไปดูผลลัพธ์ได้ทุกเมื่อ")</li>
                    </ul>
                </div>
                <figure class="service-finder-image-wrap">
                    <img class="service-finder-image" src="/src/images/services/custom-manufacturing/custom-manufacturing-story.webp" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" alt="@T("A design sketch, CAD model, and finished machined part", "แบบร่าง แบบ CAD และชิ้นงานที่ผลิตเสร็จ")" />
                    <figcaption>@T("From the first idea to a part you can use.", "จากไอเดียแรกสู่ชิ้นงานที่พร้อมใช้งาน")</figcaption>
                </figure>
            </div>

            <div class="service-finder-panel">
                <div class="service-finder-progress-header">
                    <span class="service-finder-progress-label" data-finder-progress-label aria-live="polite"></span>
                    <span class="service-finder-progress-optional service-finder-optional-label" data-finder-progress-optional hidden>@T("Optional", "คำถามเพิ่มเติม")</span>
                    <span class="service-finder-progress-time"><i class="fas fa-bolt" aria-hidden="true"></i>@T("Quick guide", "ช่วยประเมินกระบวนการที่เกี่ยวข้องเบื้องต้น")</span>
                </div>
                <ol class="service-finder-progress" data-finder-progress role="progressbar" aria-valuemin="1" aria-valuemax="17" aria-valuenow="1" aria-label="@T("Question progress", "ความคืบหน้าของคำถาม")">
                    <li data-finder-progress-step="0" class="is-active"><span>1</span><span class="visually-hidden">@T("Files", "ไฟล์")</span></li>
                    <li data-finder-progress-step="1"><span>2</span><span class="visually-hidden">@T("Service", "บริการ")</span></li>
                    <li data-finder-progress-step="2"><span>3</span><span class="visually-hidden">@T("Material", "วัสดุ")</span></li>
                    <li data-finder-progress-step="3"><span>4</span><span class="visually-hidden">@T("Quantity", "จำนวน")</span></li>
                    <li data-finder-progress-step="4"><span>5</span><span class="visually-hidden">@T("End use", "การใช้งาน")</span></li>
                    <li data-finder-progress-step="5" data-finder-optional-progress hidden><span>6</span><span class="visually-hidden">@T("3D workflow", "ขั้นตอนงาน 3 มิติ")</span></li>
                    <li data-finder-progress-step="6" data-finder-optional-progress hidden><span>7</span><span class="visually-hidden">@T("CNC priorities", "ความต้องการงาน CNC")</span></li>
                    <li data-finder-progress-step="7" data-finder-optional-progress hidden><span>8</span><span class="visually-hidden">@T("CNC details", "รายละเอียดงาน CNC")</span></li>
                    <li data-finder-progress-step="8" data-finder-optional-progress hidden><span>9</span><span class="visually-hidden">@T("CNC environment", "สภาพแวดล้อมงาน CNC")</span></li>
                    <li data-finder-progress-step="9" data-finder-optional-progress hidden><span>10</span><span class="visually-hidden">@T("3D printing priorities", "ความต้องการงานพิมพ์ 3 มิติ")</span></li>
                    <li data-finder-progress-step="10" data-finder-optional-progress hidden><span>11</span><span class="visually-hidden">@T("3D printing finish", "การเก็บงานพิมพ์ 3 มิติ")</span></li>
                    <li data-finder-progress-step="11" data-finder-optional-progress hidden><span>12</span><span class="visually-hidden">@T("Scanning output", "ผลลัพธ์งานสแกน")</span></li>
                    <li data-finder-progress-step="12" data-finder-optional-progress hidden><span>13</span><span class="visually-hidden">@T("Scanning accuracy", "ความต้องการงานสแกน")</span></li>
                    <li data-finder-progress-step="13" data-finder-optional-progress hidden><span>14</span><span class="visually-hidden">@T("Molding priorities", "ความต้องการงานหล่อ")</span></li>
                    <li data-finder-progress-step="14" data-finder-optional-progress hidden><span>15</span><span class="visually-hidden">@T("Molding details", "รายละเอียดงานหล่อ")</span></li>
                    <li data-finder-progress-step="15" data-finder-optional-progress hidden><span>16</span><span class="visually-hidden">@T("General performance", "คุณสมบัติการใช้งาน")</span></li>
                    <li data-finder-progress-step="16" data-finder-optional-progress hidden><span>17</span><span class="visually-hidden">@T("Environment", "สภาพแวดล้อม")</span></li>
                </ol>

                <span class="visually-hidden" id="service-finder-suggestion-description" data-finder-suggestion-description>@T("Suggested based on your previous answers.", "แนะนำจากคำตอบก่อนหน้าของคุณ")</span>
                <div class="service-finder-steps">
                    <fieldset class="service-finder-step" data-finder-step="0" data-finder-key="files">
                        <legend>@T("Do you have 3D files or drawings available?", "คุณมีไฟล์ 3D หรือแบบงานแล้วหรือยัง?")</legend>
                        <p>@T("The available information changes the best starting point for your project.", "ข้อมูลที่มีช่วยให้เราเลือกจุดเริ่มต้นของโปรเจ็คได้แม่นยำขึ้น")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("Available project files", "ไฟล์โปรเจ็คที่มี")">
                            <button type="button" class="service-finder-option" data-finder-answer="files-3d" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-cube" aria-hidden="true"></i></span><span><strong>@T("3D CAD files", "มีไฟล์ CAD 3D")</strong><small>@T("STEP, STL, 3MF, or another usable model", "STEP, STL, 3MF หรือไฟล์โมเดลที่ใช้งานได้")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="files-2d" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-file-alt" aria-hidden="true"></i></span><span><strong>@T("2D drawings only", "มีแบบ 2D เท่านั้น")</strong><small>@T("PDF, DWG, sketches, or a dimensioned sample", "PDF, DWG แบบร่าง หรือตัวอย่างที่มีขนาด")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="files-image" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-image" aria-hidden="true"></i></span><span><strong>@T("Images or photos only", "มีเพียงรูปภาพหรือภาพถ่าย")</strong><small>@T("Turn a reference image into a manufacturable 3D model", "เปลี่ยนรูปอ้างอิงให้เป็นโมเดล 3 มิติพร้อมผลิต")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="files-none" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-lightbulb" aria-hidden="true"></i></span><span><strong>@T("No files yet", "ยังไม่มีไฟล์")</strong><small>@T("I need help with design, scanning, or reverse engineering", "ต้องการความช่วยเหลือด้านออกแบบ สแกน หรือ Reverse Engineering")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="files-real-part" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-wrench" aria-hidden="true"></i></span><span><strong>@T("Only have a real part", "มีชิ้นงานจริงเท่านั้น")</strong><small>@T("Send a sample for scanning or reverse engineering", "มีชิ้นงานตัวอย่างสำหรับสแกนหรือทำ Reverse Engineering")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step" data-finder-step="1" data-finder-key="service" hidden>
                        <legend>@T("Have you already chosen a service?", "คุณเลือกบริการไว้แล้วหรือยัง?")</legend>
                        <p>@T("Tell us the direction you are considering, or let the guide compare the options for you.", "บอกแนวทางที่กำลังพิจารณา หรือให้เราช่วยเปรียบเทียบตัวเลือกให้")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("Service direction", "แนวทางบริการ")">
                            <button type="button" class="service-finder-option" data-finder-answer="service-machining" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-cogs" aria-hidden="true"></i></span><span><strong>@T("CNC machining", "งาน CNC")</strong><small>@T("Milling, turning, metal, or engineering plastic parts", "งานกัด งานกลึง โลหะ หรือพลาสติกวิศวกรรม")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="service-3d" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-cubes" aria-hidden="true"></i></span><span><strong>@T("A 3D process", "กระบวนการ 3 มิติ")</strong><small>@T("Printing, scanning, or converting an idea into CAD", "พิมพ์ สแกน หรือเปลี่ยนไอเดียเป็น CAD")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="service-molding" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></span><span><strong>@T("Molding or casting", "งานแม่พิมพ์หรือหล่อ")</strong><small>@T("Silicone casting or low-volume plastic injection", "หล่อซิลิโคนหรือฉีดพลาสติกจำนวนน้อย")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="service-unsure" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-compass" aria-hidden="true"></i></span><span><strong>@T("I am not sure", "ยังไม่แน่ใจ")</strong><small>@T("Show me the most suitable starting points", "ช่วยแนะนำจุดเริ่มต้นที่เหมาะสม")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step" data-finder-step="2" data-finder-key="material" hidden>
                        <legend>@T("What is the material of your part?", "ชิ้นงานของคุณใช้วัสดุอะไร?")</legend>
                        <p>@T("Choose the primary material or select unsure if you need help deciding.", "เลือกวัสดุหลัก หรือเลือกยังไม่แน่ใจหากต้องการคำแนะนำ")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("Part material", "วัสดุชิ้นงาน")">
                            <button type="button" class="service-finder-option" data-finder-answer="material-metal" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-dumbbell" aria-hidden="true"></i></span><span><strong>@T("Metal", "โลหะ")</strong><small>@T("Aluminium, steel, stainless, or another metal", "อะลูมิเนียม เหล็ก สแตนเลส หรือโลหะอื่น")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="material-standard-plastic" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-cube" aria-hidden="true"></i></span><span><strong>@T("Standard prototyping plastic", "พลาสติกสำหรับทำต้นแบบ")</strong><small>@T("PLA, ABS, PETG, TPU, or similar FDM materials", "PLA, ABS, PETG, TPU หรือวัสดุ FDM ใกล้เคียง")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="material-resin" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-gem" aria-hidden="true"></i></span><span><strong>@T("Resin / appearance prototype", "เรซิ่นหรือชิ้นงานเน้นรูปลักษณ์")</strong><small>@T("SLA or DLP resin for fine detail and presentation parts", "เรซิ่น SLA หรือ DLP สำหรับรายละเอียดและชิ้นงานนำเสนอ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="material-plastic" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-cogs" aria-hidden="true"></i></span><span><strong>@T("Engineering plastic", "พลาสติกวิศวกรรม")</strong><small>@T("Nylon, PC, acrylic, PP, or another application-specific plastic", "ไนลอน PC อะคริลิก PP หรือพลาสติกเฉพาะงาน")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="material-silicone" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-hand-sparkles" aria-hidden="true"></i></span><span><strong>@T("Silicone or flexible rubber", "ซิลิโคนหรือยางยืดหยุ่น")</strong><small>@T("Flexible parts, soft-touch components, or elastomers", "ชิ้นงานยืดหยุ่น ชิ้นงานสัมผัสนุ่ม หรืออีลาสโตเมอร์")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="material-unsure" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span><span><strong>@T("Not sure yet", "ยังไม่แน่ใจ")</strong><small>@T("Recommend a material and process review", "แนะนำให้ประเมินวัสดุและกระบวนการ")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step" data-finder-step="3" data-finder-key="quantity" hidden>
                        <legend>@T("How many parts are you looking for?", "คุณต้องการชิ้นงานจำนวนเท่าไร?")</legend>
                        <p>@T("Quantity changes the most economical process and unit-cost profile.", "จำนวนมีผลต่อกระบวนการที่คุ้มค่าและต้นทุนต่อชิ้นมากที่สุด")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("Required quantity", "จำนวนที่ต้องการ")">
                            <button type="button" class="service-finder-option" data-finder-answer="quantity-1-10" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-vial" aria-hidden="true"></i></span><span><strong>1–10</strong><small>@T("Prototype, fit check, or small test batch", "ต้นแบบ ทดสอบประกอบ หรือชุดทดลองเล็ก")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="quantity-11-100" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-boxes" aria-hidden="true"></i></span><span><strong>11–100</strong><small>@T("Short run or early product validation", "งานจำนวนน้อยหรือทดสอบผลิตภัณฑ์ระยะแรก")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="quantity-101-1000" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></span><span><strong>101–1,000</strong><small>@T("Low-volume production and repeat parts", "ผลิตจำนวนน้อยและงานผลิตซ้ำ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="quantity-over-1000" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-industry" aria-hidden="true"></i></span><span><strong>@T("More than 1,000", "มากกว่า 1,000")</strong><small>@T("Compare production routes and machine ownership", "เปรียบเทียบกระบวนการผลิตและการซื้อเครื่องจักร")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step" data-finder-step="4" data-finder-key="end-use" hidden>
                        <legend>@T("What is the end use of your product?", "สินค้าของคุณนำไปใช้งานอะไร?")</legend>
                        <p>@T("The intended use helps us balance speed, strength, appearance, and production risk.", "การใช้งานช่วยให้เราเลือกสมดุลระหว่างความเร็ว ความแข็งแรง รูปลักษณ์ และความเสี่ยงในการผลิต")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("Product end use", "การใช้งานสินค้า")">
                            <button type="button" class="service-finder-option" data-finder-answer="use-prototype" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-flask" aria-hidden="true"></i></span><span><strong>@T("Prototype or fit check", "ต้นแบบหรือทดสอบประกอบ")</strong><small>@T("Validate form, fit, function, or a new idea", "ตรวจสอบรูปทรง การประกอบ การทำงาน หรือไอเดียใหม่")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="use-industrial" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-industry" aria-hidden="true"></i></span><span><strong>@T("Functional industrial part", "ชิ้นส่วนใช้งานจริงในอุตสาหกรรม")</strong><small>@T("A durable component used in equipment or a production line", "ชิ้นส่วนทนทานสำหรับเครื่องจักรหรือสายการผลิต")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="use-replacement" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-sync-alt" aria-hidden="true"></i></span><span><strong>@T("Replacement or reverse engineering", "อะไหล่หรือ Reverse Engineering")</strong><small>@T("Recreate a part from a sample, scan, or legacy drawing", "สร้างชิ้นงานจากตัวอย่าง ไฟล์สแกน หรือแบบเดิม")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="use-consumer" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-gem" aria-hidden="true"></i></span><span><strong>@T("Consumer product or presentation", "สินค้าอุปโภคหรือชิ้นงานนำเสนอ")</strong><small>@T("Appearance, touch, color, or customer demonstration matters", "ให้ความสำคัญกับรูปลักษณ์ สัมผัส สี หรือการนำเสนอ")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step service-finder-step-optional" data-finder-step="5" data-finder-key="workflow-3d" data-finder-optional hidden>
                        <legend>@T("Which 3D workflow do you need?", "คุณต้องการขั้นตอนงาน 3 มิติแบบใด?")</legend>
                        <p>@T("Printing, scanning, and CAD work produce different deliverables. Choose the closest outcome, or skip to compare them.", "งานพิมพ์ งานสแกน และงาน CAD ให้ผลลัพธ์ต่างกัน เลือกผลลัพธ์ที่ใกล้เคียงที่สุด หรือข้ามเพื่อเปรียบเทียบ")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("3D workflow", "ขั้นตอนงาน 3 มิติ")">
                            <button type="button" class="service-finder-option" data-finder-answer="workflow-3d-printing" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-print" aria-hidden="true"></i></span><span><strong>@T("3D printing", "พิมพ์ 3 มิติ")</strong><small>@T("Turn a CAD model into a physical prototype or part", "เปลี่ยนโมเดล CAD เป็นต้นแบบหรือชิ้นงานจริง")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="workflow-3d-scanning" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-camera" aria-hidden="true"></i></span><span><strong>@T("3D scanning", "สแกน 3 มิติ")</strong><small>@T("Capture a real part as scan data, mesh, or inspection input", "เก็บข้อมูลจากชิ้นงานจริงเป็นไฟล์สแกน เมช หรือข้อมูลตรวจสอบ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="workflow-3d-design" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-drafting-compass" aria-hidden="true"></i></span><span><strong>@T("3D design or reverse engineering", "ออกแบบ 3 มิติหรือ Reverse Engineering")</strong><small>@T("Create or modify CAD for a manufacturable result", "สร้างหรือแก้ไข CAD ให้พร้อมสำหรับการผลิต")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="workflow-3d-unsure" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span><span><strong>@T("I am not sure yet", "ยังไม่แน่ใจ")</strong><small>@T("Let us compare printing, scanning, and CAD outputs", "ให้เราช่วยเปรียบเทียบผลลัพธ์จากงานพิมพ์ สแกน และ CAD")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step service-finder-step-optional" data-finder-step="6" data-finder-key="cnc-priority" data-finder-optional hidden>
                        <legend>@T("What matters most for the CNC part?", "งาน CNC นี้ควรเน้นคุณสมบัติใดมากที่สุด?")</legend>
                        <p>@T("This helps us point you toward a practical material family. You can skip it if the material is already fixed.", "คำตอบนี้ช่วยชี้แนวทางกลุ่มวัสดุที่เหมาะสม หากกำหนดวัสดุไว้แล้วสามารถข้ามได้")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("CNC material priority", "คุณสมบัติวัสดุสำหรับงาน CNC")">
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-strength" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></span><span><strong>@T("Strength and load", "ความแข็งแรงและการรับแรง")</strong><small>@T("For structural loads, impact, or safety-critical use", "สำหรับรับแรง โดนกระแทก หรืองานที่ต้องการความปลอดภัย")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-weight" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-feather-alt" aria-hidden="true"></i></span><span><strong>@T("Low weight", "น้ำหนักเบา")</strong><small>@T("Reduce mass while retaining the required function", "ลดน้ำหนักโดยยังคงการทำงานที่ต้องการ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-wear" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-sync-alt" aria-hidden="true"></i></span><span><strong>@T("Wear and repeated contact", "การสึกหรอและการสัมผัสซ้ำ")</strong><small>@T("For sliding, rubbing, bearing, or repeated-use parts", "สำหรับการเสียดสี การเลื่อน บูช หรือการใช้งานซ้ำ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-precision" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-bullseye" aria-hidden="true"></i></span><span><strong>@T("Tight tolerance and fit", "ค่าความคลาดเคลื่อนและการประกอบที่แม่นยำ")</strong><small>@T("For mating parts, critical dimensions, or inspection requirements", "สำหรับชิ้นส่วนประกบ ขนาดสำคัญ หรือข้อกำหนดการตรวจสอบ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-corrosion" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-tint-slash" aria-hidden="true"></i></span><span><strong>@T("Rust and corrosion resistance", "การป้องกันสนิมและการกัดกร่อน")</strong><small>@T("For moisture, outdoor, salt, or long-term exposure", "สำหรับความชื้น ภายนอกอาคาร ไอเกลือ หรือการใช้งานระยะยาว")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-chemical" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-flask" aria-hidden="true"></i></span><span><strong>@T("Heat and chemical resistance", "การทนความร้อนและสารเคมี")</strong><small>@T("For elevated temperature, oils, solvents, or process chemicals", "สำหรับอุณหภูมิสูง น้ำมัน ตัวทำละลาย หรือสารเคมีในกระบวนการ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-appearance" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-star" aria-hidden="true"></i></span><span><strong>@T("Appearance and surface quality", "รูปลักษณ์และคุณภาพพื้นผิว")</strong><small>@T("For visible parts, presentation, or a specific surface feel", "สำหรับชิ้นงานที่มองเห็น งานนำเสนอ หรือสัมผัสพื้นผิวเฉพาะ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-priority-unsure" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span><span><strong>@T("I am not sure yet", "ยังไม่แน่ใจ")</strong><small>@T("Let the engineer balance strength, weight, cost, and availability", "ให้วิศวกรช่วยพิจารณาความแข็งแรง น้ำหนัก ราคา และวัสดุที่หาได้")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step service-finder-step-optional" data-finder-step="7" data-finder-key="cnc-detail" data-finder-optional hidden>
                        <legend>@T("Does the CNC part need a special detail or finish?", "งาน CNC ต้องการรายละเอียดหรือการเก็บผิวพิเศษหรือไม่?")</legend>
                        <p>@T("Mentioning the most important downstream requirement helps us review tooling, tolerances, and finishing together.", "การระบุความต้องการหลังการผลิตช่วยให้เราประเมินเครื่องมือ ค่าความคลาดเคลื่อน และการเก็บผิวได้ครบถ้วน")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("CNC details and finishing", "รายละเอียดและการเก็บผิวงาน CNC")">
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-detail-finish" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-magic" aria-hidden="true"></i></span><span><strong>@T("Additional surface finishing", "ต้องการการเก็บผิวเพิ่มเติม")</strong><small>@T("Anodising, plating, powder coating, polishing, or another finish", "อโนไดซ์ ชุบสี พ่นสีฝุ่น ขัดเงา หรือการเก็บผิวอื่น")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-detail-threads" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-link" aria-hidden="true"></i></span><span><strong>@T("Threads, holes, or mating features", "เกลียว รู หรือจุดประกอบเข้าคู่")</strong><small>@T("Features that need a tool, gauge, or assembly review", "รายละเอียดที่ต้องตรวจสอบเครื่องมือ เกจ หรือการประกอบ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-detail-inspection" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-ruler-combined" aria-hidden="true"></i></span><span><strong>@T("Documented inspection", "ต้องการเอกสารผลตรวจสอบ")</strong><small>@T("Critical dimensions, inspection points, or a measurement report", "ขนาดสำคัญ จุดตรวจ หรือรายงานผลการวัด")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-detail-thin" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-compress-arrows-alt" aria-hidden="true"></i></span><span><strong>@T("Thin walls or difficult geometry", "ผนังบางหรือรูปทรงที่ผลิตยาก")</strong><small>@T("Features that need manufacturability and fixturing review", "รายละเอียดที่ต้องทบทวนความสามารถในการผลิตและการจับยึด")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-detail-none" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-check" aria-hidden="true"></i></span><span><strong>@T("No special requirement", "ไม่มีความต้องการพิเศษ")</strong><small>@T("Standard machining review is enough for now", "ประเมินงาน CNC มาตรฐานก็เพียงพอในตอนนี้")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-detail-unsure" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span><span><strong>@T("I am not sure yet", "ยังไม่แน่ใจ")</strong><small>@T("We can identify the important details from your drawing", "เราช่วยระบุรายละเอียดสำคัญจากแบบงานได้")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step service-finder-step-optional" data-finder-step="8" data-finder-key="cnc-environment" data-finder-optional hidden>
                        <legend>@T("What will the CNC part face?", "ชิ้นงาน CNC จะพบสภาพแวดล้อมแบบใด?")</legend>
                        <p>@T("Rust, chemical, heat, and cleaning requirements can change the suitable alloy and finishing route. You can skip this.", "สนิม สารเคมี ความร้อน และการล้างทำความสะอาดอาจเปลี่ยนเกรดโลหะและวิธีเก็บผิวที่เหมาะสม คุณสามารถข้ามได้")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("CNC operating environment", "สภาพแวดล้อมการใช้งานงาน CNC")">
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-environment-controlled" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-home" aria-hidden="true"></i></span><span><strong>@T("Indoor and controlled", "ภายในอาคารและควบคุมได้")</strong><small>@T("Typical room-temperature workshop or equipment use", "ใช้งานทั่วไปในอาคารหรืออุปกรณ์ที่ควบคุมได้")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-environment-outdoor" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-sun" aria-hidden="true"></i></span><span><strong>@T("Outdoor, moisture, or salt", "ภายนอกอาคาร ความชื้น หรือไอเกลือ")</strong><small>@T("Weather, washdown, humidity, or coastal exposure", "สภาพอากาศ การล้าง ความชื้น หรือสภาพใกล้ทะเล")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-environment-chemical" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-flask" aria-hidden="true"></i></span><span><strong>@T("Heat, oil, or chemicals", "ความร้อน น้ำมัน หรือสารเคมี")</strong><small>@T("Process fluids, solvents, cleaning agents, or elevated temperature", "ของเหลวในกระบวนการ ตัวทำละลาย น้ำยาล้าง หรืออุณหภูมิสูง")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-environment-clean" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-sparkles" aria-hidden="true"></i></span><span><strong>@T("Clean or regulated application", "งานสะอาดหรืองานที่มีข้อกำกับ")</strong><small>@T("A cleanability, traceability, or documented material route matters", "ให้ความสำคัญกับการทำความสะอาด การตรวจสอบย้อนกลับ หรือเอกสารวัสดุ")</small></span></button>
                            <button type="button" class="service-finder-option" data-finder-answer="cnc-environment-unsure" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span><span><strong>@T("I am not sure yet", "ยังไม่แน่ใจ")</strong><small>@T("We can confirm the operating conditions during review", "ยืนยันสภาพแวดล้อมการใช้งานได้ในขั้นตอนประเมินงาน")</small></span></button>
                        </div>
                    </fieldset>

                    <fieldset class="service-finder-step service-finder-step-optional" data-finder-step="9" data-finder-key="printing-priority" data-finder-optional hidden>
                        <legend>@T("What should the 3D-printed part prioritize?", "ชิ้นงานพิมพ์ 3 มิติควรเน้นคุณสมบัติใด?")</legend>
                        <p>@T("The priority helps us compare print technologies, layer direction, and material families. You can skip it.", "คุณสมบัติที่เน้นช่วยเปรียบเทียบเทคโนโลยี ทิศทางชั้นพิมพ์ และกลุ่มวัสดุ คุณสามารถข้ามได้")</p>
                        <div class="service-finder-options" role="radiogroup" aria-label="@T("3D printing priority", "คุณสมบัติงานพิมพ์ 3 มิติ")">
