                            <button type="button" class="service-finder-option" data-finder-answer="printing-priority-detail" aria-pressed="false"><span class="service-finder-option-icon"><i class="fas fa-star" aria-hidden="true"></i></span><span><strong>@T("Fine detail and appearance", "รายละเอียดและรูปลักษณ์")</strong><small>@T("For small features, presentation, or smooth surfaces", "สำหรับรายละเอียดเล็ก งานนำเสนอ หรือพื้นผิวเรียบ")</small></span></button>
