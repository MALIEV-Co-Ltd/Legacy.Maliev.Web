@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="service-page injection-molding-page" data-migration-component="low-volume-injection-molding-content" data-migration-route-owner="@RouteOwner">
    <nav class="service-breadcrumb" aria-label="@T("Breadcrumb", "เส้นทางนำทาง")"><ol><li><a href="/">@T("Home", "หน้าแรก")</a></li><li><a href="/services">@T("Services", "บริการ")</a></li><li aria-current="page">@T("Low-volume injection molding", "ฉีดพลาสติกจำนวนน้อย")</li></ol></nav>
    <section class="service-hero injection-hero" aria-labelledby="injection-title">
        <img class="service-hero-media injection-hero-media" src="/src/images/services/injection-molding/injection-service-hero-wide.png" width="2172" height="724" loading="eager" fetchpriority="high" decoding="async" alt="@T("PIMM low-volume injection molding machine in the MALIEV workshop", "เครื่องฉีดพลาสติก PIMM สำหรับผลิตจำนวนน้อยในพื้นที่ทำงานของ MALIEV")" />
        <div class="service-container service-hero-copy injection-hero-copy"><p class="service-eyebrow">@T("PIMM low-volume production", "ผลิตจำนวนน้อยด้วยเครื่อง PIMM")</p><h1 id="injection-title">@T("Low-Volume Injection Molding for Up to 1,000 Parts", "รับฉีดพลาสติกจำนวนน้อยไม่เกิน 1,000 ชิ้น")</h1><p class="service-hero-lead">@T("A practical route for pilot runs, fit checks, and repeat batches when you need real molded parts without buying a machine yet. Send the part, mold, material, quantity, and intended use for review.", "ทางเลือกสำหรับงานทดลอง ทดสอบประกอบ และงานผลิตซ้ำที่ต้องการชิ้นงานฉีดจริงโดยยังไม่ต้องซื้อเครื่อง ส่งข้อมูลชิ้นงาน แม่พิมพ์ วัสดุ จำนวน และการใช้งานเพื่อประเมิน")</p><ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Up to 1,000 parts", "ไม่เกิน 1,000 ชิ้น")</li><li><i class="fas fa-weight-hanging" aria-hidden="true"></i>@T("Shot weights up to 50 g", "น้ำหนักฉีดสูงสุด 50 กรัม")</li><li><i class="fas fa-temperature-high" aria-hidden="true"></i>@T("Plastics melting at no more than 350 °C", "พลาสติกหลอมไม่เกิน 350 °C")</li></ul><div class="service-actions"><a class="service-button service-button-primary" href="/Quotation?item=low-volume-injection-molding">@T("Request an injection review", "ขอประเมินงานฉีดพลาสติก") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="https://shop.maliev.com" target="_blank" rel="noopener">@T("Explore the PIMM machine", "ดูเครื่อง PIMM สำหรับซื้อ")</a></div></div>
    </section>
    <section class="service-quick" aria-label="@T("Injection molding service boundaries", "ขอบเขตบริการฉีดพลาสติก")"><div class="service-container service-quick-grid injection-quick-grid"><article><i class="fas fa-layer-group" aria-hidden="true"></i><div><h2>@T("Quantity", "จำนวน")</h2><p><strong>@T("1–1,000 parts", "1–1,000 ชิ้น")</strong> @T("for low-volume production review.", "สำหรับการประเมินงานผลิตจำนวนน้อย")</p></div></article><article><i class="fas fa-weight-hanging" aria-hidden="true"></i><div><h2>@T("Shot weight", "น้ำหนักฉีด")</h2><p>@T("Up to 50 g per shot, subject to part and mold review.", "สูงสุด 50 กรัมต่อการฉีด โดยต้องตรวจสอบชิ้นงานและแม่พิมพ์")</p></div></article><article><i class="fas fa-temperature-high" aria-hidden="true"></i><div><h2>@T("Material heat", "อุณหภูมิวัสดุ")</h2><p>@T("Plastics melting at no more than 350 °C.", "พลาสติกที่มีอุณหภูมิหลอมไม่เกิน 350 °C")</p></div></article><article><i class="fas fa-shopping-cart" aria-hidden="true"></i><div><h2>@T("Over 1,000", "มากกว่า 1,000")</h2><p><a href="https://shop.maliev.com" target="_blank" rel="noopener">@T("Consider buying a PIMM machine.", "แนะนำพิจารณาซื้อเครื่อง PIMM")</a></p></div></article></div></section>
    <nav class="service-page-toc" aria-label="@T("On this page", "ในหน้านี้")" data-service-page-toc><strong>@T("On this page", "ในหน้านี้")</strong><a href="#injection-cost-benefits">@T("Low-volume advantage", "ข้อได้เปรียบ")</a><a href="#injection-fit">@T("Choose the route", "เลือกเส้นทาง")</a><a href="#injection-materials">@T("Materials", "วัสดุ")</a><a href="#injection-assets-title">@T("Machine and mold", "เครื่องและแม่พิมพ์")</a><a href="#injection-workflow">@T("Workflow", "ขั้นตอน")</a><a href="#injection-volume-title">@T("Quantity", "จำนวน")</a><a href="#injection-faq">@T("FAQ", "คำถามที่พบบ่อย")</a></nav>
    <section id="injection-cost-benefits" class="service-section service-section-soft" aria-labelledby="injection-cost-benefits-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("The low-volume advantage", "ข้อได้เปรียบของงานจำนวนน้อย")</p><h2 id="injection-cost-benefits-title">@T("Lower tooling cost while you validate the part", "ลดต้นทุนแม่พิมพ์ระหว่างทดสอบและยืนยันชิ้นงาน")</h2><p>@T("Our pneumatic PIMM route is designed to make short runs practical. You can validate fit and function without committing to a full industrial setup first.", "เส้นทางเครื่อง PIMM ระบบลมของเราช่วยให้งานจำนวนน้อยทำได้จริง คุณทดสอบการประกอบและการใช้งานได้โดยยังไม่ต้องลงทุนชุดอุตสาหกรรมเต็มรูปแบบ")</p></header><div class="service-card-grid injection-benefit-grid"><article class="service-card"><h3>@T("A lower mold entry point", "เริ่มต้นด้วยต้นทุนแม่พิมพ์ที่ต่ำกว่า")</h3><p>@T("A simple mold may start from about 2,500 Baht, compared with roughly 100,000 Baht for an industrial injection-molding machine setup. That difference can make pilot production much easier to justify.", "แม่พิมพ์แบบง่ายอาจเริ่มต้นประมาณ 2,500 บาท เทียบกับการลงทุนชุดเครื่องฉีดพลาสติกอุตสาหกรรมราว 100,000 บาท ส่วนต่างนี้ช่วยให้งานทดลองผลิตมีความคุ้มค่ามากขึ้น")</p></article><article class="service-card"><h3>@T("No machine purchase for a pilot run", "ไม่ต้องซื้อเครื่องสำหรับงานทดลอง")</h3><p>@T("Use our machine for a defined batch up to 1,000 parts, then decide whether owning a PIMM machine makes sense for larger or recurring demand.", "ใช้เครื่องของเราสำหรับจำนวนที่กำหนดไม่เกิน 1,000 ชิ้น แล้วค่อยตัดสินใจว่าการซื้อเครื่อง PIMM เหมาะกับงานจำนวนมากหรืองานที่ทำซ้ำหรือไม่")</p></article><article class="service-card"><h3>@T("Price follows the lot size", "ราคาต่อชิ้นสัมพันธ์กับจำนวนสั่งผลิต")</h3><p>@T("A five-part order carries more setup and mold cost per part than a 1,000-part order. We quote the quantity you actually need and explain the trade-off before production.", "งาน 5 ชิ้นมีต้นทุนเตรียมงานและแม่พิมพ์ต่อชิ้นสูงกว่างาน 1,000 ชิ้น เราเสนอราคาตามจำนวนที่ต้องการจริงและอธิบายทางเลือกก่อนผลิต")</p></article></div><p class="service-note" role="note">@T("The 2,500 and 100,000 Baht figures are planning examples, not a guaranteed quote. Final cost depends on part geometry, mold design, material, finish, quantity, and inspection requirements.", "ตัวเลข 2,500 และ 100,000 บาทเป็นตัวอย่างสำหรับวางแผน ไม่ใช่ราคายืนยัน ต้นทุนจริงขึ้นกับรูปทรงชิ้นงาน การออกแบบแม่พิมพ์ วัสดุ ผิวงาน จำนวน และข้อกำหนดการตรวจสอบ")</p></div></section>
    <section id="injection-fit" class="service-section"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Choose the right route", "เลือกเส้นทางให้เหมาะกับงาน")</p><h2>@T("When does low-volume injection molding make sense?", "เมื่อใดควรเลือกฉีดพลาสติกจำนวนน้อย?")</h2><p>@T("This service is for a defined, reviewable batch. We confirm the mold, material, part geometry, and quantity before promising a production scope.", "บริการนี้เหมาะกับงานที่กำหนดขอบเขตและจำนวนได้ชัดเจน โดยจะตรวจสอบแม่พิมพ์ วัสดุ รูปทรง และจำนวนก่อนยืนยันขอบเขตการผลิต")</p></header><div class="service-card-grid injection-card-grid"><article class="service-card"><i class="fas fa-vial" aria-hidden="true"></i><h3>@T("Pilot and repeat batches", "งานทดลองและงานผลิตซ้ำ")</h3><p>@T("Validate fit, function, material behavior, or an early customer sample with a run up to 1,000 parts.", "ทดสอบการประกอบ การทำงาน พฤติกรรมวัสดุ หรือตัวอย่างลูกค้ารุ่นแรกด้วยจำนวนไม่เกิน 1,000 ชิ้น")</p></article><article class="service-card"><i class="fas fa-cubes" aria-hidden="true"></i><h3>@T("Mold-led review", "ประเมินโดยดูจากแม่พิมพ์")</h3><p>@T("Share the mold design, photos, or existing tool details. Mold condition and part geometry affect whether the machine can run the job safely.", "ส่งแบบแม่พิมพ์ รูปถ่าย หรือรายละเอียดแม่พิมพ์เดิม สภาพแม่พิมพ์และรูปทรงชิ้นงานมีผลต่อความเหมาะสมและความปลอดภัยในการผลิต")</p></article><article class="service-card"><i class="fas fa-chart-line" aria-hidden="true"></i><h3>@T("Scale beyond the service", "เมื่อจำนวนเกินขอบเขต")</h3><p>@T("More than 1,000 parts may justify owning the equipment. Compare the PIMM machine and purchasing path at shop.maliev.com.", "หากมากกว่า 1,000 ชิ้น อาจเหมาะกับการมีเครื่องเป็นของตนเอง ดูรายละเอียดเครื่อง PIMM และช่องทางซื้อที่ shop.maliev.com")</p></article></div></div></section>
    <section id="injection-workflow" class="service-section" aria-labelledby="injection-workflow-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Review workflow", "ขั้นตอนการประเมิน")</p><h2 id="injection-workflow-title">@T("From project evidence to a clear batch decision", "จากข้อมูลโปรเจ็คสู่การตัดสินใจเรื่องจำนวนผลิต")</h2></header><ol class="service-process"><li><h3>@T("Send the evidence", "ส่งข้อมูลที่มี")</h3><p>@T("Share CAD or drawings, mold information, material, quantity, and intended use.", "ส่ง CAD หรือแบบ ข้อมูลแม่พิมพ์ วัสดุ จำนวน และการใช้งาน")</p></li><li><h3>@T("Check fit and limits", "ตรวจสอบความเหมาะสมและขอบเขต")</h3><p>@T("We review the geometry, mold, shot weight, melt temperature, and handling requirements.", "ตรวจสอบรูปทรง แม่พิมพ์ น้ำหนักฉีด อุณหภูมิหลอม และข้อกำหนดการจัดการ")</p></li><li><h3>@T("Confirm the quotation", "ยืนยันใบเสนอราคา")</h3><p>@T("The agreed quantity, material, finish, inspection, and delivery expectations are written into the review.", "ระบุจำนวน วัสดุ ผิวงาน การตรวจสอบ และความคาดหวังเรื่องส่งมอบที่ตกลงกันไว้")</p></li><li><h3>@T("Produce the batch", "ผลิตตามจำนวนที่ตกลง")</h3><p>@T("We make and check the agreed low-volume batch, or redirect larger demand to the machine-purchase path.", "ผลิตและตรวจสอบงานจำนวนน้อยตามที่ตกลง หรือแนะนำช่องทางซื้อเครื่องเมื่อจำนวนมากเกินขอบเขต")</p></li></ol></div></section>
    <section id="injection-materials" class="service-section service-section-soft" aria-labelledby="injection-material-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Materials and quote drivers", "วัสดุและปัจจัยที่ใช้เสนอราคา")</p><h2 id="injection-material-title">@T("Choose a material and quantity we can review with confidence", "เลือกวัสดุและจำนวนที่เราประเมินได้อย่างมั่นใจ")</h2><p>@T("Material behavior, mold readiness, and lot size all affect the safe setup and the price per part. Share the details you know and we will confirm the route before production.", "พฤติกรรมของวัสดุ ความพร้อมของแม่พิมพ์ และจำนวนสั่งผลิตมีผลต่อการตั้งเครื่องอย่างปลอดภัยและราคาต่อชิ้น ส่งข้อมูลที่มีมาให้เราเพื่อยืนยันเส้นทางก่อนผลิต")</p></header><div class="service-material-grid"><article class="service-material"><h3>PP (Polypropylene)</h3><p>@T("A practical option for many lightweight parts; we check the geometry, shrinkage, and intended use before quoting.", "ตัวเลือกที่เหมาะกับชิ้นงานน้ำหนักเบาหลายประเภท โดยตรวจสอบรูปทรง การหดตัว และการใช้งานก่อนเสนอราคา")</p></article><article class="service-material"><h3>PE (Polyethylene)</h3><p>@T("Suitable grades depend on the part and required stiffness. Send the grade or required behavior when known.", "เกรดที่เหมาะสมขึ้นกับชิ้นงานและความแข็งที่ต้องการ หากทราบเกรดหรือคุณสมบัติที่ต้องการให้แจ้งมาด้วย")</p></article><article class="service-material"><h3>PS / HIPS</h3><p>@T("Useful for rigid prototypes and housings when the mold and finish requirements are defined.", "เหมาะกับต้นแบบและชิ้นส่วนเปลือกที่ต้องการความแข็ง เมื่อกำหนดแม่พิมพ์และผิวงานชัดเจน")</p></article><article class="service-material"><h3>ABS</h3><p>@T("A common engineering plastic for functional prototypes; final suitability depends on melt temperature and part design.", "พลาสติกวิศวกรรมที่ใช้กับต้นแบบใช้งานจริงได้บ่อย ความเหมาะสมขึ้นกับอุณหภูมิหลอมและการออกแบบชิ้นงาน")</p></article><article class="service-material"><h3>@T("Mold support", "ช่วยทำแม่พิมพ์")</h3><p>@T("We can make a mold for the job. Send the 3D design or part, target quantity, material, and finish so we can review and quote the mold and molding work together.", "เราช่วยทำแม่พิมพ์สำหรับงานได้ ส่งแบบ 3 มิติหรือชิ้นงาน จำนวนเป้าหมาย วัสดุ และผิวงาน เพื่อให้เราประเมินและเสนอราคาทั้งแม่พิมพ์และงานฉีดร่วมกัน")</p></article><article class="service-material"><h3>@T("Lot-size economics", "ราคาตามจำนวนสั่งผลิต")</h3><p>@T("The unit price normally falls as the lot grows: five parts carry more setup and mold cost per part than 1,000 parts. We quote the quantity you actually need.", "ราคาต่อชิ้นมักลดลงเมื่อจำนวนเพิ่มขึ้น งาน 5 ชิ้นมีต้นทุนเตรียมงานและแม่พิมพ์ต่อชิ้นสูงกว่างาน 1,000 ชิ้น เราเสนอราคาตามจำนวนที่ต้องการจริง")</p></article></div><p class="service-note" role="note"><strong>@T("POM is excluded from this service.", "ไม่รับ POM ในบริการนี้")</strong> @T("POM (acetal) is a specialist material with a narrow, grade-specific processing window. Manufacturer guides cite melt settings around 205–220 °C for some grades and warn that degradation accelerates above roughly 230 °C; these figures are not a universal recipe. Overheating, excessive shear, long residence time, or contamination with PVC can decompose POM, release irritating formaldehyde-containing fumes, and rapidly increase barrel pressure. Safe POM processing needs dedicated controls, purge/shutdown procedures, and local exhaust ventilation. We can review a supported material or refer you to an industrial process set up specifically for POM.", "POM (อะซีทัล) เป็นวัสดุเฉพาะทางที่มีช่วงการแปรรูปตามเกรดค่อนข้างแคบ คู่มือผู้ผลิตบางเกรดระบุอุณหภูมิหลอมราว 205–220 °C และเตือนว่าการสลายตัวจะเร่งขึ้นเมื่อสูงกว่าประมาณ 230 °C ตัวเลขนี้ไม่ใช่สูตรตายตัวสำหรับทุกเกรด หากร้อนเกินไป รับแรงเฉือนมากเกินไป ค้างอยู่ในกระบอกนานเกินไป หรือปนเปื้อน PVC POM อาจสลายตัว ปล่อยไอที่มีฟอร์มาลดีไฮด์ซึ่งระคายเคือง และทำให้ความดันในกระบอกเพิ่มขึ้นอย่างรวดเร็ว การใช้ POM อย่างปลอดภัยต้องมีระบบควบคุม ขั้นตอน purge/หยุดเครื่อง และระบบดูดอากาศเฉพาะจุดที่เตรียมไว้โดยเฉพาะ เราช่วยประเมินวัสดุที่รองรับหรือแนะนำกระบวนการอุตสาหกรรมที่เตรียมไว้สำหรับ POM ได้")</p></div></section>
    <section id="injection-gallery" class="service-section" aria-labelledby="injection-assets-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Machine and mold reference", "ภาพอ้างอิงเครื่องและแม่พิมพ์")</p><h2 id="injection-assets-title">@T("See the machine details before you send the project", "ดูรายละเอียดเครื่องก่อนส่งโปรเจ็ค")</h2><p>@T("These product renders show the pneumatic frame, temperature controllers, valve and gauge assembly, nozzle area, and a sample mold. They are reference images—not a substitute for a project-specific fit review.", "ภาพเรนเดอร์แสดงโครงเครื่องระบบลม ชุดควบคุมอุณหภูมิ วาล์ว เกจ บริเวณหัวฉีด และแม่พิมพ์ตัวอย่าง ใช้เป็นภาพอ้างอิงและไม่แทนการตรวจสอบความเหมาะสมของแต่ละโปรเจ็ค")</p></header><div class="injection-gallery-grid"><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/injection-molding/pimm-50g-controller.webp" width="1600" height="2000" loading="lazy" decoding="async" alt="@T("PIMM pneumatic machine temperature controller and valve detail", "รายละเอียดชุดควบคุมอุณหภูมิและวาล์วของเครื่อง PIMM ระบบลม")" /><figcaption class="service-card-body"><h3>@T("Controller and valve detail", "รายละเอียดชุดควบคุมและวาล์ว")</h3><p>@T("The controller and pneumatic valve assembly are shown clearly so the material and process discussion starts from the actual machine configuration.", "แสดงชุดควบคุมและวาล์วระบบลมเพื่อให้การพูดคุยเรื่องวัสดุและกระบวนการเริ่มจากเครื่องจริง")</p></figcaption></figure><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/injection-molding/pimm-50g-nozzle.webp" width="1600" height="2000" loading="lazy" decoding="async" alt="@T("PIMM pneumatic injection molding nozzle and heated barrel detail", "รายละเอียดหัวฉีดและกระบอกให้ความร้อนของเครื่องฉีดพลาสติก PIMM ระบบลม")" /><figcaption class="service-card-body"><h3>@T("Nozzle and heated barrel", "หัวฉีดและกระบอกให้ความร้อน")</h3><p>@T("Confirm the gate, nozzle, and mold interface during review; the part and tool determine the practical setup.", "ตรวจสอบทางเข้า หัวฉีด และจุดต่อกับแม่พิมพ์ระหว่างประเมิน โดยพิจารณาจากชิ้นงานและแม่พิมพ์จริง")</p></figcaption></figure><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/injection-molding/pimm-sample-mold.webp" width="3000" height="1688" loading="lazy" decoding="async" alt="@T("Sample injection mold with black and silver mold halves", "แม่พิมพ์ฉีดตัวอย่างสีดำและสีเงิน")" /><figcaption class="service-card-body"><h3>@T("Sample mold reference", "ภาพอ้างอิงแม่พิมพ์ตัวอย่าง")</h3><p>@T("A mold image helps us understand the cavity layout, inserts, and likely clamping or access questions before quoting.", "ภาพแม่พิมพ์ช่วยให้เห็นผังโพรง ชิ้นส่วนแทรก และประเด็นการจับยึดหรือการเข้าถึงก่อนเสนอราคา")</p></figcaption></figure></div></div></section>
    <section id="injection-faq" class="service-section service-section-soft" aria-labelledby="injection-faq-title" data-migration-component="public-service-faq"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Questions before sending files", "คำถามก่อนส่งไฟล์")</p><h2 id="injection-faq-title">@T("Low-volume injection molding FAQ", "คำถามเรื่องฉีดพลาสติกจำนวนน้อย")</h2></header><div class="service-faq"><details><summary>@T("What quantity is this service designed for?", "บริการนี้เหมาะกับจำนวนเท่าไร?")</summary><p>@T("This service is scoped for pilot runs and repeat batches up to 1,000 parts. If your requirement is more than 1,000 parts, compare the economics of owning a PIMM machine at shop.maliev.com.", "บริการนี้วางขอบเขตสำหรับงานทดลองและงานผลิตซ้ำไม่เกิน 1,000 ชิ้น หากต้องการมากกว่า 1,000 ชิ้น แนะนำเปรียบเทียบความคุ้มค่าของการซื้อเครื่อง PIMM ที่ shop.maliev.com")</p></details><details><summary>@T("What machine and material limits should I share?", "ควรแจ้งข้อจำกัดของเครื่องและวัสดุอะไรบ้าง?")</summary><p>@T("The pneumatic machine supports shot weights up to 50 g and plastics melting at no more than 350 °C. Final suitability still depends on the part, mold, material, quantity, and intended use, so MALIEV confirms the scope during review.", "เครื่องระบบลมรองรับน้ำหนักฉีดสูงสุด 50 กรัม และพลาสติกที่มีอุณหภูมิหลอมไม่เกิน 350 °C ความเหมาะสมจริงยังขึ้นกับชิ้นงาน แม่พิมพ์ วัสดุ จำนวน และการใช้งาน จึงต้องยืนยันขอบเขตระหว่างการประเมิน")</p></details><details><summary>@T("What should I send for a useful review?", "ควรส่งข้อมูลอะไรเพื่อให้ประเมินได้ตรงจุด?")</summary><p>@T("Send the CAD or drawing, mold details or photos, material or required behavior, quantity, critical dimensions, finish expectations, and intended use. Mark unknown items clearly so they can be resolved before production.", "ส่งไฟล์ CAD หรือแบบ รายละเอียดหรือรูปแม่พิมพ์ วัสดุหรือคุณสมบัติที่ต้องการ จำนวน ขนาดสำคัญ ความคาดหวังเรื่องผิว และการใช้งาน หากข้อมูลใดยังไม่ทราบให้ระบุไว้ชัดเจนเพื่อแก้ไขก่อนผลิต")</p></details><details><summary>@T("Which plastic materials can you support?", "รองรับวัสดุพลาสติกใดบ้าง?")</summary><p>@T("We review PP, PE, PS or HIPS, and ABS for this service, subject to the part, mold, and melt-temperature limits. POM is not offered for this route because its grade-specific processing window requires dedicated temperature control, purge/shutdown procedures, and local exhaust ventilation. Overheating, excessive shear, long residence time, or PVC contamination can cause decomposition and hazardous formaldehyde-containing fumes.", "เราประเมิน PP, PE, PS หรือ HIPS และ ABS สำหรับบริการนี้ โดยต้องดูชิ้นงาน แม่พิมพ์ และข้อจำกัดอุณหภูมิหลอมร่วมกัน ไม่รับ POM ในเส้นทางนี้ เพราะ POM มีช่วงการแปรรูปตามเกรดที่ต้องควบคุมอุณหภูมิ ขั้นตอน purge/หยุดเครื่อง และระบบดูดอากาศเฉพาะจุดโดยเฉพาะ หากร้อนเกินไป รับแรงเฉือนมากเกินไป ค้างอยู่ในกระบอกนานเกินไป หรือปนเปื้อน PVC อาจสลายตัวและปล่อยไอที่มีฟอร์มาลดีไฮด์ซึ่งเป็นอันตราย")</p></details><details><summary>@T("Can MALIEV make the mold too?", "MALIEV ทำแม่พิมพ์ให้ได้หรือไม่?")</summary><p>@T("Yes. Send the 3D design, part, target quantity, and any material or finish requirements. We can review the mold approach and quote the tooling and molding work together.", "ได้ ส่งแบบ 3 มิติ ชิ้นงาน จำนวนเป้าหมาย และข้อกำหนดวัสดุหรือผิวงานมาให้เรา เราช่วยประเมินแนวทางทำแม่พิมพ์และเสนอราคางานแม่พิมพ์กับงานฉีดรวมกันได้")</p></details><details><summary>@T("Does the lot size change the unit price?", "จำนวนสั่งผลิตมีผลต่อราคาต่อชิ้นหรือไม่?")</summary><p>@T("Yes. A five-part order normally carries a higher unit price than a 1,000-part order because setup and mold costs are spread across fewer parts. We quote the lot size you actually need.", "มีผล จำนวน 5 ชิ้นมักมีราคาต่อชิ้นสูงกว่าจำนวน 1,000 ชิ้น เพราะต้องกระจายต้นทุนเตรียมงานและแม่พิมพ์ไปยังชิ้นส่วนน้อยกว่า เราจะเสนอราคาตามจำนวนที่ต้องการจริง")</p></details></div></div></section>
    <section class="service-section service-section-soft" aria-labelledby="injection-volume-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Quantity decision", "ตัดสินใจจากจำนวน")</p><h2 id="injection-volume-title">@T("Use the service for up to 1,000 parts; own the machine for larger runs", "ใช้บริการเมื่อไม่เกิน 1,000 ชิ้น และพิจารณาซื้อเครื่องเมื่อจำนวนมากกว่า")</h2></header><div class="injection-volume-grid"><article class="injection-volume-card"><span class="injection-volume-label">@T("Service route", "เส้นทางใช้บริการ")</span><strong>@T("Up to 1,000 parts", "ไม่เกิน 1,000 ชิ้น")</strong><p>@T("Send the project for a part, mold, material, and quantity review.", "ส่งโปรเจ็คเพื่อประเมินชิ้นงาน แม่พิมพ์ วัสดุ และจำนวน")</p><a class="service-button service-button-primary" href="/Quotation?item=low-volume-injection-molding">@T("Start the review", "เริ่มประเมินงาน")</a></article><article class="injection-volume-card injection-volume-card--shop"><span class="injection-volume-label">@T("Machine route", "เส้นทางซื้อเครื่อง")</span><strong>@T("More than 1,000 parts", "มากกว่า 1,000 ชิ้น")</strong><p>@T("Compare ownership and production flexibility with the PIMM machine at shop.maliev.com.", "เปรียบเทียบความคุ้มค่าและความยืดหยุ่นของการมีเครื่อง PIMM ที่ shop.maliev.com")</p><a class="service-button service-button-secondary" href="https://shop.maliev.com" target="_blank" rel="noopener">@T("Visit shop.maliev.com", "ไปที่ shop.maliev.com")</a></article></div></div></section>
    <section id="service-pricing" class="service-section service-section-soft service-pricing-section" aria-labelledby="service-pricing-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Planning price", "ราคาเพื่อการวางแผน")</p><h2 id="service-pricing-title">@T("Indicative starting prices", "ราคาเริ่มต้นเพื่อการประเมิน")</h2><p>@T("Use these starting points to choose a service. The final quotation is confirmed after we review geometry, material, quantity, finish, tolerances, and delivery requirements.", "ใช้ราคาเริ่มต้นเหล่านี้เพื่อเลือกบริการ โดยจะยืนยันราคาจริงหลังตรวจสอบรูปทรง วัสดุ จำนวน ผิวสำเร็จ ค่าความคลาดเคลื่อน และกำหนดส่ง")</p></header><div class="service-card-grid service-pricing-grid"><article class="service-card service-pricing-card"><h3>@T("Low-cost mold", "แม่พิมพ์ต้นทุนต่ำ")</h3><p>@T("A mold for short runs can start far below industrial tooling cost, subject to part and mold review.", "แม่พิมพ์สำหรับงานจำนวนน้อยมีต้นทุนต่ำกว่าแม่พิมพ์อุตสาหกรรมมาก โดยขึ้นกับชิ้นงานและการออกแบบแม่พิมพ์")</p><strong>@T("Starts at approximately THB 2,500", "เริ่มต้นประมาณ 2,500 บาท")</strong></article><article class="service-card service-pricing-card"><h3>@T("Molding service", "ค่าบริการฉีดพลาสติก")</h3><p>@T("Unit price falls as the lot grows. We review material, shot weight, mold, and quantity before quoting.", "ราคาต่อชิ้นจะลดลงเมื่อจำนวนสั่งผลิตมากขึ้น ต้องตรวจสอบวัสดุ น้ำหนักฉีด แม่พิมพ์ และจำนวนก่อนประเมิน")</p><strong>@T("Quote after part review", "ประเมินหลังตรวจสอบชิ้นงาน")</strong></article><article class="service-card service-pricing-card"><h3>@T("Production range", "ขอบเขตจำนวนผลิต")</h3><p>@T("This service is intended for low-volume work up to 1,000 parts. Larger runs may be better served by purchasing the PIMM machine.", "เหมาะกับงานจำนวนน้อยไม่เกิน 1,000 ชิ้น หากมากกว่านี้อาจเหมาะกับการซื้อเครื่อง PIMM มากกว่า")</p><strong>@T("Up to 1,000 parts", "ไม่เกิน 1,000 ชิ้น")</strong></article></div><p class="service-pricing-note">@T("Prices are planning references, not a binding offer. We will confirm the scope, tax, delivery, and any revision or finishing work before production.", "ราคาเป็นข้อมูลเพื่อการวางแผน ไม่ใช่ข้อเสนอผูกพัน เราจะยืนยันขอบเขต ภาษี การจัดส่ง รวมถึงงานแก้ไขและเก็บผิวก่อนเริ่มผลิต")</p></div></section>
    <ServiceLocation />
    <section class="service-cta-wrap" aria-labelledby="injection-cta-title"><div class="service-container service-cta"><div><h2 id="injection-cta-title">@T("Have a part and a target quantity?", "มีชิ้นงานและจำนวนเป้าหมายแล้วหรือยัง?")</h2><p>@T("Send the evidence you have. We will confirm whether the low-volume route fits, or point you to the PIMM machine for a larger run.", "ส่งข้อมูลที่มีให้เรา เพื่อยืนยันว่าเส้นทางจำนวนน้อยเหมาะสมหรือควรไปที่เครื่อง PIMM สำหรับงานจำนวนมาก")</p></div><div class="service-actions"><a class="service-button service-button-yellow" href="/Quotation?item=low-volume-injection-molding">@T("Send the project", "ส่งโปรเจ็ค")</a><a class="service-button service-button-secondary" href="https://shop.maliev.com" target="_blank" rel="noopener">@T("Buy a PIMM machine", "ซื้อเครื่อง PIMM")</a></div></div></section>
