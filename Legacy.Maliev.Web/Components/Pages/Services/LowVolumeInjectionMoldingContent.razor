@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="service-page service-page-injection" data-migration-component="low-volume-injection-molding-content" data-migration-route-owner="@RouteOwner">
    <nav class="service-breadcrumb" aria-label="@T("Breadcrumb", "เส้นทางนำทาง")"><ol><li><a href="/">@T("Home", "หน้าแรก")</a></li><li><a href="/services">@T("Services", "บริการ")</a></li><li aria-current="page">@T("Low-volume injection molding", "ฉีดพลาสติกจำนวนน้อย")</li></ol></nav>
    <section class="service-hero" aria-labelledby="injection-title">
        <img class="service-hero-media" src="/src/images/services/injection-molding/injection-service-hero-wide.png" width="2400" height="1200" loading="eager" fetchpriority="high" decoding="async" alt="@T("Pneumatic PIMM low-volume injection molding machine", "เครื่องฉีดพลาสติก PIMM ระบบลมสำหรับงานจำนวนน้อย")" />
        <div class="service-container service-hero-copy"><p class="service-eyebrow">@T("Low-volume injection molding", "ฉีดพลาสติกจำนวนน้อย")</p><h1 id="injection-title">@T("Injection Molding for Up to 1,000 Parts", "บริการฉีดพลาสติกสำหรับงานไม่เกิน 1,000 ชิ้น")</h1><p class="service-hero-lead">@T("Use MALIEV's pneumatic PIMM service for short runs when you have a mold or need a mold reviewed. The machine supports shot weights up to 50 g and plastics that melt at no more than 350 °C; larger runs can be compared with buying the PIMM machine.", "ใช้บริการ PIMM ระบบลมของ MALIEV สำหรับงานจำนวนน้อยเมื่อมีแม่พิมพ์หรือให้เราช่วยประเมินแม่พิมพ์ รองรับน้ำหนักฉีดไม่เกิน 50 กรัม และพลาสติกที่มีอุณหภูมิหลอมไม่เกิน 350 °C หากจำนวนมากสามารถพิจารณาซื้อเครื่อง PIMM ได้")</p><ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Up to 1,000 parts", "ไม่เกิน 1,000 ชิ้น")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Up to 50 g shot weight", "น้ำหนักฉีดไม่เกิน 50 กรัม")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Melt temperature up to 350 °C", "อุณหภูมิหลอมไม่เกิน 350 °C")</li></ul><div class="service-actions"><a class="service-button service-button-primary" href="/Quotation?item=low-volume-injection-molding">@T("Request injection review", "ขอประเมินงานฉีด") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="https://shop.maliev.com" target="_blank" rel="noopener">@T("Compare the PIMM machine", "ดูเครื่อง PIMM")</a></div></div>
    </section>
    <section class="service-quick" aria-label="@T("Injection molding limits", "ขอบเขตบริการฉีดพลาสติก")"><div class="service-container service-quick-grid"><article><div><h2>@T("Quantity", "จำนวน")</h2><p>@T("Service route up to 1,000 parts; larger runs need a separate ownership review.", "ใช้บริการไม่เกิน 1,000 ชิ้น งานมากกว่าต้องประเมินเส้นทางซื้อเครื่อง")</p></div></article><article><div><h2>@T("Shot weight", "น้ำหนักฉีด")</h2><p>@T("PIMM shot weight is up to 50 g per shot.", "น้ำหนักฉีดของ PIMM ไม่เกิน 50 กรัมต่อช็อต")</p></div></article><article><div><h2>@T("Material", "วัสดุ")</h2><p>@T("Supported plastics and melt settings are confirmed per grade.", "ยืนยันพลาสติกและอุณหภูมิตามเกรดวัสดุ")</p></div></article><article><div><h2>@T("Mold", "แม่พิมพ์")</h2><p>@T("Send the mold or ask us to review a mold-making route.", "ส่งแม่พิมพ์หรือให้เราประเมินแนวทางทำแม่พิมพ์")</p></div></article></div></section>
    <nav class="service-page-toc" aria-label="@T("On this page", "ในหน้านี้")" data-service-page-toc><strong>@T("On this page", "ในหน้านี้")</strong><a href="#injection-workflow">@T("Workflow", "ขั้นตอน")</a><a href="#injection-materials">@T("Materials", "วัสดุ")</a><a href="#injection-gallery">@T("Machine and mold", "เครื่องและแม่พิมพ์")</a><a href="#injection-faq">@T("FAQ", "คำถามที่พบบ่อย")</a></nav>
    <section id="injection-workflow" class="service-section" aria-labelledby="injection-workflow-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Review workflow", "ขั้นตอนการประเมิน")</p><h2 id="injection-workflow-title">@T("From project evidence to a clear batch decision", "จากข้อมูลโปรเจ็คสู่การตัดสินใจเรื่องจำนวนผลิต")</h2></header><ol class="service-process"><li><h3>@T("Send the evidence", "ส่งข้อมูลที่มี")</h3><p>@T("Share CAD or drawings, mold information, material, quantity, and intended use.", "ส่ง CAD หรือแบบ ข้อมูลแม่พิมพ์ วัสดุ จำนวน และการใช้งาน")</p></li><li><h3>@T("Check fit and limits", "ตรวจสอบความเหมาะสมและขอบเขต")</h3><p>@T("We review geometry, mold, shot weight, melt temperature, and handling requirements.", "ตรวจสอบรูปทรง แม่พิมพ์ น้ำหนักฉีด อุณหภูมิหลอม และข้อกำหนดการจัดการ")</p></li><li><h3>@T("Confirm the quotation", "ยืนยันใบเสนอราคา")</h3><p>@T("The quantity, material, finish, inspection, and delivery expectations are written into the review.", "ระบุจำนวน วัสดุ ผิวงาน การตรวจสอบ และความคาดหวังเรื่องส่งมอบที่ตกลงกันไว้")</p></li><li><h3>@T("Produce the batch", "ผลิตตามจำนวนที่ตกลง")</h3><p>@T("We make and check the agreed low-volume batch, or redirect larger demand to the machine-purchase path.", "ผลิตและตรวจสอบงานจำนวนน้อยตามที่ตกลง หรือแนะนำช่องทางซื้อเครื่องเมื่อจำนวนมากเกินขอบเขต")</p></li></ol></div></section>
    <section id="injection-materials" class="service-section service-section-soft" aria-labelledby="injection-material-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Materials and quote drivers", "วัสดุและปัจจัยที่ใช้เสนอราคา")</p><h2 id="injection-material-title">@T("Choose a material and quantity we can review with confidence", "เลือกวัสดุและจำนวนที่เราประเมินได้อย่างมั่นใจ")</h2><p>@T("Material behavior, mold readiness, and lot size all affect safe setup and price per part. Share the details you know and we will confirm the route before production.", "พฤติกรรมของวัสดุ ความพร้อมของแม่พิมพ์ และจำนวนสั่งผลิตมีผลต่อการตั้งเครื่องอย่างปลอดภัยและราคาต่อชิ้น ส่งข้อมูลที่มีมาให้เราเพื่อยืนยันเส้นทางก่อนผลิต")</p></header><div class="service-material-grid"><article class="service-material"><h3>PP (Polypropylene)</h3><p>@T("A practical option for many lightweight parts; geometry, shrinkage, and intended use are checked before quoting.", "ตัวเลือกสำหรับชิ้นงานน้ำหนักเบาหลายประเภท โดยตรวจรูปทรง การหดตัว และการใช้งานก่อนเสนอราคา")</p></article><article class="service-material"><h3>PE (Polyethylene)</h3><p>@T("Suitable grades depend on the part and required stiffness. Send the grade or required behavior when known.", "เกรดที่เหมาะสมขึ้นกับชิ้นงานและความแข็งที่ต้องการ หากทราบเกรดหรือคุณสมบัติที่ต้องการให้แจ้งมาด้วย")</p></article><article class="service-material"><h3>PS / HIPS</h3><p>@T("Useful for rigid prototypes and housings when the mold and finish requirements are defined.", "เหมาะกับต้นแบบและชิ้นส่วนเปลือกที่ต้องการความแข็ง เมื่อกำหนดแม่พิมพ์และผิวงานชัดเจน")</p></article><article class="service-material"><h3>ABS</h3><p>@T("A common engineering plastic for functional prototypes; final suitability depends on melt temperature and part design.", "พลาสติกวิศวกรรมที่ใช้กับต้นแบบใช้งานจริงได้บ่อย ความเหมาะสมขึ้นกับอุณหภูมิหลอมและการออกแบบชิ้นงาน")</p></article><article class="service-material"><h3>@T("Mold support", "ช่วยทำแม่พิมพ์")</h3><p>@T("We can review a mold route. Send the 3D design or part, target quantity, material, and finish so we can quote the mold and molding work together.", "เราช่วยประเมินแนวทางทำแม่พิมพ์ ส่งแบบ 3 มิติหรือชิ้นงาน จำนวนเป้าหมาย วัสดุ และผิวงานเพื่อประเมินร่วมกัน")</p></article><article class="service-material"><h3>@T("Lot-size economics", "ราคาตามจำนวนสั่งผลิต")</h3><p>@T("Unit price normally falls as the lot grows; we quote the quantity you actually need.", "ราคาต่อชิ้นมักลดลงเมื่อจำนวนเพิ่มขึ้น เราเสนอราคาตามจำนวนที่ต้องการจริง")</p></article></div><p class="service-note" role="note"><strong>@T("POM is excluded from this service.", "ไม่รับ POM ในบริการนี้")</strong> @T("POM (acetal) is a specialist material with a narrow, grade-specific processing window. Safe POM processing needs dedicated controls and local exhaust ventilation; we can review a supported material or refer you to a process set up specifically for POM.", "POM (อะซีทัล) เป็นวัสดุเฉพาะทางที่มีช่วงการแปรรูปตามเกรดแคบ การใช้ POM อย่างปลอดภัยต้องมีระบบควบคุมและดูดอากาศเฉพาะจุด เราช่วยประเมินวัสดุที่รองรับหรือแนะนำกระบวนการเฉพาะได้")</p></div></section>
    <section id="injection-gallery" class="service-section" aria-labelledby="injection-gallery-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Machine and mold reference", "ภาพอ้างอิงเครื่องและแม่พิมพ์")</p><h2 id="injection-gallery-title">@T("See the machine details before you send the project", "ดูรายละเอียดเครื่องก่อนส่งโปรเจ็ค")</h2></header><div class="injection-gallery-grid"><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/injection-molding/pimm-50g-controller.webp" width="1600" height="2000" loading="lazy" decoding="async" alt="@T("PIMM pneumatic machine temperature controller and valve detail", "รายละเอียดชุดควบคุมอุณหภูมิและวาล์วของเครื่อง PIMM ระบบลม")" /><figcaption class="service-card-body"><h3>@T("Controller and valve detail", "รายละเอียดชุดควบคุมและวาล์ว")</h3><p>@T("The controller and pneumatic valve assembly start the discussion from the actual machine configuration.", "แสดงชุดควบคุมและวาล์วระบบลมเพื่อเริ่มพูดคุยจากเครื่องจริง")</p></figcaption></figure><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/injection-molding/pimm-50g-nozzle.webp" width="1600" height="2000" loading="lazy" decoding="async" alt="@T("PIMM pneumatic injection molding nozzle and heated barrel detail", "รายละเอียดหัวฉีดและกระบอกให้ความร้อนของเครื่องฉีดพลาสติก PIMM ระบบลม")" /><figcaption class="service-card-body"><h3>@T("Nozzle and heated barrel", "หัวฉีดและกระบอกให้ความร้อน")</h3><p>@T("Confirm the gate, nozzle, and mold interface during review; the part and tool determine the practical setup.", "ตรวจสอบทางเข้า หัวฉีด และจุดต่อกับแม่พิมพ์ระหว่างประเมิน โดยพิจารณาจากชิ้นงานและแม่พิมพ์จริง")</p></figcaption></figure><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/injection-molding/pimm-sample-mold.webp" width="3000" height="1688" loading="lazy" decoding="async" alt="@T("Sample injection mold with black and silver mold halves", "แม่พิมพ์ฉีดตัวอย่างสีดำและสีเงิน")" /><figcaption class="service-card-body"><h3>@T("Sample mold reference", "ภาพอ้างอิงแม่พิมพ์ตัวอย่าง")</h3><p>@T("A mold image helps us understand cavity layout, inserts, and likely clamping questions before quoting.", "ภาพแม่พิมพ์ช่วยให้เห็นผังโพรง ชิ้นส่วนแทรก และประเด็นการจับยึดก่อนเสนอราคา")</p></figcaption></figure></div></div></section>
    <section id="injection-faq" class="service-section service-section-soft" aria-labelledby="injection-faq-title" data-migration-component="public-service-faq"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Questions before sending files", "คำถามก่อนส่งไฟล์")</p><h2 id="injection-faq-title">@T("Low-volume injection molding FAQ", "คำถามเรื่องฉีดพลาสติกจำนวนน้อย")</h2></header><div class="service-faq"><details><summary>@T("How many parts can the service produce?", "บริการผลิตได้กี่ชิ้น?")</summary><p>@T("The service route is intended for up to 1,000 parts. Larger demand should be compared with buying the PIMM machine.", "บริการนี้เหมาะกับงานไม่เกิน 1,000 ชิ้น หากมากกว่านั้นควรเปรียบเทียบกับการซื้อเครื่อง PIMM")</p></details><details><summary>@T("What shot weight and temperature are supported?", "รองรับน้ำหนักฉีดและอุณหภูมิเท่าไร?")</summary><p>@T("The pneumatic PIMM route supports shot weights up to 50 g and plastics melting at no more than 350 °C, subject to project review.", "เครื่อง PIMM ระบบลมรองรับน้ำหนักฉีดไม่เกิน 50 กรัม และพลาสติกที่มีอุณหภูมิหลอมไม่เกิน 350 °C โดยต้องประเมินรายโครงการ")</p></details><details><summary>@T("Can you make a mold?", "ช่วยทำแม่พิมพ์ได้หรือไม่?")</summary><p>@T("Send the part or CAD, quantity, material, and finish. We can review the mold and molding route together.", "ส่งชิ้นงานหรือ CAD จำนวน วัสดุ และผิวงานเพื่อประเมินแม่พิมพ์และงานฉีดร่วมกัน")</p></details><details><summary>@T("Why is POM excluded?", "เหตุใดจึงไม่รับ POM?")</summary><p>@T("POM needs dedicated controls and ventilation because overheating or contamination can create a hazardous processing condition. We can review a supported material instead.", "POM ต้องใช้ระบบควบคุมและระบายอากาศเฉพาะ เพราะความร้อนหรือการปนเปื้อนอาจทำให้เกิดสภาวะอันตราย เราช่วยประเมินวัสดุที่รองรับแทนได้")</p></details></div></div></section>
    <ServiceLocation />
    <section class="service-cta-wrap" aria-labelledby="injection-cta-title"><div class="service-container service-cta"><div><h2 id="injection-cta-title">@T("Have a part and a target quantity?", "มีชิ้นงานและจำนวนเป้าหมายแล้วหรือยัง?")</h2><p>@T("Send the evidence you have. We will confirm whether the low-volume route fits, or point you to the PIMM machine for a larger run.", "ส่งข้อมูลที่มีให้เรา เพื่อยืนยันว่าเส้นทางจำนวนน้อยเหมาะสมหรือควรไปที่เครื่อง PIMM สำหรับงานจำนวนมาก")</p></div><div class="service-actions"><a class="service-button service-button-yellow" href="/Quotation?item=low-volume-injection-molding">@T("Send the project", "ส่งโปรเจ็ค")</a><a class="service-button service-button-secondary" href="https://shop.maliev.com" target="_blank" rel="noopener">@T("Buy a PIMM machine", "ซื้อเครื่อง PIMM")</a></div></div></section>
</main>

@code {
    [Parameter]
    public string? RouteOwner { get; set; }
    private bool IsThai => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    private string T(string english, string thai) => IsThai ? thai : english;
}
