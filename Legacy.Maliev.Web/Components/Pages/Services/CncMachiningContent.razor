            <figure class="service-part-bento-tile service-part-bento-tile--cnc-brass" tabindex="0" data-part-proof="source-derived" data-source-photo="Brass (CNC)/DSC_3810.JPG"><img class="service-part-bento-media" src="/src/images/services/cnc/part-bento-cnc-brass-relief.webp" srcset="/src/images/services/cnc/part-bento-cnc-brass-relief-640.webp 640w, /src/images/services/cnc/part-bento-cnc-brass-relief-1024.webp 1024w, /src/images/services/cnc/part-bento-cnc-brass-relief.webp 1536w" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 25vw" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Actual circular CNC-carved brass relief with layered contours", "ชิ้นงานทองเหลืองแกะสลัก CNC ทรงกลมที่ผลิตจริง มีรายละเอียดนูนหลายระดับ")" /><figcaption class="service-part-bento-overlay"><h3>@T("CNC · Brass", "CNC · ทองเหลือง")</h3><p>@T("Layered relief and fine carved contours", "รายละเอียดนูนและแนวแกะสลักละเอียด")</p></figcaption></figure>
