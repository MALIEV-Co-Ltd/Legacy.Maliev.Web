            <figure class="service-part-bento-tile service-part-bento-tile--cnc-linkage" tabindex="0" data-part-proof="source-derived" data-source-photo="Aluminum (CNC)/DSC_3615.JPG"><img class="service-part-bento-media" src="/src/images/services/cnc/part-bento-cnc-arched-linkage.webp" srcset="/src/images/services/cnc/part-bento-cnc-arched-linkage-640.webp 640w, /src/images/services/cnc/part-bento-cnc-arched-linkage-1024.webp 1024w, /src/images/services/cnc/part-bento-cnc-arched-linkage.webp 1536w" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 25vw" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Actual arched machined aluminum linkage with multiple circular mounting features", "ชิ้นงานลิงก์อะลูมิเนียมกัดทรงโค้งที่ผลิตจริง มีจุดยึดวงกลมหลายตำแหน่ง")" /><figcaption class="service-part-bento-overlay"><h3>@T("CNC · Aluminum", "CNC · อะลูมิเนียม")</h3><p>@T("Arched profile and multiple mounting features", "รูปทรงโค้งและจุดยึดหลายตำแหน่ง")</p></figcaption></figure>
