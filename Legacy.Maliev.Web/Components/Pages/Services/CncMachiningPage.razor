@page "/services/cnc-machining"
@using System.Globalization
@using System.Text.Json
@using Legacy.Maliev.Web.Components.Layout
@using Legacy.Maliev.Web.Components.Metadata
@inject IHttpContextAccessor HttpContextAccessor

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var title = T(
        "CNC Machining Services Across Thailand | One-Off and Production Parts",
        "รับงาน CNC ตามแบบทั่วประเทศไทย | อะลูมิเนียมชิ้นเดียวถึงงานผลิต");
    var description = T(
        "CNC milling and turning for customers across Thailand, from one-off parts and prototypes to jigs and repeat production. Send CAD and drawings for a quote.",
        "MALIEV รับ CNC อะลูมิเนียมชิ้นเดียวและผลิตชิ้นงานตามไฟล์ CAD และแบบงาน สำหรับลูกค้าทั่วประเทศไทย ส่ง CAD แบบ 2D วัสดุ และจำนวนเพื่อให้ตรวจสอบและเสนอราคา");
    var keywords = T(
        "CNC machining Thailand, CNC aluminum, CNC one piece, machine shop Bangkok, CNC Nonthaburi",
        "รับ CNC อลูมิเนียม, รับกลึง CNC, โรงกลึง นนทบุรี, CNC งานชิ้นเดียว, โรงงาน CNC");
    var faqJson = CreateFaqJson();
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <link rel="preload" as="image" href="/src/images/services/cnc/cnc-hero.webp" imagesrcset="/src/images/services/cnc/cnc-hero-640.webp 640w, /src/images/services/cnc/cnc-hero-960.webp 960w, /src/images/services/cnc/cnc-hero.webp 1672w" imagesizes="100vw" fetchpriority="high" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
    <PublicServiceStructuredData Model="@(PublicServiceStructuredDataDisplayModel.Create("CNC Machining"))" />
    <script type="application/ld+json">@((MarkupString)faqJson)</script>
</HeadContent>
<CncMachiningContent RouteOwner="blazor-static-ssr" />

@code {
    private static bool IsThai => CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "th";

    public static string CreateFaqJson()
    {
        var schema = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = new object[]
            {
                CreateQuestion(
                    T("Can you machine only one piece?", "รับ CNC อะลูมิเนียมชิ้นเดียวได้หรือไม่?"),
                    T(
                        "Yes. MALIEV accepts feasible one-off CNC parts. Setup and programming are distributed across quantity, so unit price often improves with repeat quantities.",
                        "รับงาน CNC อะลูมิเนียมชิ้นเดียวเมื่อรูปทรงและวัสดุผลิตได้จริง ควรส่ง CAD แบบ 2D ระบุวัสดุและจำนวนเพื่อให้ตรวจสอบก่อนเสนอราคา โดยค่าเตรียมเครื่องและเขียนโปรแกรมเฉลี่ยตามจำนวน")),
                CreateQuestion(
                    T("How much does CNC machining cost?", "งาน CNC ราคาเท่าไร?"),
                    T(
                        "Cost depends on material, part size, machining time, setups, tooling, tolerances, finish, inspection, and quantity. Send CAD and a drawing for a quotation.",
                        "ราคาขึ้นกับวัสดุ ขนาด เวลาเครื่อง การจับยึด เครื่องมือ ค่าคลาดเคลื่อน ผิว การตรวจสอบ และจำนวน ควรส่ง CAD และแบบงานเพื่อเสนอราคา")),
                CreateQuestion(
                    T("What is the usual CNC machining lead time?", "งาน CNC ใช้เวลาผลิตเท่าไร?"),
                    T(
                        "Lead time usually starts at about 14 days. The schedule includes material sourcing, CAM preparation and programming, machine setup and loading, machining, and final inspection—not only the time when material is being cut.",
                        "ระยะเวลาผลิตโดยทั่วไปเริ่มต้นประมาณ 14 วัน เพราะรวมการจัดหาวัสดุ การเตรียม CAM และเขียนโปรแกรม การตั้งเครื่องและโหลดวัสดุ การผลิต และการตรวจสอบขั้นสุดท้าย ไม่ได้มีเฉพาะเวลาที่เครื่องกำลังตัดชิ้นงาน")),
                CreateQuestion(
                    T("Are rush CNC orders available?", "มีบริการเร่งด่วนสำหรับงาน CNC หรือไม่?"),
                    T(
                        "Rush orders may be possible when machine capacity, material availability, tooling, geometry, and inspection requirements allow. An additional markup applies because the job must be prioritized and the production plan adjusted. Ask us to confirm feasibility before relying on a rush date.",
                        "อาจรับงานเร่งด่วนได้เมื่อกำลังการผลิต วัสดุ เครื่องมือ รูปทรง และข้อกำหนดการตรวจสอบเอื้ออำนวย โดยมีค่าบริการเพิ่มเนื่องจากต้องจัดลำดับงานและปรับแผนการผลิต กรุณาให้เรายืนยันก่อนวางแผนตามกำหนดเร่งด่วน")),
                CreateQuestion(
                    T("What files should I send for CNC machining?", "ควรส่งไฟล์อะไรสำหรับงาน CNC?"),
                    T(
                        "Send a usable solid CAD file such as STEP for geometry and a PDF drawing for critical dimensions, tolerances, threads, fits, finish, and inspection notes.",
                        "ส่งไฟล์ solid CAD เช่น STEP สำหรับรูปทรง และแบบ PDF ระบุขนาดสำคัญ ค่าคลาดเคลื่อน เกลียว ฟิต ผิว และจุดตรวจสอบ")),
                CreateQuestion(
                    T("Can you copy an existing part?", "สามารถลอกแบบชิ้นส่วนเดิมได้หรือไม่?"),
                    T(
                        "Often yes, but the correct route may include measurement or 3D scanning, reverse engineering, material identification, and a review of wear or damage. The original design intent cannot always be recovered from a worn sample.",
                        "หลายกรณีทำได้ แต่อาจต้องวัดหรือสแกน 3D ทำ Reverse Engineering ตรวจชนิดวัสดุ และประเมินการสึกหรอ ไม่สามารถกู้เจตนาการออกแบบเดิมทั้งหมดจากชิ้นงานที่สึกได้เสมอ")),
                CreateQuestion(
                    T("What general tolerance applies to CNC parts?", "งาน CNC ใช้ค่าคลาดเคลื่อนทั่วไปใด?"),
                    T(
                        "Unless the drawing or quotation specifies otherwise, ISO 2768-1 tolerance class m is the default and applies only to linear and angular dimensions without individual tolerance indications. Drawing-specific requirements override the general tolerance. Critical or tighter tolerances require engineering review and explicit confirmation in the quotation before production.",
                        "หากแบบงานหรือใบเสนอราคาไม่ได้ระบุเป็นอย่างอื่น ISO 2768-1 ระดับ m เป็นค่าคลาดเคลื่อนทั่วไปเริ่มต้น และใช้เฉพาะขนาดเชิงเส้นและเชิงมุมที่ไม่ได้กำหนดค่าคลาดเคลื่อนเป็นรายจุด ข้อกำหนดเฉพาะในแบบงานมีผลเหนือกว่าค่าคลาดเคลื่อนทั่วไป ค่าคลาดเคลื่อนสำคัญหรือแคบกว่าต้องผ่านการตรวจสอบทางวิศวกรรมและยืนยันอย่างชัดเจนในใบเสนอราคาก่อนผลิต"))
            }
        };

        return JsonSerializer.Serialize(schema);
    }

    private static Dictionary<string, object> CreateQuestion(string question, string answer) => new()
    {
        ["@type"] = "Question",
        ["name"] = question,
        ["acceptedAnswer"] = new Dictionary<string, object>
        {
            ["@type"] = "Answer",
            ["text"] = answer
        }
    };

    private static string T(string english, string thai) => IsThai ? thai : english;
}
