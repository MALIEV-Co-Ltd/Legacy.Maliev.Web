@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="service-page" data-migration-component="silicone-casting-content" data-migration-route-owner="@RouteOwner">
    <nav class="service-breadcrumb" aria-label="@T("Breadcrumb", "เส้นทางนำทาง")"><ol><li><a href="/">@T("Home", "หน้าแรก")</a></li><li><a href="/services">@T("Services", "บริการ")</a></li><li aria-current="page">@T("Silicone Casting", "หล่อซิลิโคน")</li></ol></nav>
    <section class="service-hero" aria-labelledby="silicone-title">
        <img class="service-hero-media" src="/src/images/services/silicone-casting/silicone-casting-workflow.webp" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" alt="@T("Silicone poured into a 3D-printed mold", "เทซิลิโคนลงในแม่พิมพ์พิมพ์ 3 มิติ")" />
        <div class="service-container service-hero-copy"><p class="service-eyebrow">@T("Short-run silicone parts", "ชิ้นงานซิลิโคนจำนวนน้อย")</p><h1 id="silicone-title">@T("Silicone Casting from a Reviewed 3D-Printed Mold", "หล่อซิลิโคนจากแม่พิมพ์พิมพ์ 3 มิติที่ผ่านการประเมิน")</h1><p class="service-hero-lead">@T("Use a 3D-printed mold to make practical short-run silicone parts when the application needs soft touch, flexibility, sealing, or a realistic prototype. We review the mold, material, quantity, and finish together.", "ใช้แม่พิมพ์พิมพ์ 3 มิติเพื่อผลิตชิ้นงานซิลิโคนจำนวนน้อย เมื่อต้องการสัมผัสนุ่ม ความยืดหยุ่น การซีล หรือชิ้นงานต้นแบบที่ใกล้ของจริง โดยประเมินแม่พิมพ์ วัสดุ จำนวน และผิวงานร่วมกัน")</p><ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("3D-printed mold route", "ใช้แม่พิมพ์พิมพ์ 3 มิติ")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Short-run quantities", "เหมาะกับจำนวนน้อย")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Material and finish review", "ประเมินวัสดุและผิวงาน")</li></ul><div class="service-actions"><a class="service-button service-button-primary" href="/Quotation?item=silicone-casting">@T("Request silicone review", "ขอประเมินงานซิลิโคน") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="/services/3d-design">@T("Discuss the mold design", "ปรึกษาการออกแบบแม่พิมพ์")</a></div></div>
    </section>
    <section class="service-quick" aria-label="@T("Silicone casting scope", "ขอบเขตงานหล่อซิลิโคน")"><div class="service-container service-quick-grid"><article><div><h2>@T("Mold", "แม่พิมพ์")</h2><p>@T("A reviewed split or open mold with suitable draft and release path.", "แม่พิมพ์แบบแยกหรือเปิดที่มี draft และทางถอดเหมาะสม")</p></div></article><article><div><h2>@T("Material", "วัสดุ")</h2><p>@T("Shore hardness, color, cure behavior, and intended use are confirmed.", "ยืนยันความแข็ง Shore สี พฤติกรรมการคงรูป และการใช้งาน")</p></div></article><article><div><h2>@T("Quantity", "จำนวน")</h2><p>@T("Short-run production and prototype quantities are reviewed case by case.", "ประเมินงานต้นแบบและงานจำนวนน้อยเป็นรายโครงการ")</p></div></article><article><div><h2>@T("Finish", "ผิวงาน")</h2><p>@T("Parting line, venting, surface texture, and cleanup are discussed before casting.", "คุยเรื่องแนวประกบ ช่องระบาย ลายผิว และการเก็บงานก่อนหล่อ")</p></div></article></div></section>
    <nav class="service-page-toc" aria-label="@T("On this page", "ในหน้านี้")" data-service-page-toc><strong>@T("On this page", "ในหน้านี้")</strong><a href="#silicone-workflow">@T("Workflow", "ขั้นตอน")</a><a href="#silicone-mold">@T("Mold and material", "แม่พิมพ์และวัสดุ")</a><a href="#silicone-faq">@T("FAQ", "คำถามที่พบบ่อย")</a></nav>
    <section id="silicone-workflow" class="service-section" aria-labelledby="silicone-workflow-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Review workflow", "ขั้นตอนการประเมิน")</p><h2 id="silicone-workflow-title">@T("From part intent to a repeatable short run", "จากการใช้งานสู่การผลิตจำนวนน้อยที่ทำซ้ำได้")</h2><p>@T("Silicone casting works best when the mold, material, release path, and expected finish are considered before the first pour.", "งานหล่อซิลิโคนทำได้ดีเมื่อพิจารณาแม่พิมพ์ วัสดุ ทางถอด และผิวงานก่อนเทครั้งแรก")</p></header><ol class="service-process"><li><h3>@T("Share the part evidence", "ส่งข้อมูลชิ้นงาน")</h3><p>@T("Send CAD, drawings, photos, a sample, target quantity, and intended use.", "ส่ง CAD แบบ รูปถ่าย ชิ้นงานตัวอย่าง จำนวน และการใช้งาน")</p></li><li><h3>@T("Review moldability", "ตรวจสอบการทำแม่พิมพ์")</h3><p>@T("We check split lines, draft, undercuts, vents, gates, and demolding risks.", "ตรวจแนวแบ่ง draft undercut ช่องระบาย ทางเข้า และความเสี่ยงตอนถอดงาน")</p></li><li><h3>@T("Confirm silicone", "ยืนยันซิลิโคน")</h3><p>@T("Agree hardness, color, cure behavior, temperature, chemical exposure, and finish expectations.", "ตกลงความแข็ง สี การคงรูป อุณหภูมิ สารเคมี และผิวงาน")</p></li><li><h3>@T("Cast and inspect", "หล่อและตรวจสอบ")</h3><p>@T("Cast the reviewed run, remove flash, inspect critical features, and prepare delivery.", "หล่อชิ้นงานตามขอบเขต ตัดครีบ ตรวจจุดสำคัญ และเตรียมส่งมอบ")</p></li></ol></div></section>
    <section id="silicone-mold" class="service-section service-section-soft" aria-labelledby="silicone-mold-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Mold preparation", "การเตรียมแม่พิมพ์")</p><h2 id="silicone-mold-title">@T("Small decisions determine whether silicone releases cleanly", "รายละเอียดเล็ก ๆ มีผลต่อการถอดซิลิโคน")</h2></header><div class="service-image-grid"><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/silicone-casting/silicone-mold-prep.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Preparing a silicone mold before pouring", "เตรียมแม่พิมพ์ซิลิโคนก่อนเท")" /><figcaption class="service-card-body"><h3>@T("Prepare the release path", "เตรียมทางถอดชิ้นงาน")</h3><p>@T("Draft, split lines, inserts, and vents should be agreed before the mold is printed.", "ควรตกลง draft แนวประกบ ชิ้นส่วนแทรก และช่องระบายก่อนพิมพ์แม่พิมพ์")</p></figcaption></figure><figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/silicone-casting/silicone-pour-cure.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Pouring and curing silicone in a mold", "เทและบ่มซิลิโคนในแม่พิมพ์")" /><figcaption class="service-card-body"><h3>@T("Pour, cure, and clean", "เท บ่ม และเก็บงาน")</h3><p>@T("Cure time, bubble control, demolding, flash removal, and the parting line affect the delivered part.", "เวลาบ่ม การควบคุมฟอง การถอดงาน การตัดครีบ และแนวประกบมีผลต่อชิ้นงานที่ส่งมอบ")</p></figcaption></figure></div><div class="service-card-grid"><article class="service-card"><h3>@T("Soft-touch prototypes", "ต้นแบบสัมผัสนุ่ม")</h3><p>@T("Useful for ergonomic checks, seals, gaskets, grips, covers, and visual prototypes when the material is suitable.", "เหมาะกับการทดสอบการจับ ซีล ปะเก็น ด้ามจับ ฝาครอบ และต้นแบบรูปลักษณ์เมื่อวัสดุเหมาะสม")</p></article><article class="service-card"><h3>@T("Review the real environment", "ตรวจสภาพแวดล้อมจริง")</h3><p>@T("Heat, chemicals, UV, compression set, tear, and required durability can change the material choice.", "ความร้อน สารเคมี UV การคืนตัว การฉีกขาด และความทนทานที่ต้องการมีผลต่อการเลือกวัสดุ")</p></article><article class="service-card"><h3>@T("Short-run economics", "ความคุ้มค่าของงานจำนวนน้อย")</h3><p>@T("A printed mold can reduce tooling cost for a limited run, but tool life and finish are confirmed per project.", "แม่พิมพ์พิมพ์ 3 มิติช่วยลดต้นทุนเครื่องมือสำหรับงานจำนวนน้อย แต่ต้องยืนยันอายุแม่พิมพ์และผิวงานรายโครงการ")</p></article></div></div></section>
    <section id="silicone-faq" class="service-section service-section-soft" aria-labelledby="silicone-faq-title" data-migration-component="public-service-faq"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Questions before sending files", "คำถามก่อนส่งไฟล์")</p><h2 id="silicone-faq-title">@T("Silicone casting FAQ", "คำถามเรื่องหล่อซิลิโคน")</h2></header><div class="service-faq"><details><summary>@T("Can you make the mold as well?", "ช่วยทำแม่พิมพ์ให้ได้หรือไม่?")</summary><p>@T("Yes. Send the part or CAD, target quantity, silicone behavior, and finish so we can review a 3D-printed mold route.", "ได้ ส่งชิ้นงานหรือ CAD จำนวนเป้าหมาย คุณสมบัติซิลิโคน และผิวงานเพื่อประเมินแม่พิมพ์พิมพ์ 3 มิติ")</p></details><details><summary>@T("Is silicone casting suitable for production quantities?", "งานหล่อซิลิโคนเหมาะกับจำนวนผลิตมากหรือไม่?")</summary><p>@T("It is normally a short-run route. Larger or repeated demand may need a more durable production tool, which is reviewed separately.", "โดยทั่วไปเหมาะกับงานจำนวนน้อย หากผลิตมากหรือสั่งซ้ำอาจต้องใช้เครื่องมือผลิตที่ทนกว่าและประเมินแยก")</p></details><details><summary>@T("What should I send first?", "ควรส่งข้อมูลอะไรก่อน?")</summary><p>@T("Send the geometry, expected quantity, target hardness, color, use environment, and any critical sealing or fit requirements.", "ส่งรูปทรง จำนวน ความแข็ง สี สภาพแวดล้อม และข้อกำหนดซีลหรือการฟิตที่สำคัญ")</p></details></div></div></section>
    <ServiceLocation />
    <section class="service-cta-wrap" aria-labelledby="silicone-cta-title"><div class="service-container service-cta"><div><h2 id="silicone-cta-title">@T("Need a short-run silicone part?", "ต้องการชิ้นงานซิลิโคนจำนวนน้อยหรือไม่?")</h2><p>@T("Send the part evidence and target performance for a mold and material review.", "ส่งข้อมูลชิ้นงานและคุณสมบัติที่ต้องการเพื่อประเมินแม่พิมพ์และวัสดุ")</p></div><div class="service-actions"><a class="service-button service-button-yellow" href="/Quotation?item=silicone-casting">@T("Request a review", "ขอประเมินงาน")</a></div></div></section>
</main>

@code {
    [Parameter]
    public string? RouteOwner { get; set; }
    private bool IsThai => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    private string T(string english, string thai) => IsThai ? thai : english;
}
