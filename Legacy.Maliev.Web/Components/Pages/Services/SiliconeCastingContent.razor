@using System.Globalization
@using Legacy.Maliev.Web.Components.Shared

<main class="service-page" data-migration-component="silicone-casting-content" data-migration-route-owner="@RouteOwner">
    <nav class="service-breadcrumb" aria-label="@T("Breadcrumb", "เส้นทางนำทาง")"><ol><li><a href="/">@T("Home", "หน้าแรก")</a></li><li><a href="/services">@T("Services", "บริการ")</a></li><li aria-current="page">@T("Silicone Casting", "หล่อซิลิโคน")</li></ol></nav>
    <section class="service-hero" aria-labelledby="silicone-title">
        <img class="service-hero-media" src="/src/images/services/silicone-casting/silicone-casting-workflow.webp" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" alt="@T("Silicone poured into a 3D-printed mold", "เทซิลิโคนลงในแม่พิมพ์พิมพ์ 3 มิติ")" />
        <div class="service-container service-hero-copy"><p class="service-eyebrow">@T("Short-run silicone parts", "ชิ้นงานซิลิโคนจำนวนน้อย")</p><h1 id="silicone-title">@T("Silicone Casting with a 3D-Printed Mold", "หล่อซิลิโคนด้วยแม่พิมพ์พิมพ์ 3 มิติ")</h1><p class="service-hero-lead">@T("For suitable prototypes and short runs, a 3D-printed mold can provide a practical path to flexible silicone parts. We review the part, mold, material behavior, finish, and intended use before casting.", "สำหรับต้นแบบและงานจำนวนน้อยที่เหมาะสม แม่พิมพ์พิมพ์ 3 มิติเป็นทางเลือกที่ใช้งานได้จริงสำหรับชิ้นงานซิลิโคนยืดหยุ่น เราประเมินชิ้นงาน แม่พิมพ์ พฤติกรรมวัสดุ ผิว และการใช้งานก่อนหล่อ")</p><ul class="service-hero-points"><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("3D-printed mold workflow", "ขั้นตอนด้วยแม่พิมพ์พิมพ์ 3 มิติ")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Short-run and prototype review", "ประเมินงานต้นแบบและงานจำนวนน้อย")</li><li><i class="fas fa-check-circle" aria-hidden="true"></i>@T("Material and finish discussion", "พูดคุยวัสดุและผิวงาน")</li></ul><div class="service-actions"><a class="service-button service-button-primary" href="/Quotation?item=silicone-casting">@T("Request a casting review", "ขอประเมินงานหล่อซิลิโคน") <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a class="service-button service-button-secondary" href="/services/3d-design">@T("Need the mold designed?", "ต้องการให้ออกแบบแม่พิมพ์หรือไม่?")</a></div></div>
    </section>
    <section class="service-quick" aria-label="@T("Silicone casting service scope", "ขอบเขตบริการหล่อซิลิโคน")"><div class="service-container service-quick-grid"><article><div><h2>@T("Mold", "แม่พิมพ์")</h2><p>@T("3D-printed mold halves, parting line, vents, and release strategy.", "แม่พิมพ์พิมพ์ 3 มิติ แนวแยก ช่องระบาย และแนวทางถอดแบบ")</p></div></article><article><div><h2>@T("Material", "วัสดุ")</h2><p>@T("Silicone behavior, hardness, color, and cure requirements.", "พฤติกรรม ความแข็ง สี และเงื่อนไขการแข็งตัวของซิลิโคน")</p></div></article><article><div><h2>@T("Pricing", "ราคา")</h2><p>@T("Mold, master pattern, silicone volume, color, and mold count all affect the estimate.", "ค่าแม่พิมพ์ ต้นแบบ ปริมาณซิลิโคน สี และจำนวนแม่พิมพ์มีผลต่อราคา")</p></div></article><article><div><h2>@T("Timing", "ระยะเวลา")</h2><p>@T("Around 7 days is typical; each pour needs about 6–8 hours to cure.", "โดยทั่วไปประมาณ 7 วัน และแต่ละรอบเทใช้เวลาประมาณ 6–8 ชั่วโมงเพื่อแข็งตัว")</p></div></article></div></section>
    <nav class="service-page-toc" aria-label="@T("On this page", "ในหน้านี้")" data-service-page-toc><strong>@T("On this page", "ในหน้านี้")</strong><a href="#silicone-workflow">@T("Workflow", "ขั้นตอน")</a><a href="#silicone-visuals">@T("Visual process", "ภาพขั้นตอน")</a><a href="#silicone-pricing-title">@T("Pricing", "ราคา")</a><a href="#silicone-performance">@T("Performance", "คุณสมบัติ")</a><a href="#silicone-faq">@T("FAQ", "คำถามที่พบบ่อย")</a></nav>
    <section id="silicone-workflow" class="service-section" aria-labelledby="silicone-workflow-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("From mold to flexible part", "จากแม่พิมพ์สู่ชิ้นงานยืดหยุ่น")</p><h2 id="silicone-workflow-title">@T("Review the process before the silicone is mixed", "ประเมินกระบวนการก่อนผสมซิลิโคน")</h2><p>@T("A good casting result starts with mold design and a clear application. We make the constraints visible before the first pour.", "งานหล่อที่ดีเริ่มจากการออกแบบแม่พิมพ์และการใช้งานที่ชัดเจน เราช่วยทำให้ข้อจำกัดเห็นก่อนเทครั้งแรก")</p></header><ol class="service-process">
        <li><h3>@T("Define the part", "กำหนดชิ้นงาน")</h3><p>@T("Share CAD, drawings, photos, target quantity, and the behavior the part must deliver.", "ส่ง CAD แบบ รูปถ่าย จำนวน และคุณสมบัติที่ชิ้นงานต้องมี")</p></li>
        <li><h3>@T("Plan the mold", "วางแผนแม่พิมพ์")</h3><p>@T("Choose the split, vents, gates, inserts, release approach, and print strategy for the mold.", "กำหนดแนวแยก ช่องระบาย ทางเท ชิ้นส่วนแทรก น้ำยาถอดแบบ และวิธีพิมพ์แม่พิมพ์")</p></li>
        <li><h3>@T("Cast and cure", "หล่อและทำให้แข็งตัว")</h3><p>@T("Mix and pour the agreed silicone system, manage bubbles and cure conditions, then demold carefully.", "ผสมและเทซิลิโคนตามที่ตกลง ควบคุมฟองและเงื่อนไขการแข็งตัว แล้วถอดแบบอย่างระมัดระวัง")</p></li>
        <li><h3>@T("Inspect and refine", "ตรวจสอบและปรับปรุง")</h3><p>@T("Review dimensions, flash, seams, surface, flexibility, and the next repeat or mold revision.", "ตรวจสอบขนาด ครีบ แนวประกบ ผิว ความยืดหยุ่น และการทำซ้ำหรือปรับแม่พิมพ์ครั้งถัดไป")</p></li>
    </ol></div></section>
    <section id="silicone-visuals" class="service-section service-section-soft" aria-labelledby="silicone-visuals-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Mold, pour, cure", "แม่พิมพ์ เท และแข็งตัว")</p><h2 id="silicone-visuals-title">@T("The casting process is a sequence of small decisions", "กระบวนการหล่อประกอบด้วยการตัดสินใจหลายขั้นตอน")</h2><p>@T("Mold count, preparation quality, silicone volume, color, and cure time all change the final cost and schedule.", "จำนวนแม่พิมพ์ คุณภาพการเตรียมงาน ปริมาณซิลิโคน สี และเวลาการแข็งตัวล้วนเปลี่ยนต้นทุนและกำหนดส่ง")</p></header><div class="service-image-grid">
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/silicone-casting/silicone-mold-prep.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Technician checking a 3D-printed mold before silicone casting", "ช่างตรวจสอบแม่พิมพ์พิมพ์ 3 มิติก่อนหล่อซิลิโคน")" /><figcaption class="service-card-body"><h3>@T("Prepare the mold and master pattern", "เตรียมแม่พิมพ์และต้นแบบ")</h3><p>@T("Parting lines, vents, release strategy, surface, and the master pattern must be ready before the first pour.", "แนวแยก ช่องระบาย น้ำยาถอดแบบ ผิว และต้นแบบต้องพร้อมก่อนเทครั้งแรก")</p></figcaption></figure>
        <figure class="service-card service-card-visual"><img class="service-card-media" src="/src/images/services/silicone-casting/silicone-pour-cure.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Liquid silicone poured into a 3D-printed mold while another part cures", "เทซิลิโคนเหลวลงแม่พิมพ์พิมพ์ 3 มิติขณะอีกชิ้นกำลังแข็งตัว")" /><figcaption class="service-card-body"><h3>@T("Pour, cure, and demold", "เท แข็งตัว และถอดแบบ")</h3><p>@T("Each cycle needs about 6–8 hours to fully cure. Fewer molds can lower cost, but more cycles can extend lead time.", "แต่ละรอบใช้เวลาประมาณ 6–8 ชั่วโมงเพื่อแข็งตัวเต็มที่ แม่พิมพ์น้อยช่วยลดต้นทุนแต่หลายรอบเทอาจทำให้ใช้เวลานานขึ้น")</p></figcaption></figure>
    </div></div></section>

    <section id="silicone-pricing" class="service-section" aria-labelledby="silicone-pricing-title"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Pricing and lead time", "ราคาและระยะเวลา")</p><h2 id="silicone-pricing-title">@T("Choose the trade-off that fits the project", "เลือกสมดุลให้เหมาะกับโปรเจ็ค")</h2></header><div class="service-card-grid">
        <article class="service-card"><h3>@T("Mold and master pattern", "แม่พิมพ์และต้นแบบ")</h3><p>@T("A 3D-printed mold and the master pattern are separate cost items. Geometry, size, split, vents, and surface finish determine the work involved.", "แม่พิมพ์พิมพ์ 3 มิติและต้นแบบเป็นต้นทุนคนละส่วน รูปทรง ขนาด แนวแยก ช่องระบาย และผิวงานเป็นตัวกำหนดงานที่ต้องทำ")</p></article>
        <article class="service-card"><h3>@T("Silicone volume and color", "ปริมาณและสีซิลิโคน")</h3><p>@T("Plan around a one-litre minimum of silicone for an initial estimate. Custom colors and extra material for runners, vents, and waste affect the quote.", "ใช้ปริมาณขั้นต่ำประมาณ 1 ลิตรเป็นจุดเริ่มต้นในการประเมิน สีเฉพาะและวัสดุเผื่อทางเท ช่องระบาย และเศษวัสดุมีผลต่อราคา")</p></article>
        <article class="service-card"><h3>@T("Mold count versus schedule", "จำนวนแม่พิมพ์กับกำหนดส่ง")</h3><p>@T("More molds can run more parts in parallel and shorten the schedule. Fewer molds usually lower tooling cost but require more 6–8 hour pouring cycles.", "แม่พิมพ์หลายชุดช่วยทำงานขนานและลดเวลา แม่พิมพ์น้อยมักลดต้นทุนแต่ต้องเพิ่มรอบเทที่ใช้เวลา 6–8 ชั่วโมง")</p></article>
    </div><p class="service-note">@T("A typical silicone-casting project is around 7 days, including a few days for making the mold and master pattern. The final schedule is confirmed after reviewing the geometry, quantity, material, color, and finish.", "โปรเจ็คหล่อซิลิโคนทั่วไปใช้เวลาประมาณ 7 วัน รวมเวลาทำแม่พิมพ์และต้นแบบไม่กี่วัน โดยจะยืนยันกำหนดส่งหลังตรวจสอบรูปทรง จำนวน วัสดุ สี และผิวงาน")</p></div></section>

    <section id="silicone-performance" class="service-section service-section-soft"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("What needs review", "ประเด็นที่ต้องประเมิน")</p><h2>@T("Silicone performance depends on the application", "ประสิทธิภาพซิลิโคนขึ้นกับการใช้งาน")</h2></header><div class="service-card-grid">
        <article class="service-card"><h3>@T("Geometry and demolding", "รูปทรงและการถอดแบบ")</h3><p>@T("Undercuts, thin walls, deep cavities, parting lines, draft, and trapped air affect whether the mold can release the part cleanly.", "undercut ผนังบาง โพรงลึก แนวแยก draft และอากาศค้างมีผลต่อการถอดชิ้นงานจากแม่พิมพ์")</p></article>
        <article class="service-card"><h3>@T("Material behavior", "พฤติกรรมวัสดุ")</h3><p>@T("Hardness, tear resistance, flexibility, temperature, chemical exposure, and compression set should match the real use.", "ความแข็ง การฉีกขาด ความยืดหยุ่น อุณหภูมิ สารเคมี และการคืนตัวหลังถูกกดต้องเหมาะกับการใช้งานจริง")</p></article>
        <article class="service-card"><h3>@T("Surface and inserts", "ผิวและชิ้นส่วนแทรก")</h3><p>@T("The printed mold surface, seam, vent marks, color, and any embedded insert should be agreed before the mold is released.", "ผิวแม่พิมพ์พิมพ์ 3 มิติ แนวประกบ รอยช่องระบาย สี และชิ้นส่วนแทรกต้องตกลงก่อนทำแม่พิมพ์")</p></article>
    </div></div></section>

    <section class="service-section service-section-light-cta"><div class="service-container service-split reverse"><img class="service-split-image" src="/src/images/services/silicone-casting/silicone-pour-cure.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="@T("Liquid silicone poured into a 3D-printed mold", "เทซิลิโคนเหลวลงในแม่พิมพ์พิมพ์ 3 มิติ")" /><div class="service-copy"><p class="service-eyebrow">@T("Need the mold first?", "ต้องเริ่มจากแม่พิมพ์หรือไม่?")</p><h2>@T("Design the mold around the part", "ออกแบบแม่พิมพ์ให้เหมาะกับชิ้นงาน")</h2><p>@T("If the part or mold is not ready, start with 3D design. We can help clarify the split, vents, release, and the manufacturing route before casting.", "หากยังไม่มีชิ้นงานหรือแม่พิมพ์ เริ่มจากบริการออกแบบ 3 มิติได้ เราช่วยกำหนดแนวแยก ช่องระบาย การถอดแบบ และกระบวนการก่อนหล่อ")</p><div class="service-actions"><a class="service-button service-button-primary" href="/services/3d-design">@T("Review 3D design", "ดูบริการออกแบบ 3 มิติ") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div></div></section>
    <section id="silicone-faq" class="service-section service-section-soft" aria-labelledby="silicone-faq-title" data-migration-component="public-service-faq"><div class="service-container"><header class="service-heading center"><p class="service-eyebrow">@T("Questions before sending files", "คำถามก่อนส่งไฟล์")</p><h2 id="silicone-faq-title">@T("Silicone casting FAQ", "คำถามเรื่องหล่อซิลิโคน")</h2></header><div class="service-faq">
        <details><summary>@T("Can a 3D-printed mold be used for silicone casting?", "ใช้แม่พิมพ์พิมพ์ 3 มิติหล่อซิลิโคนได้หรือไม่?")</summary><p>@T("Yes, for suitable short-run applications. Mold geometry, print material, surface, release strategy, vents, and silicone behavior must be reviewed first.", "ได้สำหรับงานจำนวนน้อยที่เหมาะสม ต้องประเมินรูปทรง วัสดุพิมพ์ ผิว น้ำยาถอดแบบ ช่องระบาย และพฤติกรรมซิลิโคนก่อน")</p></details>
        <details><summary>@T("What information is needed before casting?", "ก่อนหล่อต้องใช้ข้อมูลอะไร?")</summary><p>@T("Send the part CAD or drawing, target quantity, silicone hardness or behavior, finish, color, critical dimensions, inserts, and intended use.", "ส่ง CAD หรือแบบ จำนวนเป้าหมาย ความแข็งหรือพฤติกรรมซิลิโคน ผิว สี ขนาดสำคัญ ชิ้นส่วนแทรก และการใช้งาน")</p></details>
        <details><summary>@T("Is silicone casting the same as injection molding?", "หล่อซิลิโคนเหมือนฉีดพลาสติกหรือไม่?")</summary><p>@T("No. Silicone casting uses a liquid silicone system and a different tool and process from heated-plastic injection molding.", "ไม่เหมือนกัน การหล่อซิลิโคนใช้ซิลิโคนเหลวและเครื่องมือกับกระบวนการต่างจากการฉีดพลาสติกที่ให้ความร้อน")</p></details>
        <details><summary>@T("What drives silicone casting cost?", "อะไรเป็นตัวกำหนดราคาหล่อซิลิโคน?")</summary><p>@T("The 3D-printed mold, master pattern, silicone volume, color, number of molds, and finish all affect the estimate.", "ค่าแม่พิมพ์พิมพ์ 3 มิติ ต้นแบบ ปริมาณซิลิโคน สี จำนวนแม่พิมพ์ และผิวงานมีผลต่อราคา")</p></details>
        <details><summary>@T("What lead time should I plan for?", "ควรวางแผนระยะเวลาเท่าไร?")</summary><p>@T("Around seven days is typical, including mold and master-pattern work. Each pour needs about 6–8 hours to cure; fewer molds can lower cost but extend the schedule.", "โดยทั่วไปประมาณ 7 วันรวมงานแม่พิมพ์และต้นแบบ แต่ละรอบเทใช้เวลาประมาณ 6–8 ชั่วโมง แม่พิมพ์น้อยลดต้นทุนแต่เพิ่มระยะเวลาได้")</p></details>
        <details><summary>@T("Is there a minimum silicone order?", "มีปริมาณซิลิโคนขั้นต่ำหรือไม่?")</summary><p>@T("A one-litre minimum is a useful planning baseline. The actual quantity depends on the cavity, runners, vents, waste, and number of pours.", "ปริมาณขั้นต่ำ 1 ลิตรเป็นจุดเริ่มต้นในการวางแผน ปริมาณจริงขึ้นกับโพรง ทางเท ช่องระบาย เศษวัสดุ และจำนวนรอบเท")</p></details>
    </div></div></section>
    <ServiceLocation />
    <section class="service-cta-wrap"><div class="service-container service-cta"><div><h2>@T("Have a silicone part in mind?", "มีชิ้นงานซิลิโคนที่ต้องการผลิตหรือไม่?")</h2><p>@T("Send the geometry, quantity, material behavior, and intended use for a practical casting review.", "ส่งรูปทรง จำนวน พฤติกรรมวัสดุ และการใช้งานเพื่อประเมินงานหล่ออย่างเหมาะสม")</p></div><div class="service-actions"><a class="service-button service-button-yellow" href="/Quotation?item=silicone-casting">@T("Request a casting review", "ขอประเมินงานหล่อซิลิโคน") <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div></section>
</main>

@code {
    [Parameter]
    public string? RouteOwner { get; set; }
    private bool IsThai => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    private string T(string english, string thai) => IsThai ? thai : english;
}
