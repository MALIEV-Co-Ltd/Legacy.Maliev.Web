@inject IStringLocalizer<MemberOverviewContent> Localizer

@{
    IReadOnlyList<MemberOverviewNotice> notices = Model.NoticeDetails.Count > 0
        ? Model.NoticeDetails
        : Model.Notices.Select(content => new MemberOverviewNotice(content)).ToArray();
    MemberOverviewNoticeSeverity? panelSeverity = notices.Any(notice => notice.Severity == MemberOverviewNoticeSeverity.Error)
        ? MemberOverviewNoticeSeverity.Error
        : notices.Any(notice => notice.Severity == MemberOverviewNoticeSeverity.Warning)
            ? MemberOverviewNoticeSeverity.Warning
            : notices.Any(notice => notice.Severity == MemberOverviewNoticeSeverity.Information)
                ? MemberOverviewNoticeSeverity.Information
                : null;
}

<section class="workspace-content" aria-labelledby="member-overview-title" data-migration-component="member-overview-content">
    <div class="maliev-section-header">
        <p class="maliev-eyebrow">@Localizer["Member workspace"]</p>
        <h1 id="member-overview-title">@(string.IsNullOrWhiteSpace(Model.FirstName) ? Localizer["Account overview"] : Localizer["Welcome, {0}", Model.FirstName])</h1>
        <p>@Localizer["Review your active manufacturing work and account status."]</p>
    </div>

    @if (notices.Count == 0)
    {
        <div class="maliev-alert maliev-alert--success" role="status">@Localizer["Your account is ready."]</div>
    }
    else
    {
        <section class="maliev-panel @NoticePanelClass(panelSeverity)" aria-labelledby="member-notices-title" role="@(panelSeverity == MemberOverviewNoticeSeverity.Error ? "alert" : "status")" data-member-notice-status="@NoticeSeverityName(panelSeverity)">
            <h2 id="member-notices-title">@Localizer["Account notices"]</h2>
            <ul>
                @foreach (var notice in notices)
                {
                    <li data-member-notice-severity="@NoticeSeverityName(notice.Severity)"><span><i class="@NoticeIcon(notice.Severity)" aria-hidden="true"></i> @Localizer[notice.Content]</span></li>
                }
            </ul>
        </section>
    }

    @if (Model.BillingAddress is null || Model.ShippingAddress is null)
    {
        <aside class="maliev-alert maliev-alert--warning" role="status" data-account-setup-notice>
            <strong>@Localizer["Continue setting up your account"]</strong>
            <span>@Localizer["Your billing and shipping addresses must be complete before production and delivery."]</span>
            <a href="/member/account/manage/address">@Localizer["Complete address setup"]</a>
        </aside>
    }

    <section aria-labelledby="member-address-summary-title">
        <h2 id="member-address-summary-title">@Localizer["Address summary"]</h2>
        <div class="maliev-card-grid">
            <article class="maliev-panel">
                <h3>@Localizer["Billing address"]</h3>
                @if (Model.BillingAddress is null)
                {
                    <p>@Localizer["You have not set up a billing address yet."]</p>
                    <p class="text-danger">@Localizer["A billing address is required before you can place an order."]</p>
                }
                else
                {
                    <AddressSummary Address="Model.BillingAddress" />
                }
                <p><a href="/member/account/manage/address">@Localizer["Edit billing address"]</a></p>
            </article>
            <article class="maliev-panel">
                <h3>@Localizer["Shipping address"]</h3>
                @if (Model.ShippingAddress is null)
                {
                    <p>@Localizer["You have not set up a shipping address yet."]</p>
                    <p>@Localizer["Add a shipping address so completed work can be delivered."]</p>
                }
                else
                {
                    <AddressSummary Address="Model.ShippingAddress" />
                }
                <p><a href="/member/account/manage/address">@Localizer["Edit shipping address"]</a></p>
            </article>
        </div>
    </section>

    <section aria-labelledby="member-quick-actions-title">
        <h2 id="member-quick-actions-title">@Localizer["Quick actions"]</h2>
        <div class="maliev-card-grid">
            <a class="maliev-panel docs-link-card" href="/quotation"><strong>@Localizer["Request a quotation"]</strong><span>@Localizer["Send drawings and project requirements."]</span></a>
            <a class="maliev-panel docs-link-card" href="/member/orders/history"><strong>@Localizer["Order history"]</strong><span>@Localizer["Review manufacturing progress and files."]</span></a>
            <a class="maliev-panel docs-link-card" href="/member/account"><strong>@Localizer["Account settings"]</strong><span>@Localizer["Manage profile, addresses, email, and password."]</span></a>
        </div>
    </section>

    <section class="maliev-panel" aria-labelledby="recent-orders-title">
        <h2 id="recent-orders-title">@Localizer["Recent orders"]</h2>
        @if (Model.RecentOrders.Count == 0)
        {
            <p>@Localizer["No orders were found."]</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table data-responsive">
                    <thead><tr><th scope="col">@Localizer["Order"]</th><th scope="col">@Localizer["Name"]</th><th scope="col">@Localizer["Created"]</th></tr></thead>
                    <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr><td data-title="@Localizer["Order"]"><a href="/member/orders/view?itemID=@order.Id">#@order.Id</a></td><td data-title="@Localizer["Name"]">@(string.IsNullOrWhiteSpace(order.Name) ? Localizer["Unnamed order"] : order.Name)</td><td data-title="@Localizer["Created"]">@if (order.CreatedDate == "-") { <span>-</span> } else { <time class="convert-to-localdate" datetime="@order.CreatedDate">@order.CreatedDate</time> }</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <p><a href="/member/orders/history">@Localizer["View all orders"]</a></p>
    </section>

    <section class="maliev-panel" aria-labelledby="recent-quotations-title">
        <h2 id="recent-quotations-title">@Localizer["Recent quotations"]</h2>
        @if (Model.RecentQuotations.Count == 0)
        {
            <p>@Localizer["No quotations were found."]</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table data-responsive">
                    <thead><tr><th scope="col">@Localizer["Quotation"]</th><th scope="col">@Localizer["Period"]</th><th scope="col">@Localizer["Expiration date"]</th><th scope="col">@Localizer["Total"]</th><th scope="col">@Localizer["Status"]</th></tr></thead>
                    <tbody>
                    @foreach (var quotation in Model.RecentQuotations)
                    {
                        var status = quotation.Accepted switch
                        {
                            true => Localizer["Accepted"],
                            false => Localizer["Declined"],
                            _ => Localizer["Open"],
                        };
                        <tr><td data-title="@Localizer["Quotation"]"><a href="/member/quotations/view?id=@quotation.Id">#@quotation.Id</a></td><td data-title="@Localizer["Period"]">@quotation.Period @Localizer["days"]</td><td data-title="@Localizer["Expiration date"]"><time class="convert-to-localdate" datetime="@quotation.ExpirationDate">@quotation.ExpirationDate</time></td><td data-title="@Localizer["Total"]">@quotation.Total.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) THB</td><td data-title="@Localizer["Status"]">@status</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <p><a href="/member/quotations">@Localizer["View all quotations"]</a></p>
    </section>
</section>

@code {
    private static string NoticePanelClass(MemberOverviewNoticeSeverity? severity) => severity switch
    {
        MemberOverviewNoticeSeverity.Error => "maliev-alert--danger",
        MemberOverviewNoticeSeverity.Warning => "maliev-alert--warning",
        _ => string.Empty,
    };

    private static string NoticeSeverityName(MemberOverviewNoticeSeverity? severity) => severity switch
    {
        MemberOverviewNoticeSeverity.Information => "information",
        MemberOverviewNoticeSeverity.Warning => "warning",
        MemberOverviewNoticeSeverity.Error => "error",
        _ => "unknown",
    };

    private static string NoticeIcon(MemberOverviewNoticeSeverity severity) => severity switch
    {
        MemberOverviewNoticeSeverity.Information => "fas fa-info-circle",
        MemberOverviewNoticeSeverity.Warning => "fas fa-exclamation-triangle",
        MemberOverviewNoticeSeverity.Error => "fas fa-exclamation-circle",
        _ => "fas fa-question-circle",
    };

    [Parameter]
    public MemberOverviewDisplayModel Model { get; set; } = MemberOverviewDisplayModel.Empty;
}
