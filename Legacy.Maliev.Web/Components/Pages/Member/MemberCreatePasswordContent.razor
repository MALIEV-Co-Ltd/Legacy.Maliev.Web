@inject IStringLocalizer<MemberCreatePasswordContent> Localizer

<div data-migration-component="member-create-password-content">
    <div class="maliev-section-header">
        <p class="maliev-eyebrow">@Localizer["Customer account"]</p>
        <h1 id="member-create-password-title">@Localizer["Create password"]</h1>
        <p id="member-create-password-guidance">@Localizer["Create a password for this account. You will sign in again after it is saved."]</p>
    </div>
    @if (Model.Errors.Count > 0)
    {
        <div class="field-validation-error" role="alert"><ul>@foreach (var error in Model.Errors) { <li>@Localizer[error]</li> }</ul></div>
    }
    <div class="maliev-form-field">
        <label for="member-create-password">@Localizer["New password"]</label>
        <input id="member-create-password" type="password" name="Password" autocomplete="new-password" required minlength="8" maxlength="1024" aria-describedby="member-create-password-guidance" data-password-primary />
    </div>
    <div class="maliev-form-field">
        <label for="member-create-password-confirm">@Localizer["Confirm new password"]</label>
        <input id="member-create-password-confirm" type="password" name="ConfirmPassword" autocomplete="new-password" required maxlength="1024" aria-describedby="member-create-password-guidance" data-password-confirm />
    </div>
    <button type="submit" class="maliev-button">@Localizer["Create password"]</button>
</div>

@code {
    [Parameter]
    public MemberCreatePasswordDisplayModel Model { get; set; } = MemberCreatePasswordDisplayModel.Empty;
}
