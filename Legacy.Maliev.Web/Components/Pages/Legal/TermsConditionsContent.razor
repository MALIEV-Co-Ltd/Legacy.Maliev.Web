@using System.Globalization
@inject IStringLocalizer<TermsConditionsContent> Localizer

<main class="legal-page" data-migration-renderer="blazor-static-ssr" data-migration-route-owner="@RouteOwner">
    <header class="maliev-page-header"><div class="maliev-container"><p class="maliev-eyebrow">@Localizer["Legal"]</p><h1>@Localizer["Terms and Conditions"]</h1></div></header>
    <div class="legal-shell maliev-container">
        <nav class="legal-toc" aria-label='@Localizer["On this page"]'>
            <strong>@Localizer["On this page"]</strong>
            <ul>
                <li><a href="#terms-overview">@T("Overview", "ภาพรวม")</a></li>
                <li><a href="#cookies">@T("Cookies", "คุกกี้")</a></li>
                <li><a href="#license">@T("License", "สิทธิ์การใช้งาน")</a></li>
                <li><a href="#hyperlinking">@T("Linking to our content", "การเชื่อมโยงมายังเนื้อหาของเรา")</a></li>
                <li><a href="#iframes">@T("Frames and embedding", "เฟรมและการฝังหน้าเว็บ")</a></li>
                <li><a href="#rights">@T("Reservation of rights", "การสงวนสิทธิ์")</a></li>
                <li><a href="#link-removal">@T("Link removal", "การแจ้งลิงก์ที่ไม่เหมาะสม")</a></li>
                <li><a href="#content-liability">@T("Content liability", "ความรับผิดชอบต่อเนื้อหา")</a></li>
                <li><a href="#disclaimer">@T("Disclaimer", "ข้อสงวนสิทธิ์")</a></li>
            </ul>
        </nav>
        <article class="legal-document">
            @if (IsThai)
            {
                <TermsConditionsThaiContent EffectiveDate="@LegalEffectiveDate" />
            }
            else
            {
                <TermsConditionsEnglishContent EffectiveDate="@LegalEffectiveDate" />
            }
        </article>
    </div>
</main>

@code {
    [Parameter]
    public string? RouteOwner { get; set; }

    private static bool IsThai => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    private static string T(string english, string thai) => IsThai ? thai : english;
    private static string LegalEffectiveDate => IsThai ? "24 กรกฎาคม 2569" : "24 July 2026";
}
