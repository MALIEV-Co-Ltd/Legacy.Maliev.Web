@page "/Legal/PrivacyPolicy"
@using System.Globalization
@using Legacy.Maliev.Web.Components.Layout
@inject IHttpContextAccessor HttpContextAccessor

@{
    var context = HttpContextAccessor.HttpContext
        ?? throw new InvalidOperationException("Static SSR requires an active HTTP context.");
    var isThai = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th";
    var title = isThai ? "นโยบายความเป็นส่วนตัว | MALIEV" : "Privacy Policy | MALIEV";
    var description = isThai
        ? "นโยบายความเป็นส่วนตัวของ MALIEV อธิบายการเก็บ ใช้ และคุ้มครองข้อมูลเมื่อคุณใช้เว็บไซต์และบริการผลิตของเรา"
        : "Learn how MALIEV collects, uses, protects, and retains information when you use our website and manufacturing services.";
    var keywords = isThai
        ? "นโยบายความเป็นส่วนตัว, ข้อมูล, cookies"
        : "privacy policy, policies, service, collection, terms and conditions, data, cookies, tracking, legal, security";
}
<PageTitle>@title</PageTitle>
<HeadContent>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <PublicOpenGraphMetadata Model="@(PublicOpenGraphMetadataDisplayModel.Create(context, title, description, image: null))" />
    <PublicDocumentLinks Model="@(PublicDocumentLinksDisplayModel.Create(context))" />
</HeadContent>
<PrivacyPolicyContent RouteOwner="blazor-static-ssr" />
