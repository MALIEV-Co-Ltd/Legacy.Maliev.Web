<!-- Google Consent Mode and application-owned data layer -->
<script data-migration-component="public-google-tag-manager-head" data-migration-renderer="blazor-static-ssr">
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    var consentState = '@Model.ConsentState';
    try {
        if (/(?:^|;\s*)maliev_tracking_consent=denied(?:;|$)/.test(document.cookie)) consentState = 'denied';
    } catch (_) { consentState = 'denied'; }
    window.gtag('consent', 'default', {
        'ad_storage': consentState,
        'analytics_storage': consentState,
        'ad_user_data': consentState,
        'ad_personalization': consentState,
        'wait_for_update': 500
    });
    @if (Model.CanTrack && !string.IsNullOrEmpty(Model.UserIdConfigurationJson))
    {
        <text>if (consentState === 'granted') window.gtag('set', @((MarkupString)Model.UserIdConfigurationJson));</text>
    }
    window.malievAnalytics = window.malievAnalytics || (function (initialConsentGranted) {
        var consentGranted = initialConsentGranted;
        var consentDecisionMade = initialConsentGranted;
        var pendingEvents = [];

        function enforceRecordedDenial(forceNotify) {
            var denied;
            try {
                denied = /(?:^|;\s*)maliev_tracking_consent=denied(?:;|$)/.test(document.cookie);
            } catch (_) { denied = true; }
            if (!denied) return false;
            var notify = forceNotify === true || consentGranted || !consentDecisionMade;
            consentGranted = false;
            consentDecisionMade = true;
            pendingEvents.length = 0;
            if (notify) {
                try { window.gtag('consent', 'update', {
                    ad_storage: 'denied', analytics_storage: 'denied',
                    ad_user_data: 'denied', ad_personalization: 'denied'
                }); } catch (_) { }
                try { window.gtag('set', { user_id: null }); } catch (_) { }
            }
            return true;
        }

        window.addEventListener('focus', enforceRecordedDenial);
        window.addEventListener('pageshow', enforceRecordedDenial);
        document.addEventListener('visibilitychange', enforceRecordedDenial);
        if (window.cookieStore && typeof window.cookieStore.addEventListener === 'function') {
            window.cookieStore.addEventListener('change', enforceRecordedDenial);
        }

        function push(eventData) {
            if (!eventData || typeof eventData.event !== 'string') {
                return;
            }

            window.dataLayer.push(eventData);
        }

        return {
            canGrant: function () { return !enforceRecordedDenial(true); },
            isConsentGranted: function () { return !enforceRecordedDenial() && consentGranted; },
            emit: function (eventData) {
                if (enforceRecordedDenial()) return;
                if (consentGranted) {
                    push(eventData);
                    return;
                }

                if (!consentDecisionMade) {
                    pendingEvents.push(eventData);
                }
            },
            setConsent: function (state) {
                if (state === 'granted' && enforceRecordedDenial(true)) return;
                consentDecisionMade = true;
                consentGranted = state === 'granted';
                if (!consentGranted) {
                    pendingEvents.length = 0;
                    window.gtag('set', { user_id: null });
                    return;
                }

                pendingEvents.splice(0).forEach(push);
            }
        };
    })(consentState === 'granted');
    @((MarkupString)Model.QueuedEventScript)
    window.malievAnalytics.emit({ event: 'maliev_analytics_ready' });
</script>

<!-- Google Tag Manager: network loading is deferred until optional tracking is allowed. -->
<script>
    window.malievLoadGoogleTagManager = window.malievLoadGoogleTagManager || function () {
        if (!window.malievAnalytics || typeof window.malievAnalytics.isConsentGranted !== 'function'
            || !window.malievAnalytics.isConsentGranted()) return;
        if (document.querySelector('script[data-maliev-gtm-loader]')) {
            return;
        }

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
            'gtm.start': new Date().getTime(),
            event: 'gtm.js'
        });

        var firstScript = document.getElementsByTagName('script')[0];
        var loader = document.createElement('script');
        loader.async = true;
        loader.setAttribute('data-maliev-gtm-loader', '');
        loader.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-KHDDLVRR';
        firstScript.parentNode.insertBefore(loader, firstScript);
    };

    if (consentState === 'granted' && window.malievAnalytics.isConsentGranted()) {
        window.malievLoadGoogleTagManager();
    }
</script>
<!-- End Google Tag Manager -->

@code {
    [Parameter, EditorRequired]
    public required PublicGoogleTagManagerDisplayModel Model { get; set; }
}
