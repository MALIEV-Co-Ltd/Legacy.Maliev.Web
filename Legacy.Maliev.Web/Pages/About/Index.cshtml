@page
@model AboutModel
@using Legacy.Maliev.Web.Components.Pages.About
@{
    if (System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th")
    {
        ViewData["Title"] = "เกี่ยวกับ MALIEV | พัฒนาต้นแบบและวิศวกรรมย้อนกลับ";
        ViewData["Description"] = "รู้จัก MALIEV ผู้พัฒนาชิ้นงานต้นแบบและวิศวกรรมย้อนกลับในนนทบุรี จากแนวคิดและชิ้นงานเดิม สู่แบบ CAD ชิ้นส่วนทดแทน และการต่อยอดผลิตภัณฑ์";
        ViewData["Keywords"] = "บริษัท มาลีฟ จำกัด, พัฒนาต้นแบบ, วิศวกรรมย้อนกลับ, ออกแบบ 3 มิติ, CNC, พิมพ์ 3 มิติ, สแกน 3 มิติ";
    }
    else
    {
        ViewData["Title"] = "About MALIEV | Prototype Development & Reverse Engineering";
        ViewData["Description"] = "Meet MALIEV: prototype development and reverse engineering in Nonthaburi, Thailand. From ideas and existing parts to CAD, replacement parts and product development.";
        ViewData["Keywords"] = "MALIEV company profile, prototype development, reverse engineering, CNC machining, 3D design, 3D printing, 3D scanning";
    }

}
@section Head {
    <link rel="preload" as="image" href="/src/images/landing/about-customer-partnership.webp" fetchpriority="high" />
}
<component type="typeof(AboutContent)" render-mode="Static" />
