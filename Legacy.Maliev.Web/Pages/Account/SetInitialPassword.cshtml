@page
@model Legacy.Maliev.Web.Pages.Account.SetInitialPassword
@using Legacy.Maliev.Web.Components.Pages.Account
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SetInitialPasswordContent> Localizer
@{
    ViewData["Title"] = Localizer["Set your password | MALIEV"];
    ViewData["Robots"] = "noindex, nofollow";
}
<main class="auth-page">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="initial-password-intro-title">
            <p class="maliev-eyebrow">@Localizer["Account security"]</p>
            <h1 id="initial-password-intro-title">@Localizer["Make this account yours"]</h1>
            <p>@Localizer["Replace the temporary password before entering your workspace."]</p>
        </section>
        <section class="auth-card" aria-labelledby="initial-password-title">
            <header class="auth-card__header">
                <h2 id="initial-password-title">@Localizer["Set your new password"]</h2>
            </header>
            <form method="post" class="maliev-form" id="set-initial-password" data-single-submit>
                <component type="typeof(SetInitialPasswordContent)" render-mode="Static" param-Model="Model.DisplayModel" />
            </form>
        </section>
    </div>
</main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>GuardSingleSubmit("set-initial-password");</script>
}
