@page
@model Legacy.Maliev.Web.Pages.Account.ForgotPassword
@using Legacy.Maliev.Web.Components.Pages.Account
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ForgotPasswordContent> ForgotPasswordLocalizer
@{
    var isThai = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th";
    ViewData["Title"] = isThai ? "กู้คืนรหัสผ่าน | MALIEV" : "Forgot Password | MALIEV";
    ViewData["Description"] = isThai
        ? "กู้คืนรหัสผ่านบัญชี MALIEV ด้วยลิงก์ที่ปลอดภัยเพื่อกลับไปจัดการใบเสนอราคาและโปรเจ็คผลิตของคุณ"
        : "Recover your MALIEV account with a secure reset link and return to manage quotations and manufacturing projects.";
    ViewData["Keywords"] = isThai ? "กู้คืนรหัสผ่าน, บัญชี MALIEV" : "MALIEV password reset, account recovery";
    ViewData["Robots"] = "noindex, nofollow";
}
<main class="auth-page">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="forgot-intro-title"><h1 id="forgot-intro-title">@ForgotPasswordLocalizer["Return to your workspace"]</h1><p>@ForgotPasswordLocalizer["Enter your confirmed email address and we will send you a secure password reset link."]</p></section>
        <section class="auth-card" aria-labelledby="forgot-title">
            <header class="auth-card__header"><h2 id="forgot-title">@ForgotPasswordLocalizer["Forgot password"]</h2></header>
            <form method="post" class="maliev-form">
                <component type="typeof(ForgotPasswordContent)" render-mode="Static" param-Model="Model.DisplayModel" />
            </form>
            <footer class="auth-card__footer"><a href="/Account/Login">@ForgotPasswordLocalizer["Back to sign in"]</a></footer>
        </section>
    </div>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
