@page
@model Legacy.Maliev.Web.Pages.Account.Signup
@using Legacy.Maliev.Web.Components.Pages.Account
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SignupContent> SignupLocalizer
@{
    var isThai = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th";
    ViewData["Title"] = isThai ? "สมัครสมาชิก | MALIEV" : "Sign Up | MALIEV";
    ViewData["Description"] = isThai
        ? "สมัครบัญชี MALIEV เพื่อจัดการใบเสนอราคา คำสั่งซื้อ ไฟล์งาน และโปรเจ็คผลิตของคุณออนไลน์อย่างปลอดภัย"
        : "Create a MALIEV account to manage quotations, orders, project files, and manufacturing work online.";
    ViewData["Robots"] = "noindex, follow";
}
@section Head { <script src="https://www.google.com/recaptcha/enterprise.js?render=@Model.RecaptchaSiteKey"></script> }
<main class="auth-page">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="signup-intro-title">
            <h1 id="signup-intro-title">@SignupLocalizer["Manufacturing project management, in one place"]</h1>
            <p>@SignupLocalizer["Create an account to manage quotes, start an order or review previous projects and files."]</p>
            <ul class="auth-benefits">
                <li><i class="fas fa-layer-group" aria-hidden="true"></i><span>@SignupLocalizer["Six processes under one roof: CNC machining, 3D printing, 3D scanning, 3D design, silicone casting, and low-volume injection molding."]</span></li>
                <li><i class="fas fa-bolt" aria-hidden="true"></i><span>@SignupLocalizer["Upload a CAD file and get a price in minutes, with DFM findings on the part before you commit."]</span></li>
                <li><i class="fas fa-shield-alt" aria-hidden="true"></i><span>@SignupLocalizer["Your drawings stay confidential under our"] <a href="/Legal/NonDisclosureAgreement">@SignupLocalizer["mutual NDA"]</a>.</span></li>
                <li><i class="fas fa-comments" aria-hidden="true"></i><span>@SignupLocalizer["Thai and English support from our workshop in Nonthaburi, 09:00-18:00 Monday to Friday."]</span></li>
            </ul>
        </section>
        <section class="auth-card" aria-labelledby="signup-title">
            <header class="auth-card__header"><h2 id="signup-title">@SignupLocalizer["Create your account"]</h2></header>
            @if (!string.IsNullOrWhiteSpace(Model.Notification))
            {
                <div class="maliev-alert maliev-alert--success" role="status" aria-live="polite">@Model.Notification</div>
            }
            <form id="customer-signup" method="post" class="maliev-form">
                <component type="typeof(SignupContent)" render-mode="Static" param-Model="Model.DisplayModel" />
            </form>
            <footer class="auth-card__footer"><p class="auth-card__footer-lead">@SignupLocalizer["Already have an account?"]</p><div class="maliev-actions"><a href="/Account/Login" class="maliev-button maliev-button--secondary">@SignupLocalizer["Sign in"]</a></div></footer>
        </section>
    </div>
</main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
        <script>GuardRecaptchaSubmit("customer-signup", "submit-button", "@Model.RecaptchaSiteKey", "account_signup", "@SignupLocalizer["Submitting..."]", "signup-recaptcha-error");</script>
}
