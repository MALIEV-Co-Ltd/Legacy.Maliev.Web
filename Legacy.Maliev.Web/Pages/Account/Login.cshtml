@page
@model Legacy.Maliev.Web.Pages.Account.Login
@using Legacy.Maliev.Web.Components.Pages.Account
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<LoginContent> LoginLocalizer
@{
    var isThai = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th";
    ViewData["Title"] = isThai ? "เข้าสู่ระบบ | MALIEV" : "Login | MALIEV";
    ViewData["Description"] = isThai
        ? "เข้าสู่ระบบ MALIEV เพื่อดูใบเสนอราคา คำสั่งซื้อ ไฟล์งาน และข้อมูลบัญชีในพื้นที่ทำงานออนไลน์"
        : "Sign in to MALIEV to review quotations, orders, project files, and account details in your secure workspace.";
    ViewData["Keywords"] = isThai ? "member, เข้าสู่ระบบ" : "member area, login";
    ViewData["Robots"] = "noindex, follow";
}
<main class="auth-page">
    <div class="maliev-container auth-shell">
        <section class="auth-intro" aria-labelledby="login-intro-title">
            <p class="maliev-eyebrow">MALIEV WORKSPACE</p>
            <h1 id="login-intro-title">@LoginLocalizer["Manage your manufacturing projects"]</h1>
            <p>@LoginLocalizer["Sign in to review quotations, orders, files, and account details in one secure place."]</p>
        </section>
        <section class="auth-card" aria-labelledby="login-title">
            <header class="auth-card__header">
                <p class="maliev-eyebrow">@LoginLocalizer["Member account"]</p>
                <h2 id="login-title">@LoginLocalizer["Sign in"]</h2>
            </header>
            @if (!string.IsNullOrWhiteSpace(Model.Notification))
            {
                <div class="maliev-alert mb-3" role="status">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <span>@Model.Notification</span>
                </div>
            }
            <form method="post" class="maliev-form" id="customer-login">
                <component type="typeof(LoginContent)" render-mode="Static" param-Model="Model.DisplayModel" />
            </form>
            <footer class="auth-card__footer">
                <div class="maliev-actions">
                    <a href="/Account/Signup" class="maliev-button maliev-button--secondary">@LoginLocalizer["Create your account"]</a>
                    <a href="/Account/ForgotPassword">@LoginLocalizer["Forgot your password?"]</a>
                </div>
            </footer>
        </section>
    </div>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
