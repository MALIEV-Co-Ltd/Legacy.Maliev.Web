@page
@model Legacy.Maliev.Web.Pages.Account.ResetPassword
@using Legacy.Maliev.Web.Components.Pages.Account
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ResetPasswordContent> ResetPasswordLocalizer
@{
    var isThai = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th";
    ViewData["Title"] = isThai ? "ตั้งรหัสผ่านใหม่ | MALIEV" : "Password Reset | MALIEV";
    ViewData["Description"] = isThai
        ? "ตั้งรหัสผ่านใหม่สำหรับบัญชี MALIEV ของคุณเพื่อกลับเข้าใช้งานพื้นที่ทำงานออนไลน์"
        : "Set a new password for your MALIEV account and return to your secure workspace.";
    ViewData["Robots"] = "noindex, nofollow";
}
<main class="auth-page"><div class="maliev-container auth-shell"><section class="auth-intro" aria-labelledby="reset-intro-title"><h1 id="reset-intro-title">@ResetPasswordLocalizer["Create a new password"]</h1><p>@ResetPasswordLocalizer["Choose a strong password that you do not use for another account."]</p></section><section class="auth-card" aria-labelledby="reset-title"><header class="auth-card__header"><h2 id="reset-title">@ResetPasswordLocalizer["Reset password"]</h2></header><form method="post" class="maliev-form"><component type="typeof(ResetPasswordContent)" render-mode="Static" param-Model="Model.DisplayModel" /></form><footer class="auth-card__footer"><a class="auth-card__footer-link" href="/Account/Login">@ResetPasswordLocalizer["Back to sign in"]</a></footer></section></div></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
