@page
@model Legacy.Maliev.Web.Pages.Services.Machining
@using Legacy.Maliev.Web.Components.Pages.Services
@using Legacy.Maliev.Web.Components.Metadata
@{
    bool isThai = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th";
    Func<string, string, string> T = (en, th) => isThai ? th : en;
    ViewData["Title"] = T("CNC Machining Services Across Thailand | One-Off and Production Parts", "รับงาน CNC ตามแบบทั่วประเทศไทย | อะลูมิเนียมชิ้นเดียวถึงงานผลิต");
    ViewData["Description"] = T("CNC milling and turning for customers across Thailand, from one-off parts and prototypes to jigs and repeat production. Send CAD and drawings for a quote.", "MALIEV รับ CNC อะลูมิเนียมชิ้นเดียวและผลิตชิ้นงานตามไฟล์ CAD และแบบงาน สำหรับลูกค้าทั่วประเทศไทย ส่ง CAD แบบ 2D วัสดุ และจำนวนเพื่อให้ตรวจสอบและเสนอราคา");
    ViewData["Keywords"] = T("CNC machining Thailand, CNC aluminum, CNC one piece, machine shop Bangkok, CNC Nonthaburi", "รับ CNC อลูมิเนียม, รับกลึง CNC, โรงกลึง นนทบุรี, CNC งานชิ้นเดียว, โรงงาน CNC");
    var faqJson = CncMachiningPage.CreateFaqJson();
}

@section Head {
    <link rel="preload" as="image" href="~/src/images/services/cnc/cnc-hero.webp" imagesrcset="/src/images/services/cnc/cnc-hero-640.webp 640w, /src/images/services/cnc/cnc-hero-768.webp 768w, /src/images/services/cnc/cnc-hero-960.webp 960w, /src/images/services/cnc/cnc-hero.webp 1672w" imagesizes="100vw" fetchpriority="high" />
}

<component type="typeof(CncMachiningContent)" render-mode="Static" />

@section Schema { <component type="typeof(PublicServiceStructuredData)" render-mode="Static" param-Model="@(PublicServiceStructuredDataDisplayModel.Create("CNC Machining"))" /><script type="application/ld+json">@Html.Raw(faqJson)</script> }
