@page
@model Legacy.Maliev.Web.Pages.Legal.PrivacyModel
@using Legacy.Maliev.Web.Components.Pages.Legal
@{
    string keywordResult = string.Empty;
    if (System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "th")
    {
        ViewData["Title"] = "นโยบายความเป็นส่วนตัว | MALIEV";
        ViewData["Description"] = "นโยบายความเป็นส่วนตัวของ MALIEV อธิบายการเก็บ ใช้ และคุ้มครองข้อมูลเมื่อคุณใช้เว็บไซต์และบริการผลิตของเรา";
        List<string> keywords = new List<string>()
{
"นโยบายความเป็นส่วนตัว",
"ข้อมูล",
"cookies",
};
        keywordResult = String.Join(", ", keywords.ToArray());
    }
    else
    {
        ViewData["Title"] = "Privacy Policy | MALIEV";
        ViewData["Description"] = "Learn how MALIEV collects, uses, protects, and retains information when you use our website and manufacturing services.";
        List<string> keywords = new List<string>()
{
"privacy policy",
"policies",
"service",
"collection",
"terms and conditions",
"data",
"cookies",
"tracking",
"legal",
"security",
};
        keywordResult = String.Join(", ", keywords.ToArray());
    }

    ViewData["Keywords"] = keywordResult;
}
<component type="typeof(PrivacyPolicyContent)" render-mode="Static" />
