        .iq-cnc-summary-group-title { grid-column: 1 / -1; margin: 0; color: #111f33; font-size: var(--maliev-text-sm); font-weight: 600; line-height: 1.35; }
        .iq-cnc-summary-fact { min-width: 0; }
        .iq-cnc-summary-label { display: block; margin-bottom: 0.2rem; color: #5b6777; font-size: var(--maliev-text-xs); font-weight: 400; line-height: 1.45; }
        .iq-cnc-summary-value { display: block; color: #111f33; font-size: var(--maliev-text-xs); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.45; overflow-wrap: anywhere; }
        .iq-cnc-summary-value--measure { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 400; letter-spacing: -0.01em; }
