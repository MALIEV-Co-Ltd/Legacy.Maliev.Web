<div class="container-fluid p-0 iq-page">

    <style>
        /* ---------------------------------------------------------------------
           Design tokens. This surface ran on Bootstrap's stock palette: of 63 colour
           literals exactly one matched DESIGN.md, --bs-primary resolved to #0d6efd
           rather than Signal Blue #075de8, and --bs-secondary-color was never defined
           at all -- so every "muted" rule inherited full body ink and the page had no
           text hierarchy. Scoped to this shell rather than :root, because Bootstrap's
           blue is load-bearing elsewhere on the site.
           --------------------------------------------------------------------- */
        body.instant-quotation-shell {
            --bs-primary: #075de8;
            --bs-primary-rgb: 7, 93, 232;
            --bs-secondary-color: #5b6777;
            --bs-border-color: var(--maliev-line);
        }

        /* Compiled Bootstrap hardcodes #0d6efd into the button's own custom properties,
           so overriding --bs-primary alone does not reach it. */
        body.instant-quotation-shell .btn-primary {
            --bs-btn-bg: #075de8;
            --bs-btn-border-color: #075de8;
            --bs-btn-hover-bg: #064dcc;
            --bs-btn-hover-border-color: #064dcc;
            --bs-btn-active-bg: #064dcc;
            --bs-btn-active-border-color: #064dcc;
            --bs-btn-disabled-bg: #075de8;
            --bs-btn-disabled-border-color: #075de8;
        }

        html, body.instant-quotation-shell { height: 100%; overflow: hidden; }
        #main-content, .iq-page, #instant-quotation-form, #instant-quotation-component { height: 100%; margin: 0 !important; padding: 0 !important; overflow: hidden; }
        #instant-quotation-validation.validation-summary-valid { display: none !important; margin: 0 !important; padding: 0 !important; }
        #instant-quotation-validation.validation-summary-errors { margin: 0; padding: 0.5rem 0.75rem; }
        #instant-quotation-validation ul { margin: 0; }
        .iq-wrap { background: transparent; }
        .iq-top { display: flex; align-items: stretch; min-height: 420px; margin: 0 !important; }
        .iq-viewer-pane { flex: 0 0 44%; display: flex; flex-direction: column; gap: 0; padding: 0; position: relative; min-width: 0; min-height: 0; container-type: inline-size; container-name: iq-preview-pane; background: #f7f9fc; }
        .iq-viewer-visual { flex: 1 1 auto; display: flex; flex-direction: column; position: relative; min-width: 0; min-height: 260px; }
        .iq-viewer-stage { flex: 1 1 auto; position: relative; min-width: 0; min-height: 260px; }
        .iq-canvas { width: 100%; height: 100%; display: block; }
        /* Keep the native file control in the accessibility tree and available to the
           browser host. A display:none input can emit a chooser event while an embedded
           browser silently drops the operating-system dialog. Both visible browse labels
           below target this real control; drag-and-drop remains a separate path. */
        .iq-native-file-input {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
        }
        #file-input-hidden:focus-visible ~ .iq-top .iq-viewer-empty,
        #file-input-hidden:focus-visible ~ .iq-top .iq-dropzone {
            outline: 2px solid var(--maliev-blue); outline-offset: -4px;
        }
        /* The empty viewer is a build plate with the part hovering over it: on a cold
           load this is the only thing on the screen, and a centred line of grey text
           spent that screen saying nothing about what the tool does. The plane is
           hinged at its near edge and laid away from the viewer so the grid converges
           into a soft vanishing fade — the read is looking down a machine bed. */
        .iq-viewer-empty {
            position: absolute; inset: 0; width: auto; height: 100%; padding: 0; overflow: hidden;
            cursor: pointer; --iq-ve-cell: 34px; --iq-ve-glow: 0.55;
            background:
                radial-gradient(130% 78% at 50% 112%, rgba(7, 93, 232, calc(0.20 * var(--iq-ve-glow))) 0%, rgba(7, 93, 232, 0) 64%),
                linear-gradient(180deg, #ffffff 0%, #f8fbff 52%, #edf3fd 100%);
        }
        .iq-viewer-empty > * { pointer-events: none; }
        /* A honeycomb wall that beats, in place of the perspective grid floor. The
           tiles sit at their own resting depths and a single wave crosses the pane
           left to right once per cycle, then the wall is completely still for the
           rest of it. Driven by Three.js on its own canvas and its own renderer —
           never the part viewer's, so a failure here cannot reach the preview. */
        .iq-ve-hex { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
        /* Fades tile CONTRAST, not just motion, behind the copy. Zeroing the
           animation in the centre is not enough on its own: the dark title would
           still be sitting on lit tile edges. */
        .iq-ve-veil {
            position: absolute; inset: 0;
            background: radial-gradient(closest-side ellipse at 50% 50%,
                rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.86) 42%, rgba(255, 255, 255, 0) 78%);
        }
        .iq-ve-scene { position: relative; display: flex; flex-direction: column; align-items: center; }
        .iq-ve-canvas { display: block; width: clamp(220px, 27vw, 340px); height: clamp(170px, 21vw, 260px); }
        /* No perspective: a true isometric projection is orthographic, and a vanishing
           point on a 128px box only makes the near edges disagree with the far ones. */
        .iq-ve-rig { --iq-ve-size: clamp(84px, 9vw, 128px); animation: iq-ve-float 5.6s ease-in-out infinite; }
        /* 35.264deg is the real isometric elevation (atan(1/sqrt(2))), paired with 45deg
           of azimuth so all three visible faces foreshorten equally. */
        .iq-ve-tilt { display: block; width: var(--iq-ve-size); height: var(--iq-ve-size); transform: rotateX(-35.264deg) rotateY(-45deg); transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
