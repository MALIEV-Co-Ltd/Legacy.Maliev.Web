        .iq-ve-cube i:nth-child(2) { transform: rotateY(180deg) translateZ(calc(var(--iq-ve-size) / 2)); background: rgba(7, 93, 232, 0.06); }
        .iq-ve-cube i:nth-child(3) { transform: rotateY(-90deg) translateZ(calc(var(--iq-ve-size) / 2)); background: rgba(7, 93, 232, 0.14); }
        .iq-ve-cube i:nth-child(4) { transform: rotateY(90deg) translateZ(calc(var(--iq-ve-size) / 2)); background: rgba(7, 93, 232, 0.14); }
        .iq-ve-cube i:nth-child(5) { transform: rotateX(90deg) translateZ(calc(var(--iq-ve-size) / 2)); background: rgba(7, 93, 232, 0.22); }
        .iq-ve-cube i:nth-child(6) { transform: rotateX(-90deg) translateZ(calc(var(--iq-ve-size) / 2)); background: rgba(7, 93, 232, 0.22); }
        .iq-ve-drop {
            position: absolute; left: 50%; bottom: 0.6rem; width: clamp(90px, 10vw, 136px); height: 22px;
            transform: translateX(-50%) scaleX(1); border-radius: 50%; opacity: 0.30;
            background: radial-gradient(50% 50% at 50% 50%, rgba(16, 44, 78, 0.55), rgba(16, 44, 78, 0));
            animation: iq-ve-drop 5.6s ease-in-out infinite;
        }
        .iq-ve-copy { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.3rem; text-align: center; padding: 0 1.25rem; }
        /* Headline / body / label straight off the DESIGN.md ramp: this is the page's
           one hero moment, so it takes the documented headline step rather than a
           bespoke size invented for it. */
