        .iq-ve-sub { font-size: 1rem; color: var(--bs-secondary-color); }
        .iq-ve-limit { font-size: 0.78rem; color: var(--bs-secondary-color); }
        /* Hover changes the viewing angle, never the spin's duration. Re-timing a
