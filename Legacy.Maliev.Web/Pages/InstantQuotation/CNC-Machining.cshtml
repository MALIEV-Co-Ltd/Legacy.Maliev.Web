            var summaryCard = CreateEl('div', 'iq-customer-summary');
            var summaryHost = CreateEl('div', 'iq-review-summary-host');
            var pricingHost = document.createElement('div');
            pricingHost.id = 'customer-pricing-summary';
            summaryHost.appendChild(pricingHost);
            summaryCard.appendChild(summaryHost);
            stickyFooter.appendChild(summaryCard);
            // The full breakdown, not just the total: this is the screen where the customer
            // commits, so the shipping and VAT lines that make up the figure stay visible.
            RenderPricingSummary(pricingHost, iqReviewText.customerSummaryTitle);
            var actions = document.createElement('div');
            actions.className = 'iq-config-summary-action iq-review-summary-action iq-customer-actions';
            var footer = modal.querySelector('.modal-footer');
            var submit = footer ? footer.querySelector('#submit-final-review-button') : null;
            if (submit) {
                submit.classList.add('iq-submit-btn');
                if (isLocalPreview) {
                    submit.disabled = true;
                    submit.textContent = iqReviewText.localPreviewSubmit;
                }
                actions.appendChild(submit);
            }
            summaryHost.appendChild(actions);
            panel.appendChild(stickyFooter);
            modal.remove();
            panel.dataset.ready = 'true';

            var description = document.getElementById('Description');
            var descriptionCount = document.getElementById('iq-description-count');
            function UpdateDescriptionCount() {
                if (description && descriptionCount) {
                    descriptionCount.textContent = String(description.value.length);
                }
            }
            if (description) { description.addEventListener('input', UpdateDescriptionCount); }
            UpdateDescriptionCount();

            // Conditional fields. Each one is asked only once the answer above it makes it
            // relevant, so the default form stays short: no tax number means no branch
            // question, and shipping to the billing address means no second address to type.
            var taxNumber = document.querySelector('[data-tax-number]');
            var taxBranchField = document.getElementById('tax-branch-field');
            var taxBranchSelect = document.getElementById('TaxBranch');
            var taxBranchCodeField = document.getElementById('tax-branch-code-field');
            var taxBranchCode = document.getElementById('TaxBranchCode');

            function SyncTaxBranch() {
                var hasTaxNumber = !!(taxNumber && taxNumber.value.trim());
                var isBranch = !!(taxBranchSelect && taxBranchSelect.value === 'branch');
                if (taxBranchField) { taxBranchField.hidden = !hasTaxNumber; }
                if (taxBranchCodeField) { taxBranchCodeField.hidden = !hasTaxNumber || !isBranch; }
                // Cleared rather than left behind: a stale branch code on a head-office
                // invoice is worse than an empty one, because it looks deliberate.
                if (taxBranchCode && taxBranchCodeField && taxBranchCodeField.hidden) { taxBranchCode.value = ''; }
            }

            if (taxNumber) { taxNumber.addEventListener('input', SyncTaxBranch); }
            if (taxBranchSelect) { taxBranchSelect.addEventListener('change', SyncTaxBranch); }
            SyncTaxBranch();

            var shipToBilling = document.querySelector('[data-ship-to-billing]');
            var shippingField = document.getElementById('shipping-address-field');
            // Mirrors the billing fields that carry a required marker. Building and the
            // second street line stay optional on both addresses.
            var requiredShippingIds = ['ShippingStreet1', 'ShippingCity', 'ShippingProvince', 'ShippingPostalCode', 'ShippingCountry'];

            function SyncShippingAddress() {
                var sameAddress = !shipToBilling || shipToBilling.checked;
                if (shippingField) { shippingField.hidden = sameAddress; }
                // The required flag follows visibility, or validation blocks submission on
                // fields the customer was never shown.
                requiredShippingIds.forEach(function (id) {
                    var field = document.getElementById(id);
                    if (!field) { return; }
                    if (sameAddress) {
                        field.removeAttribute('required');
                    } else {
                        field.setAttribute('required', 'required');
                    }
                });
            }

            if (shipToBilling) { shipToBilling.addEventListener('change', SyncShippingAddress); }
            SyncShippingAddress();

            var form = document.getElementById('instant-quotation-form');
            var finalSubmit = document.getElementById('submit-final-review-button');
            if (finalSubmit) {
                finalSubmit.addEventListener('click', function () {
                    if (!SyncCncSubmissionFields()) {
                        ShowSubmissionErrors(['@Localizer["Every CNC item needs a preliminary price before engineering review can be requested."]']);
                        return;
                    }
                    if (isLocalPreview || form.dataset.submitting === 'true') { return; }
                    if (!jQuery(form).valid()) {
                        PushInstantQuoteEvent('quote_submission_error', { failure_category: 'validation' });
                        return;
                    }
                    PushInstantQuoteEvent('quote_submit_attempt', {
                        intent: 'instant_quote',
                        has_files: utils.GetAllItemIds().length > 0,
                        file_upload_completed: utils.GetAllItemIds().every(function (id) {
                            var item = utils.GetItem(id);
                            return !!(item && item.uploadComplete);
                        })
                    });
                    // Serialize before disabling controls. jQuery excludes disabled controls,
                    // including the hidden antiforgery token and generated order-item fields.
                    var serializedForm = jQuery(form).serialize();
                    form.dataset.submitting = 'true';

                    // Disable every editable field so the customer cannot keep typing
                    // while the request is in flight. The submit button is handled
                    // separately below (it stays disabled-but-visible with a spinner).
                    var editableFields = form.querySelectorAll('input, select, textarea');
                    for (var i = 0; i < editableFields.length; i++) {
                        var field = editableFields[i];
                        if (field === finalSubmit || field.disabled) { continue; }
                        field.dataset.iqWasDisabled = 'true';
                        field.disabled = true;
                    }

                    finalSubmit.disabled = true;
                    finalSubmit.innerHTML =
                        '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> '
                        + '<span class="iq-submit-text">' + panel.dataset.sendingText + '</span>';

                    jQuery.ajax({
                        url: '@submitRequestUrl',
                        method: 'POST',
                        data: serializedForm,
                        dataType: 'json'
                    }).done(function (response) {
                        if (response && response.outcome === 'terminal' && response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                            return;
                        }
                        PushInstantQuoteEvent('quote_submission_error', { failure_category: 'validation' });
                        ShowSubmissionErrors((response && response.errors) || []);
                        RestoreSubmissionForm();
                    }).fail(function () {
                        PushInstantQuoteEvent('quote_submission_error', { failure_category: 'network' });
                        // A gateway timeout is ambiguous: the durable customer and order writes
                        // may still complete after the browser loses the response. Keep this
                        // submission locked so retrying cannot create duplicate records.
                        finalSubmit.disabled = true;
                        finalSubmit.textContent = '@culture' == 'th'
                            ? 'ไม่สามารถยืนยันสถานะการส่งได้'
                            : 'Submission status unknown';
                        ShowSubmissionErrors(['@culture' == 'th'
                            ? 'ไม่สามารถยืนยันได้ว่าระบบได้รับคำขอแล้วหรือไม่ โปรดอย่าส่งซ้ำ กรุณาติดต่อ info@maliev.com เพื่อให้เราตรวจสอบ'
                            : 'We could not confirm whether your request was received. Do not submit it again; please contact info@maliev.com so we can check it safely.']);
                    });
                });
            }

            function RestoreSubmissionForm() {
                var form = document.getElementById('instant-quotation-form');
                var finalSubmit = document.getElementById('submit-final-review-button');
                if (form) { form.dataset.submitting = ''; }
                if (finalSubmit) {
                    finalSubmit.disabled = false;
                    finalSubmit.textContent = panel.dataset.submitText;
                }
                if (!form) { return; }
                var disabledBySubmit = form.querySelectorAll('[data-iq-was-disabled="true"]');
                for (var i = 0; i < disabledBySubmit.length; i++) {
                    var field = disabledBySubmit[i];
                    field.disabled = false;
                    delete field.dataset.iqWasDisabled;
                }
            }
        }

        // Renders a submission failure the same way the server-rendered validation summary and
        // notification banner look, without navigating away — used when the AJAX final
        // submission reports outcome "retry" (nothing was created server-side, so the customer
        // can fix the highlighted problem and resubmit without losing any uploaded parts).
        function ShowSubmissionErrors(errors) {
            var container = document.getElementById('instant-quotation-validation');
            if (!container) { return; }
            var banner = document.getElementById('instant-quotation-banner');
            if (!banner) {
                banner = document.createElement('div');
                banner.id = 'instant-quotation-banner';
                banner.className = 'alert alert-danger alert-dismissible fade show mb-3';
                banner.setAttribute('role', 'alert');
                var text = document.createElement('small');
                text.id = 'instant-quotation-banner-text';
                banner.appendChild(text);
                var closeBtn = document.createElement('button');
                closeBtn.type = 'button';
                closeBtn.className = 'btn-close';
                closeBtn.setAttribute('data-bs-dismiss', 'alert');
                closeBtn.setAttribute('aria-label', 'Close');
                banner.appendChild(closeBtn);
                container.parentNode.insertBefore(banner, container);
            }
            document.getElementById('instant-quotation-banner-text').textContent =
                '@culture' == 'th' ? 'กรุณาแก้ไขข้อมูลที่ระบุไว้แล้วส่งอีกครั้ง' : 'Please correct the highlighted customer details and submit again.';

            container.className = 'text-danger small validation-summary-errors';
            var list = document.createElement('ul');
            errors.forEach(function (message) {
                var li = document.createElement('li');
                li.textContent = message;
                list.appendChild(li);
            });
            container.replaceChildren(list);
        }

        function CanBuildPreliminaryQuotation() {
            var ids = utils.GetAllItemIds();
            if (ids.length === 0) { return false; }

            for (var i = 0; i < ids.length; i++) {
                var item = utils.GetItem(ids[i]);
                if (!item || item.errorMessage || !item.modelInfo || !item.parseComplete || !item.uploadComplete
                    || !item.thumbnailComplete || item.cncStatus !== 'finalized' || !item.cncQuote || item.subtotalThb == null) {
                    return false;
                }
            }

            return !!latestOrderTotal && latestOrderTotal.finalOrderPrice != null;
        }

        function SyncPreliminaryQuotationButton() {
            var button = document.getElementById('preliminary-quotation-button');
            if (!button) { return; }
            button.disabled = !CanBuildPreliminaryQuotation();
            button.setAttribute('aria-disabled', button.disabled ? 'true' : 'false');
        }

        function EscapePreliminaryQuotationHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function PreliminaryQuotationValue(value) {
            return value == null || value === '' ? '—' : String(value);
        }

        function PreliminaryQuotationMoney(value) {
            return FormatMoney(value) + ' ' + displayCurrencyLabel;
        }

        function CropPreliminaryQuotationThumbnail(image) {
            if (!image || !image.src || !image.complete || !image.naturalWidth || !image.naturalHeight) {
                return image && image.src ? image.src : '/src/images/3d-canvas-placeholder.svg';
            }

            try {
                var sourceWidth = image.naturalWidth;
                var sourceHeight = image.naturalHeight;
                var canvas = document.createElement('canvas');
                canvas.width = sourceWidth;
                canvas.height = sourceHeight;
                var context = canvas.getContext('2d', { willReadFrequently: true });
                if (!context) { return image.src; }

                context.drawImage(image, 0, 0, sourceWidth, sourceHeight);
                var pixels = context.getImageData(0, 0, sourceWidth, sourceHeight).data;
                var minX = sourceWidth;
                var minY = sourceHeight;
                var maxX = -1;
                var maxY = -1;
                for (var y = 0; y < sourceHeight; y++) {
                    for (var x = 0; x < sourceWidth; x++) {
                        var offset = (y * sourceWidth + x) * 4;
                        var isVisible = pixels[offset + 3] > 0
                            && (pixels[offset] < 245 || pixels[offset + 1] < 245 || pixels[offset + 2] < 245);
                        if (!isVisible) { continue; }
                        minX = Math.min(minX, x);
                        minY = Math.min(minY, y);
                        maxX = Math.max(maxX, x);
                        maxY = Math.max(maxY, y);
                    }
                }

                if (maxX < minX || maxY < minY) { return image.src; }

                var boundsWidth = maxX - minX + 1;
                var boundsHeight = maxY - minY + 1;
                var paddingX = Math.max(4, Math.round(boundsWidth * 0.12));
                var paddingY = Math.max(4, Math.round(boundsHeight * 0.12));
                var cropX = Math.max(0, minX - paddingX);
                var cropY = Math.max(0, minY - paddingY);
                var cropRight = Math.min(sourceWidth, maxX + 1 + paddingX);
                var cropBottom = Math.min(sourceHeight, maxY + 1 + paddingY);
                var cropWidth = cropRight - cropX;
                var cropHeight = cropBottom - cropY;
                var outputWidth = 320;
                var outputHeight = Math.max(1, Math.round(outputWidth * cropHeight / cropWidth));
                var output = document.createElement('canvas');
                output.width = outputWidth;
                output.height = outputHeight;
                var outputContext = output.getContext('2d');
                if (!outputContext) { return image.src; }
                outputContext.fillStyle = '#fff';
                outputContext.fillRect(0, 0, outputWidth, outputHeight);
                outputContext.drawImage(canvas, cropX, cropY, cropWidth, cropHeight, 0, 0, outputWidth, outputHeight);
                return output.toDataURL('image/png');
            } catch (error) {
                return image.src;
            }
        }

        function BuildPreliminaryQuotationSnapshot() {
            var items = [];
            utils.GetAllItemIds().forEach(function (id) {
                var item = utils.GetItem(id);
                if (!item || !item.modelInfo) { return; }

                var info = item.modelInfo;
                var thumbnail = document.getElementById('item-snapshot-' + id);
                var unitPrice = document.getElementById('item-estimated-unit-cost-' + id);
                var unitTime = document.getElementById('item-estimated-unit-time-' + id);
                var subtotal = document.getElementById('item-estimated-total-cost-' + id);
                var totalTime = document.getElementById('item-estimated-total-time-' + id);
                var dfmAlerts = BuildDfmAlerts(info, '@culture', 'cnc');

                items.push({
                    index: items.length + 1,
                    fileName: item.file.name,
                    thumbnail: thumbnail ? CropPreliminaryQuotationThumbnail(thumbnail) : '/src/images/3d-canvas-placeholder.svg',
                    material: item.cncAlloy || item.material || '6061',
                    quantity: NormalizeReviewQuantity(item.quantity, 1),
                    unitPrice: unitPrice && unitPrice.value ? unitPrice.value : '—',
                    subtotal: subtotal && subtotal.value ? subtotal.value : '—',
                    unitTime: unitTime && unitTime.value ? unitTime.value : '—',
                    totalTime: totalTime && totalTime.value ? totalTime.value : '—',
                    dimensions: ToTwoDecimalPoint(info.size.x) + ' × ' + ToTwoDecimalPoint(info.size.y) + ' × ' + ToTwoDecimalPoint(info.size.z) + ' mm',
                    volume: ToTwoDecimalPoint(info.volume / 1000) + ' cm³',
                    surfaceArea: ToTwoDecimalPoint(info.surfaceAreaMm2 / 100) + ' cm²',
                    minThickness: ToTwoDecimalPoint(info.minThicknessMm) + ' mm',
                    dfmAlerts: dfmAlerts
                });
            });

            return {
                items: items,
                orderTotal: {
                    itemsSubtotal: latestOrderTotal.itemsSubtotal || 0,
                    minimumOrderPrice: latestOrderTotal.minimumOrderPrice || 0,
                    minimumOrderSurcharge: latestOrderTotal.minimumOrderSurcharge || 0,
                    shipping: latestOrderTotal.shipping || 0,
                    vat: latestOrderTotal.vat || 0,
                    finalOrderPrice: latestOrderTotal.finalOrderPrice || 0
                },
                leadTime: PreliminaryQuotationValue(document.getElementById('total-estimated-time') && document.getElementById('total-estimated-time').textContent),
                currency: displayCurrencyLabel,
                generatedAt: new Date().toLocaleString(iqCulture === 'th' ? 'th-TH' : 'en-GB', {
                    timeZone: 'Asia/Bangkok',
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                })
            };
        }

        // temporary browser-side quotation bridge: this uses the rendered review state and
        // native browser print-to-PDF while the legacy iText7 path is being migrated. The
        // proper long-term implementation must be rendered through PDFService instead.
        function BuildPreliminaryQuotationDocument(snapshot) {
            function Html(value) { return EscapePreliminaryQuotationHtml(value); }
            var logoUrl = quotationLogoDataUri;

            function Field(label, value, modifier) {
                return '<div class="iq-preliminary-quotation-field' + (modifier ? ' ' + modifier : '') + '">'
                    + '<dt>' + Html(label) + '</dt><dd>' + Html(PreliminaryQuotationValue(value)) + '</dd></div>';
            }

            function DfmMarkup(part) {
                if (!part.dfmAlerts || part.dfmAlerts.length === 0) {
                    return '<div class="iq-preliminary-quotation-dfm-ok"><span aria-hidden="true">✓</span>'
                        + Html(iqReviewText.dfmNoIssues) + '</div>';
                }

                return part.dfmAlerts.map(function (alert) {
                    return '<div class="iq-preliminary-quotation-dfm-alert ' + Html(alert.level) + '">'
                        + '<span class="iq-preliminary-quotation-dfm-icon" aria-hidden="true">'
                        + (alert.level === 'danger' ? '!' : '⚠') + '</span>'
                        + '<div><strong>' + Html(alert.title) + '</strong><span>' + Html(alert.subtitle) + '</span></div>'
                        + '</div>';
                }).join('');
            }

            var partMarkup = snapshot.items.map(function (part) {
