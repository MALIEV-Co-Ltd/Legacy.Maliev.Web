                                                <small class="d-block">@(culture == "th" ? "จำเป็นเมื่อเลือกให้ระบุเกลียวในแบบ หรือใช้ค่าคลาดเคลื่อนที่เข้มงวด" : "Required when threads are specified on the drawing or tighter tolerances are selected.")</small>
                                            </div>
                                            <div class="iq-settings-group">
                                                <label class="iq-section-label" for="cnc-requirements-note">@Localizer["Requirements or drawing note"]</label>
                                                <textarea id="cnc-requirements-note" class="form-control form-control-sm" data-cnc-note maxlength="2000" rows="2" placeholder="@(culture == "th" ? "ระบุมิติสำคัญ ดาตัม ผิวสำเร็จ และข้อกำหนดการตรวจสอบ" : "Add critical dimensions, datum, surface finish, and inspection notes")" oninput="OnCncRequirementsChange();"></textarea>
                                            </div>
                                        </div>
                                    </section>
                                    <section class="iq-cnc-settings-section" data-cnc-settings-section="finish-inspection">
                                        <div>
                                            <h2 class="iq-cnc-section-title"><i class="fas fa-check-circle" aria-hidden="true"></i><span>@(culture == "th" ? "ผิวสำเร็จและการตรวจสอบ" : "Surface finish and inspection")</span></h2>
                                            <p class="iq-cnc-section-copy">@(culture == "th" ? "ราคาผิวสำเร็จที่รองรับรวมในราคาประเมินทันที" : "Supported finishing is included in the estimate immediately.")</p>
                                        </div>
                                        <fieldset class="iq-settings-group" data-cnc-requirements>
                                            <legend id="cnc-roughness-label" class="iq-section-label mb-0">@Localizer["Surface roughness"]</legend>
                                            <label class="visually-hidden" for="cnc-roughness-select">@Localizer["Surface roughness"]</label>
                                            <select id="cnc-roughness-select" class="form-select form-select-sm" data-cnc-roughness onchange="OnCncRequirementsChange();"><option value="default">@Localizer["Default machined"]</option><option value="3.2">Ra 3.2</option><option value="1.6">Ra 1.6</option><option value="tight">@Localizer["Tighter roughness"]</option></select>
                                        </fieldset>
                                        <div class="iq-settings-group">
                                            <label class="iq-section-label" for="cnc-finish-select">@Localizer["Surface finish"]</label>
                                            <select id="cnc-finish-select" class="form-select form-select-sm" data-cnc-finish onchange="OnCncRequirementsChange();"><option value="none">@(culture == "th" ? "ผิวแมชชีนมาตรฐาน (รวมแล้ว)" : "Standard machined (included)")</option><option value="anodize-clear">@(culture == "th" ? "อะโนไดซ์ใส" : "Clear anodize")</option><option value="sand-blast">@(culture == "th" ? "พ่นทราย (เม็ดแก้วละเอียด)" : "Sand blasting (fine glass bead)")</option></select>
                                            <span class="iq-cnc-finish-price" data-cnc-finish-price aria-live="polite">@(culture == "th" ? "รวมในราคาแล้ว" : "Included")</span>
                                        </div>
                                        <fieldset class="iq-settings-group" data-cnc-requirements>
                                            <legend id="cnc-inspection-label" class="iq-section-label mb-0">@Localizer["Inspection"]</legend>
                                            <label class="visually-hidden" for="cnc-inspection-select">@Localizer["Inspection"]</label>
                                            <select id="cnc-inspection-select" class="form-select form-select-sm" data-cnc-inspection onchange="OnCncRequirementsChange();"><option value="standard">@Localizer["Standard inspection"]</option><option value="report">@Localizer["Dimensional report"]</option><option value="enhanced">@Localizer["Enhanced inspection"]</option></select>
                                            <label class="mt-1"><input type="checkbox" data-cnc-certificate onchange="OnCncRequirementsChange();" /> @Localizer["Material certificate"]</label>
                                            <span class="iq-cnc-finish-price" data-cnc-certificate-price aria-live="polite" hidden></span>
                                        </fieldset>
                                    </section>


                                    <section class="iq-settings-group iq-settings-quantity iq-cnc-settings-section" data-cnc-settings-section="quantity">
                                        <div><h2 class="iq-cnc-section-title"><i class="fas fa-layer-group" aria-hidden="true"></i><span>@(culture == "th" ? "จำนวนและระดับราคา" : "Quantity and price tiers")</span></h2><p class="iq-cnc-section-copy">@(culture == "th" ? "แต่ละระดับคำนวณใหม่จากชิ้นงาน วัสดุ และข้อกำหนดปัจจุบัน" : "Each tier is recalculated from the current part, material, and requirements.")</p></div>
                                        <div class="iq-qty-heading-row"><label class="iq-section-label mb-0" for="quantity-input">@Localizer["Quantity"]</label></div>
                                        <div class="iq-quantity-input-row">
                                            <input id="quantity-input" type="number" min="1" step="1" max="1000" value="1" class="form-control form-control-sm iq-qty-input" oninput="ForceInputNumberInRange(this,1,1000); OnQuantityInput();" />
                                            <span class="iq-qty-hint">@(culture == "th" ? "มากสุด 1,000 ชิ้น" : "Maximum 1,000 pieces")</span>
                                        </div>
                                        <div class="table-responsive"><table id="cnc-bulk-pricing-table" class="iq-bulk-table"><thead><tr><th>@Localizer["Quantity"]</th><th class="text-end">@Localizer["Unit price"]</th></tr></thead><tbody id="bulk-table-body"></tbody></table></div>
                                    </section>

                            </aside>
                        </section>


                            <section id="cnc-dimensional-fallback" class="iq-card iq-settings-card" data-cnc-dimensional-fallback hidden>
                                <h2 class="iq-settings-hd">@Localizer["Add part dimensions for a preliminary CNC price"]</h2>
                                <p class="small mb-2">@Localizer["We could not read the model. Enter positive finished dimensions in millimetres; engineering will review the estimate."]</p>
                                <div class="row g-2"><div class="col-4"><label for="cnc-dimension-x">X (mm)</label><input id="cnc-dimension-x" class="form-control" type="number" min="0.01" step="0.01" data-cnc-dimension="x" oninput="OnCncRequirementsChange();" /></div><div class="col-4"><label for="cnc-dimension-y">Y (mm)</label><input id="cnc-dimension-y" class="form-control" type="number" min="0.01" step="0.01" data-cnc-dimension="y" oninput="OnCncRequirementsChange();" /></div><div class="col-4"><label for="cnc-dimension-z">Z (mm)</label><input id="cnc-dimension-z" class="form-control" type="number" min="0.01" step="0.01" data-cnc-dimension="z" oninput="OnCncRequirementsChange();" /></div></div>
                            </section>

                    </div>
                    <div id="customer-details-panel" class="iq-config-scroll iq-customer-panel" hidden data-back-text="@Localizer["Back"]" data-title-text="@Localizer["Customer details"]" data-step-text="@(culture == "th" ? "ขั้นตอนที่ 3 จาก 3" : "Step 3 of 3")" data-sending-text="@(culture == "th" ? "กำลังส่ง..." : "Submitting...")" data-submit-text="@(culture == "th" ? "ส่งไฟล์ให้ตรวจสอบ" : "Submit for final review")"></div>
                    <div id="finalization-panel" class="iq-config-scroll iq-customer-panel" hidden data-back-text="@Localizer["Back"]" data-title-text="@(culture == "th" ? "ตรวจสอบรายการ" : "Review order items")" data-continue-text="@(culture == "th" ? "ดำเนินการกรอกข้อมูลลูกค้า" : "Continue to customer details")"></div>

                        <div id="cnc-review-live-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>


                    <div id="configuration-bottom-row" class="iq-bottom-row iq-configuration-bottom-row">
                        @* This host id remains stable because the review step moves the same
                           metrics card into its footer and returns it here. *@
                        <div id="configuration-metrics-host" class="iq-config-metrics-host">
                            <section id="iq-metrics-card" class="iq-card iq-metrics-card">
                                                <div class="iq-file-header" id="active-file-name">@Localizer["No file selected"]</div>
                                                <div class="iq-part-rows">
                                                    <div class="iq-part-row"><span>@Localizer["Dimensions"] (mm)</span><b id="file-info-dimensions">&mdash;</b></div>

                                                        <div class="iq-part-row"><span>@(culture == "th" ? "ปริมาตรชิ้นงาน" : "Part volume")</span><b id="file-info-volume" data-cnc-metric="part-volume">&mdash;</b></div>
                                                        <div class="iq-part-row iq-cnc-metric-row"><span>@(culture == "th" ? "ประเภทสต็อก" : "Stock form")</span><b data-cnc-metric="stock-form">&mdash;</b></div>
                                                        <div class="iq-part-row iq-cnc-metric-row"><span>@(culture == "th" ? "ขนาดสต็อก" : "Stock size")</span><b data-cnc-metric="stock-size">&mdash;</b></div>
                                                        <div class="iq-part-row iq-cnc-metric-row"><span>@(culture == "th" ? "ปริมาตรสต็อก" : "Stock volume")</span><b data-cnc-metric="stock-volume">&mdash;</b></div>
                                                        <div class="iq-part-row iq-cnc-metric-row"><span>@(culture == "th" ? "วัสดุที่ตัดออกโดยประมาณ" : "Estimated material removed")</span><b data-cnc-metric="removal-volume">&mdash;</b></div>
                                                        <div class="iq-part-row iq-cnc-metric-row"><span>@(culture == "th" ? "จำนวนการตั้งงาน" : "Setup count")</span><b data-cnc-metric="setup-count">&mdash;</b></div>
                                                        <div class="iq-part-row iq-cnc-metric-row"><span>@(culture == "th" ? "เวลาแมชชีนโดยประมาณ" : "Estimated machining time")</span><b data-cnc-metric="machining-time">&mdash;</b></div>

                                                    <div class="iq-part-row"><span>@Localizer["Surface area"]</span><b id="file-info-surface">&mdash;</b></div>
                                                    <div class="iq-part-row"><span>@Localizer["Min. thickness"]</span><b id="file-info-thickness">&mdash;</b></div>
                                                </div>
                                                <div class="iq-dfm iq-part-verdict">
                                                    <div class="hd">DFM Analysis <i class="fas fa-info-circle" title="@Localizer["Design-for-manufacturing checks"]" aria-hidden="true"></i></div>
                                                    <div id="dfm-alerts"></div>
                                                </div>
                            </section>
                        </div>
                        <div class="iq-config-summary-host">
                            @* Canonical live values remain available to the viewer utility;
                               all three visible summaries are rendered from latestOrderTotal. *@
                            <span id="total-estimated-cost" class="visually-hidden">&mdash;</span>
                            <span id="total-estimated-time" class="visually-hidden">&mdash;</span>
                            <div id="configuration-pricing-summary" class="iq-review-pricing-host" role="status" aria-live="polite" aria-atomic="true"></div>
                            <section id="cnc-quotation-result" class="iq-review-pricing-host" role="status" aria-live="polite" aria-atomic="true" hidden></section>
                            <span id="iq-price-confidence" class="iq-price-confidence" hidden></span>
                            <div class="iq-config-summary-action">
                                <button id="submit-gate" type="button" class="btn btn-primary iq-submit-btn" onclick="OpenOrderSummary();" disabled>@Localizer["Start by uploading a file"]</button>
                                @if (Model.IsDevelopmentCustomerFixture)
                                {
                                    <button id="development-customer-preview" type="button" class="btn btn-outline-secondary iq-secondary-door" onclick="ContinueToCustomerDetails();" disabled aria-disabled="true">
                                        <i class="fas fa-flask" aria-hidden="true"></i>
                                        @(culture == "th" ? "ดูตัวอย่างข้อมูลลูกค้า" : "Preview customer details")
                                    </button>
                                }
                                <div class="iq-summary-contact-actions">
                                                    @* The second door. Instant Quotation and speaking to a person are
                                                       both first-class conversions, and self-serve pricing does not fit
                                                       every project — but this page previously offered no route to a
                                                       human at all, not even from a manufacturability warning.
                                                       It opens upward because it sits at the bottom of the column, and
                                                       every channel opens in a new tab: a configured quote only lives in
                                                       this tab's memory, so navigating away discards the customer's work.
                                                       Bootstrap positions the menu inside a subtree that sets
                                                       overflow: hidden, hence the fixed positioning strategy. *@
                                <div class="dropup iq-secondary-door-group">
                                    <button class="iq-secondary-door" type="button" id="talk-to-engineer" data-bs-toggle="dropdown" data-bs-strategy="fixed" aria-expanded="false">
                                        <i class="fas fa-comments" aria-hidden="true"></i>
                                        @(culture == "th" ? "ปรึกษาวิศวกร" : "Talk to an engineer")
                                        <i class="fas fa-chevron-up iq-secondary-door-caret" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu iq-contact-menu" aria-labelledby="talk-to-engineer" data-contact-placement="instant_quotation_engineer">
                                        <li>
                                            <a class="dropdown-item" href="@Legacy.Maliev.Web.Application.SocialNetworks.Line" target="_blank" rel="noopener">
                                                <i class="fab fa-line iq-contact-icon iq-contact-line" aria-hidden="true"></i>
                                                <span>LINE OA (@@maliev)</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="@Legacy.Maliev.Web.Application.SocialNetworks.WhatsApp" target="_blank" rel="noopener">
                                                <i class="fab fa-whatsapp iq-contact-icon iq-contact-whatsapp" aria-hidden="true"></i>
                                                <span>WhatsApp</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="@Legacy.Maliev.Web.Application.SocialNetworks.MessengerChat" target="_blank" rel="noopener">
                                                <i class="fab fa-facebook-messenger iq-contact-icon iq-contact-messenger" aria-hidden="true"></i>
                                                <span>Messenger</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item" href="/contact#contact-us" target="_blank" rel="noopener">
                                                <i class="fas fa-envelope iq-contact-icon" aria-hidden="true"></i>
                                                <span>@(culture == "th" ? "หน้าติดต่อเรา" : "Contact us page")</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                </div>
                                                    @* Points at the documents that actually govern this, rather than
                                                       asserting safety with a padlock emoji at 9.9px. *@
                                <div class="safe">
                                    <i class="fas fa-shield-halved" aria-hidden="true"></i>
                                    <a href="/legal/privacypolicy">@Localizer["Privacy Policy"]</a>
                                    &middot;
                                    <a href="/legal/nondisclosureagreement">@Localizer["Non-Disclosure Agreement"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade px-0" id="submit-order-modal" tabindex="-1" role="dialog" aria-hidden="true" hidden>
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title">@Localizer["Ready for manufacturing"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        </button>
                    </div>
                    <div class="modal-body quotation-modal-body">
                        <div class="iq-customer-sections">
                            <section class="iq-customer-section" aria-labelledby="iq-contact-title">
                                <div class="iq-customer-section-heading">
                                    <span class="iq-customer-section-index" aria-hidden="true">1</span>
                                    <div>
                                        <h3 id="iq-contact-title">@reviewText["customerContactTitle"]</h3>
                                        <p>@reviewText["customerContactDescription"]</p>
                                        @if (User?.Identity?.IsAuthenticated == true)
                                        {
                                            <p class="mb-0 text-muted">@(culture == "th" ? "ข้อมูลที่บันทึกในบัญชีแล้วจะถูกล็อก ส่วนข้อมูลที่ยังไม่มีสามารถกรอกเพิ่มเติมได้ที่นี่" : "Saved account details are locked. You can complete any information that is still missing.")</p>
                                        }
                                    </div>
                                </div>
                                <div class="iq-customer-fields">
                                    <div class="iq-customer-field">
                                        <label asp-for="FirstName">@(culture == "th" ? "ชื่อ" : "First name") <span class="iq-required" aria-hidden="true">*</span></label>
                                        <input type="text" class="form-control form-control-sm" asp-for="FirstName" autocomplete="given-name" placeholder="@(culture == "th" ? "กรอกชื่อ" : "Enter your first name")" readonly="@(Model.IsAccountValueLocked(nameof(Model.FirstName)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.FirstName)) ? "true" : "false")">
                                        <small><span asp-validation-for="FirstName" class="text-danger"></span></small>
                                    </div>
                                    <div class="iq-customer-field">
                                        <label asp-for="LastName">@(culture == "th" ? "นามสกุล" : "Last name") <span class="iq-required" aria-hidden="true">*</span></label>
                                        <input type="text" class="form-control form-control-sm" asp-for="LastName" autocomplete="family-name" placeholder="@(culture == "th" ? "กรอกนามสกุล" : "Enter your last name")" readonly="@(Model.IsAccountValueLocked(nameof(Model.LastName)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.LastName)) ? "true" : "false")">
                                        <small><span asp-validation-for="LastName" class="text-danger"></span></small>
                                    </div>
                                    <div class="iq-customer-field">
                                        <label asp-for="Email">@(culture == "th" ? "อีเมลสำหรับติดต่อ" : "Work email") <span class="iq-required" aria-hidden="true">*</span></label>
                                        <input type="email" class="form-control form-control-sm" asp-for="Email" autocomplete="email" inputmode="email" placeholder="name@company.com" data-live-email data-live-email-invalid='@(culture == "th" ? "กรุณากรอกอีเมลที่ถูกต้อง" : "Please enter a valid email address")' aria-describedby="instant-email-feedback" readonly="@(Model.IsAccountValueLocked(nameof(Model.Email)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.Email)) ? "true" : "false")">
                                        <small><span asp-validation-for="Email" class="text-danger"></span><span id="instant-email-feedback" class="text-danger" data-email-feedback hidden></span></small>
                                    </div>
                                    <div class="iq-customer-field">
                                        <label asp-for="Mobile">@(culture == "th" ? "เบอร์มือถือ" : "Mobile number") <span class="iq-required" aria-hidden="true">*</span></label>
                                        <input type="tel" class="form-control form-control-sm" asp-for="Mobile" autocomplete="mobile tel" inputmode="tel" placeholder="@(culture == "th" ? "เช่น 089 895 0690" : "e.g. 089 895 0690")" readonly="@(Model.IsAccountValueLocked(nameof(Model.Mobile)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.Mobile)) ? "true" : "false")">
                                        <small><span asp-validation-for="Mobile" class="text-danger"></span></small>
                                    </div>
                                    @* The office line is genuinely optional in Thailand, where a
                                       mobile is how the shop reaches a customer about a job. *@
                                    <div class="iq-customer-field">
                                        <label asp-for="Telephone">@(culture == "th" ? "เบอร์สำนักงาน (ไม่บังคับ)" : "Office phone (optional)")</label>
                                        <input type="tel" class="form-control form-control-sm" asp-for="Telephone" autocomplete="tel" placeholder="@(culture == "th" ? "เช่น 02 123 4567" : "e.g. +66 2 123 4567")" readonly="@(Model.IsAccountValueLocked(nameof(Model.Telephone)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.Telephone)) ? "true" : "false")">
                                        <small><span asp-validation-for="Telephone" class="text-danger"></span></small>
                                    </div>
                                </div>
                            </section>

                            <section class="iq-customer-section" aria-labelledby="iq-company-title">
                                <div class="iq-customer-section-heading">
                                    <span class="iq-customer-section-index" aria-hidden="true">2</span>
                                    <div>
                                        <h3 id="iq-company-title">@reviewText["customerCompanyTitle"]</h3>
                                        <p>@reviewText["customerCompanyDescription"]</p>
                                    </div>
                                </div>
                                <div class="iq-customer-fields">
                                    <div class="iq-customer-field">
                                        <label asp-for="Company">@(culture == "th" ? "ชื่อบริษัท (ไม่บังคับ)" : "Company name (optional)")</label>
                                        <input type="text" class="form-control form-control-sm" asp-for="Company" autocomplete="organization" placeholder="@(culture == "th" ? "กรอกชื่อบริษัท" : "Enter your company name")" readonly="@(Model.IsAccountValueLocked(nameof(Model.Company)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.Company)) ? "true" : "false")">
                                        <small><span asp-validation-for="Company" class="text-danger"></span></small>
                                    </div>
                                    <div class="iq-customer-field">
                                        <label asp-for="TaxNumber">@(culture == "th" ? "เลขประจำตัวผู้เสียภาษี (ไม่บังคับ)" : "Tax number (optional)")</label>
                                        <input type="text" class="form-control form-control-sm" asp-for="TaxNumber" autocomplete="off" inputmode="numeric" maxlength="13" placeholder="e.g. 0105559123456" data-tax-number readonly="@(Model.IsAccountValueLocked(nameof(Model.TaxNumber)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.TaxNumber)) ? "true" : "false")">
                                        <small><span asp-validation-for="TaxNumber" class="text-danger"></span></small>
                                    </div>
                                    @* A Thai tax invoice names the branch it is issued to, and an
                                       invoice addressed to the wrong one is unusable for the
                                       customer's VAT filing. Only asked once a tax number exists. *@
                                    @* A select rather than the segmented control used for build
                                       preference: that pattern hides its radios at 1x1 and relies
                                       on the labels being the target, which is fine beside a
                                       preview but not in a form where every control is expected
                                       to be a real touch target. Two options also do not earn
                                       the extra width here. *@
                                    <div class="iq-customer-field" id="tax-branch-field" hidden>
                                        <label asp-for="TaxBranch">@(culture == "th" ? "สาขาที่ออกใบกำกับภาษี" : "Tax invoice issued to")</label>
                                        @if (Model.IsAccountValueLocked(nameof(Model.TaxBranch)))
                                        {
                                            <input type="hidden" asp-for="TaxBranch">
                                        }
                                        <select asp-for="TaxBranch" class="form-control form-control-sm form-select" disabled="@(Model.IsAccountValueLocked(nameof(Model.TaxBranch)) ? "disabled" : null)" aria-disabled="@(Model.IsAccountValueLocked(nameof(Model.TaxBranch)) ? "true" : "false")">
                                            <option value="head-office">@(culture == "th" ? "สำนักงานใหญ่" : "Head office")</option>
                                            <option value="branch">@(culture == "th" ? "สาขา" : "Branch")</option>
                                        </select>
                                    </div>
                                    <div class="iq-customer-field" id="tax-branch-code-field" hidden>
                                        <label asp-for="TaxBranchCode">@(culture == "th" ? "รหัสสาขา" : "Branch code")</label>
                                        <input type="text" class="form-control form-control-sm" asp-for="TaxBranchCode" autocomplete="off" inputmode="numeric" maxlength="5" placeholder="@(culture == "th" ? "เช่น 00001" : "e.g. 00001")" readonly="@(Model.IsAccountValueLocked(nameof(Model.TaxBranchCode)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.TaxBranchCode)) ? "true" : "false")">
                                        <small><span asp-validation-for="TaxBranchCode" class="text-danger"></span></small>
                                    </div>
                                    @* Discrete fields, not one free-text box: these transcribe
                                       straight into the customer record's address columns.
                                       A single textarea would have to be re-keyed by hand,
                                       which is the work this form exists to remove. *@
                                    <div class="iq-address-group iq-customer-field--wide">
                                        <span class="iq-field-caption">@(culture == "th" ? "ที่อยู่สำหรับออกใบกำกับภาษี" : "Billing address")</span>
                                        <div class="iq-address-fields">
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="BillingBuilding">@(culture == "th" ? "อาคาร/หมู่บ้าน (ไม่บังคับ)" : "Building (optional)")</label>
                                                <input type="text" class="form-control form-control-sm" asp-for="BillingBuilding" autocomplete="billing address-line3" maxlength="128" readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingBuilding)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingBuilding)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="BillingStreet1">@(culture == "th" ? "ที่อยู่ บรรทัดที่ 1" : "Street address 1") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="BillingStreet1" autocomplete="billing address-line1" maxlength="256" placeholder="@(culture == "th" ? "เลขที่ ซอย ถนน" : "House number, soi, road")" readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingStreet1)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingStreet1)) ? "true" : "false")">
                                                <small><span asp-validation-for="BillingStreet1" class="text-danger"></span></small>
                                            </div>
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="BillingStreet2">@(culture == "th" ? "แขวง/ตำบล (ไม่บังคับ)" : "Street address 2 (optional)")</label>
                                                <input type="text" class="form-control form-control-sm" asp-for="BillingStreet2" autocomplete="billing address-line2" maxlength="256" readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingStreet2)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingStreet2)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field">
                                                <label asp-for="BillingCity">@(culture == "th" ? "เขต/อำเภอ" : "City") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="BillingCity" autocomplete="billing address-level2" maxlength="128" readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingCity)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingCity)) ? "true" : "false")">
                                                <small><span asp-validation-for="BillingCity" class="text-danger"></span></small>
                                            </div>
                                            <div class="iq-customer-field">
                                                <label asp-for="BillingProvince">@(culture == "th" ? "จังหวัด" : "State / province") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="BillingProvince" autocomplete="billing address-level1" maxlength="128" readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingProvince)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingProvince)) ? "true" : "false")">
                                                <small><span asp-validation-for="BillingProvince" class="text-danger"></span></small>
                                            </div>
                                            <div class="iq-customer-field">
                                                <label asp-for="BillingPostalCode">@(culture == "th" ? "รหัสไปรษณีย์" : "Postal code") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="BillingPostalCode" autocomplete="billing postal-code" inputmode="numeric" maxlength="10" readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingPostalCode)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.BillingPostalCode)) ? "true" : "false")">
                                                <small><span asp-validation-for="BillingPostalCode" class="text-danger"></span></small>
                                            </div>
                                        </div>
                                    </div>
                                    @* The label is a sibling with an explicit for, not a wrapper:
                                       every control on this form is addressable by its own label,
                                       which is what the screen-reader contract here relies on. *@
                                    <div class="iq-customer-field iq-customer-field--wide">
                                        <div class="iq-checkbox">
                                            <input type="checkbox" asp-for="ShipToBillingAddress" data-ship-to-billing disabled="@(Model.IsAccountValueLocked(nameof(Model.ShipToBillingAddress)) ? "disabled" : null)" aria-disabled="@(Model.IsAccountValueLocked(nameof(Model.ShipToBillingAddress)) ? "true" : "false")">
                                            @if (Model.IsAccountValueLocked(nameof(Model.ShipToBillingAddress)))
                                            {
                                                <input type="hidden" asp-for="ShipToBillingAddress">
                                            }
                                            <label asp-for="ShipToBillingAddress">@(culture == "th" ? "จัดส่งตามที่อยู่ใบกำกับภาษี" : "Ship to the billing address")</label>
                                        </div>
                                    </div>
                                    <div class="iq-address-group iq-customer-field--wide" id="shipping-address-field" hidden>
                                        <span class="iq-field-caption">@(culture == "th" ? "ที่อยู่จัดส่ง" : "Shipping address")</span>
                                        <div class="iq-address-fields">
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="ShippingBuilding">@(culture == "th" ? "อาคาร/หมู่บ้าน (ไม่บังคับ)" : "Building (optional)")</label>
                                                <input type="text" class="form-control form-control-sm" asp-for="ShippingBuilding" autocomplete="shipping address-line3" maxlength="128" readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingBuilding)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingBuilding)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="ShippingStreet1">@(culture == "th" ? "ที่อยู่ บรรทัดที่ 1" : "Street address 1") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="ShippingStreet1" autocomplete="shipping address-line1" maxlength="256" placeholder="@(culture == "th" ? "เลขที่ ซอย ถนน" : "House number, soi, road")" readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingStreet1)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingStreet1)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="ShippingStreet2">@(culture == "th" ? "แขวง/ตำบล (ไม่บังคับ)" : "Street address 2 (optional)")</label>
                                                <input type="text" class="form-control form-control-sm" asp-for="ShippingStreet2" autocomplete="shipping address-line2" maxlength="256" readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingStreet2)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingStreet2)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field">
                                                <label asp-for="ShippingCity">@(culture == "th" ? "เขต/อำเภอ" : "City") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="ShippingCity" autocomplete="shipping address-level2" maxlength="128" readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingCity)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingCity)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field">
                                                <label asp-for="ShippingProvince">@(culture == "th" ? "จังหวัด" : "State / province") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="ShippingProvince" autocomplete="shipping address-level1" maxlength="128" readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingProvince)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingProvince)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field">
                                                <label asp-for="ShippingPostalCode">@(culture == "th" ? "รหัสไปรษณีย์" : "Postal code") <span class="iq-required" aria-hidden="true">*</span></label>
                                                <input type="text" class="form-control form-control-sm" asp-for="ShippingPostalCode" autocomplete="shipping postal-code" inputmode="numeric" maxlength="10" readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingPostalCode)) ? "readonly" : null)" aria-readonly="@(Model.IsAccountValueLocked(nameof(Model.ShippingPostalCode)) ? "true" : "false")">
                                            </div>
                                            <div class="iq-customer-field iq-customer-field--wide">
                                                <label asp-for="ShippingCountry">@(culture == "th" ? "ประเทศ" : "Country") <span class="iq-required" aria-hidden="true">*</span></label>
                                                @if (Model.IsAccountValueLocked(nameof(Model.ShippingCountry)))
                                                {
                                                    <input type="hidden" asp-for="ShippingCountry">
                                                }
                                                <select asp-for="ShippingCountry" class="form-control form-control-sm form-select" autocomplete="shipping country-name" disabled="@(Model.IsAccountValueLocked(nameof(Model.ShippingCountry)) ? "disabled" : null)" aria-disabled="@(Model.IsAccountValueLocked(nameof(Model.ShippingCountry)) ? "true" : "false")">
                                                    <option value="" hidden disabled selected>@Localizer["Please select your country"]</option>
                                                    @foreach (var country in Model.Countries ?? [])
                                                    {
                                                        <option value="@country.Name">@country.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="iq-customer-field iq-customer-field--wide">
                                        <label asp-for="Country">@(culture == "th" ? "ประเทศ" : "Country") <span class="iq-required" aria-hidden="true">*</span></label>
                                        @if (Model.IsAccountValueLocked(nameof(Model.Country)))
                                        {
                                            <input type="hidden" asp-for="Country">
                                        }
                                        <select asp-for="Country" class="form-control form-control-sm form-select" autocomplete="country-name" data-auto-country disabled="@(Model.IsAccountValueLocked(nameof(Model.Country)) ? "disabled" : null)" aria-disabled="@(Model.IsAccountValueLocked(nameof(Model.Country)) ? "true" : "false")">
                                            <option value="" hidden disabled selected>@Localizer["Please select your country"]</option>
                                            @foreach (var country in Model.Countries ?? [])
                                            {
                                                <option value="@country.Name">@country.Name</option>
                                            }
                                        </select>
                                        <small><span asp-validation-for="Country" class="text-danger"></span></small>
                                    </div>
                                </div>
                            </section>

                            <section class="iq-customer-section" aria-labelledby="iq-project-title">
                                <div class="iq-customer-section-heading">
                                    <span class="iq-customer-section-index" aria-hidden="true">3</span>
                                    <div>
                                        <h3 id="iq-project-title">@reviewText["customerProjectTitle"]</h3>
                                        <p>@reviewText["customerProjectDescription"]</p>
                                    </div>
                                </div>
                                <div class="iq-customer-fields">
                                    <div class="iq-customer-field iq-customer-field--wide">
                                        <label asp-for="Description">@Localizer["Description"]</label>
                                        <textarea class="form-control form-control-sm iq-customer-description" rows="3" asp-for="Description" maxlength="512" autocomplete="off" placeholder="@(culture == "th" ? "อธิบายโครงการ วัสดุ จำนวน ค่าความคลาดเคลื่อน ผิวสำเร็จ กำหนดส่ง หรือรายละเอียดสำคัญอื่น ๆ" : "Describe your project, material, quantity, tolerance, surface finish, deadline, or any other important details...")"></textarea>
                                        <div class="iq-customer-description-meta"><span id="iq-description-count">0</span>&nbsp;/ 512</div>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <input id="estimated-due-date" type="hidden" asp-for="EstimatedLeadTime" />
                        <input id="estimated-total-price" type="hidden" asp-for="EstimatedTotalPrice" />

                        <!-- must be kept empty -->
                        <div id="order-summary-items-collection"></div>
                    </div>
                    <div class="modal-footer">
                        <div class="me-auto font-sm-0p9rem font-1rem">* @Localizer["We will get back to you with a quotation"]</div>
                        <button id="submit-final-review-button" type="button" class="btn btn-primary">@(culture == "th" ? "ส่งไฟล์ให้ตรวจสอบ" : "Submit for final review")</button>
                    </div>

                </div>
            </div>
        </div>
    </form>
    }
</div>

