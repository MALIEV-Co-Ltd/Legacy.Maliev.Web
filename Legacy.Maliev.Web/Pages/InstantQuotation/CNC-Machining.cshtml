            function pulse(t) {
                if (t < 0 || t > ATTACK + DECAY) { return 0; }
                if (t < ATTACK) { var a = t / ATTACK; return a * a * (3 - 2 * a); }
                return Math.pow(1 - (t - ATTACK) / DECAY, 1.7);
            }

            var boost = 0;
            function Draw(t) {
                if (!mesh) { return; }
                var amp = AMP * (1 + 0.30 * boost);
                var tint = TINT * (1 + 1.20 * boost);
                var period = cycle();
                var localT = ((t % period) + period) % period;
                // Fixed shading scale, never a per-frame min/max: auto-gain would
                // stretch the contrast back to full range during the rest, so the
                // wall would shimmer as hard at rest as at the peak.
                var scale = Math.max(0.0001, 2 * (amp + BASE) * tileR);

                for (var i = 0; i < tiles.length; i++) {
                    var tl = tiles[i];
                    // Only the pulse is masked. The resting relief is not, so the
                    // clearance zone goes still without going flat.
                    var env = pulse(localT - tl.u * SWEEP);
                    var z = (env * (1 - VARY + VARY * tl.gain) * amp * tl.mask + tl.rest * BASE) * tileR;

                    _p.set(tl.x, tl.y, z);
                    _m.compose(_p, _q, _s);
                    mesh.setMatrixAt(i, _m);

                    // Depth doubles as shading: on a white wall every front face takes
                    // identical Lambert shading, so value is what carries the pulse.
                    var n = Math.min(1, Math.max(0, 0.5 + z / scale));
                    var v = 1 - CONTRAST * 0.16 + CONTRAST * 0.16 * (n * 2 - 1) + CONTRAST * 0.10 * n;
                    _c.setRGB(v * (1 - tint * 0.10), v * (1 - tint * 0.04), v);
                    mesh.setColorAt(i, _c);
                }
                mesh.instanceMatrix.needsUpdate = true;
                if (mesh.instanceColor) { mesh.instanceColor.needsUpdate = true; }

                var sv = 1 - SEAM * 0.16;
                backMat.color.setRGB(sv * (1 - tint * 0.12), sv * (1 - tint * 0.05), sv);

                renderer.render(scene, camera);
            }

            if (!Build()) { return; }

            if (reduce) {
                // One frame from the still part of the cycle, not mid-sweep: a frozen
                // half-swept wave is not what a reduced-motion visitor should be left with.
                Draw(cycle() * 0.995);
            } else {
                var t0 = performance.now();
                requestAnimationFrame(function Frame(now) {
                    requestAnimationFrame(Frame);
                    // Same skip as the cube: the hint's display is set inline by UpdateEmptyHint.
                    if (document.hidden || (hint && hint.style.display === 'none')) { return; }
                    var want = (wrap && wrap.classList.contains('iq-drag-over')) || (hint && hint.matches(':hover')) ? 1 : 0;
                    boost += (want - boost) * 0.08;
                    Draw((now - t0) / 1000);
                });
            }

            // Debounced: a rebuild disposes the geometry and reallocates the instanced
            // mesh, which is not something to run on every resize event of a drag.
            var resizeTimer = null;
            window.addEventListener('resize', function () {
                if (resizeTimer) { clearTimeout(resizeTimer); }
                resizeTimer = setTimeout(function () {
                    resizeTimer = null;
                    if (Build() && reduce) { Draw(cycle() * 0.995); }
                }, 150);
            });
        });
    </script>


