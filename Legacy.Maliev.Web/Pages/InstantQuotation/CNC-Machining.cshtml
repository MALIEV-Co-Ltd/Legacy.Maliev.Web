                    // presents a face square to the camera four times a turn.
                    cube.rotation.y = t / 4200;
                    cube.rotation.x = 0.18 + Math.sin(t / 5200) * 0.16;
                    cube.position.y = 0.4 + Math.sin(t / 1700) * 0.12;
