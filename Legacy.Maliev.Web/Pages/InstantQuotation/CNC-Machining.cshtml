        function AddCncDrawing(file) {
            if (!file) { return; }
            var id = utils.GetActiveId();
            var item = utils.GetItem(id);
            if (!item) { return; }
            if (FileType(file.name) !== 'pdf') {
                alert('@Localizer["Technical drawings must be PDF files."]');
                return;
            }
            if (file.size > maxCncDrawingUploadBytes) {
                alert('@culture' == 'th'
                    ? 'ไฟล์มีขนาดใหญ่เกินไป ขนาดสูงสุดคือ ' + @maxCncDrawingUploadMb + ' MB'
                    : 'This file is too large. The maximum size is ' + @maxCncDrawingUploadMb + ' MB.');
                return;
            }

            item.cncDrawing = { fileName: file.name, storagePath: '', uploadComplete: false, status: 'uploading' };
            BeginCncRevision(item, {
                itemId: id,
                change: 'drawing-upload',
                fileName: file.name,
                material: CncSelectedAlloy(item),
                quantity: Math.max(1, Math.floor(Number(item.quantity) || 1)),
                requirements: CncRequirementInput(item)
            });
            RenderCncActiveMetrics(item);
            RenderCurrentCncQuotation();
            SetCncSubmissionHidden(id, 'CncDrawingFileName', file.name);
            SetCncSubmissionHidden(id, 'CncDrawingStoragePath', '');
            SetCncSubmissionHidden(id, 'CncDrawingUploadReceipt', '');
            SyncCncDrawingControls();
            SyncCncSubmissionSafety();
            NotifyQuotationStateChanged({ type: 'drawing-changed', itemId: id, fileName: file.name, status: 'uploading' });
            utils.IncreasePendingTask();

            var formData = new FormData();
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
            formData.append('file', file);

            formData.append('itemId', id);
            formData.append('uploadRole', 'drawing');
            { formData.append('quotationFormToken', quotationFormToken); }
            $.ajax({
                url: cncDrawingUploadFileUrl,
                data: formData, type: "POST", async: true, cache: false, processData: false, contentType: false,
                success: function (data) {
                    var current = utils.GetItem(id);
                    if (data.success === true && data.receipt && current && current.cncDrawing && current.cncDrawing.fileName === file.name) {
                        current.cncDrawing.storagePath = data.path;
                        current.cncDrawing.receipt = data.receipt;
                        current.cncDrawing.uploadComplete = true;
                        current.cncDrawing.status = 'ready';
                        SetCncSubmissionHidden(id, 'CncDrawingStoragePath', data.path);
                        SetCncSubmissionHidden(id, 'CncDrawingUploadReceipt', data.receipt);
                    } else {
                        if (current && current.cncDrawing && current.cncDrawing.fileName === file.name) {
                            if (!AllowLocalCncDrawingAfterUploadFailure(current, file.name)) {
                                current.cncDrawing.uploadComplete = false;
                                current.cncDrawing.status = 'failed';
                            }
                        }
                        if (!isLocalPreview && data && data.message) { alert(data.message); }
                    }
                    SyncCncDrawingControls();
                    SyncCncSubmissionSafety();
                    if (current && current.cncDrawing && (current.cncDrawing.status === 'ready' || current.cncDrawing.status === 'local')) {
                        CncRepriceAll(true, { type: 'drawing-ready', itemId: id, fileName: file.name });
                    } else if (current) {
                        current.cncStatus = 'review_required';
                        current.cncProgressStage = 'review_required';
                        current.cncReviewReasons = ['cnc_drawing_upload_failed'];
                        RenderCurrentCncQuotation();
                    }
                    NotifyQuotationStateChanged({ type: 'drawing-changed', itemId: id, fileName: file.name, status: current && current.cncDrawing && current.cncDrawing.uploadComplete ? 'ready' : 'failed' });
                },
                error: function (xhr) {
                    var current = utils.GetItem(id);
                    if (current && current.cncDrawing && current.cncDrawing.fileName === file.name) {
                        if (!AllowLocalCncDrawingAfterUploadFailure(current, file.name)) {
                            current.cncDrawing.uploadComplete = false;
                            current.cncDrawing.status = 'failed';
                        }
                    }
                    if (!isLocalPreview) {
                        alert(xhr && xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : iqErrorText.uploadFailed + ' (network error)');
                    }
                    SyncCncDrawingControls();
                    SyncCncSubmissionSafety();
                    if (current && current.cncDrawing && current.cncDrawing.status === 'local') {
                        CncRepriceAll(true, { type: 'drawing-ready', itemId: id, fileName: file.name });
                    } else if (current) {
                        current.cncStatus = 'review_required';
                        current.cncProgressStage = 'review_required';
                        current.cncReviewReasons = ['cnc_drawing_upload_failed'];
                        RenderCurrentCncQuotation();
                    }
                    NotifyQuotationStateChanged({ type: 'drawing-changed', itemId: id, fileName: file.name, status: 'failed' });
                },
                complete: function () { utils.DecreasePendingTask(); SyncCncSubmissionSafety(); }
            });
        }

        function AllowLocalCncDrawingAfterUploadFailure(item, fileName) {
            if (!isLocalPreview || !item || !item.cncDrawing || item.cncDrawing.fileName !== fileName) { return false; }
            item.cncDrawing.uploadComplete = false;
            item.cncDrawing.availableForLocalReview = true;
            item.cncDrawing.status = 'local';
            AllowLocalPreviewAfterUploadFailure();
            return true;
        }

        function UploadFile(id, file) {
            var progressBar = $('#upload-progress-item-' + id + ' .bar');
            var progressWrap = document.getElementById('upload-progress-item-' + id);
            var uploadPathElement = document.getElementById('item-upload-path-' + id);
            PushInstantQuoteEvent('file_upload_start', {
                file_count: 1,
                file_type: FileType(file && file.name)
            });
            var formData = new FormData();
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
            formData.append('file', file);

            formData.append('itemId', id);
            formData.append('uploadRole', 'model');
            { formData.append('quotationFormToken', quotationFormToken); }
            var retryCount = 0;
            var maximumAdmissionRetries = 3;
            return new Promise(function (resolve) {
                function sendUploadAttempt() {
                    var retryScheduled = false;
                    $.ajax({
                url: cncModelUploadFileUrl,
                data: formData, type: "POST", async: true, cache: false, processData: false, contentType: false,
                xhr: function () {
                    var myXhr = $.ajaxSettings.xhr();
                    if (myXhr.upload) {
                        myXhr.upload.addEventListener('progress', function (event) {
                            if (event.lengthComputable) {
                                if (progressWrap) { progressWrap.style.visibility = 'visible'; }
                                progressBar.css('width', ((event.loaded * 100) / event.total) + '%');
                            }
                        }, false);
                    }
                    return myXhr;
                },
                success: function (data) {
                    if (data.success == true && uploadPathElement && data.receipt) {
                        uploadPathElement.value = data.path;
                        {
                            var item = utils.GetItem(id);
                            if (item) { item.cncModelUploadReceipt = data.receipt || ''; }
                            SetCncSubmissionHidden(id, 'CncModelUploadReceipt', data.receipt || '');
                        }
                        utils.SetItemUploadComplete(id, true);
                        SyncCncSubmissionSafety();
                        PushInstantQuoteEvent('file_upload_complete', {
                            file_count: 1,
                            file_type: FileType(file && file.name)
                        });
                    } else {
                        PushInstantQuoteEvent('upload_failure', {
                            failure_category: 'server_rejected',
                            file_count: 1,
                            file_type: FileType(file && file.name)
                        });
                        if (isLocalPreview) {
                            utils.SetItemUploadComplete(id, true);
                            AllowLocalPreviewAfterUploadFailure();
                        } else {
                            alert(data && data.message ? data.message : iqErrorText.uploadFailed);
                            utils.SetItemUploadComplete(id, false);
                            utils.BlockSubmission();
                        }
                    }
                },
                error: function (xhr) {
                    if (xhr && xhr.status === 429 && retryCount < maximumAdmissionRetries) {
                        retryCount += 1;
                        retryScheduled = true;
                        var retryAfterSeconds = Number(xhr.getResponseHeader && xhr.getResponseHeader('Retry-After'));
                        var retryDelay = Number.isFinite(retryAfterSeconds) && retryAfterSeconds >= 0
                            ? retryAfterSeconds * 1000
                            : 250 * Math.pow(2, retryCount - 1);
                        setTimeout(sendUploadAttempt, retryDelay);
                        return;
                    }
                    PushInstantQuoteEvent('upload_failure', {
                        failure_category: 'network',
                        file_count: 1,
                        file_type: FileType(file && file.name)
                    });
                    if (xhr && xhr.status === 429) {
                        utils.SetItemUploadComplete(id, false);
                        utils.BlockSubmission();
                        if (!isLocalPreview) {
                            alert(xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : iqErrorText.uploadFailed);
                        }
                        return;
                    }
                    if (isLocalPreview) {
                        utils.SetItemUploadComplete(id, true);
                        AllowLocalPreviewAfterUploadFailure();
                        return;
                    }
                    utils.SetItemUploadComplete(id, false);
                    alert(xhr && xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : iqErrorText.uploadFailed + ' (network error)');
                    utils.BlockSubmission();
                },
                complete: function () {
                    if (retryScheduled) { return; }
                    if (progressWrap) { progressWrap.style.visibility = 'hidden'; }
                    { NotifyQuotationStateChanged({ type: 'upload-completed', itemId: id }); }
                    utils.DecreasePendingTask();
                    resolve();
                }
            });
                }
                sendUploadAttempt();
            });
        }

        function GetPricingGeometry(info) {
            var bboxVolume = info.size.x * info.size.y * info.size.z;
            var volume = info.volume;
            var areaProfile = info.areaProfile ? info.areaProfile.join(',') : '';
            var perimeterProfile = info.perimeterProfile ? info.perimeterProfile.join(',') : '';
            if (info.nonWatertight && (volume <= 0 || volume > bboxVolume * 1.02)) {
                volume = bboxVolume * 0.5;
                areaProfile = '';
                perimeterProfile = '';
            }

            return {
                dimensionZ: info.size.z,
                volume: volume,
                footprint: info.size.x * info.size.y,
                areaProfile: areaProfile,
                perimeterProfile: perimeterProfile
            };
        }

        function DefaultCncRequirements() {
            return { tolerance: 'ISO 2768-m', threadMode: 'none', threadNote: '', roughness: 'default', inspection: 'standard', certificate: 'not-required', note: '' };
        }

        function CncHasDetectedThreads(item) {
            var proxies = item && item.modelInfo && item.modelInfo.cncGeometry
                && item.modelInfo.cncGeometry.threadProxies;
            var proxyDetected = Array.isArray(proxies) ? proxies.length > 0
                : !!(proxies && Number.isSafeInteger(proxies.count) && proxies.count > 0);
            var operations = item && item.cncPlan && item.cncPlan.operations;
            return proxyDetected || (Array.isArray(operations) && operations.some(function (operation) {
                return operation && (operation.code === 'tapping' || operation.code === 'thread_milling'
                    || operation.kind === 'tapping' || operation.kind === 'thread_milling');
            }));
        }

        function CncRequirementsForItem(item) {
            if (!item) { return DefaultCncRequirements(); }
            if (!item.cncRequirements) { item.cncRequirements = DefaultCncRequirements(); }
            return item.cncRequirements;
        }

        function CaptureActiveCncRequirements() {
            var item = utils.GetItem(utils.GetActiveId());
            if (!item) { return null; }
            var tolerance = document.querySelector('[data-cnc-tolerance]:checked');
            var threads = document.querySelector('[data-cnc-threads]');
            var threadNote = document.querySelector('[data-cnc-thread-note]');
            var roughness = document.querySelector('[data-cnc-roughness]');
            var inspection = document.querySelector('[data-cnc-inspection]');
            var certificate = document.querySelector('[data-cnc-certificate]');
