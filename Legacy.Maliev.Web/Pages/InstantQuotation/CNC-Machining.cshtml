                '.iq-preliminary-quotation-dfm-alert.warn { color: #875000; background: #fff6e5; }',
                '.iq-preliminary-quotation-dfm-alert.danger { color: #9b241b; background: #fff0ee; }',
                '.iq-preliminary-quotation-dfm-alert strong, .iq-preliminary-quotation-dfm-alert span { display: block; }',
                '.iq-preliminary-quotation-dfm-icon { flex: 0 0 auto; width: 14px; height: 14px; border-radius: 50%; color: #fff; background: #e0a000; font-size: 9px; font-weight: 600; line-height: 14px; text-align: center; }',
                '.iq-preliminary-quotation-dfm-alert.danger .iq-preliminary-quotation-dfm-icon { background: #c73527; }',
                '.iq-preliminary-quotation-dfm-ok { color: #187a41; background: #effaf3; }',
                '.iq-preliminary-quotation-summary { margin-top: 18px; padding: 12px; border: 2px solid #172033; border-radius: 6px; break-inside: avoid; page-break-inside: avoid; }',
                '.iq-preliminary-quotation-summary h2 { margin: 0 0 8px; font-size: 15px; }',
                '.iq-preliminary-quotation-total-row { display: flex; justify-content: space-between; gap: 16px; padding: 5px 0; border-bottom: 1px solid #e4eaf0; }',
                '.iq-preliminary-quotation-total-row strong { white-space: nowrap; font-variant-numeric: tabular-nums; }',
                '.iq-preliminary-quotation-grand-total { display: flex; justify-content: space-between; gap: 16px; margin-top: 7px; padding-top: 8px; border-top: 2px solid #172033; color: #0b5ed7; font-size: 15px; font-weight: 600; }',
                '.iq-preliminary-quotation-disclaimer { margin: 14px 0 0; color: #66758a; font-size: 9px; }',
                '@@media print { html, body { background: #fff; } .iq-preliminary-quotation-toolbar { display: none !important; } .iq-preliminary-quotation-sheet { max-width: none; min-height: auto; margin: 0; padding: 0; box-shadow: none; } }',
                '@@media (max-width: 700px) { .iq-preliminary-quotation-sheet { margin: 0; padding: 16px; } .iq-preliminary-quotation-header, .iq-preliminary-quotation-meta { display: block; } .iq-preliminary-quotation-title { max-width: none; margin-top: 10px; text-align: left; } .iq-preliminary-quotation-fields, .iq-preliminary-quotation-measurements { grid-template-columns: repeat(2, minmax(0, 1fr)); } .iq-preliminary-quotation-measurements { margin-left: 0; } }'
            ].join('');

            return '<!doctype html><html lang="' + Html(iqCulture) + '"><head><meta charset="utf-8">'
                + '<meta name="viewport" content="width=device-width, initial-scale=1"><title>'
                + Html(iqReviewText.preliminaryQuotation) + ' | MALIEV</title><style>' + printStyles + '</style></head><body>'
                + '<div class="iq-preliminary-quotation-toolbar"><div class="iq-preliminary-quotation-toolbar-actions">'
                + '<button type="button" onclick="PrintPreliminaryQuotation();"><span aria-hidden="true">▣</span> ' + Html(iqReviewText.preliminaryQuotationPrint) + '</button>'
                + '<button type="button" onclick="DownloadPreliminaryQuotationPdf();" title="' + Html(iqReviewText.preliminaryQuotationDownloadPdfHint) + '"><span aria-hidden="true">⇩</span> ' + Html(iqReviewText.preliminaryQuotationDownloadPdf) + '</button>'
                + '<button type="button" class="secondary" onclick="window.close();">' + Html(iqReviewText.preliminaryQuotationClose) + '</button>'
                + '</div><span class="iq-preliminary-quotation-toolbar-meta">A4 · ' + Html(iqReviewText.preliminaryQuotationReviewOnly) + ' · ' + Html(iqReviewText.preliminaryQuotationDownloadPdfHint) + '</span></div>'
                + '<main class="iq-preliminary-quotation-sheet">'
                + '<header class="iq-preliminary-quotation-header"><div><img class="iq-preliminary-quotation-logo" src="' + Html(logoUrl) + '" alt="MALIEV" /><p class="iq-preliminary-quotation-kicker">CNC machining service</p></div>'
                + '<div class="iq-preliminary-quotation-title"><h1>' + Html(iqReviewText.preliminaryQuotation) + '</h1><p>' + Html(iqReviewText.preliminaryQuotationReviewOnly) + '</p></div></header>'
                + '<div class="iq-preliminary-quotation-meta"><span><strong>' + Html(iqReviewText.preliminaryQuotationGenerated) + ':</strong> ' + Html(snapshot.generatedAt) + '</span><span><strong>' + Html(iqReviewText.quantity) + ':</strong> ' + Html(String(snapshot.items.length)) + '</span></div>'
                + '<h2 class="iq-preliminary-quotation-section-title">' + Html(iqReviewText.preliminaryQuotationParts) + '</h2>'
                + partMarkup
                + '<section class="iq-preliminary-quotation-summary"><h2>' + Html(iqReviewText.summaryTitle) + '</h2>'
                + '<div class="iq-preliminary-quotation-total-row"><span>' + Html(iqReviewText.printingSubtotal) + '</span><strong>' + Html(PreliminaryQuotationMoney(snapshot.orderTotal.itemsSubtotal)) + '</strong></div>'
                + minimumMarkup
                + '<div class="iq-preliminary-quotation-total-row"><span>' + Html(iqReviewText.shipping) + '</span><strong>' + Html(PreliminaryQuotationMoney(snapshot.orderTotal.shipping)) + '</strong></div>'
                + '<div class="iq-preliminary-quotation-total-row"><span>' + Html(iqReviewText.vat) + '</span><strong>' + Html(PreliminaryQuotationMoney(snapshot.orderTotal.vat)) + '</strong></div>'
                + '<div class="iq-preliminary-quotation-total-row"><span>' + Html(iqReviewText.leadTime) + '</span><strong>' + Html(snapshot.leadTime + ' · ' + iqReviewText.afterConfirmed) + '</strong></div>'
                + '<div class="iq-preliminary-quotation-grand-total"><span>' + Html(iqReviewText.grandTotal) + '</span><strong>' + Html(PreliminaryQuotationMoney(snapshot.orderTotal.finalOrderPrice)) + '</strong></div>'
                + '</section><p class="iq-preliminary-quotation-disclaimer">' + Html(iqReviewText.preliminaryQuotationReviewOnly) + ' ' + Html(iqReviewText.reviewIntro) + '</p>'
                + '</main>'
                // Keep these handlers inside the generated tab. A direct PDF download belongs
                // in PDFService; this temporary bridge only uses the browser print dialog.
                + '<scr' + 'ipt>'
                + 'function PrintPreliminaryQuotation() { window.print(); }'
                + 'function DownloadPreliminaryQuotationPdf() {'
                + 'var originalTitle = document.title;'
                + 'document.title = "MALIEV Preliminary Quotation";'
                + 'window.print();'
                + 'window.setTimeout(function () { document.title = originalTitle; }, 1000);'
                + '}'
                + '</scr' + 'ipt></body></html>';
        }

        function OpenPreliminaryQuotation() {
            if (!CanBuildPreliminaryQuotation()) {
                SyncPreliminaryQuotationButton();
                return;
            }

            var previewWindow = window.open('', '_blank');
            if (!previewWindow) {
                alert('@culture' == 'th'
                    ? 'เบราว์เซอร์บล็อกหน้าต่างใหม่ กรุณาอนุญาตป๊อปอัปแล้วลองอีกครั้ง'
                    : 'The browser blocked the new quotation tab. Please allow pop-ups and try again.');
                return;
            }

            var snapshot = BuildPreliminaryQuotationSnapshot();
            previewWindow.document.open();
            previewWindow.document.write(BuildPreliminaryQuotationDocument(snapshot));
            previewWindow.document.close();
            previewWindow.opener = null;
            previewWindow.focus();
            PushInstantQuoteEvent('preliminary_quotation_opened', { file_count: snapshot.items.length });
        }

        // The review step is a projection of the item store. State changes publish here instead
        // of asking each input, upload callback, and removal path to patch an independent snapshot.
        function NotifyQuotationStateChanged(change) {

            RenderAllPricingSummaries();
            RefreshVisibleOrderSummary(change || { type: 'state-changed' });
            AnnounceReviewChange(change || { type: 'state-changed' });
        }

        function FormatReviewAnnouncement(template, fileName) {
            return String(template || '').replace('{0}', fileName || '');
        }

        function AnnounceReviewChange(change) {
            var panel = document.getElementById('finalization-panel');
            var status = document.getElementById('cnc-review-live-status');
            if (!panel || panel.hidden || !status || !change) { return; }
            var item = change.itemId !== undefined && change.itemId !== null ? utils.GetItem(change.itemId) : null;
            var fileName = change.fileName || (item && item.file ? item.file.name : '');
            var message = '';
            if (change.type === 'item-registered') { message = FormatReviewAnnouncement(iqReviewText.reviewPartAdded, fileName); }
            else if (change.type === 'item-removed') { message = FormatReviewAnnouncement(iqReviewText.reviewPartRemoved, fileName); }
            else if (change.type === 'review-control-changed' || change.type === 'quantity-changed' || change.type === 'material-changed' || change.type === 'requirements-changed') {
                message = FormatReviewAnnouncement(iqReviewText.reviewEstimateUpdated, fileName);
            } else if (change.type === 'drawing-changed' && change.status === 'ready') {
                message = FormatReviewAnnouncement(iqReviewText.reviewDrawingReady, fileName);
            } else if (change.type === 'drawing-changed' && change.status === 'failed') {
                message = FormatReviewAnnouncement(iqReviewText.reviewDrawingFailed, fileName);
            }
            if (message) { status.textContent = message; }
        }

        function ReviewFocusKey(element) {
            if (!element) { return null; }
            if (element.classList.contains('iq-review-quantity')) { return 'quantity'; }
            if (element.classList.contains('iq-review-thumbnail')) { return 'thumbnail'; }
            if (element.hasAttribute('data-part-disclosure-toggle')) { return 'disclosure'; }
            return null;
        }

        function ReviewFocusTarget(card, key) {
            if (!card || !key) { return null; }
            if (key === 'quantity') { return card.querySelector('.iq-review-quantity'); }
            if (key === 'thumbnail') { return card.querySelector('.iq-review-thumbnail'); }
            if (key === 'disclosure') { return card.querySelector('[data-part-disclosure-toggle]'); }
            return null;
        }

        function RefreshVisibleOrderSummary(change) {
            var panel = document.getElementById('finalization-panel');
            if (!panel || panel.hidden) { return; }
            var list = panel.querySelector('.iq-review-list');
            var focusedCard = document.activeElement && document.activeElement.closest
                ? document.activeElement.closest('.iq-review-item[data-item-id]') : null;
            var projection = {
                activeId: utils.GetActiveId(),
                expandedIds: Array.from(panel.querySelectorAll('[data-part-disclosure-toggle][aria-expanded="true"]'))
                    .map(function (toggle) { return String(toggle.dataset.partDisclosureToggle); }),
                focusedItemId: focusedCard ? String(focusedCard.dataset.itemId) : (change && change.focusedItemId ? String(change.focusedItemId) : null),
                focusKey: ReviewFocusKey(document.activeElement) || (change && change.focusKey ? change.focusKey : null),
                scrollTop: list ? list.scrollTop : 0
            };

            BuildOrderSummary(panel);
            panel.querySelectorAll('[data-part-disclosure-toggle]').forEach(function (toggle) {
                var open = projection.expandedIds.indexOf(String(toggle.dataset.partDisclosureToggle)) >= 0;
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                var disclosure = document.getElementById(toggle.getAttribute('aria-controls'));
                if (disclosure) { disclosure.hidden = !open; }
            });
            SyncReviewThumbnailSelection(projection.activeId);
            list = panel.querySelector('.iq-review-list');
            if (list) { list.scrollTop = projection.scrollTop; }
            if (projection.focusedItemId && projection.focusKey) {
                var card = panel.querySelector('.iq-review-item[data-item-id="' + projection.focusedItemId + '"]');
                var focusTarget = ReviewFocusTarget(card, projection.focusKey);
                if (focusTarget) {
                    focusTarget.focus({ preventScroll: true });
                    requestAnimationFrame(function () {
                        if (panel.hidden) { return; }
                        var currentCard = panel.querySelector('.iq-review-item[data-item-id="' + projection.focusedItemId + '"]');
                        var currentTarget = ReviewFocusTarget(currentCard, projection.focusKey);
                        if (currentTarget) { currentTarget.focus({ preventScroll: true }); }
                    });
                }
            }
        }

        function OpenOrderSummary() {
            { SyncCncSubmissionSafety(); }
            var gate = document.getElementById('submit-gate');
            var reviewPanel = document.getElementById('finalization-panel');
            if (!gate || gate.disabled || !reviewPanel || utils.GetAllItemIds().length === 0) { return; }
            if (!reviewReachedTracked && !WasInstantQuoteEventTracked('review_reached')) {
                reviewReachedTracked = true;
                PushInstantQuoteEvent('review_reached', { intent: 'instant_quote' });
            }
            BuildOrderSummary(reviewPanel);
            document.getElementById('quotation-config-panel').hidden = true;
            document.getElementById('customer-details-panel').hidden = true;
            reviewPanel.hidden = false;
            document.querySelector('.iq-config-pane').classList.add('iq-customer-mode');
        }

        function MoveMetricsCardToConfiguration() {
            var metricsCard = document.getElementById('iq-metrics-card');
            var configurationMetricsHost = document.getElementById('configuration-metrics-host');
            if (metricsCard && configurationMetricsHost && metricsCard.parentElement !== configurationMetricsHost) {
                configurationMetricsHost.appendChild(metricsCard);
            }
        }

        function ReturnToConfiguration() {
            MoveMetricsCardToConfiguration();
            document.getElementById('customer-details-panel').hidden = true;
            document.getElementById('finalization-panel').hidden = true;
            document.getElementById('quotation-config-panel').hidden = false;
            document.querySelector('.iq-config-pane').classList.remove('iq-customer-mode');
        }

        function ContinueToCustomerDetails() {
            if (!CncSubmissionReady()) {
                SyncCncSubmissionSafety();
                return;
            }
            var configPanel = document.getElementById('quotation-config-panel');
            var reviewPanel = document.getElementById('finalization-panel');
            var customerPanel = document.getElementById('customer-details-panel');
            if (!reviewPanel || !customerPanel) { return; }
            if (configPanel) { configPanel.hidden = true; }
            reviewPanel.hidden = true;
            customerPanel.hidden = false;
            document.querySelector('.iq-config-pane').classList.add('iq-customer-mode');
            RenderPricingSummary(document.getElementById('customer-pricing-summary'), iqReviewText.customerSummaryTitle);
        }

        function ReturnToOrderSummary() {
            document.getElementById('customer-details-panel').hidden = true;
            document.getElementById('finalization-panel').hidden = false;
        }

        function SetReviewIdentityFacts(item, details, size, batchFinalized) {
            var dimensions = CreateEl('div', 'iq-review-dimensions', batchFinalized && item.modelInfo
                ? ToTwoDecimalPoint(size.x) + ' × ' + ToTwoDecimalPoint(size.y) + ' × ' + ToTwoDecimalPoint(size.z) + ' mm'
                : 'Loading');
            dimensions.classList.toggle('iq-skeleton-text', !batchFinalized);
            details.appendChild(dimensions);

            var identityMeta = CreateEl('div', 'iq-review-identity-meta');
            var selectedMaterial = CreateEl('span');
            selectedMaterial.appendChild(document.createTextNode(iqReviewText.material + ' '));
            var materialValue = CreateEl('strong', null, batchFinalized ? (item.cncAlloy || item.material || '—') : 'Loading');
            materialValue.classList.toggle('iq-skeleton-text', !batchFinalized);
            selectedMaterial.appendChild(materialValue);
            identityMeta.appendChild(selectedMaterial);
            if (batchFinalized && item.modelInfo) {
                identityMeta.appendChild(CreateEl('span', null,
                    CncReviewTolerance(CncRequirementsForItem(item)) + ' · ' + CncReviewThreads(CncRequirementsForItem(item))));
            }
            details.appendChild(identityMeta);
        }

        function BuildOrderSummary(panel) {
            MoveMetricsCardToConfiguration();
            panel.replaceChildren();
            var batchFinalized = CncAllItemsFinalizedForPrice();
            var header = document.createElement('div');
            header.className = 'iq-customer-header';
            header.innerHTML = '<h2 class="mb-0">' + panel.dataset.titleText + '</h2>';
            var back = document.createElement('button');
            back.type = 'button'; back.className = 'btn btn-outline-secondary btn-sm'; back.textContent = '← ' + panel.dataset.backText;
            back.addEventListener('click', ReturnToConfiguration);
            header.appendChild(back); panel.appendChild(header);

            panel.appendChild(CreateEl('div', 'iq-flow-step', iqReviewText.reviewStep));
            var intro = document.createElement('p');
            intro.className = 'text-muted small mb-3';
            intro.textContent = iqReviewText.reviewIntro;
            panel.appendChild(intro);
            var list = CreateEl('div', 'iq-review-list');
            panel.appendChild(list);

            function AddReviewField(fields, label, value, modifier) {
                var field = CreateEl('div', 'iq-review-field' + (modifier ? ' ' + modifier : ''));
                field.appendChild(CreateEl('div', 'l', label));
                field.appendChild(CreateEl('div', 'v iq-review-value', value || '—'));
                fields.appendChild(field);
            }

            function AddReviewControlField(fields, label, control, wrapperClassName) {
                var field = CreateEl('div', 'iq-review-field');
                field.appendChild(CreateEl('div', 'l', label));
                var controlWrap = CreateEl('div', 'iq-review-control-wrap' + (wrapperClassName ? ' ' + wrapperClassName : ''));
                controlWrap.appendChild(control);
                field.appendChild(controlWrap);
                fields.appendChild(field);
            }

            function CreateReviewSelect(className) {
                var select = document.createElement('select');
                select.className = 'form-select form-select-sm iq-review-select' + (className ? ' ' + className : '');
                return select;
            }


            utils.GetAllItemIds().forEach(function (id) {
                var item = utils.GetItem(id);
                if (!item) { return; }
                var info = item.modelInfo || {};
                var size = info.size || { x: 0, y: 0, z: 0 };
                var card = document.createElement('section');
                card.className = 'iq-review-item iq-review-item--cnc';
                card.id = 'review-item-' + id;
                card.dataset.itemId = id;
                var itemHeadingId = 'review-item-heading-' + id;
                card.setAttribute('aria-labelledby', itemHeadingId);
                var identity = CreateEl('div', 'iq-review-identity');
                { identity.setAttribute('data-review-region', 'identity'); }
                var snapshot = document.getElementById('item-snapshot-' + id);
                var thumbnail = document.createElement('img');
                thumbnail.className = 'iq-review-thumbnail';
                thumbnail.dataset.itemId = id;
                thumbnail.setAttribute('role', 'button');
                thumbnail.setAttribute('tabindex', '0');
                thumbnail.setAttribute('aria-pressed', utils.GetActiveId() === id ? 'true' : 'false');
                thumbnail.setAttribute('aria-label', (iqCulture === 'th' ? 'เลือกชิ้นงาน ' : 'Select part ') + item.file.name);
                thumbnail.addEventListener('click', function () { SelectItem(id); });
                thumbnail.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        SelectItem(id);
                    }
                });
                thumbnail.src = snapshot && snapshot.src ? snapshot.src : '/src/images/3d-canvas-placeholder.svg';
                thumbnail.alt = item.file.name;
                identity.appendChild(thumbnail);

                var details = CreateEl('div', 'iq-review-details');
                var dfmAlerts = BuildDfmAlerts(info, '@culture', 'cnc');
                var fileName = CreateEl('h3', 'iq-review-file', item.file.name);
                fileName.id = itemHeadingId;
                if (dfmAlerts.length > 0) {
                    var warningIcon = CreateEl('span', 'iq-review-warning-icon', '!');
                    var warningDetails = dfmAlerts.map(function (alert) { return alert.title; }).join(' · ');
                    warningIcon.setAttribute('role', 'img');
                    warningIcon.setAttribute('aria-label', iqReviewText.dfmWarningLabel + ': ' + warningDetails);
                    warningIcon.title = warningDetails;
                    fileName.appendChild(warningIcon);
                }
                details.appendChild(fileName);
                SetReviewIdentityFacts(item, details, size, batchFinalized);
                if (dfmAlerts.length > 0) {
                    details.appendChild(CreateEl('div', 'iq-review-dfm-warning', iqReviewText.dfmReviewWarning));
                }
                identity.appendChild(details);
                { card.appendChild(identity); }

                var unitPrice = document.getElementById('item-estimated-unit-cost-' + id);
                var subtotal = document.getElementById('item-estimated-total-cost-' + id);
                var fields = CreateEl('div', 'iq-review-fields');



                var quantityInput = document.createElement('input');
                quantityInput.type = 'number';
                quantityInput.className = 'form-control form-control-sm iq-review-input iq-review-quantity';
                quantityInput.min = '1';
                quantityInput.max = '1000';
                quantityInput.step = '1';
                quantityInput.inputMode = 'numeric';
                quantityInput.value = String(NormalizeReviewQuantity(item.quantity, 1));
                quantityInput.setAttribute('aria-label', iqReviewText.quantity + ' — ' + item.file.name);
                quantityInput.addEventListener('change', function () { HandleReviewQuantityChange(id, this.value, card); });
                AddReviewControlField(fields, iqReviewText.quantity, quantityInput, 'iq-review-input-wrap');

                AddReviewField(fields, iqReviewText.unitPrice, unitPrice ? unitPrice.value : '—', 'iq-review-price');
                fields.lastElementChild.querySelector('.iq-review-value').dataset.reviewValue = 'unit-price';
                AddReviewField(fields, iqReviewText.lineSubtotal, subtotal ? subtotal.value : '—', 'subtotal iq-review-price');
                fields.lastElementChild.querySelector('.iq-review-value').dataset.reviewValue = 'line-subtotal';
                {
                    var commercial = CreateEl('div', 'iq-review-commercial');
                    commercial.setAttribute('data-review-region', 'commercial');
                    commercial.appendChild(fields);
                    card.appendChild(commercial);
                }
                card.appendChild(BuildPartDisclosure(id, item, info, batchFinalized));
                { SetReviewCardLoading(card, !batchFinalized); }
                SyncCncReviewExplanation(card, item);
                list.appendChild(card);
            });

            // The footer is the order total only: per-part geometry moved into each part's
            // own disclosure above, so there is no second column here to balance.
            var footer = CreateEl('div', 'iq-review-footer');
            var bottomRow = CreateEl('div', 'iq-summary-card iq-review-bottom-row');
            // The column wrapper is stable and the render target sits inside it, so the
            // action below survives RenderPricingSummary's replaceChildren on every
            // price update — the same arrangement the configuration step uses.
            var summaryHost = CreateEl('div', 'iq-review-summary-host');
            var pricingHost = document.createElement('div');
            pricingHost.id = 'review-pricing-summary';
            pricingHost.className = 'iq-review-pricing-host';
            summaryHost.appendChild(pricingHost);
            bottomRow.appendChild(summaryHost);
            footer.appendChild(bottomRow);
            RenderPricingSummary(pricingHost, iqReviewText.summaryTitle);
            var actions = document.createElement('div');
            // Keeps iq-customer-actions so the panel's forward action stays addressable as
            // the review step's action row; the other two classes give it the same slot
            // treatment as the configuration step, one column instead of two.
            actions.className = 'iq-config-summary-action iq-review-summary-action iq-customer-actions';
            var preliminaryAction = document.createElement('div');
            preliminaryAction.className = 'iq-preliminary-quotation-action iq-review-preliminary-quotation-action';
            var preliminaryButton = document.createElement('button');
            preliminaryButton.id = 'preliminary-quotation-button';
            preliminaryButton.type = 'button';
            preliminaryButton.className = 'btn btn-outline-primary iq-preliminary-quotation-button';
            preliminaryButton.title = iqReviewText.preliminaryQuotationNote;
            preliminaryButton.setAttribute('aria-label', iqReviewText.preliminaryQuotation);
            preliminaryButton.innerHTML = '<i class="fas fa-file-pdf" aria-hidden="true"></i><span aria-hidden="true">PDF</span>';
            preliminaryButton.addEventListener('click', OpenPreliminaryQuotation);
            preliminaryAction.appendChild(preliminaryButton);
            actions.appendChild(preliminaryAction);
            var continueButton = document.createElement('button');
            continueButton.id = 'continue-to-customer-details';
            continueButton.type = 'button';
            continueButton.className = 'btn btn-primary iq-submit-btn';
            continueButton.textContent = panel.dataset.continueText;
            var submissionReady = CncSubmissionReady();
            continueButton.disabled = !submissionReady;
            continueButton.setAttribute('aria-disabled', submissionReady ? 'false' : 'true');
            continueButton.addEventListener('click', ContinueToCustomerDetails);
            actions.appendChild(continueButton);
            summaryHost.appendChild(actions);
            panel.appendChild(footer);
            SyncCncSubmissionSafety();
        }

        // Measurements, DFM, and CNC manufacturing facts belong to the part they describe,
        // so in the review step they live under that part rather than in the order footer,
        // where a shared card could only describe whichever part happened to be active.
        // Every process uses the same progressive-disclosure rule: the compact commercial
        // row is visible first, and technical detail opens on demand.
        // Deliberately not a nested card — a hairline and the part's own padding carry the
        // grouping. No data-review-value attributes here; SetReviewCardLoading and
        // UpdateReviewCardValues own that namespace for the priced fields above.
        function CncReviewRoughness(value) {
            if (value === '3.2') { return 'Ra 3.2 µm'; }
            if (value === '1.6') { return 'Ra 1.6 µm'; }
            if (value === 'tight') { return iqReviewText.tighterRoughness; }
            return iqReviewText.standardMachined;
        }

        function CncReviewInspection(value) {
            if (value === 'report') { return iqReviewText.dimensionalReport; }
            if (value === 'enhanced') { return iqReviewText.enhancedInspection; }
            return iqReviewText.standardInspection;
        }

        function CncReviewThreads(requirements) {
            if (!requirements || requirements.threadMode === 'none') { return iqReviewText.none; }
            if (requirements.threadMode === 'drawing') { return iqReviewText.specifiedOnDrawing; }
            return requirements.threadNote || iqReviewText.specifiedOnDrawing;
        }

        function CncReviewTolerance(requirements) {
            if (!requirements || requirements.tolerance === 'drawing') { return iqReviewText.specifiedOnDrawing; }
            return requirements.tolerance || 'ISO 2768-m';
        }

        function CncReviewStockType(stock) {
            if (stock.stockShape && cncUiText.stockShapes[stock.stockShape]) { return cncUiText.stockShapes[stock.stockShape]; }
            if (stock.strategy && stock.strategy.indexOf('round') >= 0) { return cncUiText.stockShapes.round; }
            if (stock.strategy && stock.strategy.indexOf('plate') >= 0) { return cncUiText.stockShapes.plate; }
            return cncUiText.stockShapes.block;
        }

        function CncReviewStockDimensions(stock) {
            if (stock.stockShape === 'round' || (stock.strategy && stock.strategy.indexOf('round') >= 0)) {
                return Number(stock.diameterMm) > 0 && Number(stock.lengthMm) > 0
                    ? 'Ø' + CncMetricText(stock.diameterMm) + ' × ' + CncMetricText(stock.lengthMm) + ' mm'
                    : '—';
            }
            var size = stock.stockSizeMm || {};
            return Number(size.x) > 0 && Number(size.y) > 0 && Number(size.z) > 0
                ? CncMetricText(size.x) + ' × ' + CncMetricText(size.y) + ' × ' + CncMetricText(size.z) + ' mm'
                : '—';
        }

        function CncReviewFinish(item, quantity) {
            var code = item.cncFinish && item.cncFinish.code ? item.cncFinish.code : 'none';
            if (code === 'none') { return iqReviewText.standardMachined + ' · ' + iqReviewText.included; }
            var label = code === 'anodize-clear'
                ? iqReviewText.clearAnodize
                : (code === 'sand-blast' ? iqReviewText.sandBlast : code.replace(/[-_]/g, ' '));
            var finishLine = item.cncQuote && Array.isArray(item.cncQuote.lineItems)
                ? item.cncQuote.lineItems.find(function (line) { return line.code === 'finish'; }) : null;
            var amount = finishLine ? Math.max(0, Number(finishLine.amountBeforeVat) || 0) : 0;
            return label + ' · +' + FormatMoney(amount / Math.max(1, quantity)) + ' THB/' + cncUiText.perPiece;
        }

        function CncReviewOperationName(operation) {
            return cncUiText.operations[operation.code] || operation.name || String(operation.code || '').replace(/[-_]/g, ' ');
        }

        function CncReviewToolFamily(operation, tool) {
            var family = tool ? tool.family : (operation.toolFamily || operation.toolType);
            return cncUiText.toolFamilies[family] || String(family || '').replace(/[-_]/g, ' ');
        }

        function CncCompactMetric(value) {
            return Number(value).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        }

        function CncReviewOperationGroups(operations, setupNumber) {
            var groups = [];
            operations.filter(function (operation) { return Number(operation.setupNumber) === setupNumber; }).forEach(function (operation) {
                // Collapse adjacent identical rows only: do not reorder machining steps,
                // merge different cutters, or mutate the plan used for time and pricing.
                var key = JSON.stringify([operation.code, CncReviewOperationName(operation),
                    operation.toolId || null, operation.toolFamily || operation.toolType || null,
                    operation.toolDiameterMm || null, operation.reachable !== false,
                    operation.pitchMm || null, operation.includedAngleDegrees || null]);
                var previous = groups[groups.length - 1];
                if (previous && previous.key === key) {
                    previous.count++;
                } else {
                    groups.push({ operation: operation, key: key, count: 1 });
                }
            });
            return groups;
        }

        function BuildCncSetupDetails(item) {
            var host = CreateEl('div', 'iq-cnc-setup-list');
            var plan = item.cncPlan || {};
            var setups = Array.isArray(plan.setups) ? plan.setups : [];
            var operations = Array.isArray(plan.operations) ? plan.operations : [];
            if (!setups.length) {
                host.appendChild(CreateEl('p', 'text-muted small mb-0', iqReviewText.operationPlanPending));
                return host;
            }

            setups.forEach(function (setup, setupIndex) {
                var setupNumber = Number(setup.number) || setupIndex + 1;
                var setupSection = CreateEl('section', 'iq-cnc-setup');
                var heading = CreateEl('div', 'iq-cnc-setup-heading');
                heading.appendChild(CreateEl('strong', null, iqReviewText.setup + ' ' + setupNumber));
                heading.appendChild(CreateEl('span', null, Math.round(Math.max(0, Number(setup.minutes) || 0)) + ' ' + cncUiText.minutes));
                setupSection.appendChild(heading);
                var operationList = CreateEl('ul', 'iq-cnc-operation-list');
                CncReviewOperationGroups(operations, setupNumber).forEach(function (group) {
                    var operation = group.operation;
                    var row = CreateEl('li', 'iq-cnc-operation');
                    var operationName = CncReviewOperationName(operation) + (group.count > 1 ? ' ×' + group.count : '');
                    row.appendChild(CreateEl('span', 'iq-cnc-operation-name', operationName));
                    var tool = operation.toolId ? CncToolLibrary.get(operation.toolId) : null;
                    var toolFamily = tool ? tool.family : (operation.toolFamily || operation.toolType);
                    if (toolFamily) { row.setAttribute('data-review-tool-family', toolFamily); }
                    var toolText = CncReviewToolFamily(operation, tool);
                    // A catalogue fallback or absent cutter is not a verified machining
                    // instruction. Manual deburring deliberately has no catalogue cutter.
                    var unresolvedTool = operation.reachable === false || (!tool && operation.code !== 'deburring');
                    if (unresolvedTool) {
                        row.setAttribute('data-review-tool-status', 'unresolved');
                        toolText = iqReviewText.toolReviewRequired + (toolText ? ' · ' + toolText : '');
                    }
                    if (tool) {
                        if (tool.designation) { toolText += ' · ' + tool.designation; }
                        toolText += ' · Ø' + CncCompactMetric(tool.diameterMm) + ' mm'
                            + ' · ' + cncUiText.toolLabels.flute + ' ' + CncCompactMetric(tool.usableCutLengthMm) + ' mm'
                            + ' · ' + cncUiText.toolLabels.reach + ' ' + CncCompactMetric(tool.reachMm) + ' mm';
                    }
                    if (Number(operation.includedAngleDegrees) > 0) {
                        toolText += ' · ' + CncCompactMetric(operation.includedAngleDegrees) + '°';
                    }
                    if (operation.code === 'thread_milling'
                        && Number(operation.threadMajorDiameterMm) > 0 && Number(operation.pitchMm) > 0) {
                        toolText += ' · M' + CncCompactMetric(operation.threadMajorDiameterMm)
                            + ' × ' + CncCompactMetric(operation.pitchMm);
                    }
                    var toolSpec = CreateEl('span', 'iq-cnc-tool-spec', toolText);
                    if (tool) {
                        toolSpec.setAttribute('data-review-tool-diameter', CncCompactMetric(tool.diameterMm));
                        toolSpec.setAttribute('data-review-tool-flute', CncCompactMetric(tool.usableCutLengthMm));
                        toolSpec.setAttribute('data-review-tool-reach', CncCompactMetric(tool.reachMm));
                    }
                    row.appendChild(toolSpec);
                    operationList.appendChild(row);
                });
                if (!operationList.children.length) {
                    operationList.appendChild(CreateEl('li', 'iq-cnc-operation', iqReviewText.operationPlanPending));
                }
                setupSection.appendChild(operationList);
                host.appendChild(setupSection);
            });
            return host;
        }

        function BuildCncManufacturingSummary(item, info, batchFinalized) {
            var summary = CreateEl('div', 'iq-cnc-manufacturing-summary');
            var mayRevealFacts = batchFinalized === undefined
                ? CncHasFinalQuote(item) && item.cncValidatedPlan
                : batchFinalized && CncHasFinalQuote(item) && item.cncValidatedPlan;
            if (!mayRevealFacts) {
                var processing = CncStatusIsLoading(item) || (batchFinalized === false && CncPricingSummaryState().processing);
                if (processing) {
                    summary.setAttribute('aria-busy', 'true');
                    for (var placeholderIndex = 0; placeholderIndex < 4; placeholderIndex += 1) {
                        summary.appendChild(CreateEl('div', 'iq-skeleton-text', 'Loading'));
                    }
                } else {
                    summary.appendChild(CreateEl('p', 'iq-alert warn', cncUiText.reviewNoAutomaticPrice));
                }
                return summary;
            }
            var stock = item.cncStock || {};
            var quantity = NormalizeReviewQuantity(item.quantity, 1);
            var blankCount = Math.max(1, Number(stock.pieces) || 1);
            var stockVolumePerBlankMm3 = Math.max(0, Number(stock.stockVolumeMm3) || 0);
            var stockVolumeMm3 = stockVolumePerBlankMm3 * blankCount;
            var partVolumeMm3 = Math.max(0, Number(info.volume) || 0);
            var removedVolumeMm3 = Math.max(0, Number(stock.removalVolumeMm3) || (stockVolumeMm3 - (partVolumeMm3 * quantity)));
            var removedPercent = stockVolumeMm3 > 0 ? (removedVolumeMm3 / stockVolumeMm3) * 100 : 0;
            var requirements = CncRequirementsForItem(item);
            var quote = item.cncQuote || {};
            var setupCount = quote.setupPlan && quote.setupPlan.setupCount
                ? quote.setupPlan.setupCount
                : item.cncPlan && Array.isArray(item.cncPlan.setups) ? item.cncPlan.setups.length : 1;
            var minutesPerPart = Math.max(0, Number(quote.estimatedMinutesPerPart) || 0);

            function AddGroup(key, title) {
                var group = CreateEl('section', 'iq-cnc-summary-group');
                group.setAttribute('data-review-manufacturing-group', key);
                group.appendChild(CreateEl('h4', 'iq-cnc-summary-group-title', title));
                summary.appendChild(group);
                return group;
            }

            function AddFact(group, label, value, modifier) {
                var fact = CreateEl('div', 'iq-cnc-summary-fact');
                fact.appendChild(CreateEl('span', 'iq-cnc-summary-label', label));
                var valueElement = CreateEl('strong', 'iq-cnc-summary-value' + (modifier ? ' ' + modifier : ''), value || '—');
                valueElement.setAttribute('data-review-value', 'manufacturing');
                fact.appendChild(valueElement);
                group.appendChild(fact);
                return valueElement;
            }

            var stockGroup = AddGroup('stock-removal', iqReviewText.stockRemovalGroup);
            AddFact(stockGroup, iqReviewText.stockSize, stockVolumeMm3 > 0 ? CncReviewStockType(stock) + ' · ' + CncReviewStockDimensions(stock) : '—');
            AddFact(stockGroup, iqReviewText.stockVolume, stockVolumeMm3 > 0 ? ToTwoDecimalPoint(stockVolumeMm3 / 1000) + ' cm³' + (blankCount > 1 ? ' · ' + blankCount + '×' : '') : '—', 'iq-cnc-summary-value--measure');
            AddFact(stockGroup, iqReviewText.partVolume, partVolumeMm3 > 0 ? ToTwoDecimalPoint(partVolumeMm3 / 1000) + ' cm³ × ' + quantity : '—', 'iq-cnc-summary-value--measure');
            AddFact(stockGroup, iqReviewText.materialRemoved, stockVolumeMm3 > 0 ? ToTwoDecimalPoint(removedVolumeMm3 / 1000) + ' cm³ · ' + ToTwoDecimalPoint(removedPercent) + '%' : '—', 'iq-cnc-summary-value--measure');

            var setupGroup = AddGroup('setups-operations', iqReviewText.setupsOperationsGroup);
            AddFact(setupGroup, iqReviewText.machiningTime, minutesPerPart > 0 ? Math.round(minutesPerPart) + ' ' + cncUiText.minutes + ' ' + iqReviewText.perPart + (quantity > 1 ? ' · ' + Math.round(minutesPerPart * quantity) + ' ' + cncUiText.minutes + ' ' + iqReviewText.batchTotal : '') : '—');
            AddFact(setupGroup, iqReviewText.setupCount, item.cncPlan ? setupCount + ' ' + iqReviewText.setups : '—');
            var fixtureLine = Array.isArray(quote.lineItems)
                ? quote.lineItems.find(function (line) { return line.code === 'workholding'; }) : null;
            if (item.cncPlan && item.cncPlan.fixtureStrategy && item.cncPlan.fixtureStrategy.required === true) {
                var fixtureAmount = fixtureLine ? Math.max(0, Number(fixtureLine.amountBeforeVat) || 0) : 0;
                AddFact(setupGroup, iqReviewText.workholdingStrategy,
                    iqReviewText.machinedMatingFixture + (fixtureAmount > 0
                        ? ' · +' + FormatMoney(fixtureAmount) + ' THB/' + iqReviewText.batchTotal : ''));
            }
            setupGroup.appendChild(BuildCncSetupDetails(item));

            var finishGroup = AddGroup('finish-documentation', iqReviewText.finishDocumentationGroup);
            var finishValue = AddFact(finishGroup, iqReviewText.surfaceFinish, CncReviewFinish(item, quantity));
            finishValue.setAttribute('data-review-finish-code', item.cncFinish && item.cncFinish.code ? item.cncFinish.code : 'none');
            AddFact(finishGroup, iqReviewText.machinedSurface, CncReviewRoughness(requirements.roughness));
            var toleranceValue = AddFact(finishGroup, iqReviewText.tolerance, CncReviewTolerance(requirements), 'iq-cnc-summary-value--measure');
            toleranceValue.setAttribute('data-review-tolerance', requirements.tolerance || 'ISO 2768-m');
            AddFact(finishGroup, iqReviewText.threads, CncReviewThreads(requirements));
            AddFact(finishGroup, iqReviewText.inspection, CncReviewInspection(requirements.inspection));
            var certificateLine = Array.isArray(quote.lineItems)
                ? quote.lineItems.find(function (line) { return line.code === 'material_certificate'; })
                : null;
            var certificateAmount = certificateLine ? Math.max(0, Number(certificateLine.amountBeforeVat) || 0) : 0;
            var certificateText = requirements.certificate === 'required'
                ? iqReviewText.required + (certificateAmount > 0 ? ' · +' + FormatMoney(certificateAmount) + ' THB/' + iqReviewText.batchTotal : '')
                : iqReviewText.notRequired;
            var certificateValue = AddFact(finishGroup, iqReviewText.materialCertificate, certificateText);
            certificateValue.setAttribute('data-review-certificate', requirements.certificate || 'not-required');
            var drawingStatus = item.cncDrawing ? item.cncDrawing.status : null;
            var drawingText = item.cncDrawing && item.cncDrawing.fileName
                ? item.cncDrawing.fileName + ' · ' + (drawingStatus === 'ready'
                    ? iqReviewText.ready
                    : drawingStatus === 'failed' ? iqReviewText.drawingUploadFailed : iqReviewText.uploading)
                : iqReviewText.notAttached;
            AddFact(finishGroup, iqReviewText.technicalDrawing, drawingText, item.cncDrawing && item.cncDrawing.fileName ? 'iq-cnc-summary-value--file' : '');
            return summary;
        }

        function BuildPartDisclosure(id, item, info, batchFinalized) {
            var wrap = CreateEl('div', 'iq-part-disclosure');
            { wrap.setAttribute('data-review-region', 'manufacturing'); }
            var panelId = 'part-details-' + id;
            var initiallyOpen = false;
            var toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'iq-part-disclosure-toggle';
            toggle.setAttribute('aria-expanded', initiallyOpen ? 'true' : 'false');
            toggle.setAttribute('aria-controls', panelId);
            toggle.dataset.partDisclosureToggle = id;
            var caret = CreateEl('i', 'fas fa-chevron-down iq-part-disclosure-caret');
            caret.setAttribute('aria-hidden', 'true');
            toggle.appendChild(CreateEl('span', 'iq-part-disclosure-label', iqReviewText.cncManufacturingSummary));
            var dfmAlerts = [];
            if (dfmAlerts.length > 0) {
                var flag = CreateEl('span', 'iq-part-disclosure-flag', String(dfmAlerts.length));
                flag.setAttribute('role', 'img');
                flag.setAttribute('aria-label', iqReviewText.dfmWarningLabel + ': ' + dfmAlerts.map(function (a) { return a.title; }).join(' · '));
                toggle.appendChild(flag);
            }
            toggle.appendChild(caret);

            var panel = CreateEl('div', 'iq-part-disclosure-panel');
            panel.id = panelId;
            panel.hidden = !initiallyOpen;
            {
                panel.appendChild(BuildCncManufacturingSummary(item, info, batchFinalized));
            }
            toggle.addEventListener('click', function () { TogglePartDisclosure(id); });
            {
                // Keep native button activation without reaching the form's Enter guard.
                toggle.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') { event.stopPropagation(); }
                });
            }
            wrap.appendChild(toggle);
            wrap.appendChild(panel);
            return wrap;
        }

        // One at a time across the whole review list, and zero open is a valid state:
        // re-clicking the open part closes it rather than forcing one to stay expanded.
        // Reading geometry is not selecting a part: this only opens and closes. Selection
        // stays with the thumbnail, so opening a disclosure cannot move the viewer, rewrite
        // the configurator's shared metrics card, or trigger a reprice.
        function TogglePartDisclosure(id) {
            var toggles = document.querySelectorAll('#finalization-panel .iq-review-item [data-part-disclosure-toggle]');
            for (var i = 0; i < toggles.length; i++) {
                var t = toggles[i];
                var isTarget = String(t.dataset.partDisclosureToggle) === String(id);
                var wasOpen = t.getAttribute('aria-expanded') === 'true';
                var open = isTarget && !wasOpen;
                t.setAttribute('aria-expanded', open ? 'true' : 'false');
                var panel = document.getElementById(t.getAttribute('aria-controls'));
                if (panel) { panel.hidden = !open; }
            }
        }

        function NormalizeReviewQuantity(quantity, fallback) {
            var value = Number(quantity);
            if (!Number.isFinite(value) || value < 1) { value = Number(fallback); }
            if (!Number.isFinite(value)) { value = 1; }
            return Math.max(1, Math.min(1000, Math.trunc(value)));
        }

        function SetReviewCardLoading(card, isLoading) {
            if (!card) { return; }
            card.classList.toggle('is-calculating', isLoading);
            card.setAttribute('aria-busy', isLoading ? 'true' : 'false');
            card.querySelectorAll('.iq-review-select, .iq-review-input').forEach(function (control) {
                if (isLoading) {
                    control.disabled = true;
                } else {
                    control.disabled = false;
                }
            });
            card.querySelectorAll('[data-review-value]').forEach(function (value) {
                value.classList.toggle('iq-skeleton-text', isLoading);
            });
        }

        function SyncCncReviewExplanation(card, item) {
            if (!card) { return; }
            var existing = card.querySelector('[data-cnc-review-explanation]');
            var reviewRequired = item && (item.cncStatus === 'review_required' || item.cncStatus === 'failed');
            if (!reviewRequired) {
                if (existing) { existing.remove(); }
                return;
            }
            var explanation = existing || CreateEl('p', 'iq-alert warn', cncUiText.reviewNoAutomaticPrice);
            explanation.setAttribute('data-cnc-review-explanation', '');
            if (!existing) { card.appendChild(explanation); }
        }

        function UpdateReviewCardValues(card, id) {
            if (!card) { return; }
            var unitPrice = document.getElementById('item-estimated-unit-cost-' + id);
            var subtotal = document.getElementById('item-estimated-total-cost-' + id);
            var unitValue = card.querySelector('[data-review-value="unit-price"]');
            var subtotalValue = card.querySelector('[data-review-value="line-subtotal"]');
            if (unitValue) { unitValue.textContent = unitPrice && unitPrice.value ? unitPrice.value : '—'; }
            if (subtotalValue) { subtotalValue.textContent = subtotal && subtotal.value ? subtotal.value : '—'; }
            {
                var item = utils.GetItem(id);
                var batchFinalized = CncAllItemsFinalizedForPrice();
                SetReviewCardLoading(card, !batchFinalized);
                SyncCncReviewExplanation(card, item);
                var manufacturingSummary = card.querySelector('.iq-cnc-manufacturing-summary');
                if (item && item.modelInfo && manufacturingSummary) {
                    manufacturingSummary.replaceWith(BuildCncManufacturingSummary(item, item.modelInfo, batchFinalized));
                }
            }
        }

        // The estimate is only as firm as the geometry it was computed from. A watertight
        // mesh yields a measured volume; a non-watertight one falls back to half the
        // bounding box, which is a guess and must not be presented as a firm figure.
        function UpdatePriceConfidence() {
            var host = document.getElementById('iq-price-confidence');
            if (!host) { return; }

            var ids = utils.GetAllItemIds();
            var estimated = 0;
            for (var i = 0; i < ids.length; i++) {
                var item = utils.GetItem(ids[i]);
                if (item && item.modelInfo && item.modelInfo.nonWatertight) { estimated++; }
            }

            if (ids.length === 0) {
                host.hidden = true;
                return;
            }

            host.hidden = false;
            host.classList.toggle('is-review', estimated > 0);
            host.classList.toggle('is-firm', estimated === 0);

            if (estimated === 0) {
                host.textContent = iqConfidenceText.firm;
                return;
            }

            host.textContent = estimated === ids.length
                ? iqConfidenceText.reviewAll
                : iqConfidenceText.reviewSome;
        }

        // Re-reads every rendered review row from its backing hidden inputs. Cheap, and it
        // means no row can be left displaying a stale value or an em dash after a reprice.
        function RefreshAllReviewRows() {
            var list = document.querySelectorAll('#finalization-panel .iq-review-item[data-item-id]');
            for (var i = 0; i < list.length; i++) {
                UpdateReviewCardValues(list[i], list[i].getAttribute('data-item-id'));
            }
        }

        var reviewCalculationVersions = {};
        function RepriceReviewItem(id, card, settings) {
            var item = utils.GetItem(id);
            if (!item || !item.modelInfo) { return; }
            var reviewFocusKey = ReviewFocusKey(document.activeElement);
            if (settings && settings.material && CncMaterialCatalog.get(settings.material)) {
                item.cncAlloy = settings.material;
                item.material = settings.material;
            }
            if (settings && settings.quantity) {
                item.quantity = NormalizeReviewQuantity(settings.quantity, item.quantity);
            }
            SetReviewCardLoading(card, true);
            return GetCncEstimate(id, {
                itemOnly: true,
                change: { type: 'review-control-changed', itemId: id, focusedItemId: id, focusKey: reviewFocusKey },
                onComplete: function () { }
            });
        }

        function HandleReviewMaterialChange(id, material, card) {
            var item = utils.GetItem(id);
            if (!item) { return; }
            RepriceReviewItem(id, card, { material: material, quantity: item.quantity });
        }

        function HandleReviewQuantityChange(id, quantity, card) {
            var item = utils.GetItem(id);
            if (!item) { return; }
            var normalizedQuantity = NormalizeReviewQuantity(quantity, item.quantity);
            var quantityInput = card ? card.querySelector('.iq-review-quantity') : null;
            if (quantityInput) { quantityInput.value = String(normalizedQuantity); }
            RepriceReviewItem(id, card, { quantity: normalizedQuantity });
        }

        // totalOnly collapses the itemised rows to the grand total: the customer-details
        // step sits directly after the review step, where the same breakdown was just
        // shown line by line, so repeating it there only competes with the form.
        function CncAllItemsFinalizedForPrice() {
            var ids = utils.GetAllItemIds();
            return ids.length > 0 && ids.every(function (id) {
                var item = utils.GetItem(id);
                return !!(item && item.cncStatus === 'finalized' && item.cncQuote && item.cncValidatedPlan);
            });
        }

        function CncSubmissionReady() {
            var ids = utils.GetAllItemIds();
            return CncAllItemsFinalizedForPrice() && ids.every(function (id) {
                var item = utils.GetItem(id);
                var requirements = CncRequirementSubmission(item);
                return !!(item && item.uploadComplete && item.cncModelUploadReceipt
                    && requirements.valid && (!CncDrawingRequired(requirements) || CncDrawingAvailable(item)));
            });
        }

        function CncReviewReady() {
            return CncAllItemsFinalizedForPrice();
        }

        function CncPricingSummaryState() {
            var ids = utils.GetAllItemIds();
            var allFinalized = CncAllItemsFinalizedForPrice();
            var reviewRequired = !allFinalized && ids.some(function (id) {
                var item = utils.GetItem(id);
                return item && (item.cncStatus === 'review_required' || item.cncStatus === 'failed');
            });
            return { allFinalized: allFinalized, reviewRequired: reviewRequired, processing: !allFinalized && !reviewRequired };
        }

        function RenderCncNonfinalPricingSummary(card, state) {
            if (state.reviewRequired) {
                card.appendChild(CreateEl('p', 'iq-alert warn', cncUiText.reviewNoAutomaticPrice));
                return;
            }
            card.setAttribute('aria-busy', 'true');
            [iqReviewText.printingSubtotal, iqReviewText.shipping, iqReviewText.vat, iqReviewText.grandTotal].forEach(function (label) {
                var row = CreateEl('div', 'iq-pricing-row');
                row.appendChild(CreateEl('span', '', label));
                var placeholder = CreateEl('strong', 'iq-price-placeholder', 'Loading');
                placeholder.setAttribute('aria-label', '@Localizer["Calculating"]');
                row.appendChild(placeholder);
                card.appendChild(row);
            });
        }

        function RenderPricingSummary(host, title, totalOnly) {
            if (!host) { return; }
            host.replaceChildren();
            if (host.id === 'configuration-pricing-summary') {
                host.hidden = true;
                return;
            }
            host.hidden = false;
            var card = document.createElement('section');
            card.className = 'iq-review-card iq-pricing-summary';
            // h2, not h6. The page has exactly one h1, so an h6 here announced the price
            // summary as nested five levels under headings that do not exist. It is a peer
            // of the configurator, and its size comes from the class, not the tag.
            card.appendChild(CreateEl('h2', 'iq-pricing-summary-title', title));

            var cncSummaryState = CncPricingSummaryState();
            if (!cncSummaryState.allFinalized) {
                RenderCncNonfinalPricingSummary(card, cncSummaryState);
                host.appendChild(card);
                host.setAttribute('aria-busy', cncSummaryState.processing ? 'true' : 'false');
                return;
            }
            host.setAttribute('aria-busy', 'false');

            function AddPriceRow(label, value, modifier) {
                var row = CreateEl('div', 'iq-pricing-row' + (modifier ? ' ' + modifier : ''));
                row.appendChild(CreateEl('span', '', label));
                row.appendChild(CreateEl('strong', '', FormatMoney(value) + ' ' + displayCurrencyLabel));
                card.appendChild(row);
            }

            if (!totalOnly) {
                AddPriceRow(iqReviewText.printingSubtotal, latestOrderTotal.itemsSubtotal);
                if (latestOrderTotal.minimumOrderSurcharge > 0) {
                    var minimumLabel = iqReviewText.minimumOrderSurcharge + ' (' + iqReviewText.minimumOrderMinimum + ' ' + FormatMoney(latestOrderTotal.minimumOrderPrice) + ' ' + displayCurrencyLabel + ')';
                    AddPriceRow(minimumLabel, latestOrderTotal.minimumOrderSurcharge);
                }
                AddPriceRow(iqReviewText.shipping, latestOrderTotal.shipping);
                AddPriceRow(iqReviewText.vat, latestOrderTotal.vat);
            }
            AddPriceRow(iqReviewText.grandTotal, latestOrderTotal.finalOrderPrice, 'iq-total');

            var lead = CreateEl('div', 'iq-pricing-row iq-pricing-lead');
            lead.appendChild(CreateEl('span', '', iqReviewText.leadTime));
            var leadValue = document.getElementById('total-estimated-time');
            lead.appendChild(CreateEl('strong', '', (leadValue ? leadValue.textContent : '—') + ' · ' + iqReviewText.afterConfirmed));
            card.appendChild(lead);
            host.appendChild(card);
        }

        function RenderAllPricingSummaries() {
