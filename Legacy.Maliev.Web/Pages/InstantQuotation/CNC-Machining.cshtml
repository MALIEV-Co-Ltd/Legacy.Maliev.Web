        .iq-cnc-setup:first-child { padding-top: 0; border-top: 0; }
        .iq-cnc-setup-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; color: #111f33; font-size: var(--maliev-text-xs); }
        .iq-cnc-setup-heading strong { font-weight: 600; }
        .iq-cnc-setup-heading span { color: #5b6777; font-variant-numeric: tabular-nums; }
        .iq-cnc-operation-list { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; }
        .iq-cnc-operation { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.2rem; padding-block: 0.3rem; color: #5b6777; font-size: var(--maliev-text-sm); line-height: 1.5; }
        .iq-cnc-operation-name { color: #111f33; font-weight: 600; }
        .iq-cnc-tool-spec { min-width: 0; font-family: inherit; font-size: var(--maliev-text-sm); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }

        .iq-part-rows { display: grid; gap: 0.2rem; }
        .iq-part-row { display: flex; justify-content: space-between; gap: 0.6rem; font-size: 0.75rem; color: var(--bs-secondary-color); }
        .iq-part-row b { font-weight: 600; color: var(--maliev-ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
        .iq-part-verdict { margin-top: 0.45rem; }
        /* 992, not 768. The card sits inside the configuration column, so it only gets
           roughly half the viewport: at an 864px window each of its two columns is about
           340px, which breaks "ค่าธรรมเนียมยอดสั่งซื้อขั้นต่ำ" mid-word and wraps the CTA
           onto four lines. The breakpoint has to describe the column the card lives in,
           not the window. */
        /* Phones only. This used to start at 992px, which caught every iPad: the metrics
           card, the price summary, the submit button, the engineer dropup and the legal
           note each took their own full-width row and the footer grew to 528px -- 45% of a
           1180px-tall iPad and over half of a 768px one. A tablet has 450-700px of width
           here, which is more than the desktop layout gets at 1200px, so it keeps the
           two-up arrangement and the footer stays around 280px. */
        @@media (max-width: 767.98px) {
            .iq-bottom-row { grid-template-columns: minmax(0, 1fr); }
            .iq-bottom-row > .iq-review-summary-host, .iq-bottom-row > .iq-config-summary-host { border-left: 0; padding-left: 0; border-top: 1px solid var(--maliev-line); padding-top: 0.6rem; }
            .iq-config-summary-action { grid-template-columns: minmax(0, 1fr); }
            .iq-summary-contact-actions { grid-column: 1; grid-row: auto; }
        }
        /* Side by side, not stacked: the three actions sat at the foot of the price
           column, which is already the taller of the two, so each stacked row added its
           full height to the row while the part column beside it had run out of content.
           One line for the two doors, one for the legal note. */
        .iq-config-summary-action { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 0.4rem; margin-top: 0.35rem; padding-top: 0.55rem; border-top: 1px solid var(--maliev-line); }
        .iq-config-summary-action .iq-submit-btn { white-space: normal; }
        .iq-config-summary-action .iq-secondary-door { justify-content: center; }
        /* Was 0.62rem (9.9px). The design system's smallest step is the .78rem label, and
           Thai tone marks are not legible below it. */
        .iq-config-summary-action .safe { grid-column: 1 / -1; margin-top: 0; color: var(--bs-secondary-color); font-size: 0.78rem; text-align: center; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.35rem; }
        .iq-config-summary-action .safe a { display: inline-flex; align-items: center; min-height: 24px; padding: 0 0.15rem; color: var(--bs-primary); text-decoration: underline; }
        /* Parts dock — sits under the preview, in the viewer column. */
        /* The metrics card was stretching to the pricing summary's height, which left a
           couple of hundred pixels of empty card under the DFM findings. It sizes to its
           own content; the summary is free to be taller. */
        .iq-config-metrics-host, .iq-review-metrics-host { align-self: flex-start; }
        .iq-config-metrics-host .iq-metrics-card, .iq-review-metrics-host .iq-metrics-card { height: auto; }

        .iq-parts-dock { flex: 0 0 auto; padding: 0.75rem; }
        /* align-self: flex-start above stops the card stretching to the summary in the
           row layout; in this column-direction parent the same value collapses its width
           to zero, so it stretches here. */
        .iq-wrap.iq-state-empty .iq-parts-dock { display: none; }
        .iq-parts-dock-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.4rem; }
        .iq-parts-count { font-size: 0.78rem; color: var(--bs-secondary-color); font-variant-numeric: tabular-nums; }

        /* The dropzone names its action and then answers the two questions a first-time
           visitor actually has — which formats, and how large. The old copy said "drop
           your file" twice and never mentioned either. */
        .iq-dropzone { gap: 0.15rem; transition: border-color 0.18s ease, background-color 0.18s ease; }
        /* A tinted disc with a blue glyph, not a filled blue button: at part-tile size the
           tile sits in a row of renders, and a solid blue disc there reads as a selected
           part rather than as the way to add one. */
        .iq-dz-ring { display: inline-flex; align-items: center; justify-content: center; width: 2.15rem; height: 2.15rem; border-radius: 50%; background: var(--maliev-blue-soft); color: var(--maliev-blue); }
        .iq-dz-ring i { display: block; font-size: 1.1rem; line-height: 1; }
        .iq-dropzone .iq-dz-title { display: block; font-size: 0.85rem; font-weight: 600; color: var(--bs-body-color); }
        .iq-dz-formats { font-size: var(--maliev-text-2xs); line-height: 1.35; letter-spacing: 0.01em; }
        .iq-dz-limit { font-size: var(--maliev-text-2xs); }
        .iq-dropzone:hover { border-color: var(--bs-primary); background: rgba(var(--bs-primary-rgb), 0.04); }
        .iq-dropzone:hover .iq-dz-ring { transform: scale(1.06); }
        .iq-dz-ring { transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
        .iq-dropzone:focus-visible { outline: none; border-color: var(--bs-primary); box-shadow: 0 0 0 0.2rem rgba(7, 93, 232, 0.14); }
        @@media (prefers-reduced-motion: reduce) { .iq-dropzone, .iq-dz-ring { transition: none; } .iq-dropzone:hover .iq-dz-ring { transform: none; } }

        /* Codex's verification browser advertises reduced motion. Development deliberately
           restores the quotation's state feedback so local visual QA can observe loaders,
           transitions, and processing stages. Production keeps the accessible media-query
           behavior above. */
        html.iq-force-motion-verification .iq-ve-rig { animation: iq-ve-float 5.6s ease-in-out infinite; }
        html.iq-force-motion-verification .iq-ve-drop { animation: iq-ve-drop 5.6s ease-in-out infinite; }
        html.iq-force-motion-verification .iq-ve-cube { animation: iq-ve-spin 18s linear infinite; transform-style: preserve-3d; }
        html.iq-force-motion-verification .iq-ve-tilt { transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
        html.iq-force-motion-verification .iq-review-value.iq-skeleton-text::after,
        html.iq-force-motion-verification .iq-price-loading .iq-pricing-row strong::after,
        html.iq-force-motion-verification [data-cnc-metric].iq-metric-skeleton::after { animation: iq-shimmer 1.15s ease-in-out infinite; }
        html.iq-force-motion-verification .iq-part-disclosure-caret { transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
        html.iq-force-motion-verification .iq-dropzone { transition: border-color 0.18s ease, background-color 0.18s ease; }
        html.iq-force-motion-verification .iq-dz-ring { transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
        html.iq-force-motion-verification .iq-dropzone:hover .iq-dz-ring { transform: scale(1.06); }

        .iq-thumb-index { position: absolute; top: 5px; left: 6px; z-index: 1; padding: 0 0.3rem; border-radius: 0.3rem; background: #eaf2ff; color: var(--bs-primary); font-size: var(--maliev-text-xs); font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
        .iq-mat-toggle { margin-top: 0.5rem; min-height: 44px; width: 100%; padding: 0.5rem 0.8rem; border: 1px solid var(--bs-border-color); border-radius: 0.45rem; background: #fff; color: var(--bs-primary); font-size: var(--maliev-text-sm); font-weight: 600; cursor: pointer; }
        .iq-mat-toggle:hover { border-color: var(--bs-primary); background: #eaf2ff; }
        .iq-price-confidence { display: flex; align-items: flex-start; gap: 0.4rem; margin-top: 0.35rem; padding: 0.5rem 0.6rem; border: 1px solid transparent; border-radius: 0.45rem; font-size: 0.78rem; font-weight: 600; line-height: 1.4; }
        .iq-price-confidence.is-firm { background: #eaf7f1; border-color: #c8edd6; color: #087d55; }
        .iq-price-confidence.is-review { background: #fdf3e3; border-color: #ffe1ac; color: #a85d00; }
        .iq-secondary-door { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 44px; padding: 0.5rem 0.9rem; border: 1px solid #b9c8d9; border-radius: 0.45rem; background: #fff; color: var(--bs-body-color); font-size: 0.86rem; font-weight: 600; text-decoration: none; }
        .iq-secondary-door:hover { border-color: var(--bs-primary); background: #eaf2ff; color: #064dcc; }
        .iq-secondary-door-group { display: flex; }
        .iq-secondary-door-group .iq-secondary-door { width: 100%; cursor: pointer; }
        .iq-secondary-door-caret { font-size: 0.62rem; opacity: 0.65; transition: transform 0.15s ease; }
        .iq-secondary-door[aria-expanded="true"] .iq-secondary-door-caret { transform: rotate(180deg); }
        .iq-contact-menu { min-width: 13rem; padding: 0.3rem; border: 1px solid var(--maliev-line); border-radius: var(--maliev-radius-sm); box-shadow: 0 0.6rem 1.6rem rgba(16, 44, 78, 0.16); font-size: 0.84rem; }
        .iq-contact-menu .dropdown-item { display: flex; align-items: center; gap: 0.55rem; min-height: 40px; padding: 0.4rem 0.55rem; border-radius: 0.35rem; font-weight: 600; }
        .iq-contact-menu .dropdown-divider { margin: 0.25rem 0.3rem; }
        /* Channel marks stay in their own brand colours: they are what the customer is
           scanning for, and a row of identical grey glyphs makes them read as one option. */
        .iq-contact-icon { flex: 0 0 1.15rem; font-size: 1.05rem; text-align: center; color: var(--bs-secondary-color); }
        .iq-contact-line { color: #06c755; }
        .iq-contact-whatsapp { color: #25d366; }
        .iq-contact-messenger { color: #0084ff; }

        @@container iq-metrics-pane (max-width: 430px) {
            .iq-info-dfm { grid-template-columns: 1fr; gap: 0.55rem; }
        }

        /* A preview column can become narrow before the viewport reaches the mobile breakpoint.
           Stack DFM below the metrics based on the pane's real width. */
        @@container iq-preview-pane (max-width: 620px) {
            .iq-info-dfm { grid-template-columns: 1fr; gap: 0.55rem; }
        }

        @@container iq-preview-pane (max-width: 820px) {
            /* The setup selector and manufacturing key are supporting controls, not
               model content. In a narrow preview they leave the canvas entirely so the
               customer can rotate and inspect the part without an opaque card covering it. */
            .iq-cnc-overlay-panel {
                position: static; z-index: auto;
                display: flex; flex-wrap: wrap; align-items: center;
                gap: 0.5rem; padding: 0.55rem 0.75rem 0.65rem;
                border: 0; background: transparent;
            }
            .iq-cnc-setup-controls {
                min-width: 0; column-gap: 0; row-gap: 0; padding: 0;
                scroll-snap-type: inline proximity; scrollbar-width: thin;
            }
            .iq-cnc-setup-button {
                flex: 0 0 80px; width: 80px; padding-inline: 8px;
            }
        }

        .instant-quotation-success { display: grid; min-height: calc(100vh - 5rem); place-items: center; padding: 2rem; background: #f5f8fc; }
        .instant-quotation-success__card { width: min(100%, 42rem); padding: clamp(1.5rem, 5vw, 3rem); border: 1px solid #b8ddcb; border-radius: .85rem; background: #fff; box-shadow: 0 1rem 3rem rgba(4, 35, 24, .1); text-align: center; }
        .instant-quotation-success__icon { display: grid; width: 4rem; height: 4rem; margin: 0 auto 1rem; place-items: center; border-radius: 50%; background: #e7f8ef; color: #087d55; font-size: 1.8rem; }
        .instant-quotation-success__icon--warning { background: #fff4d6; color: #8a5b00; }
        .iq-customer-description { min-height: 5.25rem !important; height: 5.25rem; resize: vertical; }

        @@container customer-details (max-width: 760px) {
            .iq-customer-workspace { grid-template-columns: minmax(0, 1fr); }
            .iq-customer-progress { padding: 0.85rem 1rem; border-right: 0; border-bottom: 1px solid var(--maliev-line); }
            .iq-customer-progress-copy p { max-width: 60ch; }
            .iq-customer-progress-list { display: none; }
        }

        @@container customer-details (max-width: 520px) {
            .iq-customer-title { align-items: flex-start; flex-direction: column; gap: 0.4rem; }
            .iq-customer-fields { grid-template-columns: minmax(0, 1fr); }
            .iq-customer-field--wide { grid-column: auto; }
            /* City / province / postal stay side by side rather than becoming three more
               full-width rows -- they are short values and the column is already narrow. */
            .iq-address-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .iq-address-fields .iq-customer-field--wide { grid-column: 1 / -1; }
            .iq-customer-form-card { padding: 0.9rem; }
        }

        /* ---------------------------------------------------------------------
           Accessibility floor. The design system specifies a 44px touch target and
           WCAG 2.1 AA is the stated baseline, but 32 controls here measured under
           44x44 -- the 24 material info buttons at 12.5x18.7 among them -- and the
           primary call to action had outline-style: none with a static box-shadow,
           so tabbing to it changed nothing on screen.
           --------------------------------------------------------------------- */

        /* One visible focus treatment for every interactive element in the tool, so
           no control can quietly ship without one. */
        .iq-page :is(button, a, input, select, textarea, [role="radio"], [tabindex]):focus-visible {
            outline: 2px solid var(--bs-primary);
            outline-offset: 2px;
            border-radius: 0.3rem;
        }

        .iq-tool-btn { width: 44px; height: 44px; font-size: 1rem; }
        .iq-thumb-x { width: 28px; height: 28px; line-height: 26px; font-size: 13px; top: 4px; right: 4px; background: rgba(255, 255, 255, 0.92); border: 1px solid var(--bs-border-color); }
        /* Removing a part is destructive and sat on a 28px target. The glyph stays 28px --
           a bigger disc would crowd the render it sits on -- and an invisible inset carries
           the hit area to 44px. Safe here because the button owns a tile corner with no
           neighbouring target to steal taps from. */
        .iq-thumb-x::before { content: ''; position: absolute; inset: -8px; border-radius: 50%; }
        .iq-thumb-x:hover { background: #fff; color: var(--bs-danger); border-color: var(--bs-danger); }
        .iq-mat-info { position: absolute; top: 50%; right: 0; width: 44px; min-width: 44px; height: 44px; margin: 0; padding: 0; display: inline-flex; align-items: center; justify-content: center; transform: translateY(-50%); }
        #quantity-input { min-height: 44px; }
        .iq-qty-input { width: 110px; }
        .iq-submit-btn { min-height: 44px; }

        /* Touch input, not screen size: a laptop can have a touchscreen and a tablet can
           have a trackpad, so these key off the pointer rather than a breakpoint.
           The controls key off the pointer rather than a breakpoint. */
        @@media (pointer: coarse) {
            .iq-cnc-setup-button { min-height: 44px; }
        }

        /* The dropzone and empty-viewer hint are native file-input labels; keep their
           presentation aligned with the material-card controls. */
        .iq-dropzone, .iq-viewer-empty { font: inherit; color: inherit; text-align: center; -webkit-appearance: none; appearance: none; }
        .iq-viewer-empty { border: 0; }
        .iq-viewer-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; }
        .iq-mat-card { cursor: pointer; }

        /* Seam gutter between the two panes. Each pane insets its own content, so
           where they meet the viewer's right inset (.75rem) and the configuration
           column's left inset (.75-.9rem) stack into a gap roughly twice either
           outer margin, and the middle of the screen reads looser than its edges.
           The boundary is one gutter, not two: the viewer gives up its inner inset
           and the configuration column's left padding becomes the whole gap. Taking
           it off the viewer rather than halving both leaves the settings column's
           alignment untouched. Restored below 768px, where the panes stack and this
           edge is an outer edge again. Placed after the base rules it overrides. */
        .iq-viewer-notices { margin-right: 0; }
        .iq-parts-dock { padding-right: 0; }

        @@media (max-width: 767.98px) {
            html, body.instant-quotation-shell { height: auto; overflow: auto; }
            #main-content, .iq-page, #instant-quotation-form, #instant-quotation-component { height: auto; overflow: visible; }
            .iq-top { flex-direction: column; height: auto; max-height: none; min-height: 0; }
            /* Stacked: the viewer's right edge is an outer edge again, so it takes
               the same inset as its left rather than running to the pane boundary. */
            .iq-viewer-notices { margin-right: 0.75rem; }
            .iq-parts-dock { padding-right: 0.75rem; }
            .iq-viewer-pane { flex: 0 0 auto; height: auto; padding: 0; }
            .iq-cnc-setup-button { min-height: 44px; }
            .iq-viewer-visual { flex: 0 0 auto; min-height: 0; }
            .iq-viewer-stage { flex: 0 0 auto; height: clamp(280px, 72vw, 340px); min-height: 0; }
            /* The empty viewer is the mobile dropzone. Its height is calculated from
               the live viewport after page chrome (including the dismissible notice). */
            .iq-wrap.iq-state-empty .iq-top { min-height: var(--iq-empty-viewport-height, 100dvh); }
            .iq-wrap.iq-state-empty .iq-viewer-pane { flex: 1 1 auto; height: auto; min-height: 0; }
            .iq-wrap.iq-state-empty .iq-viewer-visual { flex: 1 1 auto; }
            .iq-wrap.iq-state-empty .iq-viewer-stage { flex: 1 1 auto; height: auto; }
            .iq-config-pane { flex: 1 1 auto; }
            .iq-config-pane { overflow: visible; }
            .iq-settings-card { overflow: visible; }
            .iq-settings-card .iq-mat-cards { overflow: visible; }
            .iq-settings-card {
                grid-template-columns: minmax(0, 1fr);
                grid-template-areas:
                    "heading"
                    "material"
                    "side";
            }
            .iq-info-dfm { grid-template-columns: 1fr; }
            .iq-dropzone { flex-basis: 178px; }
            .iq-thumb { flex-basis: 158px; width: 158px; min-width: 158px; max-width: 158px; height: 158px; }
            .iq-thumb-img { height: 78px; }
            .iq-review-item { grid-template-columns: 60px minmax(0, 1fr); gap: 0.65rem; }
            .iq-review-thumbnail { width: 60px; height: 60px; }
            .iq-review-fields { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .iq-config-pane.iq-customer-mode #finalization-panel { overflow: visible; }
            .iq-config-pane.iq-customer-mode #finalization-panel .iq-review-list { overflow: visible; }
            .iq-config-pane.iq-customer-mode #customer-details-panel { overflow: visible; }
            .iq-config-pane.iq-customer-mode #customer-details-panel .iq-customer-scroll { overflow: visible; }
        }

        /* Portrait tablets, and any tablet narrow enough that two panes cannot both work.
           These used to take the side-by-side branch below, which is where the configurator
           fell apart: an 820px iPad gave the configuration pane 476px, the side rail held a
           rigid 17rem of it, and the material grid was left with 132px -- two cards 81px
           wide, each carrying a name, a full material name and an info button. The preview
           was no better off at 344px.

           Stacking is the honest answer rather than shaving percentages: the preview gets
           the full width, which is what inspecting a part actually needs, and the
           configurator gets the entire content width instead of a squeezed side rail. The
           stage is capped so the controls are not pushed off the first screen. */
        @@media (min-width: 768px) and (max-width: 1279.98px) {
            html, body.instant-quotation-shell { height: auto; overflow: auto; }
            #main-content, .iq-page, #instant-quotation-form, #instant-quotation-component { height: auto; overflow: visible; }
            .iq-top { flex-direction: column; height: auto; max-height: none; min-height: 0; }
            /* Stacked, so the viewer's right edge is an outer edge again and takes the
               same inset as its left. */
            .iq-viewer-notices { margin-right: 0.9rem; }
            .iq-parts-dock { padding-right: 0.9rem; }
            .iq-viewer-pane { flex: 0 0 auto; height: auto; max-height: none; padding: 0; position: static; overflow: visible; }
            /* vh, not vw: these viewports are tall and narrow, and sizing the stage from
               width made it grow exactly where vertical room was scarcest. */
            .iq-viewer-visual { flex: 0 0 auto; min-height: 0; }
            .iq-viewer-stage { flex: 0 0 auto; height: clamp(260px, 32vh, 420px); min-height: 0; max-height: none; }
            .iq-wrap.iq-state-empty .iq-top { min-height: var(--iq-empty-viewport-height, 100dvh); }
            .iq-wrap.iq-state-empty .iq-viewer-pane { flex: 1 1 auto; height: auto; min-height: 0; max-height: none; align-self: stretch; }
            .iq-wrap.iq-state-empty .iq-viewer-visual { flex: 1 1 auto; }
            .iq-wrap.iq-state-empty .iq-viewer-stage { flex: 1 1 auto; height: auto; max-height: none; }
            .iq-config-pane { flex: 1 1 auto; overflow: visible; }
            /* One scroller, not two. The document scrolls here, so leaving the
               configuration column as its own 700px scroll region would trap touch
               momentum inside a panel whose content already fits. */
            #quotation-config-panel { flex: 0 0 auto; height: auto; min-height: 0; overflow: visible; }
            .iq-settings-card { overflow: visible; }
            .iq-settings-card .iq-mat-cards { overflow: visible; }
            /* Stacked only. On the side-by-side tablet the rail must keep its own scroller
               so the bulk-price tiers stay reachable inside a fixed shell; here the page
               scrolls, so a second nested scroller would just hide the quantity table. */
            .iq-settings-side { overflow-y: visible; }
            .iq-info-dfm { grid-template-columns: 1fr; }
            .iq-review-item { grid-template-columns: 60px minmax(0, 1fr); gap: 0.65rem; }
            .iq-review-thumbnail { width: 60px; height: 60px; }
            .iq-review-fields { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .iq-config-pane.iq-customer-mode #finalization-panel { overflow: visible; }
            .iq-config-pane.iq-customer-mode #finalization-panel .iq-review-list { overflow: visible; }
            .iq-config-pane.iq-customer-mode #customer-details-panel { overflow: visible; }
            .iq-config-pane.iq-customer-mode #customer-details-panel .iq-customer-scroll { overflow: visible; }
