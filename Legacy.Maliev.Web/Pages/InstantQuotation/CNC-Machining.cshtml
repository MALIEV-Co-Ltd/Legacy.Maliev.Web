    @*Empty-state cube. Starts on window load, when the deferred Three.js bundle is
      guaranteed to be on the window -- an earlier version guarded on typeof THREE and
      never recovered once it had bailed. Own renderer on its own canvas, so nothing
      here can disturb the part viewer.*@
    <script type="text/javascript">
        window.addEventListener('load', function () {
            var canvas = document.getElementById('iq-empty-canvas');
            var hint = document.getElementById('viewer-empty-hint');
            if (!canvas || typeof THREE === 'undefined') { return; }

            var reduce = window.malievPrefersReducedMotion();
            var w = canvas.clientWidth, h = canvas.clientHeight;
            if (!w || !h) { return; }

            var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            renderer.setSize(w, h, false);

            var scene = new THREE.Scene();
            // Orthographic: a true isometric does not converge, and a vanishing point on a
            // box this small only makes the near edges disagree with the far ones.
            var d = 1.6, a = w / h;
            var camera = new THREE.OrthographicCamera(-d * a, d * a, d, -d, 0.1, 100);
            camera.position.set(4, 4, 4);
            camera.lookAt(0, 0, 0);

            var cube = new THREE.Mesh(
                new THREE.BoxGeometry(1.3, 1.3, 1.3),
                // Neutral CAD grey: the same unpainted-stock look a viewport gives an
                // unassigned solid, so the placeholder does not imply a material choice
                // the customer has not made yet.
                new THREE.MeshLambertMaterial({ color: 0xa8adb2 })
            );
            cube.position.y = 0.4;
            scene.add(cube);

            // Restrained key-to-fill ratio. Enough fill to keep the shadowed faces from
            // going muddy, little enough that the three visible faces read as three
            // distinct values rather than one bright silhouette.
            var key = new THREE.DirectionalLight(0xffffff, 0.72);
            key.position.set(3, 6, 2.5);
            scene.add(key);
            scene.add(new THREE.AmbientLight(0xffffff, 0.28));
            scene.add(new THREE.HemisphereLight(0xffffff, 0xa9adb2, 0.38));

            function Frame(t) {
                requestAnimationFrame(Frame);
                // Skip the work whenever the empty state is not on screen. The hint's
                // display is set inline by UpdateEmptyHint.
                if (document.hidden || (hint && hint.style.display === 'none')) { return; }
                if (!reduce) {
