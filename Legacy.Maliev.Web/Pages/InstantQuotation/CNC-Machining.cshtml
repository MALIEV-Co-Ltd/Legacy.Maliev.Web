            }
            return item.cncDecisionMaterialPriceCache;
        }

        function CncCommonMaterialCodes() {
            return CncMaterialCatalog.listEnabled().filter(function (material) {
                return material.commonRank > 0;
            }).map(function (material) { return material.code; });
        }

        function CncVisibleMaterialCodes() {
            return Array.from(document.querySelectorAll('[data-cnc-material]')).filter(function (button) {
                return !button.hidden;
            }).map(function (button) { return button.dataset.cncMaterial; });
        }

        function CancelCncDecisionPriceWork(item) {
            if (!item) { return; }
            item.cncDecisionPriceGeneration = (item.cncDecisionPriceGeneration || 0) + 1;
            item.cncDecisionPricePromise = null;
            if (CncQuotationWorkerClient && typeof CncQuotationWorkerClient.cancelBackground === 'function') {
                CncQuotationWorkerClient.cancelBackground(item);
            }
        }

        function SyncCncDecisionPricesForSelection(item, showSelectedPrice) {
            var loadingPriceText = iqCulture === 'th' ? 'กำลังคำนวณราคา' : 'Calculating price';
            document.querySelectorAll('[data-cnc-quick-price]').forEach(function (priceHost) {
                priceHost.classList.add('is-loading');
                priceHost.setAttribute('aria-busy', 'true');
                priceHost.setAttribute('aria-label', loadingPriceText);
                var spinner = CreateEl('span', 'spinner-border spinner-border-sm');
                spinner.setAttribute('aria-hidden', 'true');
                priceHost.replaceChildren(spinner, CreateEl('span', 'visually-hidden', loadingPriceText));
            });
            utils.RenderBulkTable([]);
            var tierTable = document.getElementById('cnc-bulk-pricing-table');
            if (tierTable) { tierTable.setAttribute('aria-busy', 'true'); }
            if (!showSelectedPrice || !CncHasFinalQuote(item)) { return; }
            ApplyCncDecisionPriceSnapshot(item);
            var selectedAlloy = CncSelectedAlloy(item);
            if (item.cncDecisionPriceSnapshot
                && item.cncDecisionPriceSnapshot.materialPrices
                && item.cncDecisionPriceSnapshot.materialPrices[selectedAlloy]) { return; }
            var selectedPrice = document.querySelector('[data-cnc-material="' + selectedAlloy + '"] [data-cnc-quick-price]');
            if (!selectedPrice) { return; }
            selectedPrice.classList.remove('is-loading');
            selectedPrice.setAttribute('aria-busy', 'false');
            selectedPrice.removeAttribute('aria-label');
            selectedPrice.textContent = FormatMoney(item.cncQuote.estimatedPriceBeforeVat / Math.max(1, Number(item.quantity) || 1))
                + ' THB/' + cncUiText.perPiece;
        }

        function ApplyCncDecisionPriceSnapshot(item) {
            if (!CncHasFinalQuote(item)) { return false; }
            var snapshot = item && item.cncDecisionPriceSnapshot;
            if (!snapshot || !snapshot.materialPrices || !Array.isArray(snapshot.tiers)) { return false; }
            Object.keys(snapshot.materialPrices).forEach(function (alloy) {
                var priceHost = document.querySelector('[data-cnc-material="' + alloy + '"] [data-cnc-quick-price]');
                if (!priceHost) { return; }
                priceHost.classList.remove('is-loading');
                priceHost.setAttribute('aria-busy', 'false');
                priceHost.removeAttribute('aria-label');
                priceHost.textContent = snapshot.materialPrices[alloy];
            });
            var finishPrice = document.querySelector('[data-cnc-finish-price]');
            if (finishPrice) { finishPrice.textContent = snapshot.finishPriceText || ''; }
            var certificatePrice = document.querySelector('[data-cnc-certificate-price]');
            if (certificatePrice) {
                certificatePrice.hidden = snapshot.certificateHidden === true;
                certificatePrice.textContent = snapshot.certificatePriceText || '';
            }
            utils.RenderBulkTable(snapshot.tiers);
            var tierTable = document.getElementById('cnc-bulk-pricing-table');
            if (tierTable) { tierTable.setAttribute('aria-busy', snapshot.complete === true ? 'false' : 'true'); }
            RenderCncActiveMetrics(item);
            return true;
        }

        async function PriceCncMaterialCodes(item, alloys, decisionSnapshot, generation, includeShipping) {
            if (!CncHasFinalQuote(item) || !decisionSnapshot) { return; }
            var quantity = Math.max(1, Number(item.quantity) || 1);
            var cache = CncDecisionMaterialPriceCache(item, includeShipping);
            var selectedAlloy = CncSelectedAlloy(item);
            var isCurrentWork = function () { return generation === item.cncDecisionPriceGeneration; };
            var isCurrentSelection = function () {
                return isCurrentWork() && utils.GetItem(utils.GetActiveId()) === item;
            };
            function publish(alloy, text) {
                decisionSnapshot.materialPrices[alloy] = text;
                if (!isCurrentSelection()) { return; }
                var priceHost = document.querySelector('[data-cnc-material="' + alloy + '"] [data-cnc-quick-price]');
                if (!priceHost) { return; }
                priceHost.classList.remove('is-loading');
                priceHost.setAttribute('aria-busy', 'false');
                priceHost.removeAttribute('aria-label');
                priceHost.textContent = text;
            }
            await Promise.all(Array.from(new Set(alloys)).map(async function (alloy) {
                if (!alloy) { return; }
                if (alloy === selectedAlloy) {
                    var selectedText = FormatMoney(item.cncQuote.estimatedPriceBeforeVat / quantity)
                        + ' THB/' + cncUiText.perPiece;
                    cache.prices[alloy] = selectedText;
                    publish(alloy, selectedText);
                    return;
                }
                if (Object.prototype.hasOwnProperty.call(cache.prices, alloy)) {
                    publish(alloy, cache.prices[alloy]);
                    return;
                }
                if (!cache.pending[alloy]) {
                    cache.pending[alloy] = CalculateCncEstimateAsync(
                        item, alloy, quantity, includeShipping, undefined, undefined, undefined, item)
                        .then(function (estimate) {
                            var text = CncEstimateHasFinalQuote(estimate, item)
                                ? FormatMoney(estimate.quote.estimatedPriceBeforeVat / quantity) + ' THB/' + cncUiText.perPiece
                                : '—';
                            cache.prices[alloy] = text;
                            return text;
                        }).finally(function () { delete cache.pending[alloy]; });
                }
                try {
                    var text = await cache.pending[alloy];
                    if (isCurrentWork()) { publish(alloy, text); }
                } catch (error) {
                    if (isCurrentWork() && (!error || error.code !== 'cnc_quote_cancelled')) { publish(alloy, '—'); }
                }
            }));
        }

        async function RenderCncVisibleMaterialPrices(item) {
            if (!CncHasFinalQuote(item)) { return; }
            if (!item.cncDecisionPriceSnapshot) { await RenderCncDecisionPrices(item); }
            var snapshot = item.cncDecisionPriceSnapshot;
            if (!snapshot) { return; }
            await PriceCncMaterialCodes(item, CncVisibleMaterialCodes(), snapshot,
                item.cncDecisionPriceGeneration, CncDecisionPriceIncludesShipping(item));
        }

        async function RenderCncDecisionPrices(item) {
            if (!CncHasFinalQuote(item)) { return; }
            if (item.cncDecisionPriceSnapshot && item.cncDecisionPriceSnapshot.complete === true) {
                if (utils.GetItem(utils.GetActiveId()) === item) { ApplyCncDecisionPriceSnapshot(item); }
                return;
            }
            if (item.cncDecisionPricePromise) { return item.cncDecisionPricePromise; }

            var generation = (item.cncDecisionPriceGeneration || 0) + 1;
            item.cncDecisionPriceGeneration = generation;
            var decisionWork = (async function () {
                var isCurrentWork = function () {
                    return generation === item.cncDecisionPriceGeneration;
                };
                var isCurrentSelection = function () {
                    return isCurrentWork() && utils.GetItem(utils.GetActiveId()) === item;
                };
                if (!isCurrentWork()) { return; }
                if (isCurrentSelection()) { SyncCncDecisionPricesForSelection(item, true); }
                var includeShipping = CncDecisionPriceIncludesShipping(item);
                var materialCache = CncDecisionMaterialPriceCache(item, includeShipping);
                var decisionSnapshot = {
                    materialPrices: Object.assign({}, materialCache.prices),
                    finishPriceText: '',
                    certificateHidden: true,
                    certificatePriceText: '',
                    tiers: [],
                    complete: false
                };
                item.cncDecisionPriceSnapshot = decisionSnapshot;
                if (isCurrentSelection()) { ApplyCncDecisionPriceSnapshot(item); }

                var quantity = Math.max(1, Number(item.quantity) || 1);
                var commonMaterialWork = PriceCncMaterialCodes(item,
                    CncCommonMaterialCodes().concat([CncSelectedAlloy(item)]),
                    decisionSnapshot, generation, includeShipping);
                var selectedFinish = CncFinishForItem(item, CncSelectedAlloy(item), CncGeometryForItem(item));
                if (selectedFinish) {
                    var standardEstimate = await CalculateCncEstimateAsync(
                        item, CncSelectedAlloy(item), quantity, includeShipping, null, undefined, function () { }, item);
                    if (!isCurrentWork()) { return; }
                    decisionSnapshot.finishPriceText = CncEstimateHasFinalQuote(standardEstimate, item)
                        ? cncUiText.estimatedPriceChange + ' + ' + FormatMoney(Math.max(0,
                            item.cncQuote.estimatedPriceBeforeVat - standardEstimate.quote.estimatedPriceBeforeVat) / quantity)
                            + ' THB/' + cncUiText.perPiece
                        : '—';
                } else {
                    decisionSnapshot.finishPriceText = cncUiText.included;
                }
                if (isCurrentSelection()) {
                    var finishPrice = document.querySelector('[data-cnc-finish-price]');
                    if (finishPrice) { finishPrice.textContent = decisionSnapshot.finishPriceText; }
                }

                var certificateRequired = CncRequirementsForItem(item).certificate === 'required';
                decisionSnapshot.certificateHidden = !certificateRequired;
                if (certificateRequired) {
                    var certificateAlloy = CncSelectedAlloy(item);
                    var certificateFinish = CncFinishForItem(item, certificateAlloy, CncGeometryForItem(item));
                    var withoutCertificate = await CalculateCncEstimateAsync(
                        item, certificateAlloy, quantity, includeShipping, certificateFinish, false, function () { }, item);
                    if (!isCurrentWork()) { return; }
                    decisionSnapshot.certificatePriceText = CncEstimateHasFinalQuote(withoutCertificate, item)
                        ? cncUiText.estimatedPriceChange + ' + ' + FormatMoney(Math.max(0,
                            item.cncQuote.estimatedPriceBeforeVat - withoutCertificate.quote.estimatedPriceBeforeVat))
                            + ' THB/' + cncUiText.batch
                        : '—';
                }
                if (isCurrentSelection()) {
                    var certificatePrice = document.querySelector('[data-cnc-certificate-price]');
                    if (certificatePrice) {
                        certificatePrice.hidden = decisionSnapshot.certificateHidden;
                        certificatePrice.textContent = decisionSnapshot.certificatePriceText;
                    }
                }

                await commonMaterialWork;
                if (!isCurrentWork()) { return; }

                var tierQuantities = [1, 2, 5, 10, 25, 50, 100];
                var selectedQuantity = quantity;
                decisionSnapshot.tiers = await Promise.all(tierQuantities.map(async function (tierQuantity, tierIndex) {
                    var estimate = tierQuantity === selectedQuantity
                        ? { quote: item.cncQuote }
                        : await CalculateCncEstimateAsync(item, CncSelectedAlloy(item), tierQuantity, includeShipping,
                            undefined, undefined, undefined, item);
                    var nextQuantity = tierQuantities[tierIndex + 1];
                    return { minQuantity: tierQuantity,
                        unitPrice: CncEstimateHasFinalQuote(estimate, item) ? estimate.quote.estimatedPriceBeforeVat / tierQuantity : null,
                        active: selectedQuantity >= tierQuantity && (!nextQuantity || selectedQuantity < nextQuantity) };
                }));
                if (!isCurrentWork()) { return; }
                decisionSnapshot.complete = true;
                item.cncDecisionPriceSnapshot = decisionSnapshot;
                if (isCurrentSelection()) { ApplyCncDecisionPriceSnapshot(item); }
            })();

            item.cncDecisionPricePromise = decisionWork;
            try {
                await decisionWork;
            } finally {
                if (item.cncDecisionPricePromise === decisionWork) { item.cncDecisionPricePromise = null; }
            }
        }

        function CncMetricText(value) {
            return Number(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function CncEstimatedMassText(volumeMm3, densityKgPerMm3) {
            var massKg = Number(volumeMm3) * Number(densityKgPerMm3);
            if (!Number.isFinite(massKg) || massKg <= 0) { return ''; }
            if (massKg >= 1) {
                return '≈' + massKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg';
            }
            var massGrams = massKg * 1000;
            return '≈' + massGrams.toLocaleString('en-US', {
                minimumFractionDigits: massGrams < 10 ? 1 : 0,
                maximumFractionDigits: massGrams < 10 ? 1 : 0
            }) + ' g';
        }

        function CncStatusIsLoading(item) {
            return !!item && item.cncStatus !== 'finalized'
                && item.cncStatus !== 'review_required' && item.cncStatus !== 'failed';
        }

        function RenderCncActiveMetrics(item) {

            var stock = item && item.cncStock;
            var plan = item && item.cncPlan;
            var quote = item && item.cncQuote;
            var geometry = item ? CncGeometryForItem(item) : null;
            var stages = item && item.processingStages || {};
            var finalized = CncHasFinalQuote(item) && item.cncValidatedPlan;
            var values = {
                'stock-form': '—', 'stock-size': '—', 'stock-volume': '—',
                'part-volume': '—', 'removal-volume': '—', 'setup-count': '—', 'machining-time': '—'
            };
            var pending = {
                'stock-form': !!item && stages.stock !== 'ready',
                'stock-size': !!item && stages.stock !== 'ready',
                'stock-volume': !!item && stages.stock !== 'ready',
                'part-volume': !!item && stages.geometry !== 'ready',
                'removal-volume': !!item && stages.stock !== 'ready',
                'setup-count': !!item && stages.planning !== 'ready',
                'machining-time': !!item && stages.pricing !== 'ready'
            };
            if (!finalized) {
                var processing = CncStatusIsLoading(item);
                var nonfinalText = CncStatusIsLoading(item) ? 'Loading' : '—';
                Object.keys(values).forEach(function (metric) {
                    var element = document.querySelector('[data-cnc-metric="' + metric + '"]');
                    if (!element) { return; }
                    element.textContent = nonfinalText;
                    element.classList.toggle('iq-metric-skeleton', processing);
                    element.setAttribute('aria-busy', processing ? 'true' : 'false');
                });
                if (utils && typeof utils.RenderFileInfo === 'function') {
                    utils.RenderFileInfo(item && item.modelInfo);
                }
                return;
            }
            var quantity = item ? Math.max(1, Math.floor(Number(item.quantity) || 1)) : 1;
            var partVolumeMm3 = geometry && Number(geometry.partVolumeMm3) > 0
                ? Number(geometry.partVolumeMm3)
                : Number(item && item.modelInfo && item.modelInfo.volume) || 0;
            var material = item ? CncMaterialCatalog.get(CncSelectedAlloy(item)) : null;
            var density = material && material.densityKgPerMm3;
            var partMass = CncEstimatedMassText(partVolumeMm3, density);

            if (partVolumeMm3 > 0) {
                values['part-volume'] = CncMetricText((partVolumeMm3 * quantity) / 1000) + ' cm³';
                pending['part-volume'] = false;
            }
            if (stock) {
                var blankCount = Math.max(1, Math.floor(Number(stock.pieces) || 1));
                var batchStockVolumeMm3 = stock.stockVolumeMm3 * blankCount;
                var stockMass = CncEstimatedMassText(stock.stockVolumeMm3, density);
                values['stock-form'] = cncUiText.stockShapes[stock.stockShape] || stock.stockShape;
                values['stock-size'] = stock.stockShape === 'round'
                    ? 'Ø' + CncMetricText(stock.diameterMm) + ' × ' + CncMetricText(stock.lengthMm) + ' mm'
                    : CncMetricText(stock.stockSizeMm.x) + ' × ' + CncMetricText(stock.stockSizeMm.y) + ' × ' + CncMetricText(stock.stockSizeMm.z) + ' mm';
                if (stockMass) { values['stock-size'] += ' · ' + stockMass; }
                values['stock-volume'] = CncMetricText(batchStockVolumeMm3 / 1000) + ' cm³';
                var removalPercent = batchStockVolumeMm3 > 0 ? (stock.removalVolumeMm3 / batchStockVolumeMm3) * 100 : 0;
                values['removal-volume'] = CncMetricText(stock.removalVolumeMm3 / 1000) + ' cm³ (' + Math.round(removalPercent) + '%)';
            }
            if (plan) {
                values['setup-count'] = String(plan.setupCount || (plan.setups && plan.setups.length) || 1);
            }
            if (quote) {
                values['machining-time'] = Math.round(quote.estimatedMinutesPerPart) + ' ' + cncUiText.minutes;
            }
            if (item && item.modelInfo) {
                var partDimensions = item.modelInfo && item.modelInfo.size;
                var partDimensionsElement = document.getElementById('file-info-dimensions');
                if (partDimensionsElement && partDimensions) {
                    partDimensionsElement.textContent = CncMetricText(partDimensions.x) + ' × '
                        + CncMetricText(partDimensions.y) + ' × ' + CncMetricText(partDimensions.z)
                        + ' mm' + (partMass ? ' · ' + partMass : '');
                }
                if (utils && typeof utils.RenderFileInfo === 'function') { utils.RenderFileInfo(item.modelInfo); }
            }
            Object.keys(values).forEach(function (metric) {
                var element = document.querySelector('[data-cnc-metric="' + metric + '"]');
                if (element) {
                    element.textContent = pending[metric] ? 'Loading' : values[metric];
                    element.classList.toggle('iq-metric-skeleton', pending[metric]);
                    element.setAttribute('aria-busy', pending[metric] ? 'true' : 'false');
                }
            });
        }

        function SyncCncViewerPlanning(item) {
            var stockButton = document.getElementById('cnc-stock-overlay-toggle');
            var directionButton = document.getElementById('cnc-direction-overlay-toggle');
            var residualButton = document.getElementById('cnc-residual-overlay-toggle');
            var ready = !!(item && item.cncStock && item.cncPlan
                && Array.isArray(item.cncPlan.setups)
                && Array.isArray(item.cncPlan.reachMatrix)
                && item.cncPlan.residual);
            if (stockButton) { stockButton.disabled = !ready; }
            if (directionButton) { directionButton.disabled = !ready; }
            if (residualButton) { residualButton.disabled = !ready; }
            var geometry = ready ? CncGeometryForItem(item) : null;
            var reachableClusterIds = new Set(ready
                ? item.cncPlan.reachMatrix
                    .filter(function (reach) { return reach && reach.reachable === true; })
                    .map(function (reach) { return String(reach.clusterId); })
                : []);
            var surfaceResidualClusterIds = ready && Array.isArray(item.cncPlan.residual.clusterIds)
                ? item.cncPlan.residual.clusterIds.filter(function (clusterId) {
                    return !reachableClusterIds.has(String(clusterId));
                })
                : [];
            var residual = ready ? Object.assign({}, item.cncPlan.residual, {
                partId: String(utils.GetActiveId()),
                clusterIds: surfaceResidualClusterIds,
                surfaceClusters: geometry && Array.isArray(geometry.surfaceClusters) ? geometry.surfaceClusters : [],
                accessibilityField: geometry && geometry.accessibilityField || null,
                unmachinableSampleIds: Array.isArray(item.cncPlan.unmachinableSampleIds)
                    ? item.cncPlan.unmachinableSampleIds : [],
                axialFluteClusterIds: Array.isArray(item.cncPlan.axialFluteClusterIds)
                    ? item.cncPlan.axialFluteClusterIds : [],
                topologyDegraded: !!(geometry && geometry.analysisLimits && geometry.analysisLimits.topologyDegraded)
            }) : { partId: utils.GetActiveId() === null ? null : String(utils.GetActiveId()) };
            viewer.SetCncOverlayPlan(
                ready ? item.cncStock : null,
                ready ? item.cncPlan.setups : [],
                ready ? item.cncPlan.reachMatrix : [],
                residual);
            RenderCncSetupControls(ready ? item.cncPlan.setups : []);
            ApplyCncOverlayUiState(viewer.GetCncOverlayState());
        }

        function SetCncOverlayButtonState(button, pressed, showLabel, hideLabel) {
            if (!button) { return; }
            button.setAttribute('aria-pressed', pressed ? 'true' : 'false');
            var label = pressed ? hideLabel : showLabel;
            button.setAttribute('aria-label', label);
            button.title = label;
        }

        function RenderCncSetupControls(setups) {
            var controls = document.getElementById('cnc-setup-controls');
            if (!controls) { return; }
            controls.replaceChildren();
            (setups || []).forEach(function (setup, index) {
                var number = Number(setup.number) || index + 1;
                var setupId = setup.id || ('setup-' + number);
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'iq-cnc-setup-button';
                button.appendChild(CreateEl('span', 'iq-cnc-setup-button-label', 'Setup ' + number));
                button.dataset.cncSetupNumber = String(number);
                button.dataset.cncSetupId = setupId;
                button.setAttribute('aria-label', cncUiText.overlays.selectSetup + ' ' + number);
                button.setAttribute('aria-pressed', 'false');
                var selectSetup = function () { viewer.SelectCncSetup(setupId); };
                button.addEventListener('click', selectSetup);
                button.addEventListener('keydown', function (event) {
                    if (event.key !== 'Enter' && event.key !== ' ') { return; }
                    event.preventDefault();
                    event.stopPropagation();
                    selectSetup();
                });
                controls.appendChild(button);
            });
            controls.hidden = controls.childElementCount === 0;
        }

        function ApplyCncOverlayUiState(state) {

            var setupUnavailableText = state.topologyDegraded === true
                ? cncUiText.overlays.topologyDegraded
                : (state.overlayUnavailableReason && state.overlayUnavailableReason.indexOf('performance-budget-') === 0
                    ? cncUiText.overlays.performanceBudgetTitle + '. ' + cncUiText.overlays.performanceBudgetDetail
                    : cncUiText.overlays.setupUnavailable);
            SetCncOverlayButtonState(
                document.getElementById('cnc-stock-overlay-toggle'),
                state.stockVisible === true,
                cncUiText.overlays.showStock,
                cncUiText.overlays.hideStock);
            SetCncOverlayButtonState(
                document.getElementById('cnc-direction-overlay-toggle'),
                state.directionsVisible === true,
                cncUiText.overlays.showDirections,
                cncUiText.overlays.hideDirections);
            var residualButton = document.getElementById('cnc-residual-overlay-toggle');
            SetCncOverlayButtonState(
                residualButton,
                state.residualVisible === true,
                cncUiText.overlays.showResidual,
                cncUiText.overlays.hideResidual);
            document.querySelectorAll('#cnc-setup-controls [data-cnc-setup-id]').forEach(function (button) {
                var selectedIds = Array.isArray(state.selectedSetupIds) ? state.selectedSetupIds : [];
                button.setAttribute('aria-pressed', selectedIds.indexOf(button.dataset.cncSetupId) >= 0 ? 'true' : 'false');
                button.disabled = state.setupSelectionAvailable !== true;
                button.setAttribute('aria-disabled', button.disabled ? 'true' : 'false');
                if (button.disabled) {
                    button.setAttribute('aria-describedby', 'cnc-overlay-warning');
                    button.title = setupUnavailableText;
                } else {
                    button.removeAttribute('aria-describedby');
                    button.removeAttribute('title');
                }
            });
            if (residualButton) {
                residualButton.disabled = state.residualToggleAvailable !== true;
                if (residualButton.disabled) { residualButton.setAttribute('aria-describedby', 'cnc-overlay-warning'); }
                else { residualButton.removeAttribute('aria-describedby'); }
            }
            var setupControls = document.getElementById('cnc-setup-controls');
            if (setupControls) {
                setupControls.hidden = state.setupSelectionAvailable !== true
                    || setupControls.childElementCount === 0;
            }
            var legend = document.getElementById('cnc-overlay-legend');
            var status = document.getElementById('cnc-overlay-status');
            var warning = document.getElementById('cnc-overlay-warning');
            if (legend) { legend.hidden = !state.partId; }
            if (warning) {
                warning.replaceChildren();
                var warningTitle = '';
                var warningDetail = '';
                if (state.topologyDegraded === true) {
                    warningTitle = cncUiText.overlays.topologyDegraded;
                } else if (state.overlayUnavailableReason && state.overlayUnavailableReason.indexOf('performance-budget-') === 0) {
                    warningTitle = cncUiText.overlays.performanceBudgetTitle;
                    warningDetail = cncUiText.overlays.performanceBudgetDetail;
                }
                warning.hidden = !warningTitle;
                if (warningTitle) {
                    var warningIcon = CreateEl('i', 'fas fa-exclamation-triangle');
                    warningIcon.setAttribute('aria-hidden', 'true');
                    warning.appendChild(warningIcon);
                    var warningCopy = CreateEl('span', 'iq-cnc-overlay-status-copy');
                    warningCopy.appendChild(CreateEl('span', 'iq-cnc-overlay-status-title', warningTitle));
                    if (warningDetail) {
                        warningCopy.appendChild(CreateEl('span', 'iq-cnc-overlay-status-detail', warningDetail));
                    }
                    warning.appendChild(warningCopy);
                }
            }
            if (status) {
                status.classList.remove('iq-cnc-overlay-status--warning');
                status.replaceChildren();
                if (state.setupSelectionAvailable === true && state.selectedSetupNumber > 0) {
                    status.textContent = (state.selectedSetupName || (cncUiText.overlays.selectedSetup + ' ' + state.selectedSetupNumber))
                        + ' · ' + state.highlightedClusterCount + ' ' + cncUiText.overlays.reachableClusters;
                } else {
                    status.textContent = '';
                }
            }
        }

        function ToggleCncStockOverlay(button) {
            var visible = viewer.ToggleCncStockOverlay();
            SetCncOverlayButtonState(button, visible, cncUiText.overlays.showStock, cncUiText.overlays.hideStock);
        }

        function ToggleCncDirectionOverlay(button) {
            var visible = viewer.ToggleCncDirectionOverlay();
            SetCncOverlayButtonState(button, visible, cncUiText.overlays.showDirections, cncUiText.overlays.hideDirections);
        }

        function ToggleCncResidualOverlay(button) {
            var visible = viewer.ToggleCncResidualOverlay();
            SetCncOverlayButtonState(button, visible, cncUiText.overlays.showResidual, cncUiText.overlays.hideResidual);
        }

        function CncCustomerShippingThb(actualGrams, boundingCm3) {
            var actualKg = (Math.max(0, Number(actualGrams) || 0) + cncShippingPricing.boxTareGrams) / 1000;
            var volumetricKg = Math.max(0, Number(boundingCm3) || 0) / cncShippingPricing.volumetricDivisor;
            var chargeableKg = Math.max(actualKg, volumetricKg);
            var carrierRate = null;
            for (var index = 0; index < cncShippingPricing.weightBoundsKg.length; index += 1) {
                if (chargeableKg <= cncShippingPricing.weightBoundsKg[index]) {
                    carrierRate = cncShippingPricing.carrierRatesThb[index];
                    break;
                }
            }
            if (carrierRate === null) {
                var lastIndex = cncShippingPricing.weightBoundsKg.length - 1;
                carrierRate = cncShippingPricing.carrierRatesThb[lastIndex]
                    + (Math.ceil(chargeableKg - cncShippingPricing.weightBoundsKg[lastIndex]) * 13);
            }
            var price = (carrierRate * cncShippingPricing.carrierMarkup) + cncShippingPricing.packagingMaterialThb;
            return Math.max(cncShippingPricing.minimumShippingThb, Math.ceil(price / 10) * 10);
        }

        function CncCustomerShippingForPricedItems(ids) {
            var actualGrams = 0;
            var boundingCm3 = 0;
            var pricedCount = 0;
            (ids || []).forEach(function (id) {
                var item = utils.GetItem(id);
                var geometry = item && item.cncQuote ? CncGeometryForItem(item) : null;
                var material = item ? CncMaterialCatalog.get(CncSelectedAlloy(item)) : null;
                if (!geometry || !material) { return; }
                var quantity = Math.max(1, Math.floor(Number(item.quantity) || 1));
                var dimensions = geometry.orientedSizeMm || (item.modelInfo && item.modelInfo.size);
                actualGrams += Math.max(0, Number(geometry.partVolumeMm3) || 0)
                    * Math.max(0, Number(material.densityKgPerMm3) || 0) * 1000 * quantity;
                if (dimensions) {
                    boundingCm3 += Math.max(0, Number(dimensions.x) || 0)
                        * Math.max(0, Number(dimensions.y) || 0)
                        * Math.max(0, Number(dimensions.z) || 0) / 1000 * quantity;
                }
                pricedCount += 1;
            });
            return pricedCount > 0 ? CncCustomerShippingThb(actualGrams, boundingCm3) : 0;
        }

        var cncItemPricingGenerations = {};

        function RenderCurrentCncQuotation() {
            var ids = utils.GetAllItemIds();
            var quotes = [];
            var failures = [];
            var pendingCount = 0;
            ids.forEach(function (id) {
                var item = utils.GetItem(id);
                if (!item) { return; }
                if (item.cncStatus === 'finalized' && item.cncQuote) { quotes.push(item.cncQuote); }
                if ((item.cncStatus === 'review_required' || item.cncStatus === 'failed') && item.cncQuoteError) {
                    failures.push(item.cncQuoteError);
                }
                if (!item.errorMessage && item.cncStatus !== 'finalized'
                    && item.cncStatus !== 'review_required' && item.cncStatus !== 'failed') { pendingCount += 1; }
            });
            var allFinalized = CncAllItemsFinalizedForPrice();
            var beforeVat = allFinalized
                ? quotes.reduce(function (total, quote) { return total + quote.estimatedPriceBeforeVat; }, 0) : 0;
            var customerShipping = allFinalized ? CncCustomerShippingForPricedItems(ids) : 0;
            var vat = Math.ceil(((beforeVat + customerShipping) * 0.07) / 10) * 10;
            latestCncOrderTotal = { itemsSubtotal: beforeVat, vat: vat, finalOrderPrice: beforeVat + customerShipping + vat, shipping: customerShipping };
            latestOrderTotal = { itemsSubtotal: beforeVat, minimumOrderPrice: 0, minimumOrderSurcharge: 0, shipping: customerShipping, vat: vat, finalOrderPrice: beforeVat + customerShipping + vat };
            utils.SetGrandTotal(allFinalized ? latestOrderTotal.finalOrderPrice : null);
            RenderCncQuotationResult(allFinalized ? quotes : [], failures, pendingCount, ids.length);
            return { quotes: allFinalized ? quotes : [], failures: failures, pendingCount: pendingCount };
        }

        async function CncRepriceAll(onComplete, change, targetIds) {
            var allIds = utils.GetAllItemIds();
            var requestedIds = Array.isArray(targetIds)
                ? targetIds.filter(function (id) { return id !== null && id !== undefined && !!utils.GetItem(id); })
                : [];
            // A rejected upload deliberately leaves no active selection while retaining the
            // dimensional-fallback item. Treat that state as an all-items reprice so completing
            // X/Y/Z can still produce its low-confidence quotation.
            var itemOnly = requestedIds.length > 0;
            var ids = (itemOnly ? requestedIds : allIds.slice()).filter(function (id) {
                return CncGeometryReadyForPricing(utils.GetItem(id));
            });
            var shippingOwnerId = allIds.length ? allIds[0] : null;
            ids.forEach(function (id) {
                var item = utils.GetItem(id);
                var geometry = CncGeometryForItem(item);
                if (geometry) {
                    CancelCncDecisionPriceWork(item);
                    cncItemPricingGenerations[id] = (cncItemPricingGenerations[id] || 0) + 1;
                    BeginCncRevision(item, {
                        itemId: String(id),
                        geometryRevision: geometry.geometryRevision || null,
                        material: CncSelectedAlloy(item),
                        quantity: Math.max(1, Math.floor(Number(item.quantity) || 1)),
                        requirements: CncRequirementInput(item),
                        finish: item.cncFinish || null,
                        includeShipping: String(id) === String(shippingOwnerId)
                    });
                    utils.SetItemProcessingStage(id, 'stock', 'processing');
                    utils.SetItemProcessingStage(id, 'planning', 'processing');
                    utils.SetItemProcessingStage(id, 'pricing', 'processing');
                    utils.SetItemPricingPending(id, true);
                }
            });
            var activePricingId = utils.GetActiveId();
            var activePricingItem = utils.GetItem(activePricingId);
            if (activePricingItem && ids.some(function (id) { return String(id) === String(activePricingId); })) {
                SyncCncDecisionPricesForSelection(activePricingItem, false);
                RenderCncActiveMetrics(activePricingItem);
            }
            RenderCurrentCncQuotation();
            RefreshVisibleOrderSummary({ type: 'pricing-started', itemId: activePricingId });
            var priceItem = async function (id) {
                var item = utils.GetItem(id);
                if (!item) { return; }
                var geometry = CncGeometryForItem(item);
                if (!geometry) { item.cncQuote = null; item.cncStock = null; item.cncPlan = null; return; }
                var generation = cncItemPricingGenerations[id];
                var analysisRevision = item.analysisRevision;
                try {
                    var quantity = Math.max(1, Math.floor(Number(item.quantity) || 1));
                    var estimate = await CalculateCncEstimateAsync(
                        item,
                        CncSelectedAlloy(item),
                        quantity,
                        String(id) === String(shippingOwnerId),
                        undefined,
                        undefined,
                        function (progress) {
                            if (generation !== cncItemPricingGenerations[id] || utils.GetItem(id) !== item
                                || progress.analysisRevision !== item.analysisRevision) { return; }
                            item.cncProgressStage = progress.stage || item.cncProgressStage;
                            if (utils.GetActiveId() === id) {
                                RenderCncActiveMetrics(item);
                            }
                            RenderCurrentCncQuotation();
                        });
                    if (generation !== cncItemPricingGenerations[id] || utils.GetItem(id) !== item
                        || !CommitCncResult(item, { analysisRevision: estimate && estimate.analysisRevision, estimate: estimate })) { return; }
                    var finalized = item.cncStatus === 'finalized';
                    utils.SetItemProcessingStage(id, 'stock', finalized ? 'ready' : 'failed');
                    utils.SetItemProcessingStage(id, 'planning', finalized ? 'ready' : 'failed');
                    utils.SetItemProcessingStage(id, 'pricing', finalized ? 'ready' : 'failed');
                    if (utils.GetActiveId() === id) {
                        RenderCncActiveMetrics(item);
                        SyncCncItemControls(item);
                    }
                    if (!finalized) {
                        item.process = 'CncMilling';
                        item.material = CncSelectedAlloy(item);
                        item.quantity = quantity;
                        utils.SaveItemSettings(id);
                        return;
                    }
                    item.subtotalThb = item.cncQuote.estimatedPriceBeforeVat;
                    item.process = 'CncMilling';
                    item.material = CncSelectedAlloy(item);
                    item.quantity = quantity;
                    var unitCost = item.cncQuote.estimatedPriceBeforeVat / quantity;
                    var unitCostInput = document.getElementById('item-estimated-unit-cost-' + id);
                    var totalCostInput = document.getElementById('item-estimated-total-cost-' + id);
                    var unitTimeInput = document.getElementById('item-estimated-unit-time-' + id);
                    var totalTimeInput = document.getElementById('item-estimated-total-time-' + id);
                    if (unitCostInput) { unitCostInput.value = FormatMoney(unitCost) + ' ' + displayCurrencyLabel; }
                    if (totalCostInput) { totalCostInput.value = FormatMoney(item.cncQuote.estimatedPriceBeforeVat) + ' ' + displayCurrencyLabel; }
                    if (unitTimeInput) { unitTimeInput.value = Math.round(item.cncQuote.estimatedMinutesPerPart) + ' ' + cncUiText.minutes; }
                    if (totalTimeInput) { totalTimeInput.value = Math.round(item.cncQuote.estimatedMinutesPerPart * quantity) + ' ' + cncUiText.minutes; }
                    utils.SaveItemSettings(id);
                    item.cncQuoteError = null;
                } catch (error) {
                    if (generation !== cncItemPricingGenerations[id] || utils.GetItem(id) !== item
                        || analysisRevision !== item.analysisRevision) { return; }
                    item.cncQuote = null;
                    item.cncStock = null;
                    item.cncPlan = null;
                    item.cncQuoteError = error && error.code || 'cnc_quote_unpriceable';
                    item.cncReviewReasons = [item.cncQuoteError];
                    item.cncStatus = 'failed';
                    item.cncProgressStage = 'failed';
                    utils.SetItemProcessingStage(id, 'stock', item.cncStock ? 'ready' : 'failed');
                    utils.SetItemProcessingStage(id, 'planning', item.cncPlan ? 'ready' : 'failed');
                    utils.SetItemProcessingStage(id, 'pricing', 'failed');
                } finally {
                    if (generation === cncItemPricingGenerations[id] && utils.GetItem(id) === item) {
                        utils.SetItemPricingPending(id, false);
                        RenderCurrentCncQuotation();
                    }
                }
            };
            await Promise.all(ids.map(priceItem));
            if (!itemOnly && shippingOwnerId !== null) {
                var shippingOwner = utils.GetItem(shippingOwnerId);
                if (!shippingOwner || !shippingOwner.cncQuote) {
                    var fallbackShippingOwnerId = ids.find(function (id) {
                        var candidate = utils.GetItem(id);
                        return candidate && candidate.cncQuote;
                    });
                    if (fallbackShippingOwnerId !== undefined) {
                        shippingOwnerId = fallbackShippingOwnerId;
                        cncItemPricingGenerations[fallbackShippingOwnerId]
                            = (cncItemPricingGenerations[fallbackShippingOwnerId] || 0) + 1;
                        await priceItem(fallbackShippingOwnerId);
                    }
                }
            }
            var current = RenderCurrentCncQuotation();
            if (isDevelopment) { window.__lastCncQuote = current.quotes.length ? current.quotes[current.quotes.length - 1] : undefined; }
            var activeItem = utils.GetItem(utils.GetActiveId());
            SyncCncMachineCapabilityBadge(activeItem);
            RenderCncActiveMetrics(activeItem);
            SyncCncViewerPlanning(activeItem);
            // Decision-support comparisons belong to each part and fill independently after
            // its primary quote. They are never owned by the current viewer selection.
            ids.forEach(function (id) {
                var pricedItem = utils.GetItem(id);
                if (pricedItem && pricedItem.cncQuote) {
                    Promise.resolve(RenderCncDecisionPrices(pricedItem)).catch(function () { });
                }
            });
            NotifyQuotationStateChanged(change || { type: current.failures.length ? 'price-failed' : 'price-changed' });
            if (typeof onComplete === 'function') { onComplete(current.quotes.length > 0); }
            return current.quotes.length > 0;
        }

        function SyncCncSubmissionSafety() {

            var gate = document.getElementById('submit-gate');
            var ready = CncSubmissionReady();
            if (gate) {
                var reviewReady = CncReviewReady();
                gate.disabled = !reviewReady;
                gate.setAttribute('aria-disabled', reviewReady ? 'false' : 'true');
                gate.textContent = iqReviewText.reviewItemsShort;
                gate.setAttribute('aria-label', iqReviewText.reviewAllItems);
                gate.removeAttribute('title');
            }
            ['development-customer-preview', 'continue-to-customer-details', 'submit-final-review-button'].forEach(function (buttonId) {
                var button = document.getElementById(buttonId);
                if (!button) { return; }
                button.disabled = !ready || (buttonId === 'submit-final-review-button' && isLocalPreview);
                button.setAttribute('aria-disabled', button.disabled ? 'true' : 'false');
            });
            SyncPreliminaryQuotationButton();
        }

        function CncRequirementSubmission(item) {
            var requirements = CncRequirementsForItem(item);
            var threadValue = requirements.threadMode;
            if (requirements.threadMode === 'note') {
                threadValue = requirements.threadNote ? 'note: ' + requirements.threadNote : '';
            }

            return {
                valid: requirements.threadMode !== 'note' || !!threadValue,
                tolerance: requirements.tolerance,
                threads: threadValue,
                roughness: requirements.roughness,
                inspection: requirements.inspection,
                certificate: requirements.certificate,
                note: requirements.note
            };
        }

        function CncDrawingRequired(requirements) {
            return requirements.threads === 'drawing' || requirements.tolerance !== 'ISO 2768-m';
        }

        function CncDrawingAvailable(item) {
            return !!(item && item.cncDrawing && ((item.cncDrawing.status === 'ready' && item.cncDrawing.uploadComplete)
                || (isLocalPreview && item.cncDrawing.status === 'local' && item.cncDrawing.availableForLocalReview)));
        }

        function SetCncSubmissionHidden(id, field, value) {
            var host = document.getElementById('order-summary-item-' + id);
            if (!host) { return false; }
            var inputId = 'item-cnc-' + field.toLowerCase() + '-' + id;
            var input = document.getElementById(inputId);
            if (!input) {
                input = document.createElement('input');
                input.type = 'hidden';
                input.id = inputId;
                input.name = 'OrderItems[' + id + '].' + field;
                host.appendChild(input);
            }
            input.value = value;
            return true;
        }

        function SyncCncSubmissionFields() {

            var ids = utils.GetAllItemIds();
            if (!ids.length) { return false; }
            return ids.every(function (id) {
                var item = utils.GetItem(id);
                var requirements = CncRequirementSubmission(item);
                if (!item || !item.uploadComplete || !item.cncModelUploadReceipt || !item.cncQuote || item.cncQuote.estimateStatus !== 'Preliminary'
                    || !requirements.valid || (CncDrawingRequired(requirements) && !CncDrawingAvailable(item))) { return false; }
                return SetCncSubmissionHidden(id, 'Process', 'CncMilling')
                    && SetCncSubmissionHidden(id, 'CncEstimateJson', JSON.stringify(item.cncQuote))
                    && SetCncSubmissionHidden(id, 'CncTolerance', requirements.tolerance)
                    && SetCncSubmissionHidden(id, 'CncThreads', requirements.threads)
                    && SetCncSubmissionHidden(id, 'CncRoughness', requirements.roughness)
                    && SetCncSubmissionHidden(id, 'CncInspection', requirements.inspection)
                    && SetCncSubmissionHidden(id, 'CncCertificate', requirements.certificate)
                    && SetCncSubmissionHidden(id, 'CncRequirementsNote', requirements.note);
            });
        }

        function RenderCncQuotationResult(quotes, failures, pendingCount, totalCount) {
            var host = document.getElementById('cnc-quotation-result');
            if (!host) { return; }
            host.replaceChildren();
            failures = failures || [];
            pendingCount = Math.max(0, Number(pendingCount) || 0);
            totalCount = Math.max(0, Number(totalCount) || 0);
            if (!totalCount && !quotes.length && !failures.length) {
                latestCncBatchProgress = { totalCount: 0, readyCount: 0 };
                host.hidden = true;
                return;
            }
            if (!quotes.length && !pendingCount) {
                host.hidden = false;
                var guidance = CreateEl('p', 'iq-alert warn', cncUiText.reviewNoAutomaticPrice);
                guidance.setAttribute('data-cnc-price-guidance', '');
                host.appendChild(guidance);
                SyncCncSubmissionSafety();
                return;
            }
            host.hidden = false;
            var card = CreateEl('section', 'iq-review-card iq-pricing-summary');
            card.appendChild(CreateEl('h2', 'iq-pricing-summary-title', iqReviewText.cncEstimateTitle));
            var readyCount = Math.max(0, totalCount - pendingCount);
            var pendingStatus = '@culture' === 'th'
                ? 'กำลังคำนวณราคา ' + readyCount + ' จาก ' + totalCount + ' ชิ้น'
                : 'Calculating prices · ' + readyCount + ' of ' + totalCount + ' parts ready';
            var status = CreateEl('p', 'iq-pricing-summary-status' + (pendingCount ? ' is-loading' : ''), pendingCount ? '' : iqReviewText.cncEstimateStatus);
            status.setAttribute('data-cnc-estimate-status', '');
            status.setAttribute('aria-live', 'polite');
            if (pendingCount) {
                var statusSpinner = CreateEl('span', 'spinner-border spinner-border-sm');
                statusSpinner.setAttribute('aria-hidden', 'true');
                status.appendChild(statusSpinner);
                status.appendChild(CreateEl('span', '', pendingStatus));
            }
            card.appendChild(status);
            if (pendingCount && totalCount > 1) {
                var currentProgressRatio = Math.min(1, readyCount / totalCount);
                var previousProgressRatio = latestCncBatchProgress.totalCount === totalCount
                    && readyCount >= latestCncBatchProgress.readyCount
                    ? latestCncBatchProgress.readyCount / totalCount : 0;
                var batchProgress = CreateEl('div', 'iq-batch-progress');
                batchProgress.setAttribute('data-cnc-batch-progress', '');
                batchProgress.setAttribute('role', 'progressbar');
                batchProgress.setAttribute('aria-label', iqCulture === 'th'
                    ? 'ความคืบหน้าการคำนวณราคาชุดงาน' : 'Batch pricing progress');
                batchProgress.setAttribute('aria-valuemin', '0');
                batchProgress.setAttribute('aria-valuenow', String(readyCount));
                batchProgress.setAttribute('aria-valuemax', String(totalCount));
                batchProgress.setAttribute('aria-valuetext', pendingStatus);
                var batchProgressFill = CreateEl('span', 'iq-batch-progress-fill');
                batchProgressFill.setAttribute('aria-hidden', 'true');
                batchProgressFill.style.transform = 'scaleX(' + previousProgressRatio + ')';
                batchProgress.appendChild(batchProgressFill);
                card.appendChild(batchProgress);
                requestAnimationFrame(function () {
                    batchProgressFill.style.transform = 'scaleX(' + currentProgressRatio + ')';
                });
                latestCncBatchProgress = { totalCount: totalCount, readyCount: readyCount };
            }
            else if (!pendingCount) {
                latestCncBatchProgress = { totalCount: 0, readyCount: 0 };
            }
            [['@Localizer["Before VAT"]', latestCncOrderTotal.itemsSubtotal], [iqReviewText.shipping, latestCncOrderTotal.shipping], ['@Localizer["VAT"]', latestCncOrderTotal.vat], ['@Localizer["After VAT total"]', latestCncOrderTotal.finalOrderPrice]].forEach(function (row) {
                var valueReady = pendingCount === 0;
                var line = CreateEl('div', 'iq-pricing-row' + (row[0] === '@Localizer["After VAT total"]' ? ' iq-total' : ''));
                line.appendChild(CreateEl('span', '', row[0]));
                var value = CreateEl('strong', valueReady ? '' : 'iq-price-placeholder', valueReady ? FormatMoney(row[1]) + ' THB' : 'Loading');
                if (!valueReady) { value.setAttribute('aria-label', '@Localizer["Calculating"]'); }
                line.appendChild(value);
                card.appendChild(line);
            });
            if (failures.length) {
                var guidance = CreateEl('p', 'iq-alert warn', cncUiText.reviewNoAutomaticPrice);
                guidance.setAttribute('data-cnc-price-guidance', '');
                card.appendChild(guidance);
            }
            host.appendChild(card);
            host.setAttribute('aria-busy', pendingCount ? 'true' : 'false');
            SyncCncSubmissionSafety();
        }

        function SelectCncMaterial(alloy) {
            if (!CncMaterialCatalog.get(alloy)) { return; }
            var item = utils.GetItem(utils.GetActiveId());
            if (!item) { return; }
            item.cncAlloy = alloy;
            if (item.cncFinish && !CncMaterialSupportsFinish(alloy, item.cncFinish.code)) { item.cncFinish = null; }
            SyncCncMaterialControls(item);
            var activeId = utils.GetActiveId();
            CncRepriceAll(null, { type: 'material-changed', itemId: activeId }, [activeId]);
        }

        function OnCncRequirementsChange() { { var activeId = utils.GetActiveId(); CaptureActiveCncRequirements(); CncRepriceAll(null, { type: 'requirements-changed', itemId: activeId }, [activeId]); SyncCncItemControls(utils.GetItem(activeId)); SyncCncSubmissionSafety(); } }

        function RefreshMaterialPrices(id, options) {
            var item = utils.GetItem(id);
            if (!item || !item.modelInfo) { return Promise.resolve(false); }
            return CncRepriceAll(options && options.onComplete, options && options.change, [id]);
        }

        function GetCncEstimate(id, options) {
            var item = utils.GetItem(id);
            if (!item) {
                if (options && options.onComplete) { options.onComplete(false); }
                return Promise.resolve(false);
            }

            return CncRepriceAll(
                options && options.onComplete,
                options && options.change,
                options && options.itemOnly ? [id] : undefined);
        }

        function RefreshOrderTotal(onComplete) {
            var complete = typeof onComplete === 'function' ? onComplete : function () { };
            return CncRepriceAll(complete);
        }

        // Formats a number with thousands separators and exactly two decimals (e.g. 64123 -> "64,123.00").
        function FormatMoney(value) {
            var number = Number(value);
            if (isNaN(number)) { number = 0; }
            return number.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function RemoveOrderItem(id) {
            var removedItem = utils.GetItem(id);
            var removedFileName = removedItem && removedItem.file ? removedItem.file.name : '';
            delete estimateRequestTokens[id];
            delete materialPriceRequestTokens[id];
            delete pricingRequestTokens[id];
            delete reviewCalculationVersions[id];
            if (quantityTimeouts[id]) {
                clearTimeout(quantityTimeouts[id]);
                delete quantityTimeouts[id];
            }
            UpdatePricingLoadingState();
            var removedQueuedProcessing = CancelPartProcessing(id);
            var cancelledActiveParse = !!parseHandles[id];
            if (cancelledActiveParse) {
                parseHandles[id].cancel();
                delete parseHandles[id];
            }
            if (removedQueuedProcessing || cancelledActiveParse) { utils.DecreasePendingTask(); }
            { viewer.ForgetCncOverlayState(id); }
            utils.RemoveItem(id);
            { NotifyQuotationStateChanged({ type: 'item-removed', itemId: id, fileName: removedFileName }); }
            { RenderCurrentCncQuotation(); }
            utils.UpdateEstimatedTime();
            UpdateEmptyHint();

            var newActiveId = utils.GetActiveId();
            if (newActiveId) {
                {
                    var newActiveItem = utils.GetItem(newActiveId);
                    SyncCncItemControls(newActiveItem);
                    SyncCncMachineCapabilityBadge(newActiveItem);
                    RenderCncActiveMetrics(newActiveItem);
                    SyncCncViewerPlanning(newActiveItem);
                }
                GetCncEstimate(newActiveId);
            }
            RefreshOrderTotal();

            if (utils.GetAllItemIds().length === 0) {
                var gate = document.getElementById('submit-gate');
                gate.disabled = true;
                gate.textContent = iqReviewText.startUpload;
                gate.removeAttribute('aria-label');
                gate.removeAttribute('title');
                utils.SetGrandTotal(null);
                document.getElementById('total-estimated-time').textContent = '—';
                RenderAllPricingSummaries();
            }
        }

        // Drag-and-drop support across the whole component (not just the small dropzone
        // tile), so dropping a file anywhere on the viewer or config pane works. The
        // highlight target (big empty-state pane vs. small persistent tile) is resolved
        // purely in CSS via the .iq-wrap.iq-drag-over selector.
        (function () {
            var zone = document.getElementById('instant-quotation-component');
            if (!zone) { return; }
            ['dragenter', 'dragover'].forEach(function (evt) {
                zone.addEventListener(evt, function (e) { e.preventDefault(); zone.classList.add('iq-drag-over'); });
            });
            ['dragleave', 'drop'].forEach(function (evt) {
                zone.addEventListener(evt, function (e) { e.preventDefault(); zone.classList.remove('iq-drag-over'); });
            });
            zone.addEventListener('drop', function (e) {
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
                    AddModel(e.dataTransfer.files);
                }
            });
            { RenderCncMaterialCatalog(); }
        })();
    </script>
}
