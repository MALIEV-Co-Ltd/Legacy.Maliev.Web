                    + '</span><strong>' + Html(PreliminaryQuotationMoney(snapshot.orderTotal.minimumOrderSurcharge)) + '</strong></div>'
                : '';

            var printStyles = [
                '@@page { size: A4; margin: 12mm 12mm 16mm; }',
