        // Mouse wheels emit deltaY only, so a container that scrolls horizontally is
        // unreachable with one unless deltaY is translated into scrollLeft. The decision
        // has to be made per event rather than baked in per element: the material list is
        // a vertical grid inside the settings card but a horizontal strip on narrow
        // viewports, and the media queries at the top of this page switch several of these
        // containers to overflow: visible. Measuring at event time keeps both layouts right.
        function EnableWheelScrollAffordance(element) {
            if (!element) { return; }
            element.addEventListener('wheel', function (event) {
                // Vertical room means the browser's own handling is correct. Swallowing the
                // event here is what left the material list unscrollable by wheel.
                if (element.scrollHeight > element.clientHeight) { return; }
                if (element.scrollWidth <= element.clientWidth) { return; }

                var delta = event.deltaY || event.deltaX;
                if (!delta) { return; }
                // deltaMode 1 is lines and 2 is pages; neither is a pixel count.
                if (event.deltaMode === 1) { delta *= 16; }
                else if (event.deltaMode === 2) { delta *= element.clientWidth; }

                var maxScroll = element.scrollWidth - element.clientWidth;
                var target = Math.max(0, Math.min(maxScroll, element.scrollLeft + delta));
                // At either end, leave the event alone so the gesture is not simply dead.
                if (target === element.scrollLeft) { return; }

                element.scrollLeft = target;
                event.preventDefault();
            }, { passive: false });
        }

        function EnableMaterialWheelScroll() {
            EnableWheelScrollAffordance(document.getElementById('material-cards'));
            EnableWheelScrollAffordance(document.getElementById('parts-strip'));
        }

        function IsAllowedRouteModelFile(fileName) {

            return ['step', 'stp', 'iges', 'igs'].indexOf(FileType(fileName)) !== -1;
        }

        function AddModel(files) {
            for (var i = 0; i < files.length; i++) {
                var file = files[i];
                if (!IsAllowedRouteModelFile(file.name)) {
                    alert('@culture' == 'th'
                        ? 'งาน CNC รองรับเฉพาะไฟล์ STEP, STP, IGES และ IGS โดยแนะนำ STEP'
                        : 'CNC models must be STEP, STP, IGES, or IGS files. STEP is preferred.');
                    continue;
                }
                if (file.size > maxUploadBytes) {
                    alert('@culture' == 'th'
                        ? 'ไฟล์มีขนาดใหญ่เกินไป ขนาดสูงสุดคือ ' + @maxUploadMb + ' MB'
                        : 'This file is too large. The maximum size is ' + @maxUploadMb + ' MB.');
                    continue;
                }

                TrackQuoteStarted();

                (function (uploadedFile) {
                    var id = nextItemId++;
                    utils.IncreasePendingTask();
                    utils.RegisterItem(id, uploadedFile);
                    {
                        var cncItem = utils.GetItem(id);
                        if (cncItem) {
                            cncItem.id = id;
                            cncItem.cncAlloy = '6061';
                            cncItem.material = '6061';
                            cncItem.cncRequirements = DefaultCncRequirements();
                            cncItem.cncStatus = 'idle';
                            cncItem.cncProgressStage = 'decoding';
                            cncItem.cncValidatedPlan = null;
                            cncItem.cncQuote = null;
                            cncItem.cncReviewReasons = [];
                        }
                        SyncCncItemControls(cncItem);
                    }
                    UpdateEmptyHint();
                    {
                        NotifyQuotationStateChanged({ type: 'item-registered', itemId: id });
                        RenderCurrentCncQuotation();
                    }

                    var parseOptions = {
                        analysisProfile: 'cnc',
                        onPreviewReady: function (modelInfo, object3D) {
                            if (!utils.GetItem(id)) { return Promise.resolve(); }
                            utils.SetItemPreview(id, object3D, modelInfo);
                            // Completion order is not customer intent. Only claim the shared
                            // canvas when no part has been selected yet, or refresh this part if
                            // it is already active. A background upload must never steal focus.
                            var activeId = utils.GetActiveId();
                            if (activeId === null || activeId === undefined || activeId === id) {
                                utils.SetActiveItem(id);
                            }
                            NotifyQuotationStateChanged({ type: 'preview-ready', itemId: id });
                            if (utils.GetActiveId() === id) { RenderCncActiveMetrics(utils.GetItem(id)); }
                            viewer.AdjustCanvasSize(true);
                            // The canvas and core measurements are the first useful result.
                            // Capture the thumbnail on the following painted frame, then allow
                            // the independent accessibility worker to start.
                            return new Promise(function (resolve) {
                                requestAnimationFrame(function () {
                                    setTimeout(function () {
                                        if (utils.GetItem(id)) { UpdateSnapshot(id, object3D, modelInfo); }
                                        resolve();
                                    }, 0);
                                });
                            });
                        }
                    };
                    EnqueuePartProcessing(id, function () {
                    parseHandles[id] = viewer.ParseFile(uploadedFile, function (modelInfo, object3D, error, cncGeometry) {
                        delete parseHandles[id];
                        if (!modelInfo) {
                            var readFailure = error || iqErrorText.unreadableModel;
                            {
                                cncFallbackItemId = id;
                                var fallback = document.getElementById('cnc-dimensional-fallback');
                                if (fallback) { fallback.hidden = false; }
                                var failedItem = utils.GetItem(id);
                                if (failedItem) { failedItem.cncParseFailed = true; failedItem.errorMessage = null; }
                                NotifyQuotationStateChanged({ type: 'parse-failed', itemId: id });
                                utils.DecreasePendingTask();
                                FinishPartProcessing(id);
                                UpdateEmptyHint();
                                return;
                            }
                            utils.SetItemFailed(id, readFailure);
                            utils.DecreasePendingTask();
                            FinishPartProcessing(id);
                            UpdateEmptyHint();
                            alert(readFailure);
                            return;
                        }
                        { modelInfo.cncGeometry = cncGeometry || null; }
                        { utils.SetItemPricingPending(id, true); }
                        utils.SetItemParsed(id, object3D, modelInfo);
                        { NotifyQuotationStateChanged({ type: 'parse-completed', itemId: id }); }

                        // Geometry and the thumbnail have already painted. Refresh the active
                        // item with the completed analysis, then dispatch stock/setup/pricing to
                        // their separate worker without revisiting or stealing the active part.
                        setTimeout(function () {
                            if (!utils.GetItem(id)) { utils.DecreasePendingTask(); return; }
                            var currentActiveId = utils.GetActiveId();
                            var remainsActive = currentActiveId === id;
                            if (currentActiveId === null || currentActiveId === undefined || remainsActive) {
                                utils.SetActiveItem(id);
                                { NotifyQuotationStateChanged({ type: 'active-item-refreshed', itemId: id }); }
                            }
                            Promise.resolve(GetCncEstimate(id, { itemOnly: true, change: { type: 'item-price-ready', itemId: id } })).finally(function () {
                                utils.DecreasePendingTask();
                                FinishPartProcessing(id);
                            });
                        }, 0);
                    }, parseOptions);
                    });

                    utils.IncreasePendingTask();
                    QueueModelUpload(id, uploadedFile);
                })(file);
            }
        }

