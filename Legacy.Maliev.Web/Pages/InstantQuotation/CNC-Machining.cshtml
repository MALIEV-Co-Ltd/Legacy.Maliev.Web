        function SyncCncDrawingControls(item) {

            var status = document.getElementById('cnc-drawing-status');
            if (!status) { return; }
            item = item || utils.GetItem(utils.GetActiveId());
            var requirements = CncRequirementSubmission(item);
            var required = CncDrawingRequired(requirements);
            var control = document.querySelector('[data-cnc-drawing-control]');
            if (control) { control.dataset.required = required ? 'true' : 'false'; }
            if (item && item.cncDrawing && item.cncDrawing.status === 'ready' && item.cncDrawing.uploadComplete) {
                status.textContent = item.cncDrawing.fileName + ' · ' + iqReviewText.ready;
                status.classList.remove('iq-required-indicator');
            } else if (item && item.cncDrawing && item.cncDrawing.status === 'local' && item.cncDrawing.availableForLocalReview) {
                status.textContent = item.cncDrawing.fileName + ' · ' + iqReviewText.readyForLocalReview;
                status.classList.remove('iq-required-indicator');
            } else if (item && item.cncDrawing && item.cncDrawing.status === 'uploading') {
                status.textContent = item.cncDrawing.fileName + ' · ' + iqReviewText.uploading;
                status.classList.toggle('iq-required-indicator', required);
            } else if (item && item.cncDrawing && item.cncDrawing.status === 'failed') {
                status.textContent = item.cncDrawing.fileName + ' · ' + iqReviewText.drawingUploadFailed;
                status.classList.toggle('iq-required-indicator', required);
            } else if (required) {
                status.textContent = '@Localizer["Required — upload a PDF drawing for this part to continue."]';
                status.classList.add('iq-required-indicator');
