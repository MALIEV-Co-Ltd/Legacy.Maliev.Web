{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maliev.com/schemas/additive/filament-profile-catalog.v1.schema.json",
  "title": "MALIEV additive filament profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "slicer",
    "slicerVersion",
    "machineProfileId",
    "upstreamCatalogUrl",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "slicer": { "const": "Bambu Studio" },
    "slicerVersion": { "type": "string", "minLength": 1 },
    "machineProfileId": { "type": "string", "minLength": 1 },
    "upstreamCatalogUrl": { "type": "string", "format": "uri" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "materialKey",
          "preferredVendor",
          "profileId",
          "sourceAuthority",
          "resolvedSha256",
          "exactMaterialMatch",
          "operatorApproved",
          "automationEligible",
          "blockers"
        ],
        "properties": {
          "materialKey": { "type": "string", "minLength": 1 },
          "preferredVendor": { "type": "string", "minLength": 1 },
          "profileId": { "type": ["string", "null"], "minLength": 1 },
          "sourceAuthority": {
            "enum": [
              "bambu_official_bundle",
              "bambu_official_bundle_fallback",
              "operator_local_custom",
              "none"
            ]
          },
          "resolvedSha256": {
            "type": ["string", "null"],
            "pattern": "^[A-F0-9]{64}$"
          },
          "exactMaterialMatch": { "type": "boolean" },
          "operatorApproved": { "type": "boolean" },
          "automationEligible": { "type": "boolean" },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

