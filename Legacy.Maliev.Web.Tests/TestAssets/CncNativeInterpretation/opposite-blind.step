#295 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#296 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#297 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(
    1.00000000000000022E-07),#294,'distance_accuracy_value',
  'confusion accuracy');
#298 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
