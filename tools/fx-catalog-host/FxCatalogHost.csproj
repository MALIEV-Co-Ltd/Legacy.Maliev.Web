<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Maliev.FxCatalogHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <ProjectReference Include="$(FxCatalogRoot)/Legacy.Maliev.CatalogService.Api/Legacy.Maliev.CatalogService.Api.csproj" Aliases="CatalogApi" />
    <ProjectReference Include="../fx-provider-transport/FxProviderTransport.csproj" />
  </ItemGroup>
  <Target Name="RequireReviewedCatalogRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FxCatalogRoot)' == ''" Text="Exact reviewed native Catalog checkout required through FxCatalogRoot." />
  </Target>
</Project>
