<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Maliev.FxAuthHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <ProjectReference Include="$(FxAuthRoot)/Legacy.Maliev.AuthService.Api/Legacy.Maliev.AuthService.Api.csproj" Aliases="AuthApi" />
    <ProjectReference Include="$(FxAuthRoot)/Legacy.Maliev.AuthService.Infrastructure/Legacy.Maliev.AuthService.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="RequireReviewedAuthRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FxAuthRoot)' == ''" Text="Exact reviewed native Auth checkout required through FxAuthRoot." />
  </Target>
</Project>
