+    .hero-assembly-grid, .hero-partnership-stage, .hero-journey-heading { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
+    .hero-assembly-media { padding: 0; }
+    .hero-assembly-media img { aspect-ratio: 3 / 2; }
+    .hero-assembly-annotated img { aspect-ratio: auto; }
+    .hero-partnership-copy, .hero-partnership-media { grid-row: auto; grid-column: 1; width: 100%; }
+    .hero-partnership-copy { padding: 0; }
+    .hero-partnership-media { order: 2; }
+    .hero-partnership-media img { height: auto; aspect-ratio: 3 / 2; object-fit: contain; }
+    .hero-journey-images { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin-top: 1.75rem; }
+    .hero-journey-images img { aspect-ratio: 3 / 2; object-fit: contain; }
+}
+
+/* All three compositions share one measured grid track; no layout jump on rotation. */
+.home-hero-carousel { position: relative; }
+.hero-carousel-controls { display: flex; justify-content: flex-end; padding-block: .75rem; }
+.hero-carousel-controls[hidden] { display: none; }
+.hero-carousel-controls button { min-height: 2.75rem; padding: .5rem .875rem; border: 1px solid var(--landing-line); border-radius: .375rem; background: #fff; color: var(--landing-ink); font: inherit; font-size: .875rem; }
+.hero-carousel-controls button:focus-visible { outline: 3px solid var(--landing-blue); outline-offset: 4px; }
+.hero-carousel-controls button:disabled { color: var(--landing-muted); }
+.hero-carousel-stage { display: grid; }
+.hero-carousel-panel { grid-area: 1 / 1; min-width: 0; }
+/* Bootstrap's [hidden] uses !important: keep inactive scenes measurable, not visible. */
+.home-hero-carousel[data-carousel-ready="true"] .hero-carousel-panel[hidden] { display: block !important; visibility: hidden; pointer-events: none; }
+.hero-carousel-panel[aria-hidden="true"] { pointer-events: none; }
+@media (prefers-reduced-motion: reduce) {
+    .home-hero-carousel *, .home-hero-carousel *::before, .home-hero-carousel *::after { animation: none !important; transition: none !important; }
+}
+
+/* Home-only dependencies extracted from source company-profile.css; no About activation. */
+.landing-service-card .profile-image-note { min-height: 0; margin: 0 0 .35rem; font-size: .76rem; }
+.profile-pricing-link { display: inline-flex; margin-top: .85rem; }
+.profile-cutout-cta img { display: block; width: 30%; max-height: 100%; aspect-ratio: 3 / 2; object-fit: contain; border: 0; border-radius: 0; background: transparent; right: -.5rem; filter: none; }
