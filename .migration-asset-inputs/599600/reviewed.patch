+    .hero-partnership-media { width: 80%; }
+    .hero-journey-heading { gap: 2rem; }
+}
+@media (max-width: 767px) {
+    .hero-review-inner { gap: .25rem 1rem; }
+    .hero-review-inner > span { width: 100%; }
+    .hero-review-options { gap: .25rem 1rem; }
+    .hero-review-original { margin-left: 0; }
