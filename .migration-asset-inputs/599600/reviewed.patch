+.hero-review-inner > span { font-weight: 600; color: var(--landing-ink); }
+.hero-review-options { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
+.hero-review-bar a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--landing-muted); text-decoration: none; border-bottom: 2px solid transparent; }
+.hero-review-bar a[aria-current="page"] { color: var(--landing-ink); border-color: var(--landing-blue); }
+.hero-review-original { margin-left: auto; }
+.hero-review-bar a:hover, .hero-option-link:hover { color: var(--landing-blue); }
+.home-hero-option { color: var(--landing-ink); background: #fff; padding-block: clamp(2.5rem, 5vw, 5rem); }
+.home-hero-option :is(h1, h2) { margin: 0; color: var(--landing-ink); font-size: clamp(2.7rem, 4.8vw, 4.75rem); font-weight: 600; line-height: 1.12; letter-spacing: -.035em; text-wrap: balance; }
+html[lang="th"] .home-hero-option :is(h1, h2) { line-height: 1.4; letter-spacing: -.025em; }
+.hero-option-copy { min-width: 0; }
+.hero-option-copy > p { margin: 1.6rem 0 0; color: var(--landing-muted); max-width: 56ch; font-size: 1.05rem; line-height: 1.85; }
+.home-hero-option .landing-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
+.hero-option-link { display: inline-flex; align-items: center; gap: .65rem; min-height: 2.75rem; color: var(--landing-ink); font-weight: 600; text-decoration: none; }
+.hero-option-link:hover, .hero-option-link:focus-visible { text-decoration: none; }
+.hero-option-link > span { text-decoration: underline; text-underline-offset: .3em; }
+.home-hero-option a:focus-visible, .hero-review-bar a:focus-visible { outline: 3px solid var(--landing-blue); outline-offset: 4px; }
+.hero-assembly-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); align-items: center; gap: clamp(2rem, 4vw, 4rem); }
+.hero-assembly-media { margin: 0; min-width: 0; padding: 1rem; background: var(--landing-soft); overflow: hidden; }
+.hero-assembly-media, .hero-partnership-media img, .hero-journey-images img { border-radius: 20px; }
+.hero-assembly-media img { display: block; width: 100%; height: auto; aspect-ratio: 1.1; object-fit: contain; }
+.hero-assembly-annotated { position: relative; aspect-ratio: 1.1; }
+.hero-assembly-annotated img { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
+.hero-tech-leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
+.hero-tech-leaders path { fill: none; stroke: var(--landing-blue); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
+.hero-tech-leaders circle { fill: #fff; stroke: var(--landing-blue); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
+.hero-tech-callouts { list-style: none; margin: 0; padding: 0; }
+.hero-tech-callouts li { position: absolute; width: fit-content; max-width: 39%; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--landing-ink); line-height: 1.45; }
+.hero-tech-callouts strong { display: block; font-size: clamp(.75rem, 1.05vw, .95rem); font-weight: 600; }
+.hero-tech-callouts span { display: block; margin-top: .15rem; font-size: clamp(.65rem, .9vw, .8rem); color: var(--landing-muted); }
+.hero-tech-resin { top: 4%; left: 59%; }
+.hero-tech-fdm { top: 4%; left: 2%; }
+.hero-tech-nylon { bottom: 4%; left: 2%; }
+.hero-tech-cnc { bottom: 4%; right: 2%; }
+.hero-option-copy > .hero-material-summary { border-top: 1px solid var(--landing-line); padding-top: 1.25rem; font-size: .85rem; max-width: 48ch; }
+.hero-partnership-stage { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; isolation: isolate; }
+.hero-partnership-media { margin: 0; grid-row: 1; grid-column: 1 / -1; width: 76%; justify-self: end; }
+.hero-partnership-media img { display: block; width: 100%; height: clamp(32rem, 40vw, 40rem); object-fit: cover; object-position: 72% center; }
+.hero-partnership-copy { position: relative; grid-row: 1; grid-column: 1; z-index: 1; background: #fff; padding: 2.5rem 2.5rem 2.5rem 0; }
+.hero-journey-heading { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: end; gap: clamp(2rem, 6vw, 6rem); }
+.hero-journey-heading .hero-option-copy > p { margin: 0 0 .4rem; }
+.hero-journey-images { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; margin-top: 2.5rem; }
+.hero-journey-images img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
+.hero-journey-images img:nth-child(2) { object-position: 63% center; }
