diff --git a/Legacy.Maliev.Web/wwwroot/src/app/css/company-profile.css b/Legacy.Maliev.Web/wwwroot/src/app/css/company-profile.css
new file mode 100644
index 0000000000000000000000000000000000000000..3ae99db69fb793884d43e4fe1154b7d88276e12f
--- /dev/null
+++ b/Legacy.Maliev.Web/wwwroot/src/app/css/company-profile.css
@@ -0,0 +1,208 @@
+/* Page-scoped additions to the original production landing design. */
+.landing-service-card .profile-image-note { min-height: 0; margin: 0 0 .35rem; font-size: .76rem; }
+.profile-pricing-link { display: inline-flex; margin-top: .85rem; }
+html[lang="th"] .landing-hero h1 { line-height: 1.32; }
+.profile-hero-source { display: block; font-size: .77em; white-space: nowrap; }
+.profile-hero-result { display: block; white-space: nowrap; }
+html[lang="th"] .landing-hero-lead { line-height: 1.85; }
+.profile-about-hero .landing-hero-lead { font-size: 1.05rem; }
+.profile-company-facts .landing-value-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.profile-company-facts .landing-value-strip article { border-top: 0; }
+.profile-company-facts .landing-value-strip article + article { border-left: 1px solid var(--landing-line); }
+.profile-outcomes .landing-service-card p { min-height: 0; }
+.profile-story-grid { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); }
+.profile-story-media { margin: 0; min-width: 0; }
+.profile-story-media img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: .65rem; }
+.profile-story-media figcaption { color: var(--landing-muted); font-size: .86rem; line-height: 1.7; padding-top: .8rem; }
+.profile-workpiece-gallery { position: relative; }
+.profile-workpiece-stage { display: grid; aspect-ratio: 3 / 2; overflow: hidden; border-radius: .65rem; background: var(--landing-soft); }
+.profile-workpiece-stage img { grid-area: 1 / 1; width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; border-radius: 0; }
+.profile-workpiece-controls { position: absolute; right: .65rem; bottom: .65rem; display: flex; align-items: center; padding-inline: .2rem; background: #fff; border-radius: .4rem; opacity: 0; pointer-events: none; }
+.profile-workpiece-controls[hidden] { display: none; }
+.profile-workpiece-gallery:hover .profile-workpiece-controls, .profile-workpiece-controls:focus-within { opacity: 1; pointer-events: auto; }
+.profile-workpiece-controls > div { display: flex; }
+.profile-workpiece-controls button { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; padding: 0; background: transparent; color: var(--landing-ink); cursor: pointer; }
+.profile-workpiece-controls [data-workpiece-index]::before { content: ''; width: .4rem; height: .4rem; border-radius: 50%; background: var(--landing-muted); }
+.profile-workpiece-controls [aria-pressed="true"]::before { background: var(--landing-blue); }
+.profile-workpiece-controls button:focus-visible { outline: 3px solid var(--landing-blue); outline-offset: 2px; }
+.workpiece-play, [data-paused="true"] .workpiece-pause { display: none; }
+[data-paused="true"] .workpiece-play { display: inline-block; }
+@media (hover: none) { .profile-workpiece-controls { opacity: 1; pointer-events: auto; } }
+.profile-story-grid .landing-section-heading { text-align: left; margin: 0 0 1.6rem; }
+.profile-visual-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.3rem; }
+.profile-visual-steps li { display: flex; gap: 1.3rem; align-items: flex-start; }
+.profile-visual-steps li > span { color: var(--landing-blue); font-size: 1.5rem; font-weight: 600; line-height: 1.3; }
+.profile-visual-steps h3 { margin: 0; font-size: 1.12rem; }
+.profile-visual-steps p { margin: .35rem 0 0; color: var(--landing-muted); font-size: .95rem; }
+.profile-short-copy { color: var(--landing-muted); line-height: 1.8; margin: 1.1rem 0; }
+.profile-story-grid-reverse { grid-template-columns: 1fr 1.05fr; }
+.profile-real-part img { background: #30343b; }
+.profile-collaboration-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; padding-block: 1rem 2rem; }
+.profile-collaboration-grid article { border-top: 1px solid var(--landing-line); padding-top: 1rem; }
+.profile-collaboration-grid p { color: var(--landing-muted); line-height: 1.8; margin: .75rem 0 0; }
