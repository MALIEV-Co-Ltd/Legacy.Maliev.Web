+                await link.HoverAsync();
+                Assert.Equal("none", await link.EvaluateAsync<string>("element => getComputedStyle(element).textDecorationLine"));
+                await link.FocusAsync();
+                Assert.Equal("none", await link.EvaluateAsync<string>("element => getComputedStyle(element).textDecorationLine"));
+            }
+        }
